import SymmetricSubgroupAsymptotics.AffineCoprimeCyclicSocles
import SymmetricSubgroupAsymptotics.FiniteNormalRegistrySocleOfQuotientBounds
import SymmetricSubgroupAsymptotics.PrimitiveAffineDegreeTwoTwelveRow131AffineModel

/-!
# Every original quotient socle of the literal row-131 top

The actual complement is cyclic of order four. Its displayed translation
representation is the regular four-point representation over `F₃`,
generated by one delta function. The coprime cyclic affine theorem thus
applies to every original quotient, including quotients without a chosen
complement. This does not use a normal-subgroup registry or a rank bound.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open scoped Classical

namespace SymmetricSubgroupAsymptotics
namespace PrimitiveAffineDegreeTwoTwelveRow131AffineModel

open Non2UnipotentPrefixFiniteMenu.PrimitiveAffineImprimitiveBlockTransfer
open DegreeTwoTwelvePairFiniteCatalogue

theorem linearRepresentation_comp :
    (AffineModel.linearRepresentation linearGroup).comp complementEquiv.toMonoidHom =
      permutationFunctionRepresentation (ZMod 3) Block Block := by
  apply MonoidHom.ext
  intro c
  apply LinearMap.ext
  intro v
  funext i
  rfl

theorem linearRepresentation_generated :
    RepresentationGeneratedBy (AffineModel.linearRepresentation linearGroup) 1 := by
  apply RepresentationGeneratedBy.of_comp
    (AffineModel.linearRepresentation linearGroup) complementEquiv.toMonoidHom
  rw [linearRepresentation_comp]
  apply permutationFunctionRepresentation_generatedBy_orbitCover (fun _ : Fin 1 ↦ 1)
  intro c
  exact ⟨0, c, mul_one c⟩

theorem linearGroup_coprime : Nat.Coprime 3 (Nat.card linearGroup) := by
  rw [linearGroup_card]
  decide

/-- The quotient map starts at the original literal permutation top. -/
theorem socle_of_surjective {Q : Type} [Group Q]
    (pi : Top →* Q) (hpi : Function.Surjective pi) :
    SocleNormalGeneratorBound Q 1 :=
  AffineModel.socle_one_of_surjective_coprime_cyclic linearGroup
    linearGroup_coprime linearRepresentation_generated
    (pi.comp topAffineEquiv.symm.toMonoidHom)
    (hpi.comp topAffineEquiv.symm.surjective)

theorem quotientSocle (N : Subgroup Top) [N.Normal] :
    SocleNormalGeneratorBound (Top ⧸ N) 1 :=
  socle_of_surjective (QuotientGroup.mk' N) (QuotientGroup.mk'_surjective N)

def topSocle : row131Interface.normalRegistry.QuotientSocleGeneratorFamily 1 :=
  .ofQuotientBounds _ (fun N ↦ by
    letI := N.2
    exact quotientSocle N.1)

end PrimitiveAffineDegreeTwoTwelveRow131AffineModel
end SymmetricSubgroupAsymptotics

end
