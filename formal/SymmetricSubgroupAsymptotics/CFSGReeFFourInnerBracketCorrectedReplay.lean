theorem indicesOne : ∀ i : Fin stepsOne.length,
    ∃ j : Fin 269, (stepsOne.get i).rule = rules j := by decide +kernel

theorem validOne : ∀ s ∈ stepsOne,
    CFSGNormTwoCharTwoRootWordRewrite.validRule A root s.rule := by
  have h : ∀ i : Fin stepsOne.length,
      CFSGNormTwoCharTwoRootWordRewrite.validRule A root (stepsOne.get i).rule := by
    intro i
    obtain ⟨j,hj⟩ := indicesOne i
    rw [hj]
    exact rule_certificate j
  exact (List.forall_mem_iff_get (l := stepsOne)
    (p := fun s => CFSGNormTwoCharTwoRootWordRewrite.validRule A root s.rule)).2 h

theorem runOne : TwoLetterWordRewrite.run stepsOne initial = some middleOne := by decide +kernel

theorem collectedOne (K : Type) [CommRing K] [CharP K 2] :
    value (CFSGNormTwoCharTwoRootWordRewrite.parameter A hd hs hp ho root K) initial =
      value (CFSGNormTwoCharTwoRootWordRewrite.parameter A hd hs hp ho root K) middleOne :=
  CFSGNormTwoCharTwoRootWordRewrite.run_sound A hd hs hp ho root K
    (fun i t => (root_properties i).2 t) stepsOne initial middleOne validOne runOne

