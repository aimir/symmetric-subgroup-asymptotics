import SymmetricSubgroupAsymptotics.ThreePointTransitiveCubicMembership
import SymmetricSubgroupAsymptotics.PermutationPolynomialOrbitGenerators

/-! The actual cubic in a transitive three-point group has one point orbit,
so every invariant binary natural subspace is generated by one vector. -/
set_option autoImplicit false
noncomputable section
namespace SymmetricSubgroupAsymptotics

private theorem transitiveThree_rotation_cover : ∀ x : Fin 3,∃ m : Fin 3,
    (OddMarkerTernaryChart.rotation^m.val) 0=x := by decide +kernel

 theorem transitiveThree_binary_natural_uniform_one
    (B : Subgroup (Equiv.Perm (Fin 3))) [MulAction.IsPretransitive B (Fin 3)] :
    UniformSubrepresentationGeneratorBound
      (permutationFunctionRepresentation (ZMod 2) B (Fin 3)) 1 := by
  let g : B := ⟨OddMarkerTernaryChart.rotation,
    ThreePointTransitiveCubicMembership.rotation_mem B
      (fun x y => MulAction.exists_smul_eq B x y)⟩
  apply permutationFunctionRepresentation_uniform_of_polynomial_orbitCover
    g (fun _ : Fin 1 => (0 : Fin 3))
  intro x
  obtain ⟨m,hm⟩ := transitiveThree_rotation_cover x
  exact ⟨0,m.val,hm⟩

end SymmetricSubgroupAsymptotics
