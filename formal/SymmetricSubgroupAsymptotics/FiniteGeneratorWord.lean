import Mathlib.Algebra.Group.Subgroup.Finite
import Mathlib.Algebra.Group.Subgroup.Map

/-!
# Compact words for selected finite witnesses

The bounded affine witness emitter records short straight-line words rather
than expanding inverses into long positive products.  This file gives those
words their literal interpretation in the original group and converts the
checked equations into subgroup-containment certificates.
-/

set_option autoImplicit false
noncomputable section

namespace SymmetricSubgroupAsymptotics

/-- A compact group word.  The generator alphabet is finite in applications,
but the generic consumer does not need to assume this. -/
inductive FiniteGeneratorWord (ι : Type*) where
  | one : FiniteGeneratorWord ι
  | generator : ι → FiniteGeneratorWord ι
  | mul : FiniteGeneratorWord ι → FiniteGeneratorWord ι →
      FiniteGeneratorWord ι
  | inv : FiniteGeneratorWord ι → FiniteGeneratorWord ι

namespace FiniteGeneratorWord

variable {G H ι : Type*} [Group G] [Group H]

/-- Evaluate a compact word in the displayed literal generators. -/
def eval : FiniteGeneratorWord ι → (ι → G) → G
  | .one, _ => 1
  | .generator i, generators => generators i
  | .mul u v, generators => u.eval generators * v.eval generators
  | .inv u, generators => (u.eval generators)⁻¹

@[simp] theorem eval_one (generators : ι → G) :
    (one : FiniteGeneratorWord ι).eval generators = 1 := rfl

@[simp] theorem eval_generator (generators : ι → G) (i : ι) :
    (generator i).eval generators = generators i := rfl

@[simp] theorem eval_mul (generators : ι → G)
    (u v : FiniteGeneratorWord ι) :
    (mul u v).eval generators = u.eval generators * v.eval generators := rfl

@[simp] theorem eval_inv (generators : ι → G)
    (u : FiniteGeneratorWord ι) :
    (inv u).eval generators = (u.eval generators)⁻¹ := rfl

/-- Every checked word lies in the subgroup generated by its literal
alphabet. -/
theorem eval_mem_closure (generators : ι → G)
    (w : FiniteGeneratorWord ι) :
    w.eval generators ∈ Subgroup.closure (Set.range generators) := by
  induction w with
  | one => exact (Subgroup.closure (Set.range generators)).one_mem
  | generator i =>
      exact Subgroup.subset_closure (Set.mem_range_self i)
  | mul u v hu hv => exact (Subgroup.closure (Set.range generators)).mul_mem hu hv
  | inv u hu => exact (Subgroup.closure (Set.range generators)).inv_mem hu

/-- Compact words commute with homomorphisms.  This is used when a selected
finite certificate is transported back to the literal block action. -/
theorem map_eval (f : G →* H) (generators : ι → G)
    (w : FiniteGeneratorWord ι) :
    f (w.eval generators) = w.eval (fun i => f (generators i)) := by
  induction w <;> simp_all only [eval, map_one, map_mul, map_inv]

end FiniteGeneratorWord

variable {G ι κ τ : Type*} [Group G]

/-- Explicit words expressing one displayed generator tuple in another. -/
structure FiniteGeneratorWordCertificate
    (source : ι → G) (target : κ → G) where
  words : ι → FiniteGeneratorWord κ
  equations : ∀ i, (words i).eval target = source i

namespace FiniteGeneratorWordCertificate

variable {source : ι → G} {target : κ → G}
    (C : FiniteGeneratorWordCertificate source target)

include C

/-- Word equations give the corresponding inclusion of literal generated
subgroups. -/
theorem closure_le :
    Subgroup.closure (Set.range source) ≤
      Subgroup.closure (Set.range target) := by
  apply (Subgroup.closure_le _).mpr
  rintro _ ⟨i, rfl⟩
  rw [← C.equations i]
  exact (C.words i).eval_mem_closure target

end FiniteGeneratorWordCertificate

/-- Bidirectional word certificates identify two literal generated
subgroups without enumerating either subgroup. -/
structure FiniteGeneratorEqualityCertificate
    (left : ι → G) (right : κ → G) where
  forward : FiniteGeneratorWordCertificate left right
  backward : FiniteGeneratorWordCertificate right left

namespace FiniteGeneratorEqualityCertificate

variable {left : ι → G} {right : κ → G}
    (C : FiniteGeneratorEqualityCertificate left right)

include C

theorem closure_eq :
    Subgroup.closure (Set.range left) =
      Subgroup.closure (Set.range right) :=
  le_antisymm C.forward.closure_le C.backward.closure_le

end FiniteGeneratorEqualityCertificate

end SymmetricSubgroupAsymptotics

end
