  ⟨((code i / 2^(4*p.val)) % 16) % 12, Nat.mod_lt _ (by decide)⟩

def nextIndex (s : Fin 4) (i : Fin 495) : Fin 495 :=
  ⟨((stepCodes[s.val]!)[i.val]!) % 495, Nat.mod_lt _ (by decide)⟩

def generatorPermutation (s : Fin 4) : Perm12 :=
  match s.val with
  | 0 => xPermutation
  | 1 => xPermutation⁻¹
  | 2 => yPermutation
  | _ => yPermutation⁻¹

private theorem eval_map {G H : Type*} [Group G] [Group H]
    (f : G →* H) (u v : G) (w : List Letter) :
    f (eval u v w) = eval (f u) (f v) w := by
  induction w with
  | nil => simp only [eval,map_one]
  | cons s w ih =>
    have hs : f (value u v s) = value (f u) (f v) s := by
      cases s <;> simp only [value,map_inv]
    simp only [eval,map_mul,ih,hs]

theorem row_coe (i : Fin 495) :
    (rows i).val =
      eval xPermutation yPermutation (originWords[i.val]!) * xPermutation *
        (eval xPermutation yPermutation (originWords[i.val]!))⁻¹ := by
  change M12Subgroup.subtype (rows i) = _
  simp only [rows,conjugator,map_mul,map_inv,eval_map]
  change eval x.val y.val (originWords[i.val]!) * x.val *
    (eval x.val y.val (originWords[i.val]!))⁻¹ = _
  rw [x_coe_eq,y_coe_eq]

theorem generator_coe (s : Fin 4) :
    (signedGenerator x y s).val = generatorPermutation s := by
  fin_cases s
  · exact x_coe_eq
  · exact congrArg (fun z : Perm12 => z⁻¹) x_coe_eq
  · exact y_coe_eq
  · exact congrArg (fun z : Perm12 => z⁻¹) y_coe_eq

def rowPoint (i : Fin 495) (p : Fin 12) : Fin 12 :=
  applyWord xPermutation xPermutation.symm yPermutation yPermutation.symm
    ((originWords[i.val]!) ++ [Letter.first] ++ inverseWord (originWords[i.val]!)) p

/-- Only single-generator inverses are evaluated by later scalar row commands. -/
theorem rowPoint_eq (i : Fin 495) (p : Fin 12) :
    rowPoint i p = (rows i).val p := by
  unfold rowPoint
  rw [applyWord_eq,eval_append,eval_append,eval_inverse]
  simp only [eval,value,mul_one]
  rw [row_coe]

