import SymmetricSubgroupAsymptotics.BinaryMenuCayley8T21
import SymmetricSubgroupAsymptotics.DerivedGeneratorWords
import SymmetricSubgroupAsymptotics.MarkedC4ActualGlobalMarkGeneratorRank

/-! The original21 action is generated by its second and third displayed
generators. A single literal commutator word recovers the first one. -/
set_option autoImplicit false
noncomputable section
open scoped Classical
namespace SymmetricSubgroupAsymptotics.BinaryEightTopTwentyOneRankBound
abbrev H := Subgroup.closure (Set.range BinaryMenuCayley8T21.generators)
def original : Fin 3 → H := closureGenerators BinaryMenuCayley8T21.generators
def pair : Fin 2 → H := ![original 1, original 2]

private theorem original_zero_word :
    original 0 = original 1 *
      (original 1 * original 2 * (original 1)⁻¹ * (original 2)⁻¹) * (original 1)⁻¹ := by
  apply Subtype.ext
  decide +kernel

theorem pair_full : Subgroup.closure (Set.range pair) = ⊤ := by
  let S := Subgroup.closure (Set.range pair)
  have h1 : original 1 ∈ S := Subgroup.subset_closure ⟨0, rfl⟩
  have h2 : original 2 ∈ S := Subgroup.subset_closure ⟨1, rfl⟩
  have h0 : original 0 ∈ S := by
    rw [original_zero_word]
    exact S.mul_mem (S.mul_mem h1
      (S.mul_mem (S.mul_mem (S.mul_mem h1 h2) (S.inv_mem h1)) (S.inv_mem h2))) (S.inv_mem h1)
  have hall : Subgroup.closure (Set.range original) ≤ S := by
    apply (Subgroup.closure_le S).mpr
    rintro _ ⟨i, rfl⟩
    fin_cases i
    · exact h0
    · exact h1
    · exact h2
  have hfull : Subgroup.closure (Set.range original) = ⊤ := closureGenerators_full _
  rw [hfull] at hall
  exact top_le_iff.mp hall

theorem genRank_le_two : MarkedC4.genRank H ≤ 2 := by
  let S : Finset H := Finset.univ.image pair
  have hs : (S : Set H) = Set.range pair := by
    ext x
    simp only [S, Finset.coe_image, Finset.coe_univ, Set.image_univ]
  have hg : Subgroup.closure (S : Set H) = ⊤ := by rw [hs]; exact pair_full
  exact (MarkedC4.genRank_le hg).trans (Finset.card_image_le.trans (by simp))

end SymmetricSubgroupAsymptotics.BinaryEightTopTwentyOneRankBound
