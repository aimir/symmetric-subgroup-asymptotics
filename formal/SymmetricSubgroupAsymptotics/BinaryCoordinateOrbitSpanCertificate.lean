import SymmetricSubgroupAsymptotics.BinaryCoordinateRegistry

/-!
# Sparse coordinate certificates for cyclic orbit spans

The selected eight-frame rows store a reversible coordinate chart for every
distinct cyclic invariant submodule.  A generated row expresses each chart
basis vector as a short sum of images of its selected orbit representative.
Together with stability and membership of that representative, these
equalities identify the chart with the literal orbit span.
-/

set_option autoImplicit false
noncomputable section
open scoped Classical

namespace SymmetricSubgroupAsymptotics

variable {G : Type*} [Group G] {w d : ℕ}
  (C : BinaryCoordinateSpace w d)
  (rho : Representation (ZMod 2) G (Fin w → ZMod 2))
  (S : Subrepresentation rho) (hS : S.toSubmodule = C.space)
  (v : Fin w → ZMod 2) (hv : v ∈ C.space)
  (orbit : Fin d → List G)
  (basis_eq : ∀ j, C.inclusion (Pi.single j 1) =
    ((orbit j).map (fun g ↦ rho g v)).sum)

include S hS hv orbit basis_eq in
/-- Sparse orbit words on the coordinate basis identify the complete
cyclic submodule generated by the selected vector. -/
theorem binaryCoordinate_eq_orbitSpan :
    C.space = binaryOrbitSpan (k := ZMod 2) rho v := by
  apply le_antisymm
  · apply C.le_of_basis_mem
    intro j
    rw [basis_eq j]
    apply (binaryOrbitSpan (k := ZMod 2) rho v).list_sum_mem
    intro x hx
    obtain ⟨g, _hg, rfl⟩ := List.mem_map.mp hx
    exact Submodule.subset_span ⟨g, rfl⟩
  · rw [← hS] at hv ⊢
    exact binaryOrbitSpan_le rho S hv

include S hS in
/-- Two orbit representatives whose checked words generate the same
coordinate space have equal literal cyclic orbit spans. -/
theorem binaryOrbitSpan_eq_of_commonCoordinateSpace
    (u v : Fin w → ZMod 2)
    (hu : u ∈ C.space) (hv : v ∈ C.space)
    (orbitU orbitV : Fin d → List G)
    (basisU : ∀ j, C.inclusion (Pi.single j 1) =
      ((orbitU j).map (fun g ↦ rho g u)).sum)
    (basisV : ∀ j, C.inclusion (Pi.single j 1) =
      ((orbitV j).map (fun g ↦ rho g v)).sum) :
    binaryOrbitSpan (k := ZMod 2) rho u =
      binaryOrbitSpan (k := ZMod 2) rho v := by
  rw [← binaryCoordinate_eq_orbitSpan C rho S hS u hu orbitU basisU,
    ← binaryCoordinate_eq_orbitSpan C rho S hS v hv orbitV basisV]

end SymmetricSubgroupAsymptotics

end
