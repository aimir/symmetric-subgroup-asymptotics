import SymmetricSubgroupAsymptotics.TraceyPrimePowerInput
import Mathlib.GroupTheory.Perm.Fin
import Mathlib.Data.Fin.VecNotation
import Mathlib.LinearAlgebra.Pi

/-!
# Cyclic ternary modules on three regular coordinates

Over `F3`, the regular three-coordinate permutation module for `C3` has
the uniserial chain

`0 < constant line < augmentation plane < full module`.

The finite lemmas below certify exactly the orbit reductions needed to
prove that every invariant submodule is generated by one orbit.  Only the
fixed group of order three and its 27 vectors occur in the computation.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open scoped BigOperators Classical MonoidAlgebra

namespace SymmetricSubgroupAsymptotics

/-- The standard regular cyclic subgroup on three labelled points. -/
abbrev TernaryNaturalC3 : Subgroup (Equiv.Perm (Fin 3)) :=
  alternatingGroup (Fin 3)

/-- Its regular permutation module in defining characteristic. -/
abbrev ternaryNaturalC3Representation :
    Representation (ZMod 3) TernaryNaturalC3 (Fin 3 → ZMod 3) :=
  (permutationFunctionRepresentation (ZMod 3) (Equiv.Perm (Fin 3))
    (Fin 3)).comp TernaryNaturalC3.subtype

/-- Every order-three subgroup of the permutations of three labelled
points is the standard alternating subgroup. -/
theorem orderThree_subgroup_fin_three_eq_ternaryNaturalC3
    (T : Subgroup (Equiv.Perm (Fin 3)))
    (hT : Nat.card T = 3) : T = TernaryNaturalC3 := by
  have hle : T ≤ TernaryNaturalC3 := by
    intro g hg
    rw [Equiv.Perm.mem_alternatingGroup]
    have hpowT := pow_card_eq_one' (x := (⟨g, hg⟩ : T))
    rw [hT] at hpowT
    have hpow : g ^ 3 = 1 := congrArg Subtype.val hpowT
    have hsignpow : Equiv.Perm.sign g ^ 3 = 1 := by
      rw [← map_pow, hpow, map_one]
    rcases Int.units_eq_one_or (Equiv.Perm.sign g) with hsign | hsign
    · exact hsign
    · rw [hsign] at hsignpow
      norm_num at hsignpow
  apply Subgroup.eq_of_le_of_card_ge hle
  rw [nat_card_alternatingGroup, hT]
  norm_num [Nat.card_eq_fintype_card]

private def ternaryUnit : Fin 3 → ZMod 3 := ![1, 0, 0]

private def ternaryDifference : Fin 3 → ZMod 3 := ![1, -1, 0]

private def ternaryDiagonal : Fin 3 → ZMod 3 := fun _ ↦ 1

private def naturalC3OrbitLinearSum
    (v : Fin 3 → ZMod 3) (c : TernaryNaturalC3 → ZMod 3) :
    Fin 3 → ZMod 3 :=
  ∑ g, c g • ternaryNaturalC3Representation g v

/-- One coordinate delta generates the whole regular module. -/
private theorem ternaryUnit_orbit_spans :
    ∀ x : Fin 3 → ZMod 3, ∃ c : TernaryNaturalC3 → ZMod 3,
      naturalC3OrbitLinearSum ternaryUnit c = x := by
  native_decide

/-- A vector outside the augmentation plane generates the full module;
inside that plane it is generated by the orbit of one first difference. -/
private theorem ternaryDifference_orbit_or_unit_from_vector :
    ∀ x : Fin 3 → ZMod 3,
      (∃ c : TernaryNaturalC3 → ZMod 3,
        naturalC3OrbitLinearSum ternaryDifference c = x) ∨
      ∃ c : TernaryNaturalC3 → ZMod 3,
        naturalC3OrbitLinearSum x c = ternaryUnit := by
  native_decide

/-- Modulo the constant line, a vector either stays constant, generates
the augmentation plane, or generates the full module. -/
private theorem ternaryDiagonal_orbit_or_difference_or_unit_from_vector :
    ∀ x : Fin 3 → ZMod 3,
      (∃ c : TernaryNaturalC3 → ZMod 3,
        naturalC3OrbitLinearSum ternaryDiagonal c = x) ∨
      (∃ c : TernaryNaturalC3 → ZMod 3,
        naturalC3OrbitLinearSum x c = ternaryDifference) ∨
      ∃ c : TernaryNaturalC3 → ZMod 3,
        naturalC3OrbitLinearSum x c = ternaryUnit := by
  native_decide

/-- Every nonzero vector generates one of the three canonical layers. -/
private theorem ternaryThree_vector_generates_layer :
    ∀ x : Fin 3 → ZMod 3,
      x = 0 ∨
      (∃ c : TernaryNaturalC3 → ZMod 3,
        naturalC3OrbitLinearSum x c = ternaryDiagonal) ∨
      (∃ c : TernaryNaturalC3 → ZMod 3,
        naturalC3OrbitLinearSum x c = ternaryDifference) ∨
      ∃ c : TernaryNaturalC3 → ZMod 3,
        naturalC3OrbitLinearSum x c = ternaryUnit := by
  native_decide

private theorem orbitLinearSum_mem
    (M : Subrepresentation ternaryNaturalC3Representation)
    (v : Fin 3 → ZMod 3) (hv : v ∈ M.toSubmodule)
    (c : TernaryNaturalC3 → ZMod 3) :
    naturalC3OrbitLinearSum v c ∈ M.toSubmodule := by
  rw [naturalC3OrbitLinearSum]
  apply M.toSubmodule.sum_mem
  intro g _hg
  exact M.toSubmodule.smul_mem (c g)
    (M.apply_mem_toSubmodule g hv)

/-- Every invariant submodule of the regular ternary permutation module
on three points is additively generated by the orbit of one vector. -/
theorem ternaryThree_subrepresentation_cyclic
    (M : Subrepresentation ternaryNaturalC3Representation) :
    ∃ v : M.toSubmodule, ∀ x : M.toSubmodule,
      ∃ c : TernaryNaturalC3 → ZMod 3,
        (∑ g, c g • M.toRepresentation g v) = x := by
  by_cases hu : ternaryUnit ∈ M.toSubmodule
  · refine ⟨⟨ternaryUnit, hu⟩, ?_⟩
    intro x
    obtain ⟨c, hc⟩ := ternaryUnit_orbit_spans x.1
    refine ⟨c, ?_⟩
    apply Subtype.ext
    exact hc
  · by_cases hd : ternaryDifference ∈ M.toSubmodule
    · refine ⟨⟨ternaryDifference, hd⟩, ?_⟩
      intro x
      rcases ternaryDifference_orbit_or_unit_from_vector x.1 with
        ⟨c, hc⟩ | ⟨c, hc⟩
      · refine ⟨c, ?_⟩
        apply Subtype.ext
        exact hc
      · exfalso
        apply hu
        rw [← hc]
        exact orbitLinearSum_mem M x.1 x.2 c
    · by_cases hdiag : ternaryDiagonal ∈ M.toSubmodule
      · refine ⟨⟨ternaryDiagonal, hdiag⟩, ?_⟩
        intro x
        rcases ternaryDiagonal_orbit_or_difference_or_unit_from_vector x.1 with
          ⟨c, hc⟩ | ⟨c, hc⟩ | ⟨c, hc⟩
        · refine ⟨c, ?_⟩
          apply Subtype.ext
          exact hc
        · exfalso
          apply hd
          rw [← hc]
          exact orbitLinearSum_mem M x.1 x.2 c
        · exfalso
          apply hu
          rw [← hc]
          exact orbitLinearSum_mem M x.1 x.2 c
      · refine ⟨0, ?_⟩
        intro x
        have hx : x.1 = 0 := by
          rcases ternaryThree_vector_generates_layer x.1 with
            hx | ⟨c, hc⟩ | ⟨c, hc⟩ | ⟨c, hc⟩
          · exact hx
          · exact False.elim (hdiag (by
              rw [← hc]
              exact orbitLinearSum_mem M x.1 x.2 c))
          · exact False.elim (hd (by
              rw [← hc]
              exact orbitLinearSum_mem M x.1 x.2 c))
          · exact False.elim (hu (by
              rw [← hc]
              exact orbitLinearSum_mem M x.1 x.2 c))
        refine ⟨fun _ ↦ 0, ?_⟩
        apply Subtype.ext
        simpa only [zero_smul, Finset.sum_const_zero] using hx.symm

/-- Generator-strength form of the preceding fixed regular-module
calculation. -/
theorem naturalC3Ternary_uniformSubrepresentationGeneratorBound_one :
    UniformSubrepresentationGeneratorBound
      ternaryNaturalC3Representation 1 := by
  intro M
  obtain ⟨v, hv⟩ := ternaryThree_subrepresentation_cyclic M
  let generator : Fin 1 → M.toRepresentation.asModule := fun _ ↦
    M.toRepresentation.asModuleEquiv.symm v
  let W : Submodule (ZMod 3)[TernaryNaturalC3]
      M.toRepresentation.asModule :=
    Submodule.span (ZMod 3)[TernaryNaturalC3] (Set.range generator)
  have hgenerator : generator 0 ∈ W :=
    Submodule.subset_span (Set.mem_range_self 0)
  refine ⟨generator, ?_⟩
  apply top_unique
  intro x _hx
  obtain ⟨c, hc⟩ := hv (M.toRepresentation.asModuleEquiv x)
  have hsum : ∑ g : TernaryNaturalC3,
      MonoidAlgebra.single g (c g) • generator 0 ∈ W := by
    apply Submodule.sum_mem
    intro g _hg
    exact W.smul_mem _ hgenerator
  have heq : (∑ g : TernaryNaturalC3,
      MonoidAlgebra.single g (c g) • generator 0) = x := by
    apply M.toRepresentation.asModuleEquiv.injective
    rw [map_sum]
    simp only [Representation.asModuleEquiv_map_smul,
      Representation.asAlgebraHom_single,
      LinearEquiv.apply_symm_apply, generator]
    exact congrArg Subtype.val hc
  rw [heq] at hsum
  exact hsum

end SymmetricSubgroupAsymptotics

end
