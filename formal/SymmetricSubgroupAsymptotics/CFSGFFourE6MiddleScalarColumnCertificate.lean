  decide +kernel

private theorem blocks (b : Fin 8) (n : Fin 8) :
    parityTransition (actions (blockIndex b n))
      (states (blockIndex b n).castSucc) (states (blockIndex b n).succ) := by
  fin_cases b
  · exact block_0 n
  · exact block_1 n
  · exact block_2 n
  · exact block_3 n
  · exact block_4 n
  · exact block_5 n
  · exact block_6 n
  · exact block_7 n

private theorem tail : ∀n : Fin 4,
    parityTransition (actions (tailIndex n)) (states (tailIndex n).castSucc) (states (tailIndex n).succ) := by
  unfold parityTransition
  decide +kernel

theorem transitions (n : Fin 68) :
    parityTransition (actions n) (states n.castSucc) (states n.succ) := by
  by_cases hn : n.val<64
  · let b : Fin 8 := ⟨n.val/8,by omega⟩
    let k : Fin 8 := ⟨n.val%8,Nat.mod_lt _ (by decide)⟩
    have he : blockIndex b k=n := by
      apply Fin.ext
      dsimp only [blockIndex,b,k]
      omega
    rw [←he]
    exact blocks b k
  · let k : Fin 4 := ⟨n.val-64,by omega⟩
    have he : tailIndex k=n := by
      apply Fin.ext
      dsimp only [tailIndex,k]
      omega
    rw [←he]
    exact tail k

theorem actions_axes : ∀n : Fin 68,(actions n).1.2=1∨(actions n).1.2=2 := by decide +kernel

theorem initial : ∀j : Fin 26,states 0 j=if j=0 then [(0,0)] else [] := by decide +kernel

theorem final_thirteen : states (Fin.last 68) 13=[(1,0),(2,0)] := by decide +kernel

