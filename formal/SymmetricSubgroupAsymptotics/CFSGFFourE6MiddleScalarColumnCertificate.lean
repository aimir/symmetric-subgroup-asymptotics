private def blockIndex (b : Fin 8) (n : Fin 8) : Fin 68 :=
  ⟨8*b.val+n.val,by omega⟩
private def tailIndex (n : Fin 4) : Fin 68 := ⟨64+n.val,by omega⟩

private theorem block_0 : ∀n : Fin 8,
    parityTransition (actions (blockIndex 0 n))
      (states (blockIndex 0 n).castSucc) (states (blockIndex 0 n).succ) := by
  unfold parityTransition
  decide +kernel

private theorem block_1 : ∀n : Fin 8,
