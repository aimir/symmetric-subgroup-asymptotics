import SymmetricSubgroupAsymptotics.KernelLiftGeneratorClosure
import SymmetricSubgroupAsymptotics.BinaryPairAffineCoboundary
import SymmetricSubgroupAsymptotics.BinaryPairLiftCarryExponent

/-! A sparse linear normalization of the original lift offsets gives an
actual conjugacy of permutation subgroups. Changes of lift by vectors in
the actual kernel do not change the generated subgroup. -/
set_option autoImplicit false
noncomputable section
namespace SymmetricSubgroupAsymptotics.BinaryPairFrame

variable {X J : Type} {w : ℕ} {U : Subgroup (Equiv.Perm X)}
  (F : BinaryPairFrame U (Fin w))

/-- Left multiplication by a literal physical flip adds its coordinates
in the destination convention of the affine chart. -/
theorem physicalFlip_mul_affinePermutation (k v : (Fin w) → ZMod 2) (t : Equiv.Perm (Fin w)) :
    F.physicalFlip k * F.affinePermutation t v = F.affinePermutation t (k + v) := by
  apply Equiv.ext
  intro x
  obtain ⟨⟨i, b⟩, rfl⟩ := F.frame.surjective x
  change F.physicalFlip k (F.affinePermutation t v (F.frame (i, b))) = _
  rw [F.affinePermutation_apply_frame, F.physicalFlip_apply_frame,
    F.affinePermutation_apply_frame]
  congr 1
  apply congrArg (fun c : ZMod 2 => (t i, c))
  change b + v (t i) + k (t i) = b + (k (t i) + v (t i))
  abel

/-- Every physical orientation change fixes all actual pair-kernel flips. -/
theorem physicalFlip_conjugate_kernel (a : (Fin w) → ZMod 2) (k : F.top.ker) :
    F.physicalFlip a * (k.val : Equiv.Perm X) * (F.physicalFlip a)⁻¹ =
      F.physicalFlip (F.bits k) := by
  rw [F.physicalFlip_conjugate, F.affineTranslation_kernel, k.property]
  have ht : F.top.rangeRestrict (k : U) = 1 := Subtype.ext k.property
  rw [ht, map_one]
  change F.affinePermutation 1 (F.bits k + a - a) = F.affinePermutation 1 (F.bits k)
  rw [add_sub_cancel_right]

/-- A finite affine model generated by the same actual correlated kernel
and the displayed top lifts. It is a literal subgroup of the original
permutation group. -/
def affineGeneratedModel (K : Submodule (ZMod 2) ((Fin w) → ZMod 2))
    (t : J → Equiv.Perm (Fin w)) (v : J → (Fin w) → ZMod 2) : Subgroup (Equiv.Perm X) :=
  Subgroup.closure
    ({p | ∃ k ∈ K, p = F.physicalFlip k} ∪
      Set.range fun i => F.affinePermutation (t i) (v i))

/-- A sparse offset quotient witness yields exact original-point
conjugacy, including every original group element and kernel correlation. -/
theorem physical_conjugate_eq_affineGeneratedModel
    (u : J → U)
    (hgen : Subgroup.closure (Set.range fun i => F.top (u i)) = F.top.range)
    (a : (Fin w) → ZMod 2) (v : J → (Fin w) → ZMod 2)
    (hshift : ∀ i,
      F.affineTranslation (u i) + a -
        permutationFunctionRepresentation (ZMod 2) F.top.range (Fin w)
          (F.top.rangeRestrict (u i)) a - v i ∈ F.kernelSpace) :
    U.map (MulAut.conj (F.physicalFlip a)).toMonoidHom =
      F.affineGeneratedModel F.kernelSpace (fun i => F.top (u i)) v := by
  let c := (MulAut.conj (F.physicalFlip a)).toMonoidHom
  let j := c.comp U.subtype
  let C := F.affineGeneratedModel F.kernelSpace (fun i => F.top (u i)) v
  let delta : J → (Fin w) → ZMod 2 := fun i =>
    F.affineTranslation (u i) + a -
      permutationFunctionRepresentation (ZMod 2) F.top.range (Fin w)
        (F.top.rangeRestrict (u i)) a - v i
  have hdelta (i : J) : delta i ∈ F.kernelSpace := hshift i
  have hj : j.range = U.map c := by
    ext p
    constructor
    · rintro ⟨x, rfl⟩
      exact ⟨x.val, x.property, rfl⟩
    · rintro ⟨x, hx, rfl⟩
      exact ⟨⟨x, hx⟩, rfl⟩
  have hkernel (k : (Fin w) → ZMod 2) (hk : k ∈ F.kernelSpace) :
      F.physicalFlip k ∈ j.range := by
    obtain ⟨b, hb⟩ := hk
    change F.bits b.toMul = k at hb
    refine ⟨(b.toMul : U), ?_⟩
    change F.physicalFlip a * (b.toMul.val : Equiv.Perm X) * (F.physicalFlip a)⁻¹ = _
    rw [F.physicalFlip_conjugate_kernel, hb]
  have hu (i : J) : j (u i) = F.physicalFlip (delta i) *
      F.affinePermutation (F.top (u i)) (v i) := by
    change F.physicalFlip a * (u i : Equiv.Perm X) * (F.physicalFlip a)⁻¹ = _
    rw [F.physicalFlip_conjugate, F.physicalFlip_mul_affinePermutation]
    congr 1
    exact (sub_add_cancel _ _).symm
  rw [← hj]
  apply le_antisymm
  · rw [range_eq_closure_kernel_and_actual_lifts F.top.rangeRestrict j u
      (F.top_lift_tuple_full u hgen)]
    apply (Subgroup.closure_le C).mpr
    rintro p (⟨k, rfl⟩ | ⟨i, rfl⟩)
    · let b : F.top.ker := ⟨k.val, by
        simpa only [MonoidHom.ker_rangeRestrict] using k.property⟩
      have he : j k.val = F.physicalFlip (F.bits b) :=
        F.physicalFlip_conjugate_kernel a b
      change j k.val ∈ C
      rw [he]
      exact Subgroup.subset_closure (Or.inl ⟨F.bits b, ⟨Additive.ofMul b, rfl⟩, rfl⟩)
    · change j (u i) ∈ C
      rw [hu]
      apply C.mul_mem
      · exact Subgroup.subset_closure (Or.inl ⟨delta i, hdelta i, rfl⟩)
      · exact Subgroup.subset_closure (Or.inr ⟨i, rfl⟩)
  · apply (Subgroup.closure_le j.range).mpr
    rintro p (⟨k, hk, rfl⟩ | ⟨i, rfl⟩)
    · exact hkernel k hk
    · have he : j (u i) ∈ j.range := ⟨u i, rfl⟩
      rw [hu] at he
      exact (j.range.mul_mem_cancel_left (hkernel (delta i) (hdelta i))).mp he

end SymmetricSubgroupAsymptotics.BinaryPairFrame
