def normalizer : Ambient where
  toFun := ![3, 2, 5, 4, 7, 6, 1, 0]
  invFun := ![7, 6, 1, 0, 3, 2, 5, 4]
  left_inv := by decide +kernel
  right_inv := by decide +kernel

def normalizerCertificate : FiniteGeneratorEquivWordCertificate (MulAut.conj normalizer)
    BinaryMenuCayley8T16.generators BinaryMenuCayley8T16.generators where
  forward := {
    words := ![(.generator 0), (.mul (.mul (.generator 0) (.generator 1)) (.mul (.generator 0) (.mul (.inv (.generator 1)) (.inv (.generator 1)))))]
