import SymmetricSubgroupAsymptotics.CFSGTwoGenerationBasic
import Mathlib.GroupTheory.SpecificGroups.Cyclic.Basic
import Mathlib.GroupTheory.OrderOfElement

/-! An odd-order group has no nontrivial involution. Consequently a
noncommutative group generated by involutions and at most one further
element has even order. These are literal generator statements; no
classification, model order or solvability theorem is assumed. -/
set_option autoImplicit false
noncomputable section
open scoped Classical

namespace SymmetricSubgroupAsymptotics.CFSGReduction

theorem eq_one_of_square_eq_one_of_odd_card {G : Type*} [Group G]
    (hodd : Odd (Nat.card G)) (x : G) (hx : x ^ 2 = 1) : x = 1 := by
  obtain ⟨k, hk⟩ := hodd
  have hc : x ^ Nat.card G = 1 := pow_card_eq_one'
  rw [hk, pow_add, pow_mul, hx, one_pow, pow_one, one_mul] at hc
  exact hc

theorem even_card_of_involutions_and_one_generator {G : Type*} [Group G]
    {ι : Type*} (g : ι → G) (base : ι)
    (hgen : Subgroup.closure (Set.range g) = ⊤)
    (hsq : ∀ i, i ≠ base → g i ^ 2 = 1)
    (hn : ¬ IsMulCommutative G) : Even (Nat.card G) := by
  by_contra heven
  have hodd : Odd (Nat.card G) := Nat.not_even_iff_odd.mp heven
  have hle : (⊤ : Subgroup G) ≤ Subgroup.zpowers (g base) := by
    rw [← hgen]
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨i, rfl⟩
    by_cases hi : i = base
    · subst i
      exact Subgroup.mem_zpowers _
    · rw [eq_one_of_square_eq_one_of_odd_card hodd (g i) (hsq i hi)]
      exact (Subgroup.zpowers (g base)).one_mem
  letI : IsCyclic G := isCyclic_iff_exists_zpowers_eq_top.mpr
    ⟨g base, le_antisymm le_top hle⟩
  exact hn inferInstance

theorem presented_pair_even_card (rels : List (FreeGroup (Fin 2)))
    (hfirst : (FreeGroup.of (0 : Fin 2)) ^ 2 ∈ rels)
    (hn : ¬ IsMulCommutative (PresentedGroup {w | w ∈ rels})) :
    Even (Nat.card (PresentedGroup {w | w ∈ rels})) := by
  apply even_card_of_involutions_and_one_generator
    (PresentedGroup.of (rels := {w | w ∈ rels})) (1 : Fin 2)
    (PresentedGroup.closure_range_of _)
  · intro i hi
    have hi0 : i = 0 := by omega
    subst i
    have h := PresentedGroup.one_of_mem (rels := {w | w ∈ rels})
      (x := (FreeGroup.of (0 : Fin 2)) ^ 2) hfirst
    simpa only [map_pow, PresentedGroup.of] using h
  · exact hn

end SymmetricSubgroupAsymptotics.CFSGReduction
