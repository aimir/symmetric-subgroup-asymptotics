import SymmetricSubgroupAsymptotics.CFSGGTwoD4GeckImageRealization
import SymmetricSubgroupAsymptotics.CFSGTrialityGeckSimpleParameterGeneration

/-! The group generated by the literal G2 cubic units equals the
identity-field-twist D4 fixed-root-generated group on the SAME matrix
carrier. This is a proved subgroup equality, not a named-group or
projective-quotient identification. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
open scoped Classical
namespace SymmetricSubgroupAsymptotics.CFSGGTwoD4GeckGeneratedGroup
open CFSGGTwoD4GeckRootUnits CFSGGTwoD4GeckImageRealization
open CFSGTrialityGeckSimpleParameterGeneration CFSGTrialityGeckRelativeRootGenerated
open CFSGTrialityGeckFixedRootWords CFSGTrialityGeckDiagramCovariance

 theorem generated_eq_folded (K : Type) [Field K] [Finite K] :
    fixedRootGenerated K (RingEquiv.refl K)=foldedGroup K := by
  apply le_antisymm
  · apply fixedRootGenerated_le_of_simple_parameters K (RingEquiv.refl K) (foldedGroup K)
    · intro neg t _
      exact Subgroup.subset_closure ⟨neg,(0:Fin 2),t,rfl⟩
    · intro neg t _
      exact Subgroup.subset_closure ⟨neg,(1:Fin 2),t,rfl⟩
  · apply (Subgroup.closure_le _).mpr
    rintro u ⟨neg,i,t,rfl⟩
    fin_cases i
    · exact shortOrbit_mem_generated K (RingEquiv.refl K) neg t rfl
    · exact central_root_mem_generated K (RingEquiv.refl K) neg t rfl

 def generatedEquiv (K : Type) [Field K] [Finite K] :
    fixedRootGenerated K (RingEquiv.refl K)≃*foldedGroup K :=
  MulEquiv.subgroupCongr (generated_eq_folded K)

 theorem generatedEquiv_val (K : Type) [Field K] [Finite K]
    (g : fixedRootGenerated K (RingEquiv.refl K)) : (generatedEquiv K g).val=g.val := rfl

 def generatedImageAction (K : Type) [Field K] [Finite K] :
    fixedRootGenerated K (RingEquiv.refl K)→*(Image K≃ₗ[K]Image K) :=
  (foldedImageAction K).comp (generatedEquiv K).toMonoidHom

 theorem generatedImageAction_apply (K : Type) [Field K] [Finite K]
    (g : fixedRootGenerated K (RingEquiv.refl K)) (y : Image K) :
    (generatedImageAction K g y).val=(g.val : Matrix GeckIndex GeckIndex K)*y.val*
      (↑(g.val⁻¹) : Matrix GeckIndex GeckIndex K) := rfl

 theorem generated_action_ranges_eq (K : Type) [Field K] [Finite K] :
    (sourceImageRepresentation K).range=(generatedImageAction K).range := by
  rw [action_ranges_eq]
  apply le_antisymm
  · rintro _ ⟨g,rfl⟩
    exact ⟨(generatedEquiv K).symm g,congrArg (foldedImageAction K) ((generatedEquiv K).apply_symm_apply g)⟩
  · rintro _ ⟨g,rfl⟩
    exact ⟨generatedEquiv K g,rfl⟩

end SymmetricSubgroupAsymptotics.CFSGGTwoD4GeckGeneratedGroup
