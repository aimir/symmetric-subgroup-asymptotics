import SymmetricSubgroupAsymptotics.PermutationSectionNormalGenerators

/-!
# The sharp McIver--Neumann bound in a literal permutation section

McIver and Neumann proved that a subgroup of `S_n`, other than the full
group `S_3`, can be generated by at most `floor(n/2)` elements.  The
statement is recorded in Blackburn--Neumann--Venkataraman, *Enumeration of
Finite Groups*, Cambridge Tracts in Mathematics 173 (2007), Lemma 5.2;
their proof reference is Cameron--Solomon--Turull, *Chains of subgroups in
the symmetric group*, J. Algebra 127 (1989), Section 4.

This module keeps exactly that published input visible and proves the
transport through an arbitrary quotient section.  In particular it does
not fold the exceptional full `S_3` into the literature hypothesis.  A
consumer which can meet that exception must discharge it from its own
structure.
-/

set_option autoImplicit false
noncomputable section
open scoped Classical

namespace SymmetricSubgroupAsymptotics

/-- McIver--Neumann's sharp ordinary-generator theorem.  The implication
is deliberately written so that the sole exception is literally the full
three-point symmetric group. -/
def McIverNeumannPermutationGeneratorBound : Prop :=
  ∀ (s : ℕ) (J : Subgroup (Equiv.Perm (Fin s))),
    (s = 3 → J ≠ ⊤) →
      ∃ X : Finset J, Subgroup.closure (X : Set J) = ⊤ ∧
        2 * X.card ≤ s

/-- A normal subgroup which embeds in a quotient section of a literal
degree-`s` permutation group inherits the McIver--Neumann half-degree
bound, provided its actual pullback is not the exceptional full `S_3`.

The pullback `J` is retained in the statement.  This makes the exceptional
seam available to the caller rather than silently strengthening the
published theorem. -/
theorem normalGen_normalSubgroup_le_halfDegree_of_permutationSection
    (hMN : McIverNeumannPermutationGeneratorBound)
    {s : ℕ}
    (R : Subgroup (Equiv.Perm (Fin s)))
    {A : Type} [Group A] [Finite A]
    (q : R →* A) (hq : Function.Surjective q)
    {G : Type} [Group G] [Finite G]
    (K : Subgroup G) [K.Normal]
    (f : K →* A) (hf : Function.Injective f)
    (hexception : s = 3 →
      let H : Subgroup A := f.range
      let J : Subgroup R := H.comap q
      let jinc : J →* Equiv.Perm (Fin s) := R.subtype.comp J.subtype
      jinc.range ≠ ⊤) :
    MarkedC4.normalGen K ≤ s / 2 := by
  let H : Subgroup A := f.range
  let J : Subgroup R := H.comap q
  let qJ : J →* H :=
    (q.comp J.subtype).codRestrict H (fun x ↦ x.2)
  have hqJ : Function.Surjective qJ := by
    intro y
    obtain ⟨x, hx⟩ := hq y.1
    refine ⟨⟨x, ?_⟩, Subtype.ext hx⟩
    show q x ∈ H
    rw [hx]
    exact y.2
  let jinc : J →* Equiv.Perm (Fin s) := R.subtype.comp J.subtype
  have hjinc : Function.Injective jinc := by
    intro x y hxy
    apply Subtype.ext
    apply Subtype.ext
    exact hxy
  have hjrange : Function.Injective jinc.rangeRestrict :=
    MonoidHom.rangeRestrict_injective_iff.mpr hjinc
  let eJ : J ≃* jinc.range := MulEquiv.ofBijective jinc.rangeRestrict
    ⟨hjrange, jinc.rangeRestrict_surjective⟩
  have hnot : s = 3 → jinc.range ≠ ⊤ := by
    intro hs
    simpa only [H, J, jinc] using hexception hs
  obtain ⟨X, hX, hXcard⟩ := hMN s jinc.range hnot
  let e : K ≃* H := MulEquiv.ofBijective f.rangeRestrict
    ⟨fun x y h ↦ hf (congrArg Subtype.val h),
      f.rangeRestrict_surjective⟩
  have hgenH : MarkedC4.genRank H ≤ X.card := by
    exact (MarkedC4.genRank_le_of_surjective qJ hqJ).trans
      ((MarkedC4.genRank_le_of_surjective eJ.symm.toMonoidHom
        eJ.symm.surjective).trans (MarkedC4.genRank_le hX))
  have hgenK : MarkedC4.genRank K ≤ X.card := by
    exact (MarkedC4.genRank_le_of_surjective e.symm.toMonoidHom
      e.symm.surjective).trans hgenH
  calc
    MarkedC4.normalGen K ≤
        MarkedC4.normalGen (⊤ : Subgroup K) :=
      MarkedC4.normalGen_normalSubgroup_le_internal K
    _ ≤ MarkedC4.genRank K := MarkedC4.normalGen_top_le_genRank K
    _ ≤ X.card := hgenK
    _ ≤ s / 2 := by omega

end SymmetricSubgroupAsymptotics

end
