import SymmetricSubgroupAsymptotics.CFSGGradedMatrixLieDegree
import Mathlib.Algebra.Lie.Subalgebra

/-! A matrix Lie algebra generated by homogeneous matrices is linearly
spanned by homogeneous elements belonging to that SAME Lie algebra.
The statement uses literal additive degrees, in arbitrary characteristic;
it does not replace generated-Lie membership by ambient matrix support. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
namespace SymmetricSubgroupAsymptotics.CFSGGradedMatrixHomogeneousLieSpan
open CFSGGradedMatrixSupport CFSGGradedMatrixLieDegree
variable {I V K : Type*} [Fintype I] [DecidableEq I] [AddCommGroup V] [CommRing K]

def homogeneousHull (weight : I→V) (L : LieSubalgebra K (Matrix I I K)) :
    Submodule K (Matrix I I K) :=
  Submodule.span K {M | M∈L ∧ ∃d,Supported weight (fun v=>v+d) M}

theorem lie_mem_homogeneousHull (weight : I→V)
    (L : LieSubalgebra K (Matrix I I K)) (M N : Matrix I I K)
    (hM : M∈homogeneousHull weight L) (hN : N∈homogeneousHull weight L) :
    ⁅M,N⁆∈homogeneousHull weight L := by
  induction hM using Submodule.span_induction generalizing N with
  | mem M hM=>
    obtain ⟨hML,d,hMd⟩ := hM
    induction hN using Submodule.span_induction with
    | mem N hN=>
      obtain ⟨hNL,e,hNe⟩ := hN
      exact Submodule.subset_span ⟨L.lie_mem hML hNL,d+e,
        supported_lie weight d e M N hMd hNe⟩
    | zero=>simpa only [lie_zero] using (homogeneousHull weight L).zero_mem
    | add X Y _ _ hX hY=>
      rw [lie_add]
      exact (homogeneousHull weight L).add_mem hX hY
    | smul c X _ hX=>
      rw [lie_smul]
      exact (homogeneousHull weight L).smul_mem c hX
  | zero=>simpa only [zero_lie] using (homogeneousHull weight L).zero_mem
  | add X Y _ _ hX hY=>
    rw [add_lie]
    exact (homogeneousHull weight L).add_mem (hX N hN) (hY N hN)
  | smul c X _ hX=>
    rw [smul_lie]
    exact (homogeneousHull weight L).smul_mem c (hX N hN)

def homogeneousLieHull (weight : I→V) (L : LieSubalgebra K (Matrix I I K)) :
    LieSubalgebra K (Matrix I I K) where
  __ := homogeneousHull weight L
  lie_mem' := lie_mem_homogeneousHull weight L _ _

theorem homogeneousHull_le (weight : I→V) (L : LieSubalgebra K (Matrix I I K)) :
    homogeneousHull weight L≤L.toSubmodule := by
  apply Submodule.span_le.mpr
  rintro M ⟨hM,_⟩
  exact hM

theorem lieSpan_eq_homogeneousHull (weight : I→V) (s : Set (Matrix I I K))
    (hs : ∀M∈s,∃d,Supported weight (fun v=>v+d) M) :
    (LieSubalgebra.lieSpan K (Matrix I I K) s).toSubmodule=
      homogeneousHull weight (LieSubalgebra.lieSpan K (Matrix I I K) s) := by
  apply le_antisymm
  · have h : LieSubalgebra.lieSpan K (Matrix I I K) s≤
        homogeneousLieHull weight (LieSubalgebra.lieSpan K (Matrix I I K) s) := by
      apply LieSubalgebra.lieSpan_le.mpr
      intro M hM
      exact Submodule.subset_span ⟨LieSubalgebra.subset_lieSpan hM,hs M hM⟩
    exact h
  · exact homogeneousHull_le weight _

end SymmetricSubgroupAsymptotics.CFSGGradedMatrixHomogeneousLieSpan
