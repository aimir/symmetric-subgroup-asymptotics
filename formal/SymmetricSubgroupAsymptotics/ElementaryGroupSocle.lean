import SymmetricSubgroupAsymptotics.ZmudFaithfulCharacterInput
import Mathlib.GroupTheory.SpecificGroups.Cyclic

/-!
# The socle of a finite elementary abelian group

Every nonidentity element of a finite commutative group of prime exponent
generates a minimal normal subgroup.  Hence the group is its own socle.
This elementary lemma is the intrinsic input needed after an affine
translation section has been cut out of a literal quotient.
-/

set_option autoImplicit false
noncomputable section
open scoped Classical

namespace SymmetricSubgroupAsymptotics

/-- A finite commutative group of prime exponent is generated by its
minimal normal subgroups, and therefore equals its finite-group socle. -/
theorem finiteGroupSocle_eq_top_of_prime_exponent
    (G : Type) [CommGroup G] [Finite G]
    (p : ℕ) (hp : p.Prime)
    (hexponent : ∀ g : G, g ^ p = 1) :
    finiteGroupSocle G = ⊤ := by
  apply top_unique
  intro g _
  by_cases hg : g = 1
  · subst g
    exact (finiteGroupSocle G).one_mem
  have horder_dvd : orderOf g ∣ p :=
    orderOf_dvd_iff_pow_eq_one.mpr (hexponent g)
  have horder_ne_one : orderOf g ≠ 1 :=
    orderOf_eq_one_iff.not.mpr hg
  have horder : orderOf g = p :=
    (Nat.dvd_prime hp).mp horder_dvd |>.resolve_left horder_ne_one
  let N : Subgroup G := Subgroup.zpowers g
  have hNcard : Nat.card N = p := by
    simpa only [N, Nat.card_zpowers] using horder
  have hNne : N ≠ ⊥ := by
    intro hbot
    have : g = 1 := by
      apply Subgroup.mem_bot.mp
      rw [← hbot]
      exact Subgroup.mem_zpowers g
    exact hg this
  have hNminimal : IsMinimalNormalSubgroup N := by
    refine ⟨inferInstance, hNne, ?_⟩
    intro M _hMnormal hMne hMN
    haveI : Fact (Nat.card N).Prime := ⟨hNcard ▸ hp⟩
    rcases (M.subgroupOf N).eq_bot_or_eq_top_of_prime_card with hbot | htop
    · obtain ⟨x, hxne⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp hMne
      let xN : N := ⟨x.1, hMN x.2⟩
      have hxsub : xN ∈ M.subgroupOf N := x.2
      rw [hbot] at hxsub
      have hxN_one : xN = 1 := Subgroup.mem_bot.mp hxsub
      have hxval : x.1 = 1 := congrArg Subtype.val hxN_one
      exact False.elim (hxne (Subtype.ext hxval))
    · apply le_antisymm hMN
      intro x hxN
      let xN : N := ⟨x, hxN⟩
      have hxsub : xN ∈ M.subgroupOf N := by
        rw [htop]
        exact Subgroup.mem_top xN
      exact hxsub
  exact Subgroup.subset_normalClosure ⟨N, hNminimal, Subgroup.mem_zpowers g⟩

end SymmetricSubgroupAsymptotics

end
