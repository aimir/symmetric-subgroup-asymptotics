import SymmetricSubgroupAsymptotics.CFSGNormTwoCoordinateFunctionalRootTail
import SymmetricSubgroupAsymptotics.CFSGTrialityD4RelativeComplementRoots
import SymmetricSubgroupAsymptotics.CFSGNormTwoCoordinateLatticeWord
import SymmetricSubgroupAsymptotics.CFSGNormTwoCoordinateWordRootElementSign
import SymmetricSubgroupAsymptotics.CFSGTrialityGeckFixedRootWords
import SymmetricSubgroupAsymptotics.CFSGTrialityGeckPositiveTwist

/-! The actual short relative complement is generated by positive D4
roots of positive central coefficient. It is normal in U, strictly
raises the literal central grading, and is normalized by the actual
short Weyl word. No full fixed ambient Bruhat cover is inferred. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
open scoped Classical Matrix
namespace SymmetricSubgroupAsymptotics.CFSGTrialityGeckShortComplement
open CFSGTrialityD4NormTwo CFSGTrialityGeckDiagramCovariance
open CFSGTrialityGeckPositiveTwist CFSGTrialityGeckFixedRootWords
open CFSGTrialityD4RelativeComplementRoots CFSGNormTwoRootPairing
open CFSGNormTwoCoordinateFunctionalRootTail CFSGNormTwoCoordinateLatticeWord
open CFSGNormTwoGeckWeylWordDegree CFSGNormTwoGeckWeylLatticeLinear
open CFSGNormTwoCoordinateWordRootElementSign CFSGNormTwoCoordinateSelectedRootElement
open CFSGSerreQuadraticWeylWord

abbrev shortComplement (K : Type) [Field K] : Subgroup (Matrix GeckIndex GeckIndex K)ˣ :=
  functionalTail (CartanMatrix.D 4) (CartanMatrix.D_diag 4) (CartanMatrix.D_transpose 4)
    D4_positive_definite (CartanMatrix.D_off_diag_nonpos 4) K (LinearMap.proj 1) 1

private abbrev selected (K : Type) [Field K] (k : Roots (CartanMatrix.D 4)) (a : K) :
    (Matrix GeckIndex GeckIndex K)ˣ :=
  selectedRootElement (CartanMatrix.D 4) (CartanMatrix.D_diag 4) (CartanMatrix.D_transpose 4)
    D4_positive_definite (CartanMatrix.D_off_diag_nonpos 4) K k a

theorem shortComplement_le_positive (K : Type) [Field K] : shortComplement K ≤ Positive K :=
  functionalTail_le_positive (CartanMatrix.D 4) (CartanMatrix.D_diag 4) (CartanMatrix.D_transpose 4)
    D4_positive_definite (CartanMatrix.D_off_diag_nonpos 4) K (LinearMap.proj 1) 1

theorem positive_le_normalizer_shortComplement (K : Type) [Field K] :
    Positive K ≤ Subgroup.normalizer (shortComplement K : Set (Matrix GeckIndex GeckIndex K)ˣ) :=
  positive_le_normalizer_functionalTail (CartanMatrix.D 4) (CartanMatrix.D_diag 4)
    (CartanMatrix.D_transpose 4) D4_positive_definite (CartanMatrix.D_off_diag_nonpos 4)
    K (LinearMap.proj 1) 1 (fun k => k.property 1)

theorem shortComplement_le_strict (K : Type) [Field K] :
    shortComplement K ≤ CFSGGradedMatrixSubgroups.strictUnits
      (fun j => CFSGNormTwoGeckLatticeDegree.latticeWeight
        (CartanMatrix.D 4) (CartanMatrix.D_transpose 4) D4_positive_definite Base j 1) :=
  functionalTail_le_strict (CartanMatrix.D 4) (CartanMatrix.D_diag 4) (CartanMatrix.D_transpose 4)
    D4_positive_definite (CartanMatrix.D_off_diag_nonpos 4) K (LinearMap.proj 1) 1 zero_lt_one

theorem short_word_root_coordinates (k : Roots (CartanMatrix.D 4)) :
    (wordRoot (CartanMatrix.D 4) (CartanMatrix.D_transpose 4)
      D4_positive_definite Base Index [0,2,3] k).val = shortStep *ᵥ k.val := by
  have hh := LinearMap.congr_fun (latticeWord_linear (CartanMatrix.D 4)
    (CartanMatrix.D_diag 4) (CartanMatrix.D_transpose 4) D4_positive_definite
    (CartanMatrix.D_off_diag_nonpos 4) [0,2,3]) k.val
  change shortStep *ᵥ k.val = wordLinear (CartanMatrix.D 4) (CartanMatrix.D_transpose 4)
    D4_positive_definite Base Index [0,2,3] k.val at hh
  exact (wordLinear_root (CartanMatrix.D 4) (CartanMatrix.D_transpose 4)
    D4_positive_definite Base Index [0,2,3] k).symm.trans hh.symm

theorem short_word_central_degree (k : Roots (CartanMatrix.D 4)) :
    (wordRoot (CartanMatrix.D 4) (CartanMatrix.D_transpose 4)
      D4_positive_definite Base Index [0,2,3] k).val 1 = k.val 1 := by
  rw [short_word_root_coordinates]
  change shortStep 1 ⬝ᵥ k.val = k.val 1
  rw [shortStep_central_row]
  simp

theorem short_word_positive_of_central_positive (k : Roots (CartanMatrix.D 4))
    (hk : ∀ i, 0 ≤ k.val i) (hc : 0 < k.val 1) :
    ∀ i, 0 ≤ (wordRoot (CartanMatrix.D 4) (CartanMatrix.D_transpose 4)
      D4_positive_definite Base Index [0,2,3] k).val i := by
  obtain ⟨a, ha⟩ := CFSGTrialityD4PositiveRootIndex.positiveRoot_surjective ⟨k, hk⟩
  have he : CFSGTrialityD4PositiveRootIndex.coordinates a = k.val :=
    (CFSGTrialityD4PositiveRootIndex.positiveRoot_coordinates a).symm.trans
      (congrArg (fun x : CFSGTrialityD4PositiveRootIndex.Positive => x.val.val) ha)
  rw [short_word_root_coordinates, ← he]
  exact short_complement_positive a (by rw [he]; exact hc)

theorem shortWeyl_mem_normalizer_shortComplement (K : Type) [Field K] [Finite K] :
    shortWeyl K ∈ Subgroup.normalizer (shortComplement K : Set (Matrix GeckIndex GeckIndex K)ˣ) := by
  let C := shortComplement K
  have hle : C.map (MulAut.conj (shortWeyl K)).toMonoidHom ≤ C := by
    apply Subgroup.map_le_iff_le_comap.mpr
    apply (Subgroup.closure_le _).mpr
    rintro x ⟨k, hk, a, rfl⟩
    obtain ⟨ε, _, he⟩ := word_selected_root_sign (CartanMatrix.D 4)
      (CartanMatrix.D_diag 4) (CartanMatrix.D_transpose 4) D4_positive_definite
      (CartanMatrix.D_off_diag_nonpos 4) [0,2,3] k.val
    change canonicalWord rawData K [0,2,3] * selected K k.val a *
      (canonicalWord rawData K [0,2,3])⁻¹ ∈ C
    have hword := he K a
    change canonicalWord rawData K [0,2,3] * selected K k.val a *
      (canonicalWord rawData K [0,2,3])⁻¹ = selected K
        (wordRoot (CartanMatrix.D 4) (CartanMatrix.D_transpose 4)
          D4_positive_definite Base Index [0,2,3] k.val) ((ε : K) * a) at hword
    rw [hword]
    apply root_mem_functionalTail (CartanMatrix.D 4) (CartanMatrix.D_diag 4)
      (CartanMatrix.D_transpose 4) D4_positive_definite (CartanMatrix.D_off_diag_nonpos 4)
      K (LinearMap.proj 1) 1
    · exact short_word_positive_of_central_positive k.val k.property (lt_of_lt_of_le zero_lt_one hk)
    · change 1 ≤ (wordRoot (CartanMatrix.D 4) (CartanMatrix.D_transpose 4)
        D4_positive_definite Base Index [0,2,3] k.val).val 1
      rw [short_word_central_degree]
      exact hk
  have heq : C.map (MulAut.conj (shortWeyl K)).toMonoidHom = C :=
    Subgroup.eq_of_le_of_card_ge hle
      (Nat.card_congr ((MulAut.conj (shortWeyl K)).subgroupMap C).toEquiv).le
  apply Subgroup.mem_normalizer_iff_conj_image_eq.mpr
  exact congrArg (fun H : Subgroup (Matrix GeckIndex GeckIndex K)ˣ =>
    (H : Set (Matrix GeckIndex GeckIndex K)ˣ)) heq

end SymmetricSubgroupAsymptotics.CFSGTrialityGeckShortComplement
