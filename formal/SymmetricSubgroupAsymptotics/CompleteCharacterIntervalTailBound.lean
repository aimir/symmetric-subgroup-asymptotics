import SymmetricSubgroupAsymptotics.Non2PreE7CompleteCharacterIntervalSource
import SymmetricSubgroupAsymptotics.Non2PreE7SmallModelNumerics
import SymmetricSubgroupAsymptotics.FiniteGroupPaddedGenerators
import SymmetricSubgroupAsymptotics.PermutationSectionNormalGenerators

/-!
# A uniform finite coefficient bound for complete character intervals

The correlated character-interval source has one finite automorphism
coefficient for every literal normal axis below its retained subgroup.  This
file bounds that whole coefficient from a single order ceiling for the
ambient finite group.  The argument is independent of the affine degree:
there are at most `2^(m^2)` normal axes and every quotient has at most
`2^(m^2)` automorphisms when the ambient group has order at most `2^m`.

This is the shared coefficient estimate used by the exceptional affine
component rows.  Their degree-specific work is therefore reduced to an
explicit order ceiling and the elementary inequality `2*m^2 <= 64*w`.
-/

set_option autoImplicit false
noncomputable section
open scoped BigOperators Classical

namespace SymmetricSubgroupAsymptotics

-- Keep the unfolded tail sum on the canonical subtype enumeration, as in
-- the source theorem which defines it.
attribute [-instance] originalNormalFintype

namespace CompleteCharacterIntervalData

variable {w : ℕ} {U : Subgroup (Equiv.Perm (Fin w))}

/-- The normal subgroup generated by a padded ambient tuple. -/
private def normalTupleClosure (t : ℕ) (x : Fin t → U) :
    {N : Subgroup U // N.Normal} :=
  ⟨Subgroup.normalClosure (Set.range x), Subgroup.normalClosure_normal⟩

/-- If every normal subgroup has `t` ambient normal generators, then the
literal normal-axis menu has at most `|U|^t` members. -/
private theorem normalAxis_card_le_generator_power (t : ℕ)
    (h : ∀ N : {N : Subgroup U // N.Normal}, MarkedC4.normalGen N.1 ≤ t) :
    Nat.card {N : Subgroup U // N.Normal} ≤ Nat.card U ^ t := by
  have hsurj : Function.Surjective (normalTupleClosure (U := U) t) := by
    intro N
    letI : N.1.Normal := N.2
    obtain ⟨x, hx⟩ := exists_normal_generating_tuple_of_normalGen_le
      N.1 (h N)
    exact ⟨x, Subtype.ext hx⟩
  calc
    Nat.card {N : Subgroup U // N.Normal} ≤ Nat.card (Fin t → U) :=
      Nat.card_le_card_of_surjective _ hsurj
    _ = Nat.card U ^ t := by rw [Nat.card_fun, Nat.card_fin]

/-- The published permutation-subgroup generator bound gives an `w`-tuple
normal generator bound for every literal normal axis of a degree-`w`
permutation group. -/
private theorem normalAxis_card_le_two_pow_mul_width
    (hgen : PermutationSubgroupGeneratorBound) (m : ℕ)
    (horder : Nat.card U ≤ 2 ^ m) (hw : 2 ≤ w) :
    Nat.card {N : Subgroup U // N.Normal} ≤ 2 ^ (m * w) := by
  have hnormal : ∀ N : {N : Subgroup U // N.Normal},
      MarkedC4.normalGen N.1 ≤ w := by
    intro N
    letI : N.1.Normal := N.2
    exact normalGen_normalSubgroup_le_degree_of_permutationSection hgen U
      (MonoidHom.id U) Function.surjective_id N.1 N.1.subtype
      Subtype.val_injective hw
  calc
    Nat.card {N : Subgroup U // N.Normal} ≤ Nat.card U ^ w :=
      normalAxis_card_le_generator_power w hnormal
    _ ≤ (2 ^ m) ^ w := Nat.pow_le_pow_left horder w
    _ = 2 ^ (m * w) := by rw [pow_mul]

/-- Every quotient automorphism is determined by the images of the
published rounded generating tuple of the ambient permutation group. -/
private theorem quotient_mulEquiv_card_le_two_pow_generator
    (hgen : PermutationSubgroupGeneratorBound) (m : ℕ)
    (horder : Nat.card U ≤ 2 ^ m) (N : Subgroup U) [N.Normal] :
    Nat.card ((U ⧸ N) ≃* (U ⧸ N)) ≤
      2 ^ (m * ((w + 2) / 2)) := by
  obtain ⟨S, hS, hScard⟩ := hgen w U
  let q : U →* U ⧸ N := QuotientGroup.mk' N
  let T : Finset (U ⧸ N) := S.image q
  have hq : Function.Surjective q := QuotientGroup.mk'_surjective N
  have hT : Subgroup.closure (T : Set (U ⧸ N)) = ⊤ := by
    have hmap := congrArg (Subgroup.map q) hS
    simpa only [T, Finset.coe_image, MonoidHom.map_closure,
      Subgroup.map_top_of_surjective q hq] using hmap
  have hquot : Nat.card (U ⧸ N) ≤ 2 ^ m :=
    (Nat.card_le_card_of_surjective (QuotientGroup.mk' N)
      (QuotientGroup.mk'_surjective N)).trans horder
  have hTcard : T.card ≤ (w + 2) / 2 := by
    have himage : T.card ≤ S.card := Finset.card_image_le
    omega
  letI : Finite ((U ⧸ N) →* (U ⧸ N)) := Finite.of_injective
    (fun f : (U ⧸ N) →* (U ⧸ N) => (f : (U ⧸ N) → (U ⧸ N)))
    DFunLike.coe_injective
  calc
    Nat.card ((U ⧸ N) ≃* (U ⧸ N)) ≤
        Nat.card ((U ⧸ N) →* (U ⧸ N)) :=
      Nat.card_le_card_of_injective (fun e => e.toMonoidHom)
        (fun _ _ h => MulEquiv.ext (fun g => DFunLike.congr_fun h g))
    _ ≤ Nat.card (U ⧸ N) ^ T.card :=
      monoidHom_card_le_pow_of_closure T hT
    _ ≤ (2 ^ m) ^ T.card := Nat.pow_le_pow_left hquot _
    _ ≤ (2 ^ m) ^ ((w + 2) / 2) :=
      Nat.pow_le_pow_right (by positivity) hTcard
    _ = 2 ^ (m * ((w + 2) / 2)) := by rw [pow_mul]

/-- A quotient of a finite group has no more elements than the group. -/
private theorem quotient_card_le_self (N : Subgroup U) [N.Normal] :
    Nat.card (U ⧸ N) ≤ Nat.card U :=
  Nat.card_le_card_of_surjective (QuotientGroup.mk' N)
    (QuotientGroup.mk'_surjective N)

/-- An order ceiling `|U| <= 2^m` bounds the entire finite coefficient in a
complete character interval by `2^(2*m^2)`. -/
theorem tailConstant_le_two_pow_of_order
    (D : CompleteCharacterIntervalData U) (m : ℕ)
    (horder : Nat.card U ≤ 2 ^ m) :
    D.tailConstant ≤ ((2 ^ (m * m + m * m) : ℕ) : ℝ) := by
  let Ax := {N : {N : Subgroup U // N.Normal} // ¬ D.E ≤ N.1}
  have haxes : Nat.card Ax ≤ 2 ^ (m * m) := by
    apply (Nat.card_le_card_of_injective (fun N : Ax => N.1)
      (fun _ _ h => Subtype.ext h)).trans
    exact normalSubgroup_card_le_two_pow_sq m horder
  have hterm : ∀ N : Ax,
      (Nat.card ((U ⧸ N.1.1) ≃* (U ⧸ N.1.1)) : ℝ) ≤
        ((2 ^ (m * m) : ℕ) : ℝ) := by
    intro N
    letI : N.1.1.Normal := N.1.2
    have hquot : Nat.card (U ⧸ N.1.1) ≤ 2 ^ m :=
      (quotient_card_le_self N.1.1).trans horder
    have haut : Nat.card ((U ⧸ N.1.1) ≃* (U ⧸ N.1.1)) ≤
        2 ^ (m * m) := by
      calc
        Nat.card ((U ⧸ N.1.1) ≃* (U ⧸ N.1.1)) ≤
            Nat.card (U ⧸ N.1.1) ^ Nat.log 2 (Nat.card (U ⧸ N.1.1)) :=
          Non2UnipotentPrefixFiniteMenu.mulEquiv_card_le_card_pow_log _
        _ ≤ (2 ^ m) ^ Nat.log 2 (Nat.card (U ⧸ N.1.1)) :=
          Nat.pow_le_pow_left hquot _
        _ ≤ (2 ^ m) ^ m := by
          apply Nat.pow_le_pow_right (by positivity)
          exact (Nat.log_mono_right (b := 2) hquot).trans_eq
            (Nat.log_pow (by norm_num) m)
        _ = 2 ^ (m * m) := by rw [pow_mul]
    exact_mod_cast haut
  change (∑ N : Ax,
      (Nat.card ((U ⧸ N.1.1) ≃* (U ⧸ N.1.1)) : ℝ)) ≤ _
  calc
    (∑ N : Ax,
        (Nat.card ((U ⧸ N.1.1) ≃* (U ⧸ N.1.1)) : ℝ)) ≤
        ∑ _N : Ax, ((2 ^ (m * m) : ℕ) : ℝ) :=
      Finset.sum_le_sum (fun N _ => hterm N)
    _ = (Nat.card Ax : ℝ) * ((2 ^ (m * m) : ℕ) : ℝ) := by
      simp [Nat.card_eq_fintype_card]
    _ ≤ ((2 ^ (m * m) : ℕ) : ℝ) * ((2 ^ (m * m) : ℕ) : ℝ) := by
      apply mul_le_mul_of_nonneg_right
      · exact_mod_cast haxes
      · positivity
    _ = ((2 ^ (m * m + m * m) : ℕ) : ℝ) := by
      norm_num [pow_add]

/-- Once `2*m^2` fits below `64*w`, the common logarithmic-square menu pays
the complete interval coefficient uniformly in the complement degree. -/
theorem tailConstant_le_menuMass_of_order
    (D : CompleteCharacterIntervalData U) (m : ℕ)
    (horder : Nat.card U ≤ 2 ^ m)
    (hw : 8 ≤ w) (hexp : m * m + m * m ≤ 64 * w) (b : ℕ) :
    D.tailConstant ≤
      (2 : ℝ) ^
        (16 * (w : ℝ) * Real.log ((w + b + 2 : ℕ) : ℝ) ^ 2) := by
  calc
    D.tailConstant ≤ ((2 ^ (m * m + m * m) : ℕ) : ℝ) :=
      D.tailConstant_le_two_pow_of_order m horder
    _ = (2 : ℝ) ^ ((m * m + m * m : ℕ) : ℝ) := by
      rw [Real.rpow_natCast]
      norm_num
    _ ≤ (2 : ℝ) ^ (64 * (w : ℝ)) := by
      apply Real.rpow_le_rpow_of_exponent_le (by norm_num)
      exact_mod_cast hexp
    _ ≤ _ :=
      Non2UnipotentPrefixFiniteMenu.two_rpow_sixtyFour_width_le_menuMass hw b

/-- Sharper coefficient estimate using the published permutation-subgroup
generator bound.  Normal axes cost `m*w`, while quotient automorphisms cost
only `m*floor((w+2)/2)`, instead of charging `m^2` twice. -/
theorem tailConstant_le_two_pow_of_order_and_generators
    (D : CompleteCharacterIntervalData U)
    (hgen : PermutationSubgroupGeneratorBound) (m : ℕ)
    (horder : Nat.card U ≤ 2 ^ m) (hw : 2 ≤ w) :
    D.tailConstant ≤
      ((2 ^ (m * w + m * ((w + 2) / 2)) : ℕ) : ℝ) := by
  let Ax := {N : {N : Subgroup U // N.Normal} // ¬ D.E ≤ N.1}
  have haxes : Nat.card Ax ≤ 2 ^ (m * w) := by
    apply (Nat.card_le_card_of_injective (fun N : Ax => N.1)
      (fun _ _ h => Subtype.ext h)).trans
    exact normalAxis_card_le_two_pow_mul_width hgen m horder hw
  have hterm : ∀ N : Ax,
      (Nat.card ((U ⧸ N.1.1) ≃* (U ⧸ N.1.1)) : ℝ) ≤
        ((2 ^ (m * ((w + 2) / 2)) : ℕ) : ℝ) := by
    intro N
    letI : N.1.1.Normal := N.1.2
    exact_mod_cast quotient_mulEquiv_card_le_two_pow_generator
      hgen m horder N.1.1
  change (∑ N : Ax,
      (Nat.card ((U ⧸ N.1.1) ≃* (U ⧸ N.1.1)) : ℝ)) ≤ _
  calc
    (∑ N : Ax,
        (Nat.card ((U ⧸ N.1.1) ≃* (U ⧸ N.1.1)) : ℝ)) ≤
        ∑ _N : Ax, ((2 ^ (m * ((w + 2) / 2)) : ℕ) : ℝ) :=
      Finset.sum_le_sum (fun N _ => hterm N)
    _ = (Nat.card Ax : ℝ) *
        ((2 ^ (m * ((w + 2) / 2)) : ℕ) : ℝ) := by
      simp [Nat.card_eq_fintype_card]
    _ ≤ ((2 ^ (m * w) : ℕ) : ℝ) *
        ((2 ^ (m * ((w + 2) / 2)) : ℕ) : ℝ) := by
      apply mul_le_mul_of_nonneg_right
      · exact_mod_cast haxes
      · positivity
    _ = ((2 ^ (m * w + m * ((w + 2) / 2)) : ℕ) : ℝ) := by
      norm_num [pow_add]

/-- Numerical installation form of the refined generator estimate. -/
theorem tailConstant_le_menuMass_of_order_and_generators
    (D : CompleteCharacterIntervalData U)
    (hgen : PermutationSubgroupGeneratorBound) (m : ℕ)
    (horder : Nat.card U ≤ 2 ^ m) (hw : 8 ≤ w)
    (hexp : m * w + m * ((w + 2) / 2) ≤ 64 * w) (b : ℕ) :
    D.tailConstant ≤
      (2 : ℝ) ^
        (16 * (w : ℝ) * Real.log ((w + b + 2 : ℕ) : ℝ) ^ 2) := by
  calc
    D.tailConstant ≤
        ((2 ^ (m * w + m * ((w + 2) / 2)) : ℕ) : ℝ) :=
      D.tailConstant_le_two_pow_of_order_and_generators hgen m horder
        (by omega)
    _ = (2 : ℝ) ^ ((m * w + m * ((w + 2) / 2) : ℕ) : ℝ) := by
      rw [Real.rpow_natCast]
      norm_num
    _ ≤ (2 : ℝ) ^ (64 * (w : ℝ)) := by
      apply Real.rpow_le_rpow_of_exponent_le (by norm_num)
      exact_mod_cast hexp
    _ ≤ _ :=
      Non2UnipotentPrefixFiniteMenu.two_rpow_sixtyFour_width_le_menuMass hw b

end CompleteCharacterIntervalData

end SymmetricSubgroupAsymptotics
