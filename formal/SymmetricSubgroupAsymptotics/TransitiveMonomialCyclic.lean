import SymmetricSubgroupAsymptotics.TraceyPrimePowerInput
import Mathlib.LinearAlgebra.Pi

/-!
# A transitive monomial coordinate module is cyclic

If a group permutes a finite coordinate basis transitively, multiplying
each transported basis vector by an arbitrary nonzero scalar, then one
coordinate vector generates the whole representation.  This small lemma is
the local module input for each repeated sign isotype: the transitive binary
subgroup supplied by the literal sign stabilizer acts monomially on that
isotype over `F3`.
-/

set_option autoImplicit false
noncomputable section
open scoped Classical MonoidAlgebra

namespace SymmetricSubgroupAsymptotics

universe u

attribute [local instance] Fintype.ofFinite

/-- A representation which transports coordinate deltas transitively up to
nonzero scalars is generated by one vector. -/
theorem representationGeneratedBy_one_of_transitive_monomial
    {k G I : Type u} [Field k] [Group G]
    [Finite I] [Nonempty I]
    (top : G →* Equiv.Perm I)
    (rho : Representation k G (I → k))
    (htrans :
      letI : MulAction G I := MulAction.compHom I top
      MulAction.IsPretransitive G I)
    (hmonomial : ∀ (g : G) (i : I),
      ∃ c : k, c ≠ 0 ∧
        rho g (Pi.single i 1) = Pi.single (top g i) c) :
    RepresentationGeneratedBy rho 1 := by
  letI : MulAction G I := MulAction.compHom I top
  letI : MulAction.IsPretransitive G I := htrans
  let i₀ : I := Classical.choice inferInstance
  let generator : Fin 1 → rho.asModule := fun _ ↦
    rho.asModuleEquiv.symm (Pi.single i₀ 1)
  let W : Submodule k[G] rho.asModule :=
    Submodule.span k[G] (Set.range generator)
  have hgenerator : generator 0 ∈ W :=
    Submodule.subset_span (Set.mem_range_self 0)
  have hsingle : ∀ (j : I) (z : k),
      rho.asModuleEquiv.symm (Pi.single j z) ∈ W := by
    intro j z
    obtain ⟨g, hg⟩ := MulAction.exists_smul_eq G i₀ j
    obtain ⟨c, hc, hgc⟩ := hmonomial g i₀
    let d : k := z * c⁻¹
    have hmem := W.smul_mem (MonoidAlgebra.single g d) hgenerator
    have heq : MonoidAlgebra.single g d • generator 0 =
        rho.asModuleEquiv.symm (Pi.single j z) := by
      apply rho.asModuleEquiv.injective
      rw [Representation.asModuleEquiv_map_smul,
        Representation.asAlgebraHom_single,
        LinearMap.smul_apply, LinearEquiv.apply_symm_apply, hgc]
      change d • Pi.single (top g i₀) c = Pi.single j z
      rw [hg]
      funext x
      by_cases hx : x = j
      · subst x
        simp only [Pi.smul_apply, Pi.single_eq_same, smul_eq_mul, d]
        rw [mul_assoc, inv_mul_cancel₀ hc, mul_one]
      · simp [Pi.smul_apply, hx]
    rw [heq] at hmem
    exact hmem
  refine ⟨generator, ?_⟩
  apply top_unique
  intro x _hx
  let f : I → k := rho.asModuleEquiv x
  have hsum : ∑ i : I, rho.asModuleEquiv.symm (Pi.single i (f i)) ∈ W := by
    apply Submodule.sum_mem
    intro i _hi
    exact hsingle i (f i)
  have heq : (∑ i : I,
      rho.asModuleEquiv.symm (Pi.single i (f i))) = x := by
    apply rho.asModuleEquiv.injective
    rw [map_sum]
    simp only [LinearEquiv.apply_symm_apply]
    exact Finset.univ_sum_single f
  rw [heq] at hsum
  exact hsum

end SymmetricSubgroupAsymptotics

end
