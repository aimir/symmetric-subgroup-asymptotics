import SymmetricSubgroupAsymptotics.BinaryInvariantCyclicOrbitRegistry
import SymmetricSubgroupAsymptotics.PrimitiveAffineEightFrameOrbitImporter

/-!
# Deduplicated cyclic-orbit module importer for eight-block rows

The finite checker visits every vector orbit to prove coverage, but a join
depends only on the cyclic invariant submodule generated by that orbit.  This
adapter retains that distinction and then reuses the checked orbit importer.
-/

set_option autoImplicit false
noncomputable section

namespace SymmetricSubgroupAsymptotics
namespace Non2UnipotentPrefixFiniteMenu
namespace PrimitiveAffineImprimitiveBlockTransfer

/-- The module half of a finite-frame row with a vector-orbit cover and a
child table indexed by distinct cyclic invariant submodules. -/
structure FiniteFrameModuleCyclicOrbitHeadRegistry
    {k G V : Type} [Field k] [Group G] [AddCommGroup V] [Module k V]
    (rho : Representation k G V) (rank : ℕ) : Type 1 where
  Index : Type
  [indexFinite : Finite Index]
  state : Index → Subrepresentation rho
  axes : BinaryInvariantCyclicOrbitRegistry rho state
  head_le : ∀ i,
    Module.finrank k (state i).toRepresentation.Coinvariants ≤ rank

attribute [instance] FiniteFrameModuleCyclicOrbitHeadRegistry.indexFinite

namespace FiniteFrameModuleCyclicOrbitHeadRegistry

variable {k G V : Type} [Field k] [Group G]
  [AddCommGroup V] [Module k V]
  {rho : Representation k G V} {rank : ℕ}

/-- Forget only the distinction between orbit rows and cyclic join columns. -/
noncomputable def toOrbitRegistry
    (C : FiniteFrameModuleCyclicOrbitHeadRegistry rho rank) :
    FiniteFrameModuleOrbitHeadRegistry rho rank where
  Index := C.Index
  state := C.state
  axes := C.axes.toOrbitRegistry
  head_le := C.head_le

/-- The deduplicated row proves the uniform module-head bound. -/
theorem bound [Finite V]
    (C : FiniteFrameModuleCyclicOrbitHeadRegistry rho rank)
    (B : Subrepresentation rho) :
    Module.finrank k B.toRepresentation.Coinvariants ≤ rank :=
  C.toOrbitRegistry.bound B

end FiniteFrameModuleCyclicOrbitHeadRegistry

variable {w : ℕ} {U : PreE7NonPairActionClass w}
  {basePoint : Fin w}
  (block : OriginalMinimalBlock
    (A := preE7NonPairAction w U) basePoint)
  (P : PrimitiveAffineProfile block.Component block.Fibre)
  [Nontrivial block.Fibre]

namespace DegreeFourZeroCoreFiniteFrameBounds

/-- Import a top registry and a deduplicated cyclic-orbit module registry
when they already live on the literal retained top and module. -/
noncomputable def ofCyclicOrbitRegistries {slots topSlots moduleSlots : ℕ}
    [Finite (elementaryChart block P).V]
    (slot_sum_le : topSlots + moduleSlots ≤ slots)
    (top : FiniteTopRelativeBinaryRankRegistry
      (DegreeFourComplementQuotient block P) topSlots)
    (module : FiniteFrameModuleCyclicOrbitHeadRegistry
      (elementaryChart block P).quotientRepresentation.ρ moduleSlots) :
    DegreeFourZeroCoreFiniteFrameBounds block P slots :=
  DegreeFourZeroCoreFiniteFrameBounds.ofOrbitRegistries block P slot_sum_le top
    module.toOrbitRegistry

end DegreeFourZeroCoreFiniteFrameBounds

end PrimitiveAffineImprimitiveBlockTransfer
end Non2UnipotentPrefixFiniteMenu
end SymmetricSubgroupAsymptotics

end
