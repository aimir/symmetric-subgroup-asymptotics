import SymmetricSubgroupAsymptotics.CFSGSuzukiWeylWord
import SymmetricSubgroupAsymptotics.CFSGSuzukiZeroFirstBruhat

/-! The literal Suzuki model is generated by its two actual opposite
unipotent groups. The constant Weyl word and the zero-first-parameter
Bruhat identity suffice; no group-order theorem is assumed. -/
set_option autoImplicit false
noncomputable section
open scoped Classical
namespace SymmetricSubgroupAsymptotics.CFSGSuzukiUnipotent
open CFSG.Models.SuzukiConstruction CFSGSuzukiTorus CFSGSuzukiBruhat

theorem opposite_unipotent_closure (m : ℕ) :
    Subgroup.closure ((unipotentSubgroup m : Set (Ambient m)) ∪
      (unipotentSubgroup m).map (MulAut.conj (weylElement m)).toMonoidHom) =
        subgroup m := by
  apply le_antisymm
  · apply (Subgroup.closure_le _).mpr
    intro g hg
    rcases hg with hu | ⟨u,hu,rfl⟩
    · exact unipotentSubgroup_le_model m hu
    · change weylElement m * u * (weylElement m)⁻¹ ∈ subgroup m
      exact (subgroup m).mul_mem
        ((subgroup m).mul_mem (weylElement_mem_model m)
          (unipotentSubgroup_le_model m hu))
        ((subgroup m).inv_mem (weylElement_mem_model m))
  · apply model_le_of_unipotent_weyl m
    · intro u hu
      exact Subgroup.subset_closure (Or.inl hu)
    · exact weylElement_mem_opposite_closure m

end SymmetricSubgroupAsymptotics.CFSGSuzukiUnipotent
