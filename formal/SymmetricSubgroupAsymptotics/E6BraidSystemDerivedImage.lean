import SymmetricSubgroupAsymptotics.E6BraidSystemDerivedOrbitGap
import SymmetricSubgroupAsymptotics.DerivedGeneratorWords

/-! The literal derived image generated by six actual E6 reflections.
The inclusion lands in the original ambient commutator. No surjectivity
onto that ambient commutator or whole centralizer generation is claimed. -/
set_option autoImplicit false
noncomputable section
namespace SymmetricSubgroupAsymptotics.E6BraidSystemDerivedImage
open InvolutionBraidPresentation
open CFSGYE6SelectedWords (adjacent)
variable {G : Type*} [Group G] (S : System adjacent G)

abbrev ReflectionGroup := Subgroup.closure (Set.range S.generator)
abbrev DerivedImage := commutator (ReflectionGroup S)

def imageSystem : System adjacent (ReflectionGroup S) where
  generator := closureGenerators S.generator
  square i := Subtype.ext (S.square i)
  commute i j hij := Subtype.ext (S.commute i j hij)
  braid i j hij := Subtype.ext (S.braid i j hij)

theorem imageSystem_generates :
    Subgroup.closure (Set.range (imageSystem S).generator)=⊤ :=
  closureGenerators_full S.generator

/-- The actual subgroup inclusion; only its injectivity is asserted. -/
def embedding : DerivedImage S →* commutator G where
  toFun x := ⟨x.val.val,by
    have hle : (commutator (ReflectionGroup S)).map (ReflectionGroup S).subtype≤commutator G := by
      rw [Subgroup.map_subtype_commutator,commutator_def]
      exact Subgroup.commutator_mono le_top le_top
    exact hle ⟨x.val,x.property,rfl⟩⟩
  map_one' := rfl
  map_mul' _ _ := rfl

theorem embedding_injective : Function.Injective (embedding S) := by
  intro x y h
  apply Subtype.ext
  apply Subtype.ext
  exact congrArg (fun z : commutator G => z.val) h

theorem anchor_binding :
    embedding S (E6BraidSystemDerivedWords.a (imageSystem S))=
      E6BraidSystemDerivedWords.a S := by
  apply Subtype.ext
  change (E6BraidSystemWordAlgebra.a (imageSystem S)).val=E6BraidSystemWordAlgebra.a S
  rw [E6BraidSystemWordAlgebra.raw_a,E6BraidSystemWordAlgebra.raw_a]
  rfl

theorem derived_perfect : commutator (DerivedImage S)=⊤ :=
  E6BraidSystemDerivedStructure.derived_perfect (imageSystem S) (imageSystem_generates S)

theorem card_ge_twentySeven_of_nontrivial_action
    [Finite (commutator G)] {X : Type*} [Finite X]
    [MulAction (DerivedImage S) X]
    (hmove : ∃ g : DerivedImage S, ∃ x : X, g • x≠x) : 27≤Nat.card X := by
  letI : Finite (DerivedImage S) := Finite.of_injective (embedding S) (embedding_injective S)
  exact E6BraidSystemDerivedOrbitGap.card_ge_twentySeven_of_nontrivial_action
    (imageSystem S) (imageSystem_generates S) hmove

end SymmetricSubgroupAsymptotics.E6BraidSystemDerivedImage
