def normalData : FiniteNormalJoinWordRegistryData
    conjugacy.toCardinalCover ambient stateGenerators where
  ambient_full := ambient_full
  normality := normality
  bottom := 4
  bottom_eq := by native_decide
  child := child
  transition := transition

noncomputable def rowRegistry : FiniteNormalStateRegistry Source :=
  FiniteNormalStateRegistry.ofWordRegistry
    conjugacy.toCardinalCover ambient stateGenerators normalData
      rowState_injective

noncomputable def topRegistry :
    FiniteNormalStateRegistry Catalogue.Row3Top :=
  rowRegistry.mapEquiv originalEquiv

private abbrev RR := rowRegistry

private theorem rowRegistry_state (i : Fin 5) :
    RR.state i = rowState i := rfl

private def RowIsMinimalStateAbove (base j : Fin 5) : Prop :=
  rowState base < rowState j ∧
    ∀ k : Fin 5, rowState base < rowState k →
      rowState k ≤ rowState j → rowState k = rowState j

private theorem rowRegistry_minimal_iff (base j : Fin 5) :
    RR.IsMinimalStateAbove base j ↔ RowIsMinimalStateAbove base j := by
  rfl

private def carrierState (i : Fin 5) : Fin 5 :=
  (if i.val < 2 then (if i.val < 1 then 0 else 0) else (if i.val < 3 then 0 else (if i.val < 4 then 0 else 3)))

private def state0SocleGenerators : Fin 2 → Source :=
  fun j => (⟨(if j.val < 1 then 239 else 239)⟩ : Source)

private def state1SocleGenerators : Fin 2 → Source :=
  fun j => (⟨(if j.val < 1 then 1 else 239)⟩ : Source)

private def state2SocleGenerators : Fin 2 → Source :=
  fun j => (⟨(if j.val < 1 then 1 else 239)⟩ : Source)

private def state3SocleGenerators : Fin 2 → Source :=
  fun j => (⟨(if j.val < 1 then 1 else 239)⟩ : Source)

private def state4SocleGenerators : Fin 2 → Source :=
  fun j => (⟨(if j.val < 1 then 0 else 239)⟩ : Source)

private def rowSocleGenerator (i : Fin 5) :
    Fin 2 → Source :=
  (Fin.cases (state0SocleGenerators) (Fin.cases (state1SocleGenerators) (Fin.cases (state2SocleGenerators) (Fin.cases (state3SocleGenerators) (Fin.cases (state4SocleGenerators) (fun i => Fin.elim0 i))))))

private theorem row_carrier_eq_checked : ∀ i : Fin 5,
    rowState (carrierState i) = rowState i ⊔
      ⨆ j : {j : Fin 5 // RowIsMinimalStateAbove i j},
        rowState j.1 := by
  native_decide

private theorem row_generated_checked : ∀ i : Fin 5,
    Subgroup.normalClosure (Set.range (rowSocleGenerator i)) ⊔ rowState i =
      rowState (carrierState i) := by
  native_decide

noncomputable def rowStateData (i : Fin 5) :
    FiniteRelativeSocleGeneratorData Source (RR.state i) 2 :=
  RR.relativeSocleGeneratorDataOfStates i (carrierState i) 2
    {j : Fin 5 // RowIsMinimalStateAbove i j}
    Subtype.val
    (fun j ↦ (rowRegistry_minimal_iff i j).2 j.property)
    (fun j hj ↦ ⟨⟨j, (rowRegistry_minimal_iff i j).1 hj⟩, rfl⟩)
    (by simpa only [rowRegistry_state] using row_carrier_eq_checked i)
    (rowSocleGenerator i)
    (by simpa only [rowRegistry_state] using row_generated_checked i)

noncomputable def topStateData (i : Fin 5) :
    FiniteRelativeSocleGeneratorData Catalogue.Row3Top
      (topRegistry.state i) 2 :=
  (rowStateData i).mapEquiv originalEquiv

/-- Uniform quotient-socle tuples on the catalogue row's canonical normal
registry, transported from the checked selected Cayley source. -/
noncomputable def family :
    (Catalogue.row3.normalRegistry).
      QuotientSocleGeneratorFamily 2 where
  data := by
    intro i
    let N := Catalogue.row3.normalRegistry.state i
    letI : N.Normal :=
      Catalogue.row3.normalRegistry.state_normal i
    obtain ⟨j, hj⟩ := topRegistry.complete N
    exact cast
      (congrArg
        (fun M : Subgroup Catalogue.Row3Top ↦
          FiniteRelativeSocleGeneratorData
            Catalogue.Row3Top M 2) hj)
      (topStateData j)

end PrimitiveAffineDegreeTwoPrimitiveSixteenRow3CayleySocles
