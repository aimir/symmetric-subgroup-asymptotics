import SymmetricSubgroupAsymptotics.CFSGReeGTwoFixedFactorDescent
import SymmetricSubgroupAsymptotics.CFSGReeGTwoOppositionTorus

/-! The subgroup generated by the actual positive Ree subgroup and its
actual opposite is normal in the full original fixed group. Normality uses
the proved two-cell decomposition and actual torus inversion, not a
perfectness or simplicity assertion for the full fixed group. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
namespace SymmetricSubgroupAsymptotics.CFSGReeGTwoRootGeneratedNormal
open CFSGReeGTwoFieldParameters CFSGReeGTwoFixedModelEquivalence
open CFSGReeGTwoOriginalPositiveSubgroup CFSGReeGTwoOriginalBorel
open CFSGReeGTwoOriginalTorus CFSGReeGTwoOriginalOpposition
open CFSGReeGTwoFixedFactorDescent CFSGReeGTwoOppositionTorus
open CFSGReeGTwoPositiveDerived

def fixedNegativeGroup (m : ℕ) : Subgroup (originalModelFixed m) :=
  (fixedPositiveGroup m).map (MulAut.conj (fixedOpposition m)).toMonoidHom

def fixedRootGenerated (m : ℕ) : Subgroup (originalModelFixed m) :=
  fixedPositiveGroup m⊔fixedNegativeGroup m

theorem positive_le_generated (m : ℕ) : fixedPositiveGroup m≤fixedRootGenerated m := le_sup_left

private theorem involution_conjugation_twice {G : Type*} [Group G]
    (w x : G) (hw : w*w=1) : w*(w*x*w⁻¹)*w⁻¹=x := by
  have hi : w⁻¹=w := inv_eq_of_mul_eq_one_right hw
  calc
    _=(w*w)*x*(w*w) := by rw [hi]; group
    _=x := by rw [hw,one_mul,mul_one]

private theorem normalizes_of_involutive_conjugation {G : Type*} [Group G]
    (H : Subgroup G) (w : G) (hw : w*w=1)
    (hp : ∀x∈H,w*x*w⁻¹∈H) : w∈Subgroup.normalizer H := by
  apply Subgroup.mem_normalizer_iff.mpr
  intro x
  constructor
  · exact hp x
  · intro hx
    have h := hp _ hx
    rwa [involution_conjugation_twice w x hw] at h

theorem fixedOpposition_normalizes_generated (m : ℕ) :
    fixedOpposition m∈Subgroup.normalizer (fixedRootGenerated m) := by
  apply normalizes_of_involutive_conjugation _ _ (fixedOpposition_square m)
  have hmap : (fixedRootGenerated m).map
      (MulAut.conj (fixedOpposition m)).toMonoidHom≤fixedRootGenerated m := by
    rw [fixedRootGenerated,Subgroup.map_sup]
    apply sup_le
    · exact le_sup_right
    · rintro _ ⟨x,⟨u,hu,he⟩,rfl⟩
      rw [←he]
      change fixedOpposition m*(fixedOpposition m*u*(fixedOpposition m)⁻¹)*
        (fixedOpposition m)⁻¹∈fixedPositiveGroup m⊔fixedNegativeGroup m
      rw [involution_conjugation_twice _ _ (fixedOpposition_square m)]
      exact positive_le_generated m hu
  intro x hx
  exact hmap ⟨x,hx,rfl⟩

theorem fixedTorus_normalizes_negative (m : ℕ) (t : (Field m)ˣ) :
    fixedTorusHom m t∈Subgroup.normalizer (fixedNegativeGroup m) := by
  have h := (fixedPositiveGroup m).le_normalizer_map
    (MulAut.conj (fixedOpposition m)).toMonoidHom
    ⟨fixedTorusHom m t⁻¹,fixedTorus_mem_normalizer m t⁻¹,rfl⟩
  have he : (MulAut.conj (fixedOpposition m)) (fixedTorusHom m t⁻¹)=fixedTorusHom m t := by
    change fixedOpposition m*fixedTorusHom m t⁻¹*(fixedOpposition m)⁻¹=fixedTorusHom m t
    rw [fixedOpposition_fixedTorus,inv_inv]
  change (MulAut.conj (fixedOpposition m)) (fixedTorusHom m t⁻¹)∈
    Subgroup.normalizer (fixedNegativeGroup m) at h
  rwa [he] at h

theorem fixedTorus_normalizes_generated (m : ℕ) (t : (Field m)ˣ) :
    fixedTorusHom m t∈Subgroup.normalizer (fixedRootGenerated m) :=
  (fixedPositiveGroup m).normalizer_inf_normalizer_le_normalizer_sup
    (fixedNegativeGroup m) ⟨fixedTorus_mem_normalizer m t,fixedTorus_normalizes_negative m t⟩

theorem fixedBorel_normalizes_generated (m : ℕ) :
    borelGroup m≤Subgroup.normalizer (fixedRootGenerated m) := by
  rintro _ ⟨x,rfl⟩
  rw [borelHom_apply]
  apply (Subgroup.normalizer _).mul_mem
  · exact (fixedRootGenerated m).le_normalizer (positive_le_generated m x.left.property)
  · exact fixedTorus_normalizes_generated m x.right

theorem fixedRootGenerated_normal (m : ℕ) : (fixedRootGenerated m).Normal := by
  apply Subgroup.normalizer_eq_top_iff.mp
  apply top_unique
  intro g _
  rcases fixed_bruhat m g with hb | ⟨b,hb,u,hu,rfl⟩
  · exact fixedBorel_normalizes_generated m hb
  · exact (Subgroup.normalizer _).mul_mem
      ((Subgroup.normalizer _).mul_mem (fixedBorel_normalizes_generated m hb)
        (fixedOpposition_normalizes_generated m))
      ((fixedRootGenerated m).le_normalizer (positive_le_generated m hu))

end SymmetricSubgroupAsymptotics.CFSGReeGTwoRootGeneratedNormal
