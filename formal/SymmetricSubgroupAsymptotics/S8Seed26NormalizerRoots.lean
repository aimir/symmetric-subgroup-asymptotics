      BinaryMenuCayley8T26.certificate.encode_elements _
    have he := permutationCode_injective 8 ((residue_checked i hi).trans hrow.symm)
    rw [he]
    exact row_mem _
  parent_lt := parent_lt_checked

theorem root_zero_eq_seed : H ⊔ Subgroup.closure {representatives (roots 0)} = H := by
  have h : representatives (roots 0) = 1 := by decide +kernel
  rw [h]
  simp

