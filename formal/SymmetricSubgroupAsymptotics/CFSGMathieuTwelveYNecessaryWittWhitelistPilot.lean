def literalWhitelist : Finset (Fin 1944) := {0, 40, 80, 243, 283, 323, 324, 364, 404, 567, 607, 647, 648, 688, 728, 891, 931, 971, 972, 1012, 1052, 1215, 1255, 1295, 1296, 1336, 1376, 1539, 1579, 1619, 1620, 1660, 1700, 1863, 1903, 1943}

def cachedForward (c : Fin 1944) (p : Fin 12) : Fin 12 :=
  ⟨((packedRows[c.val]! / 2^(4*p.val)) % 16) % 12,Nat.mod_lt _ (by decide)⟩

def badIndex (c : Fin 1944) : Fin 132 :=
  ⟨badIndices[c.val]! % 132,Nat.mod_lt _ (by decide)⟩

def pilotIndex (i : Fin 64) : Fin 1944 :=
  ⟨i.val,Nat.lt_trans i.isLt (by decide)⟩

private theorem point_binding_0 :
    (indexedChart 0 : Fin 12 → Fin 12) = cachedForward 0 := by
  funext p
  fin_cases p <;> decide +kernel

private theorem witness_0 : 0 ∈ literalWhitelist ∨
    blockMap (indexedChart 0) (wittBlockAt (badIndex 0)) ∉ wittBlocks := by
  rw [blockMap,point_binding_0]
  decide +kernel

