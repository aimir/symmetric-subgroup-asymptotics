import SymmetricSubgroupAsymptotics.TernaryMonomialOrbitUniform
import SymmetricSubgroupAsymptotics.RepresentationGeneratorRestrictionMaschke

/-! A transitive monomial action is generated by one delta. Restriction to
an actual finite subgroup of invertible order makes that generator bound
uniform by Maschke, including coordinate-dependent signs. -/
set_option autoImplicit false
noncomputable section
open scoped Classical MonoidAlgebra BigOperators
namespace SymmetricSubgroupAsymptotics.TernaryMonomialTransitiveMaschkeUniform
open TernaryMonomialOrbitUniform

variable {R X : Type} [Group R] [Fintype X] [DecidableEq X]
  (b : R →* Equiv.Perm X) (d : R → X → ZMod 3)
  (hone : ∀ i, d 1 i = 1)
  (hmul : ∀ g h i, d (g*h) i = d g i * d h (b g⁻¹ i))

theorem generatedBy_orbitCover {n : ℕ} (representative : Fin n → X)
    (hcover : ∀ x : X, ∃ (j : Fin n) (g : R), b g (representative j) = x) :
    RepresentationGeneratedBy (representation b d hone hmul) n := by
  let rho := representation b d hone hmul
  let code : Fin n → rho.asModule := fun j =>
    rho.asModuleEquiv.symm (Pi.single (representative j) 1)
  let P : Submodule (ZMod 3)[R] rho.asModule :=
    Submodule.span (ZMod 3)[R] (Set.range code)
  let S : Subrepresentation rho := Subrepresentation.ofSubmodule' P
  have hdelta (x : X) : (Pi.single x 1 : X → ZMod 3) ∈ S := by
    obtain ⟨j,g,hg⟩ := hcover x
    have hj : (Pi.single (representative j) 1 : X → ZMod 3) ∈ S := by
      change code j ∈ P
      exact Submodule.subset_span ⟨j,rfl⟩
    have hm := S.apply_mem_toSubmodule g hj
    change representation b d hone hmul g (Pi.single (representative j) 1) ∈ S at hm
    rw [single,hg,mul_one] at hm
    have hn := S.toSubmodule.smul_mem ((d g x)⁻¹) hm
    simpa only [← Pi.single_smul,smul_eq_mul,
      inv_mul_cancel₀ (coefficient_ne_zero b d hone hmul g x)] using hn
  have hall (v : X → ZMod 3) : v ∈ S := by
    have he : (∑ i, v i • (Pi.single i 1 : X → ZMod 3)) = v := by
      calc
        _ = ∑ i, Pi.single i (v i) := by
          apply Finset.sum_congr rfl
          intro i _
          rw [← Pi.single_smul]
          simp
        _ = v := LinearMap.sum_single_apply (fun _ : X => ZMod 3) v
    rw [← he]
    exact S.toSubmodule.sum_mem fun i _ => S.toSubmodule.smul_mem (v i) (hdelta i)
  refine ⟨code,top_unique ?_⟩
  intro v _
  exact hall v

theorem uniform_of_invertible_order [Finite R] [NeZero (Nat.card R : ZMod 3)]
    {n : ℕ} (representative : Fin n → X)
    (hcover : ∀ x : X, ∃ (j : Fin n) (g : R), b g (representative j) = x) :
    UniformSubrepresentationGeneratorBound (representation b d hone hmul) n :=
  RepresentationGeneratedBy.uniform_of_invertible_order _
    (generatedBy_orbitCover b d hone hmul representative hcover)

end SymmetricSubgroupAsymptotics.TernaryMonomialTransitiveMaschkeUniform
