import SymmetricSubgroupAsymptotics.MarkedC4GeneratorNumbers

/-! A group generated by a subgroup and one of its conjugates is generated
by generators of that same subgroup and one displayed conjugating element.
No simplicity, subgroup recognition or two-generation input is required. -/
set_option autoImplicit false
noncomputable section
open scoped Classical
namespace SymmetricSubgroupAsymptotics.TwoConjugateSubgroupsOrdinaryGenerators

theorem genRank_le_add_one {G : Type} [Group G] [Finite G]
    (P : Subgroup G) (g : G)
    (hgen : Subgroup.closure ((P : Set G) ∪
      P.map (MulAut.conj g).toMonoidHom) = ⊤) :
    MarkedC4.genRank G ≤ MarkedC4.genRank P + 1 := by
  obtain ⟨S,hcard,hS⟩ := MarkedC4.genRank_spec (G:=P)
  let T : Finset G := insert g (S.image P.subtype)
  let K := Subgroup.closure (T : Set G)
  have hg : g ∈ K := Subgroup.subset_closure (by simp [T])
  have hP : P ≤ K := by
    have hSK : Subgroup.closure (S : Set P) ≤ K.comap P.subtype := by
      apply (Subgroup.closure_le _).mpr
      intro x hx
      exact Subgroup.subset_closure (by
        change (x:G) ∈ T
        exact Finset.mem_insert_of_mem (Finset.mem_image.mpr ⟨x,hx,rfl⟩))
    rw [hS] at hSK
    intro x hx
    exact hSK (show (⟨x,hx⟩:P)∈(⊤:Subgroup P) from trivial)
  have hC : P.map (MulAut.conj g).toMonoidHom ≤ K := by
    rintro _ ⟨x,hx,rfl⟩
    change g*x*g⁻¹∈K
    exact K.mul_mem (K.mul_mem hg (hP hx)) (K.inv_mem hg)
  have hK : K=⊤ := by
    apply top_unique
    rw [←hgen]
    exact (Subgroup.closure_le _).mpr (Set.union_subset hP hC)
  calc
    MarkedC4.genRank G ≤ T.card := MarkedC4.genRank_le hK
    _ ≤ (S.image P.subtype).card+1 := Finset.card_insert_le _ _
    _ ≤ S.card+1 := Nat.add_le_add_right Finset.card_image_le _
    _ = MarkedC4.genRank P+1 := by rw [hcard]

end SymmetricSubgroupAsymptotics.TwoConjugateSubgroupsOrdinaryGenerators
