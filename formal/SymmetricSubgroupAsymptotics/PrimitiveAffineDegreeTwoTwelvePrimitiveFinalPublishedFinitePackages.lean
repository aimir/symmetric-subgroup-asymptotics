/-! Fifteen original joint packages at capacity two for their actual
primitive pair-image socles. Each keeps its original natural bound.
The two explicit parameters are existing final published inputs. -/

set_option autoImplicit false
noncomputable section

namespace SymmetricSubgroupAsymptotics
namespace Non2UnipotentPrefixFiniteMenu.PrimitiveAffineImprimitiveBlockTransfer
namespace DegreeTwoTwelvePrimitiveFinalPublishedFinitePackages

open DegreeTwoTwelvePairFiniteCatalogue DegreeTwoTwelveJointFiniteRows

/-- Original row33, index32, joint; historical (1,2). -/
def row33At2 (socle : PublishedPrimitiveSocleDichotomyInput)
    (catalogue : PublishedBoundedPrimitiveCatalogueCorrespondence) :
    DegreeTwoTwelveJointFiniteRowData row33Interface 2 2 where
  topSocle := PrimitiveAffineDegreeTwoTwelvePrimitiveFinalPublishedSocles.row33AtTwo_family socle catalogue
  natural := PrimitiveAffineDegreeTwoTwelveTwoGeneratorNaturalFamily.row33Natural

noncomputable def row33At2Data (socle : PublishedPrimitiveSocleDichotomyInput)
    (catalogue : PublishedBoundedPrimitiveCatalogueCorrespondence) :
    DegreeTwoTwelveFlexibleProfiles.Data row33Interface :=
  .ofExact (row33At2 socle catalogue) (by decide +kernel)

