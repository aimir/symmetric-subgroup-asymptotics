import SymmetricSubgroupAsymptotics.InvolutionArmProductGeneration
import SymmetricSubgroupAsymptotics.CFSGYSectionEvenOrder
import Mathlib.Data.List.OfFn

/-! FOUR displayed generators of every original Y group: its central
involution and the three complete arm products. The actual arm relations
are verified uniformly for arbitrary arm lengths. The strip-arm lemma
then recovers every original presented generator. No finite group order,
Coxeter identification, model callback or abstract generator bound is used. -/
set_option autoImplicit false
noncomputable section
open scoped Classical
namespace SymmetricSubgroupAsymptotics.CFSGYArmProductGeneration
open CFSG.Models.YGroups CFSGGeneration CFSGReduction

private theorem chain_ofFn {G : Type*} [Group G] (n : ℕ) (s : G) (f : Fin n → G)
    (hs : s^2 = 1) (hf : ∀ i, (f i)^2 = 1)
    (hfirst : ∀ i, i.val = 0 → (f i*s)^3 = 1)
    (hnext : ∀ i j, i.val+1 = j.val → (f j*f i)^3 = 1)
    (hfarHead : ∀ i, 1 ≤ i.val → Commute s (f i))
    (hfar : ∀ i j, i.val+2 ≤ j.val → Commute (f i) (f j)) :
    InvolutionArmProductGeneration.Chain s (List.ofFn f) := by
  induction n generalizing s with
  | zero => simpa only [List.ofFn_zero,InvolutionArmProductGeneration.Chain] using hs
  | succ n ih =>
    rw [List.ofFn_succ]
    refine ⟨hs,hfirst 0 rfl,?_,?_⟩
    · intro u hu
      obtain ⟨i,rfl⟩ := List.mem_ofFn.mp hu
      exact hfarHead i.succ (by simp)
    · apply ih (f 0) (fun i => f i.succ) (hf 0)
      · intro i
        exact hf i.succ
      · intro i hi
        exact hnext 0 i.succ (by simp only [Fin.val_zero,Fin.val_succ]; omega)
      · intro i j hij
        exact hnext i.succ j.succ (by simp only [Fin.val_succ]; omega)
      · intro i hi
        exact hfar 0 i.succ (by simp only [Fin.val_zero,Fin.val_succ]; omega)
      · intro i j hij
        exact hfar i.succ j.succ (by simp only [Fin.val_succ]; omega)

private theorem commute_of_involutory_product {G : Type*} [Group G] (s t : G)
    (hs : s^2 = 1) (ht : t^2 = 1) (hst : (s*t)^2 = 1) : Commute s t := by
  have hsi : s⁻¹ = s := inv_eq_of_mul_eq_one_right (by simpa only [pow_two] using hs)
  have hti : t⁻¹ = t := inv_eq_of_mul_eq_one_right (by simpa only [pow_two] using ht)
  have hpi : (s*t)⁻¹ = s*t := inv_eq_of_mul_eq_one_right (by simpa only [pow_two] using hst)
  have he : t*s = s*t := by simpa only [mul_inv_rev,hsi,hti] using hpi
  exact he.symm

/-- The original generators on ONE entire arm, in their given order. -/
def armList (arms : Arms) (i : Fin 3) : List (CFSG.Models.YGroups.Group arms) :=
  List.ofFn (fun d : Fin (arms.length i) => PresentedGroup.of (rels := relations arms) (some ⟨i,d⟩))

def armProduct (arms : Arms) (i : Fin 3) : CFSG.Models.YGroups.Group arms := (armList arms i).prod

/-- The literal full-group generating family, before taking any derived
subgroup or FULL central quotient. -/
def fourGenerators (arms : Arms) : Fin 4 → CFSG.Models.YGroups.Group arms :=
  Fin.cases (PresentedGroup.of (rels := relations arms) none) (armProduct arms)

private theorem actual_arm_chain (arms : Arms) (i : Fin 3) :
    InvolutionArmProductGeneration.Chain
      (PresentedGroup.of (rels := relations arms) none) (armList arms i) := by
  apply chain_ofFn (arms.length i) _ _ (y_generator_sq arms none)
  · intro d
    exact y_generator_sq arms (some ⟨i,d⟩)
  · intro d hd
    exact y_adjacent_product_cube arms (some ⟨i,d⟩) none hd
  · intro d e hde
    exact y_adjacent_product_cube arms (some ⟨i,e⟩) (some ⟨i,d⟩) ⟨rfl,Or.inr hde⟩
  · intro d hd
    apply commute_of_involutory_product _ _ (y_generator_sq arms none)
      (y_generator_sq arms (some ⟨i,d⟩))
    apply y_nonadjacent_product_sq arms none (some ⟨i,d⟩)
    exact ⟨by simp,by dsimp only [Adjacent]; omega⟩
  · intro d e hde
    apply commute_of_involutory_product _ _ (y_generator_sq arms (some ⟨i,d⟩))
      (y_generator_sq arms (some ⟨i,e⟩))
    apply y_nonadjacent_product_sq arms (some ⟨i,d⟩) (some ⟨i,e⟩)
    constructor
    · intro he
      have hv : d.val = e.val := congrArg
        (fun q : Node arms => match q with | none => 0 | some a => a.2.val) he
      omega
    · dsimp only [Adjacent]
      intro he
      omega

/-- Strip every actual arm inside the subgroup generated by this named
four-element family; the original presented generators are all recovered. -/
theorem fourGenerators_generate (arms : Arms) :
    Subgroup.closure (Set.range (fourGenerators arms)) = ⊤ := by
  let H := Subgroup.closure (Set.range (fourGenerators arms))
  have hs : PresentedGroup.of (rels := relations arms) none ∈ H :=
    Subgroup.subset_closure ⟨0,rfl⟩
  have hprod (i : Fin 3) : (armList arms i).prod ∈ H :=
    Subgroup.subset_closure ⟨i.succ,rfl⟩
  apply top_unique
  rw [← PresentedGroup.closure_range_of (relations arms)]
  apply (Subgroup.closure_le _).mpr
  rintro _ ⟨q,rfl⟩
  cases q with
  | none => exact hs
  | some a =>
    apply InvolutionArmProductGeneration.members_mem_of_head_and_prod H _ _
      (actual_arm_chain arms a.1) hs (hprod a.1)
    exact List.mem_ofFn.mpr ⟨a.2,rfl⟩

theorem exists_four_generators (arms : Arms) :
    ∃ S : Finset (CFSG.Models.YGroups.Group arms), Subgroup.closure (S : Set (CFSG.Models.YGroups.Group arms)) = ⊤ ∧ S.card ≤ 4 := by
  obtain ⟨S,hS,hcard⟩ := CFSGGeneration.generators_card_le_of_family
    (fourGenerators arms) (fourGenerators_generate arms)
  exact ⟨S,hS,by simpa only [Nat.card_fin] using hcard⟩

end SymmetricSubgroupAsymptotics.CFSGYArmProductGeneration
