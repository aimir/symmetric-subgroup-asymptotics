import SymmetricSubgroupAsymptotics.S8Seed9LeftCosets
import SymmetricSubgroupAsymptotics.BinaryMenuCayley8T35
import SymmetricSubgroupAsymptotics.FiniteNormalizerAdjunctionProperty
import SymmetricSubgroupAsymptotics.FiniteGeneratorEquivWordCertificate

/-! Selected original8T9 normalizer forest. The actual normalizer
generator, both seed-word inclusions and every forest edge are checked. -/
set_option autoImplicit false
set_option maxRecDepth 100000
noncomputable section
open scoped Pointwise
namespace SymmetricSubgroupAsymptotics.S8Seed9NormalizerRoots
open S8Seed9LeftCosets

def normalizer : Ambient where
  toFun := ![4, 6, 5, 0, 7, 1, 2, 3]
  invFun := ![3, 5, 6, 7, 0, 2, 1, 4]
  left_inv := by decide +kernel
  right_inv := by decide +kernel

def normalizerCertificate : FiniteGeneratorEquivWordCertificate (MulAut.conj normalizer)
    BinaryMenuCayley8T9.generators BinaryMenuCayley8T9.generators where
  forward := {
    words := ![(.generator 0), (.mul (.generator 0) (.generator 1)), (.mul (.generator 0) (.generator 2)), (.mul (.generator 0) (.generator 3))]
    equations := by
      intro j
      fin_cases j <;> apply Equiv.ext <;> intro x <;> revert x <;> decide +kernel }
  backward := {
    words := ![(.generator 0), (.mul (.generator 0) (.generator 1)), (.mul (.generator 0) (.generator 2)), (.mul (.generator 0) (.generator 3))]
    equations := by
      intro j
      fin_cases j <;> apply Equiv.ext <;> intro x <;> revert x <;> decide +kernel }

theorem normalizes_seed : MulAut.conj normalizer • H = H := by
  change H.map (MulAut.conj normalizer).toMonoidHom = H
  exact normalizerCertificate.map_closure_eq

def edgeConjugator : Fin 5 → Ambient := ![1, 1, 1, 1, normalizer]
def edgeFactor : Fin 5 → Ambient :=
  ![BinaryMenuCayley8T9.generators 0, BinaryMenuCayley8T9.generators 1, BinaryMenuCayley8T9.generators 2, BinaryMenuCayley8T9.generators 3, 1]

theorem edge_normalizes (j : Fin 5) : MulAut.conj (edgeConjugator j) • H = H := by
  fin_cases j
  · change MulAut.conj (1 : Ambient) • H = H
    simp only [map_one, one_smul]
  · change MulAut.conj (1 : Ambient) • H = H
    simp only [map_one, one_smul]
  · change MulAut.conj (1 : Ambient) • H = H
    simp only [map_one, one_smul]
  · change MulAut.conj (1 : Ambient) • H = H
    simp only [map_one, one_smul]
  · exact normalizes_seed

theorem edge_factor_mem (j : Fin 5) : edgeFactor j ∈ H := by
  fin_cases j
  · exact Subgroup.subset_closure (Set.mem_range_self 0)
  · exact Subgroup.subset_closure (Set.mem_range_self 1)
  · exact Subgroup.subset_closure (Set.mem_range_self 2)
  · exact Subgroup.subset_closure (Set.mem_range_self 3)
  · exact H.one_mem

