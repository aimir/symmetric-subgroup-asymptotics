import SymmetricSubgroupAsymptotics.CFSGReeFFourOuterThreeWord
import SymmetricSubgroupAsymptotics.FiniteCyclicNormalizerProduct
import SymmetricSubgroupAsymptotics.CFSGReeFFourFixedAmbientHom

/-! The literal subgroup generated by the two checked outer constant
words is soluble and has at most six elements, over every original Ree
field. Only period and conjugation relations are used; no group
recognition or exact order statement is needed. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
namespace SymmetricSubgroupAsymptotics.CFSGReeFFourOuterConstantSubgroup
open CFSGReeFFourOuterThreeWord CFSGReeFFourFixedModelEquivalence
open CFSGReeFFourRelativePositiveSubgroups CFSGReeFFourFixedAmbientHom
private instance fixed_finite (m : ℕ) : Finite (originalModelFixed m) :=
  Finite.of_injective (fixedAmbientHom m) (fixedAmbientHom_injective m)

def outerConstantSubgroup (m : ℕ) : Subgroup (originalModelFixed m) :=
  Subgroup.zpowers (outerFixedWeyl m * outerInvolution m) ⊔ Subgroup.zpowers (outerInvolution m)

theorem outerInvolution_mem_constant (m : ℕ) : outerInvolution m ∈ outerConstantSubgroup m :=
  Subgroup.mem_sup_right (Subgroup.mem_zpowers _)

theorem outerWeyl_mem_constant (m : ℕ) : outerFixedWeyl m ∈ outerConstantSubgroup m := by
  have hr : outerFixedWeyl m * outerInvolution m ∈ outerConstantSubgroup m :=
    Subgroup.mem_sup_left (Subgroup.mem_zpowers _)
  have he : (outerFixedWeyl m * outerInvolution m) * (outerInvolution m)⁻¹ =
      outerFixedWeyl m := by group
  exact he ▸ (outerConstantSubgroup m).mul_mem hr
    ((outerConstantSubgroup m).inv_mem (outerInvolution_mem_constant m))

theorem outerConstantSubgroup_solvable (m : ℕ) : IsSolvable (outerConstantSubgroup m) :=
  FiniteCyclicNormalizerProduct.join_solvable (outerFixedWeyl m * outerInvolution m)
    (outerInvolution m) 2 (outerInvolution_conjugates_product_square m)

theorem outerConstantSubgroup_card_le_six (m : ℕ) : Nat.card (outerConstantSubgroup m) ≤ 6 :=
  FiniteCyclicNormalizerProduct.card_join_le_mul (outerFixedWeyl m * outerInvolution m)
    (outerInvolution m) 2 (outerInvolution_conjugates_product_square m)
    3 2 (by decide) (by decide) (outerWeyl_product_cube m) (outerInvolution_square m)

end SymmetricSubgroupAsymptotics.CFSGReeFFourOuterConstantSubgroup
