import SymmetricSubgroupAsymptotics.CFSGE6GeckOrbitZeroRoots
import SymmetricSubgroupAsymptotics.CFSGNormTwoCoordinateFunctionalFlagIntersection
import SymmetricSubgroupAsymptotics.CFSGNormTwoCoordinateCanonicalSimpleRootLine

/-! The actual positive E6 group meets each orbit-excluded forward flag
in EXACTLY the subgroup generated by that orbit's one or two simple root
lines. This is an actual subgroup equality, including characteristic two. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
open scoped Classical
namespace SymmetricSubgroupAsymptotics.CFSGE6GeckOrbitRootIntersection
open CFSGE6GeckOrbitZeroRoots CFSGE6GeckSimpleOrbitFlags
open CFSGTwistedE6GeckDiagramCovariance CFSGTwistedE6GeckPositiveTwist
open CFSGTwistedE6RelativeWeylOrbits CFSGExceptionalNormTwoBases
open CFSGExceptionalCartanPositiveDefinite CFSGNormTwoRootPairing
open CFSGNormTwoCoordinateZeroFunctionalSupport CFSGNormTwoCoordinateFunctionalFlagIntersection
open CFSGNormTwoCoordinateSelectedRootElement CFSGNormTwoCoordinateRootSubgroup
open CFSGNormTwoCoordinateRootElementRange CFSGNormTwoCoordinateCanonicalSimpleRootLine
open CFSGNormTwoGeckLatticeDegree CFSGGradedMatrixTriangularUnits CFSGSerreQuadraticMatrix
local notation "A" => CartanMatrix.E₆
local notation "hd" => CartanMatrix.E₆_diag
local notation "hs" => CartanMatrix.E₆_transpose
local notation "hp" => E6_positive_definite
local notation "ho" => CartanMatrix.E₆_off_diag_nonpos

def orbitPositiveGroup (K : Type) [Field K] (a : Fin 4) : Subgroup (Matrix GeckIndex GeckIndex K)ˣ :=
  ⨆i : Fin 6,⨆_ : i∈orbitWord a,canonicalRootSubgroup rawData K false i

theorem zeroFunctionalGroup_eq_orbitPositiveGroup (K : Type) [Field K] (a : Fin 4) :
    zeroFunctionalGroup A hd hs hp ho K (orbitHeight a)=orbitPositiveGroup K a := by
  apply le_antisymm
  · apply (Subgroup.closure_le _).mpr
    rintro _ ⟨k,hk,t,rfl⟩
    obtain ⟨i,hi,he⟩ := zero_orbit_positive_root_simple a k.val k.property hk
    have hr : selectedRootElement A hd hs hp ho K k.val t∈rootSubgroup A hd hs hp ho K k.val :=
      (mem_rootSubgroup_iff_selected A hd hs hp ho K k.val _).mpr ⟨t,rfl⟩
    have hline : rootSubgroup A hd hs hp ho K (E6Index i)=canonicalRootSubgroup rawData K false i :=
      rootSubgroup_simple_eq_canonical A hd hs hp ho K i
    rw [he,hline] at hr
    rw [he]
    exact (show canonicalRootSubgroup rawData K false i≤orbitPositiveGroup K a from
      le_iSup_of_le i (le_iSup_of_le hi le_rfl)) hr
  · apply iSup_le
    intro i
    apply iSup_le
    intro hi x hx
    have hline : rootSubgroup A hd hs hp ho K (E6Index i)=canonicalRootSubgroup rawData K false i :=
      rootSubgroup_simple_eq_canonical A hd hs hp ho K i
    have hr : x∈rootSubgroup A hd hs hp ho K (E6Index i) := hline.symm ▸ hx
    obtain ⟨t,ht⟩ := (mem_rootSubgroup_iff_selected A hd hs hp ho K (E6Index i) x).mp hr
    rw [←ht]
    apply root_mem_zeroFunctionalGroup A hd hs hp ho K (orbitHeight a)
      ⟨E6Index i,?_⟩ (by rw [orbitHeight_simple,if_pos hi]) t
    intro j
    change 0≤(Pi.single i (1:ℤ) : Fin 6→ℤ) j
    simp only [Pi.single_apply]
    split_ifs <;> omega

def orbitLowerFlag (K : Type) [Field K] (a : Fin 4) : Subgroup (Matrix GeckIndex GeckIndex K)ˣ :=
  triangularUnits (fun j=>orbitHeight a (latticeWeight A hs hp E6Base j))

theorem positive_inf_orbitLowerFlag (K : Type) [Field K] (a : Fin 4) :
    Positive K ⊓ orbitLowerFlag K a=orbitPositiveGroup K a := by
  have hh := positive_inf_functional_flag_eq_zeroFunctionalGroup A hd hs hp ho K
    (orbitHeight a) (fun k=>orbitHeight_nonneg a k.val.val k.property)
  exact hh.trans (zeroFunctionalGroup_eq_orbitPositiveGroup K a)

end SymmetricSubgroupAsymptotics.CFSGE6GeckOrbitRootIntersection
