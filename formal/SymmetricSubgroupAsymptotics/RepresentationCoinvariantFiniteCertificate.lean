import SymmetricSubgroupAsymptotics.RepresentationCoinvariantHead
import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas

/-!
# Finite displacement certificates for coinvariant heads

The eight-block checker computes, for every invariant submodule `B`, the
span of the literal generator displacements `g v - v`.  A lower bound on
that span's dimension gives the required upper bound on `B`'s coinvariant
head.  This file is the generic Lean consumer of that finite calculation.
-/

set_option autoImplicit false
noncomputable section
open scoped Classical

namespace SymmetricSubgroupAsymptotics

universe uk uG uV uI

variable {k : Type uk} {G : Type uG} {V : Type uV} {I : Type uI}
  [Field k] [Group G]
  [AddCommGroup V] [Module k V]

/-- The subspace of an invariant module generated by displacements of the
retained original group generators. -/
def representationGeneratorDisplacementSpan
    (rho : Representation k G V) (generators : I → G)
    (B : Subrepresentation rho) : Submodule k B.toSubmodule :=
  Submodule.span k (Set.range fun iv : I × B.toSubmodule ↦
    (⟨rho (generators iv.1) iv.2.1 - iv.2.1,
      B.toSubmodule.sub_mem
        (B.apply_mem_toSubmodule (generators iv.1) iv.2.2) iv.2.2⟩ :
      B.toSubmodule))

/-- Every retained-generator displacement is a genuine coinvariant
relation. -/
theorem representationGeneratorDisplacementSpan_le_coinvariantsKer
    (rho : Representation k G V) (generators : I → G)
    (B : Subrepresentation rho) :
    representationGeneratorDisplacementSpan rho generators B ≤
      Representation.Coinvariants.ker B.toRepresentation := by
  apply Submodule.span_le.mpr
  rintro _ ⟨⟨i, v⟩, rfl⟩
  exact Representation.Coinvariants.sub_mem_ker
    (ρ := B.toRepresentation) (generators i) v

/-- The intrinsic coinvariant-relation space is invariant under the
original representation.  Conjugating one displacement produces another
literal displacement. -/
theorem representationCoinvariantsKer_apply_mem
    (rho : Representation k G V) (g : G) (v : V)
    (hv : v ∈ Representation.Coinvariants.ker rho) :
    rho g v ∈ Representation.Coinvariants.ker rho := by
  induction hv using Submodule.span_induction with
  | mem v hv =>
      obtain ⟨⟨h, x⟩, rfl⟩ := hv
      apply Submodule.subset_span
      refine ⟨⟨g * h * g⁻¹, rho g x⟩, ?_⟩
      simp only [map_sub, map_mul, map_inv, Module.End.mul_apply]
      rw [show rho g⁻¹ (rho g x) = x by
        change (rho g⁻¹ * rho g) x = x
        rw [← map_mul, inv_mul_cancel, map_one]
        rfl]
  | zero => simpa only [map_zero] using
      (Representation.Coinvariants.ker rho).zero_mem
  | add x y _ _ hx hy => simpa only [map_add] using
      (Representation.Coinvariants.ker rho).add_mem hx hy
  | smul a x _ hx => simpa only [map_smul] using
      (Representation.Coinvariants.ker rho).smul_mem a hx

/-- If the displayed tuple generates the acting group, its literal
displacements already span every coinvariant relation.  This identifies a
finite certificate's generator span with the intrinsic representation head;
no unrecorded group elements are needed in the denominator. -/
theorem representationGeneratorDisplacementSpan_eq_coinvariantsKer
    (rho : Representation k G V) (generators : I → G)
    (hgen : Subgroup.closure (Set.range generators) = ⊤)
    (B : Subrepresentation rho) :
    representationGeneratorDisplacementSpan rho generators B =
      Representation.Coinvariants.ker B.toRepresentation := by
  apply le_antisymm
  · exact representationGeneratorDisplacementSpan_le_coinvariantsKer
      rho generators B
  · let D := representationGeneratorDisplacementSpan rho generators B
    let S : Subgroup G :=
      { carrier := {g | ∀ v : B.toSubmodule,
          B.toRepresentation g v - v ∈ D}
        one_mem' := by
          intro v
          simp only [map_one, Module.End.one_apply, sub_self]
          exact D.zero_mem
        mul_mem' := by
          intro g h hg hh v
          have heq :
              B.toRepresentation (g * h) v - v =
                (B.toRepresentation g (B.toRepresentation h v) -
                    B.toRepresentation h v) +
                  (B.toRepresentation h v - v) := by
            rw [map_mul]
            change _
            abel
          rw [heq]
          exact D.add_mem (hg (B.toRepresentation h v)) (hh v)
        inv_mem' := by
          intro g hg v
          have hcancel :
              B.toRepresentation g (B.toRepresentation g⁻¹ v) = v := by
            change (B.toRepresentation g * B.toRepresentation g⁻¹) v = v
            rw [← map_mul, mul_inv_cancel, map_one]
            rfl
          have heq :
              B.toRepresentation g⁻¹ v - v =
                -(B.toRepresentation g (B.toRepresentation g⁻¹ v) -
                    B.toRepresentation g⁻¹ v) := by
            rw [hcancel]
            abel
          rw [heq]
          exact D.neg_mem (hg (B.toRepresentation g⁻¹ v)) }
    have hclosure : Subgroup.closure (Set.range generators) ≤ S := by
      apply (Subgroup.closure_le S).mpr
      rintro _ ⟨i, rfl⟩ v
      exact Submodule.subset_span ⟨⟨i, v⟩, rfl⟩
    apply Submodule.span_le.mpr
    rintro _ ⟨⟨g, v⟩, rfl⟩
    have hgS : g ∈ S := hclosure (by rw [hgen]; trivial)
    exact hgS v

/-- A checked codimension bound on the literal generator-displacement span
implies the same bound for the full coinvariant head. -/
theorem representationCoinvariants_finrank_le_of_displacementSpan
    [FiniteDimensional k V]
    (rho : Representation k G V) (generators : I → G)
    (B : Subrepresentation rho) (rank : ℕ)
    (hcodim : Module.finrank k B.toSubmodule ≤
      Module.finrank k
        (representationGeneratorDisplacementSpan rho generators B) + rank) :
    Module.finrank k B.toRepresentation.Coinvariants ≤ rank := by
  letI : FiniteDimensional k B.toSubmodule :=
    FiniteDimensional.of_injective
      (B.toSubmodule.subtype.restrictScalars k) B.toSubmodule.subtype_injective
  have hDK : representationGeneratorDisplacementSpan rho generators B ≤
      Representation.Coinvariants.ker B.toRepresentation :=
    representationGeneratorDisplacementSpan_le_coinvariantsKer
      rho generators B
  have hdim : Module.finrank k
        (representationGeneratorDisplacementSpan rho generators B) ≤
      Module.finrank k
        (Representation.Coinvariants.ker B.toRepresentation) :=
    Submodule.finrank_mono hDK
  have hquot :=
    (Representation.Coinvariants.ker B.toRepresentation).finrank_quotient_add_finrank
  change Module.finrank k B.toRepresentation.Coinvariants +
      Module.finrank k (Representation.Coinvariants.ker B.toRepresentation) =
        Module.finrank k B.toSubmodule at hquot
  omega

/-- A smaller explicitly based displacement subspace suffices.  This is the
form used by generated rows: the exporter stores a basis of a subspace of
the generator-displacement span and checks only its codimension. -/
theorem representationCoinvariants_finrank_le_of_displacementSubspace
    [FiniteDimensional k V]
    (rho : Representation k G V) (generators : I → G)
    (B : Subrepresentation rho) (D : Submodule k B.toSubmodule)
    (rank : ℕ)
    (hD : D ≤ representationGeneratorDisplacementSpan rho generators B)
    (hcodim : Module.finrank k B.toSubmodule ≤
      Module.finrank k D + rank) :
    Module.finrank k B.toRepresentation.Coinvariants ≤ rank := by
  apply representationCoinvariants_finrank_le_of_displacementSpan
    rho generators B rank
  exact hcodim.trans (Nat.add_le_add_right
    (Submodule.finrank_mono hD) rank)

end SymmetricSubgroupAsymptotics

end
