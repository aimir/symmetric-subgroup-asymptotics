import SymmetricSubgroupAsymptotics.CFSGNormTwoGeckBorelEnvelope
import SymmetricSubgroupAsymptotics.CFSGSerreQuadraticCanonicalRootAdditive
import Mathlib.Tactic.Group

/-! Actual rank-one cells: each nonzero negative simple root belongs to
B n_i(1) B. Consequently the original canonical group is generated by
the literal soluble envelope and these simple Weyl words. This is not
the full higher-rank Bruhat decomposition. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
namespace SymmetricSubgroupAsymptotics.CFSGNormTwoGeckSimpleRootCells
open CFSGIntegerMatrixPairing CFSGNormTwoRootPairing
open CFSGNormTwoGeckIntegralRealization CFSGSerreQuadraticMatrix
open CFSGNormTwoGeckParameterizedWeyl CFSGNormTwoGeckParameterizedTorus
open CFSGNormTwoGeckPositivePGroup CFSGNormTwoGeckBorelEnvelope
variable {n : Type} [Fintype n] [DecidableEq n]
    (A : Matrix n n ℤ) (hs : A.transpose=A) (hp : (rationalMatrix A).PosDef)
    [Fintype (Roots A)] [DecidableEq (Roots A)] [(rootPairing A hs hp).IsIrreducible]
    (b : (rootPairing A hs hp).Base) {r : ℕ} (s : Fin r≃b.support)

theorem positive_mem_borel (K : Type) [Field K] (i : Fin r) (a : K) :
    canonicalRoot (realizationData A hs hp b s) K false i a∈borelEnvelope A hs hp b s K := by
  have hU : rootGroup A hs hp b s K false≤borelEnvelope A hs hp b s K := le_sup_left
  exact hU (Subgroup.subset_closure ⟨(i,a),rfl⟩)

theorem negative_nonzero_cell (K : Type) [Field K] (i : Fin r) (a : K) (ha : a≠0) :
    ∃x∈borelEnvelope A hs hp b s K,∃y∈borelEnvelope A hs hp b s K,
      canonicalRoot (realizationData A hs hp b s) K true i a=
        x*parameterWeyl A hs hp b s K i 1*y := by
  let t : Kˣ := Units.mk0 (-a⁻¹) (neg_ne_zero.mpr (inv_ne_zero ha))
  let u := canonicalRoot (realizationData A hs hp b s) K false i (t:K)
  have hu : u∈borelEnvelope A hs hp b s K := positive_mem_borel A hs hp b s K i (t:K)
  have ht : parameterTorus A hs hp b s K i t∈borelEnvelope A hs hp b s K := by
    have hT : torusGroup A hs hp b s K≤borelEnvelope A hs hp b s K := le_sup_right
    exact hT (Subgroup.subset_closure ⟨(i,t),rfl⟩)
  refine ⟨u⁻¹*parameterTorus A hs hp b s K i t,
    (borelEnvelope A hs hp b s K).mul_mem ((borelEnvelope A hs hp b s K).inv_mem hu) ht,
    u⁻¹,(borelEnvelope A hs hp b s K).inv_mem hu,?_⟩
  have hta : -(t:K)⁻¹=a := by
    change -(-a⁻¹)⁻¹=a
    simp
  change canonicalRoot (realizationData A hs hp b s) K true i a=
    (u⁻¹*(parameterWeyl A hs hp b s K i t*(parameterWeyl A hs hp b s K i 1)⁻¹))*
      parameterWeyl A hs hp b s K i 1*u⁻¹
  rw [←hta]
  dsimp only [parameterWeyl,u]
  group

theorem negative_cell (K : Type) [Field K] (i : Fin r) (a : K) :
    canonicalRoot (realizationData A hs hp b s) K true i a∈borelEnvelope A hs hp b s K ∨
    ∃x∈borelEnvelope A hs hp b s K,∃y∈borelEnvelope A hs hp b s K,
      canonicalRoot (realizationData A hs hp b s) K true i a=
        x*parameterWeyl A hs hp b s K i 1*y := by
  by_cases ha : a=0
  · subst a
    left
    have hz : canonicalRoot (realizationData A hs hp b s) K true i 0=1 := by
      apply Units.ext
      simp only [canonicalRoot_val,zero_smul,zero_pow (by decide : 2≠0),add_zero,Units.val_one]
    rw [hz]
    exact (borelEnvelope A hs hp b s K).one_mem
  · exact Or.inr (negative_nonzero_cell A hs hp b s K i a ha)

theorem borel_simple_weyls_generate (K : Type) [Field K] :
    Subgroup.closure ((borelEnvelope A hs hp b s K : Set _) ∪
      Set.range (fun i : Fin r=>parameterWeyl A hs hp b s K i 1))=
        canonicalElementaryGroup (realizationData A hs hp b s) K := by
  apply le_antisymm
  · apply (Subgroup.closure_le _).mpr
    intro g hg
    rcases hg with hg|⟨i,rfl⟩
    · exact borelEnvelope_le_canonical A hs hp b s K hg
    · exact parameterWeyl_mem A hs hp b s K i 1
  · apply (Subgroup.closure_le _).mpr
    rintro _ ⟨neg,i,a,rfl⟩
    cases neg
    · exact Subgroup.subset_closure (Or.inl (positive_mem_borel A hs hp b s K i a))
    · rcases negative_cell A hs hp b s K i a with h|⟨x,hx,y,hy,he⟩
      · exact Subgroup.subset_closure (Or.inl h)
      · rw [he]
        exact Subgroup.mul_mem _
          (Subgroup.mul_mem _ (Subgroup.subset_closure (Or.inl hx))
            (Subgroup.subset_closure (Or.inr ⟨i,rfl⟩)))
          (Subgroup.subset_closure (Or.inl hy))

end SymmetricSubgroupAsymptotics.CFSGNormTwoGeckSimpleRootCells
