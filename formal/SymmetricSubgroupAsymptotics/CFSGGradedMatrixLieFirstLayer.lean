import SymmetricSubgroupAsymptotics.CFSGGradedMatrixSupport
import Mathlib.Algebra.Lie.Subalgebra
import Mathlib.Algebra.Lie.OfAssociative
import Lean.Elab.Tactic.Omega

/-! The height-one layer of the actual matrix Lie algebra generated by
height-one operators is their linear span. Brackets of positive-height
operators have no height-one entries. This is a statement about genuine
Lie-span membership, not arbitrary surrounding homogeneous matrices. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
namespace SymmetricSubgroupAsymptotics.CFSGGradedMatrixLieFirstLayer
open CFSGGradedMatrixSupport
variable {I K : Type*} [Fintype I] [DecidableEq I] [CommRing K]

def Positive (weight : I→ℤ) (M : Matrix I I K) : Prop :=
  ∀i j,weight i≤weight j→M i j=0

def firstPart (weight : I→ℤ) : Matrix I I K→ₗ[K]Matrix I I K where
  toFun M := Matrix.of (fun i j=>if weight i=weight j+1 then M i j else 0)
  map_add' := by intro M N;ext i j;by_cases h : weight i=weight j+1 <;> simp [h]
  map_smul' := by intro a M;ext i j;by_cases h : weight i=weight j+1 <;> simp [h]

omit [Fintype I] [DecidableEq I] in
theorem firstPart_apply (weight : I→ℤ) (M : Matrix I I K) (i j : I) :
    firstPart weight M i j=if weight i=weight j+1 then M i j else 0 := rfl

omit [Fintype I] [DecidableEq I] in
theorem positive_of_supported (weight : I→ℤ) (M : Matrix I I K)
    (hM : Supported weight (fun w=>w+1) M) : Positive weight M := by
  intro i j hij
  apply hM i j
  dsimp only
  omega

theorem firstPart_eq_of_supported (weight : I→ℤ) (M : Matrix I I K)
    (hM : Supported weight (fun w=>w+1) M) : firstPart weight M=M := by
  ext i j
  rw [firstPart_apply]
  by_cases h : weight i=weight j+1
  · exact if_pos h
  · rw [if_neg h,hM i j h]

omit [DecidableEq I] in
theorem positive_mul_entry_zero (weight : I→ℤ) (M N : Matrix I I K)
    (hM : Positive weight M) (hN : Positive weight N) (i j : I)
    (hij : weight i≤weight j+1) : (M*N) i j=0 := by
  rw [Matrix.mul_apply]
  apply Finset.sum_eq_zero
  intro k _
  by_cases hik : weight i≤weight k
  · rw [hM i k hik,zero_mul]
  · have hkj : weight k≤weight j := by omega
    rw [hN k j hkj,mul_zero]

theorem positive_lie (weight : I→ℤ) (M N : Matrix I I K)
    (hM : Positive weight M) (hN : Positive weight N) : Positive weight ⁅M,N⁆ := by
  intro i j hij
  rw [Ring.lie_def,Matrix.sub_apply,
    positive_mul_entry_zero weight M N hM hN i j (by omega),
    positive_mul_entry_zero weight N M hN hM i j (by omega),sub_self]

theorem firstPart_lie_zero (weight : I→ℤ) (M N : Matrix I I K)
    (hM : Positive weight M) (hN : Positive weight N) : firstPart weight ⁅M,N⁆=0 := by
  ext i j
  rw [firstPart_apply]
  by_cases h : weight i=weight j+1
  · rw [if_pos h,Ring.lie_def,Matrix.sub_apply,
      positive_mul_entry_zero weight M N hM hN i j (le_of_eq h),
      positive_mul_entry_zero weight N M hN hM i j (le_of_eq h),sub_self]
    rfl
  · rw [if_neg h]
    rfl

theorem positive_and_firstPart_mem_span (weight : I→ℤ) (S : Set (Matrix I I K))
    (hS : ∀M∈S,Supported weight (fun w=>w+1) M)
    {M : Matrix I I K} (hM : M∈LieSubalgebra.lieSpan K (Matrix I I K) S) :
    Positive weight M ∧ firstPart weight M∈Submodule.span K S := by
  induction hM using LieSubalgebra.lieSpan_induction with
  | mem M hm=>
    refine ⟨positive_of_supported weight M (hS M hm),?_⟩
    rw [firstPart_eq_of_supported weight M (hS M hm)]
    exact Submodule.subset_span hm
  | zero=>
    refine ⟨fun _ _ _=>rfl,?_⟩
    simpa only [map_zero] using (Submodule.span K S).zero_mem
  | add M N _ _ hm hn=>
    refine ⟨?_,?_⟩
    · intro i j hij
      rw [Matrix.add_apply,hm.1 i j hij,hn.1 i j hij,zero_add]
    · rw [map_add]
      exact (Submodule.span K S).add_mem hm.2 hn.2
  | smul a M _ hm=>
    refine ⟨?_,?_⟩
    · intro i j hij
      rw [Matrix.smul_apply,hm.1 i j hij,smul_zero]
    · rw [map_smul]
      exact (Submodule.span K S).smul_mem a hm.2
  | lie M N _ _ hm hn=>
    refine ⟨positive_lie weight M N hm.1 hn.1,?_⟩
    rw [firstPart_lie_zero weight M N hm.1 hn.1]
    exact (Submodule.span K S).zero_mem

theorem firstPart_mem_span (weight : I→ℤ) (S : Set (Matrix I I K))
    (hS : ∀M∈S,Supported weight (fun w=>w+1) M)
    {M : Matrix I I K} (hM : M∈LieSubalgebra.lieSpan K (Matrix I I K) S) :
    firstPart weight M∈Submodule.span K S :=
  (positive_and_firstPart_mem_span weight S hS hM).2

end SymmetricSubgroupAsymptotics.CFSGGradedMatrixLieFirstLayer
