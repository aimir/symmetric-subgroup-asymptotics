import SymmetricSubgroupAsymptotics.CoinducedOrbitFixedHead
import SymmetricSubgroupAsymptotics.BinaryCoinducedSylowOrbitHead

/-! Evaluation on the orbits of an odd subgroup together with one actual
normalizer element. The combined subgroup is generated inside the original
group; every local fibre retains its original conjugation twist. -/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open scoped BigOperators Classical

namespace SymmetricSubgroupAsymptotics.CoinducedNormalizerOrbitHead

variable {k G V : Type} [Field k] [Group G]
    [AddCommGroup V] [Module k V]

private def vectorStabilizer (rho : Representation k G V) (v : V) : Subgroup G where
  carrier := {g | rho g v = v}
  one_mem' := by simp only [Set.mem_setOf_eq, map_one, Module.End.one_apply]
  mul_mem' {a b} ha hb := by
    change rho a v = v at ha
    change rho b v = v at hb
    change rho (a * b) v = v
    rw [map_mul, Module.End.mul_apply, hb, ha]
  inv_mem' {a} ha := by
    change rho a⁻¹ v = v
    calc
      rho a⁻¹ v = rho a⁻¹ (rho a v) := congrArg (rho a⁻¹) ha.symm
      _ = v := by rw [← Module.End.mul_apply, ← map_mul, inv_mul_cancel, map_one]; rfl

/-- The simultaneous fixed space sits in the invariants of the actual
subgroup generated by the odd subgroup and its normalizer witness. -/
theorem fixedSpace_le_join (rho : Representation k G V) (P : Subgroup G) (g : G) :
    oddNormalizerFixedSpace rho P g ≤
      Representation.invariants (rho.comp (P ⊔ Subgroup.zpowers g).subtype) := by
  intro v hv a
  have hle : P ⊔ Subgroup.zpowers g ≤ vectorStabilizer rho v := by
    apply sup_le
    · intro p hp
      exact hv.1 ⟨p, hp⟩
    · exact Subgroup.zpowers_le.mpr
        ((mem_representationElementFixedSpace rho g v).mp hv.2)
  exact hle a.2

variable [Finite G] [FiniteDimensional k V]

private theorem head_le_join_fixed (rho : Representation k G V)
    (P : Subgroup G) (g : G) (hodd : IsUnit (Nat.card P : k))
    (hg : g ∈ Subgroup.normalizer (P : Set G)) (B : Subrepresentation rho) :
    Module.finrank k
      (B.toRepresentation.IntertwiningMap (Representation.trivial k G k)) ≤
      Module.finrank k
        (Representation.invariants (rho.comp (P ⊔ Subgroup.zpowers g).subtype)) :=
  ((representationHead_finrank_eq_coinvariants B.toRepresentation).le.trans
    (subrepresentation_coinvariants_le_oddNormalizerFixedSpace
      (ρ := rho) hodd hg B)).trans
    (Submodule.finrank_mono (fixedSpace_le_join rho P g))

theorem subrepresentation_head_le_active
    (H P : Subgroup G) (rho : Representation k H V) (g : G)
    (hodd : IsUnit (Nat.card P : k))
    (hg : g ∈ Subgroup.normalizer (P : Set G))
    [Fintype (DoubleCoset.Quotient (H : Set G)
      ((P ⊔ Subgroup.zpowers g : Subgroup G) : Set G))]
    (active : Finset (DoubleCoset.Quotient (H : Set G)
      ((P ⊔ Subgroup.zpowers g : Subgroup G) : Set G)))
    (inactive : ∀ q, q ∉ active →
      CoinducedOrbitFixedHead.fibreFixedSpace H (P ⊔ Subgroup.zpowers g) rho q = ⊥)
    (B : Subrepresentation (Representation.coind H.subtype rho)) :
    Module.finrank k
      (B.toRepresentation.IntertwiningMap (Representation.trivial k G k)) ≤
      active.card * Module.finrank k V := by
  letI : Fintype G := Fintype.ofFinite G
  letI : FiniteDimensional k (Representation.coindV H.subtype rho) :=
    FiniteDimensional.of_injective (Representation.coindV H.subtype rho).subtype
      (Representation.coindV H.subtype rho).subtype_injective
  apply (head_le_join_fixed (Representation.coind H.subtype rho) P g hodd hg B).trans
  apply (CoinducedOrbitFixedHead.fixed_finrank_le_sum
    H (P ⊔ Subgroup.zpowers g) rho).trans
  calc
    _ = ∑ q ∈ active, Module.finrank k
        (CoinducedOrbitFixedHead.fibreFixedSpace H (P ⊔ Subgroup.zpowers g) rho q) := by
      symm
      apply Finset.sum_subset (Finset.subset_univ active)
      intro q _ hq
      rw [inactive q hq, finrank_bot]
    _ ≤ ∑ _q ∈ active, Module.finrank k V :=
      Finset.sum_le_sum (fun _ _ => Submodule.finrank_le _)
    _ = active.card * Module.finrank k V := by simp

end CoinducedNormalizerOrbitHead

namespace BinaryCoinducedSylowOrbitHead

variable {G L V : Type} [Group G] [Finite G] [Group L] [Finite L]
    [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]

/-- An orbit fixed by the original Sylow still has zero fibre after
enlarging that Sylow inside the original group. -/
theorem fibre_invariants_eq_bot_of_sylow_full_stabilizer
    (H : Subgroup G) (P : Sylow 3 G) (A : Subgroup G)
    (hPA : (P : Subgroup G) ≤ A)
    (f : H →* L) (hf : Function.Surjective f)
    (rho : Representation (ZMod 2) L V)
    (hL : Nat.card L = 3 ∨ Nat.card L = 6)
    (hdim : Module.finrank (ZMod 2) V = 2) (hrho : Function.Injective rho)
    (x : G) (hfull : inducedOrbitStabilizer H (P : Subgroup G) x = ⊤) :
    Representation.invariants (inducedOrbitFibre H A (rho.comp f) x) = ⊥ := by
  have hz := fibre_invariants_eq_bot_of_full_stabilizer
    H P f hf rho hL hdim hrho x hfull
  apply le_antisymm _ bot_le
  intro v hv
  have hp : v ∈ Representation.invariants
      (inducedOrbitFibre H (P : Subgroup G) (rho.comp f) x) := by
    intro p
    let a : inducedOrbitStabilizer H A x := ⟨⟨p.1, hPA p.1.2⟩, p.2⟩
    exact hv a
  rw [hz] at hp
  exact hp

end BinaryCoinducedSylowOrbitHead
end SymmetricSubgroupAsymptotics

end
