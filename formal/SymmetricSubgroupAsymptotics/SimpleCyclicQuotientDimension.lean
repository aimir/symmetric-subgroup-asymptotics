import SymmetricSubgroupAsymptotics.FaithfulFiniteLinearRepresentationOrder
import Mathlib.GroupTheory.Subgroup.Simple
import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas

/-! A simple group acts faithfully or trivially on each actual quotient.
If the ambient representation is cyclic, every trivial quotient has
linear dimension at most one. This includes signed monomial actions
whenever their actual orbit spans; no unsigned-action or semisimplicity
hypothesis is used. No finite model order exclusion is asserted here. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
namespace SymmetricSubgroupAsymptotics.SimpleCyclicQuotientDimension

variable {K S V W : Type} [Field K] [Group S]
    [AddCommGroup V] [Module K V] [AddCommGroup W] [Module K W]

/-- The kernel dichotomy retains the full actual target GL. -/
theorem representation_trivial_or_card_dvd [Finite S] [IsSimpleGroup S]
    [FiniteDimensional K W] (sigma : Representation K S W) :
    (∀ g : S, sigma g=1) ∨
      Nat.card S ∣ Nat.card (Matrix.GeneralLinearGroup (Fin (Module.finrank K W)) K) := by
  rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal sigma.ker inferInstance with hb | ht
  · exact Or.inr (FaithfulFiniteLinearRepresentationOrder.card_dvd_matrix_GL sigma
      ((MonoidHom.ker_eq_bot_iff sigma).mp hb))
  · exact Or.inl (fun g => MonoidHom.mem_ker.mp (show g ∈ sigma.ker by
      rw [ht]
      trivial))

/-- A trivial image of a cyclic module is generated by the image of its
one cyclic vector, in arbitrary characteristic. -/
theorem trivial_cyclic_image_finrank_le_one [FiniteDimensional K W]
    (rho : Representation K S V) (v : V)
    (hcyclic : Submodule.span K (Set.range (fun g : S => rho g v))=⊤)
    (q : V →ₗ[K] W) (hq : Function.Surjective q)
    (hfixed : ∀ (g : S) (w : V), q (rho g w)=q w) :
    Module.finrank K W≤1 := by
  classical
  have hspan : Submodule.span K (Set.range (fun g : S => rho g v))≤
      (Submodule.span K {q v}).comap q := by
    apply Submodule.span_le.mpr
    rintro _ ⟨g,rfl⟩
    change q (rho g v) ∈ Submodule.span K {q v}
    rw [hfixed]
    exact Submodule.subset_span (Set.mem_singleton _)
  have hr : q.range≤Submodule.span K {q v} := by
    rintro _ ⟨w,rfl⟩
    exact hspan (by rw [hcyclic]; trivial)
  have hd := Submodule.finrank_mono hr
  rw [LinearMap.range_eq_top.mpr hq,finrank_top] at hd
  exact hd.trans (by simpa using (finrank_span_le_card ({q v} : Set W)))

/-- An actual equivariant surjective image is at most one dimensional,
or the simple source order divides the order of its full matrix GL. -/
theorem cyclic_image_dichotomy [Finite S] [IsSimpleGroup S]
    [FiniteDimensional K W] (rho : Representation K S V) (v : V)
    (hcyclic : Submodule.span K (Set.range (fun g : S => rho g v))=⊤)
    (sigma : Representation K S W) (q : V →ₗ[K] W)
    (hq : Function.Surjective q)
    (hintertwine : ∀ (g : S) (w : V), q (rho g w)=sigma g (q w)) :
    Module.finrank K W≤1 ∨
      Nat.card S ∣ Nat.card (Matrix.GeneralLinearGroup (Fin (Module.finrank K W)) K) := by
  rcases representation_trivial_or_card_dvd sigma with htrivial | hdvd
  · apply Or.inl
    apply trivial_cyclic_image_finrank_le_one rho v hcyclic q hq
    intro g w
    rw [hintertwine,htrivial g]
    rfl
  · exact Or.inr hdvd

/-- The dichotomy for the literal invariant-subspace quotient, with its
actual inherited action and quotient map. -/
theorem cyclic_quotient_dichotomy [Finite S] [IsSimpleGroup S]
    [FiniteDimensional K V] (rho : Representation K S V) (v : V)
    (hcyclic : Submodule.span K (Set.range (fun g : S => rho g v))=⊤)
    (N : Submodule K V) (hstable : ∀ g : S, N≤N.comap (rho g)) :
    Module.finrank K (V ⧸ N)≤1 ∨
      Nat.card S ∣ Nat.card (Matrix.GeneralLinearGroup (Fin (Module.finrank K (V ⧸ N))) K) := by
  exact cyclic_image_dichotomy rho v hcyclic (rho.quotient N hstable)
    N.mkQ N.mkQ_surjective (fun _ _ => rfl)

/-- Equivalent codimension form, without changing the invariant source
subspace or taking a separate worst-case quotient. -/
theorem codimension_dichotomy [Finite S] [IsSimpleGroup S]
    [FiniteDimensional K V] (rho : Representation K S V) (v : V)
    (hcyclic : Submodule.span K (Set.range (fun g : S => rho g v))=⊤)
    (N : Submodule K V) (hstable : ∀ g : S, N≤N.comap (rho g)) :
    Module.finrank K V-Module.finrank K N≤1 ∨
      Nat.card S ∣ Nat.card (Matrix.GeneralLinearGroup
        (Fin (Module.finrank K V-Module.finrank K N)) K) := by
  have hdim : Module.finrank K (V ⧸ N)=Module.finrank K V-Module.finrank K N := by
    have h := N.finrank_quotient_add_finrank
    omega
  rcases cyclic_quotient_dichotomy rho v hcyclic N hstable with hsmall | hdvd
  · exact Or.inl (by omega)
  · apply Or.inr
    have hc : Nat.card (Matrix.GeneralLinearGroup (Fin (Module.finrank K (V ⧸ N))) K)=
        Nat.card (Matrix.GeneralLinearGroup
          (Fin (Module.finrank K V-Module.finrank K N)) K) :=
      congrArg (fun d : ℕ => Nat.card (Matrix.GeneralLinearGroup (Fin d) K)) hdim
    exact hc ▸ hdvd

end SymmetricSubgroupAsymptotics.SimpleCyclicQuotientDimension
