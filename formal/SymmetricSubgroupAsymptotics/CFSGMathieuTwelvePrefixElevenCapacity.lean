private def failure (j k l m : ℕ) : ℕ :=
  selectorRow j k l / 2 ^ (7 * (m - 4)) % 128


def whitelist : List RawTail := []

private theorem batch_1 : batchCheck 11 failure whitelist 1 = true := by
  decide +kernel

private theorem batch_2 : batchCheck 11 failure whitelist 2 = true := by
  decide +kernel

private theorem batch_3 : batchCheck 11 failure whitelist 3 = true := by
  decide +kernel

private theorem batch_4 : batchCheck 11 failure whitelist 4 = true := by
  decide +kernel

private theorem batch_5 : batchCheck 11 failure whitelist 5 = true := by
  decide +kernel

private theorem batch_6 : batchCheck 11 failure whitelist 6 = true := by
  decide +kernel

private theorem batch_7 : batchCheck 11 failure whitelist 7 = true := by
  decide +kernel

private theorem batch_8 : batchCheck 11 failure whitelist 8 = true := by
  decide +kernel

private theorem batch_9 : batchCheck 11 failure whitelist 9 = true := by
  decide +kernel

private theorem batch_10 : batchCheck 11 failure whitelist 10 = true := by
  decide +kernel

private theorem batch_11 : batchCheck 11 failure whitelist 11 = true := by
  decide +kernel

private theorem batches (j : Second) : batchCheck 11 failure whitelist j.val.val = true := by
  rcases j with ⟨j,hj⟩
  fin_cases j
  · exact (hj rfl).elim
  · exact batch_1
  · exact batch_2
  · exact batch_3
  · exact batch_4
  · exact batch_5
  · exact batch_6
  · exact batch_7
  · exact batch_8
  · exact batch_9
  · exact batch_10
  · exact batch_11

def acceptedElements : Finset M12 :=
  CFSGMathieuTwelvePackedPrefixCertificate.acceptedElements 11 whitelist

theorem accepts_mem_acceptedElements (c : Code) (hfirst : c.1.1 = 11)
    (h : Accepts (decode c)) : decode c ∈ acceptedElements :=
  CFSGMathieuTwelvePackedPrefixCertificate.accepts_mem_acceptedElements
    11 failure whitelist batches c hfirst h

theorem acceptedElements_card_le_whitelistLength : acceptedElements.card ≤ whitelist.length :=
  CFSGMathieuTwelvePackedPrefixCertificate.acceptedElements_card_le_length 11 whitelist

theorem acceptedElements_card_le_capacity : acceptedElements.card ≤ 0 := by
  exact acceptedElements_card_le_whitelistLength

theorem accepts_coordinates_mem_whitelist (t : Tail) (h : Accepts (decode (code 11 t))) :
    coordinates t ∈ whitelist :=
  accepts_coordinates_mem 11 failure whitelist batches t h

theorem fixed_first_image_mem (f : MulAut M12) (hf : f firstElement = firstElement)
    (c : Code) (hc : decode c = f secondElement) (hfirst : c.1.1 = 11) :
    f secondElement ∈ acceptedElements :=
  CFSGMathieuTwelvePackedPrefixCertificate.map_second_mem_acceptedElements
    11 failure whitelist batches f hf c hc hfirst

end SymmetricSubgroupAsymptotics.CFSGMathieuTwelvePrefixElevenCapacity
