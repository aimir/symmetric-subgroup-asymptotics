import SymmetricSubgroupAsymptotics.CFSGTwoGenerationBasic
import SymmetricSubgroupAsymptotics.External.CFSG.Models.Sporadic

/-! Two-generation of the twenty sporadic models which are explicitly
built from two generators. This uses only their concrete definitions,
not their order, simplicity, or the CFSG classification hypothesis.
The remaining six models are recorded explicitly and are not assumed
or asserted to be two-generated by this file. -/
set_option autoImplicit false
noncomputable section
namespace SymmetricSubgroupAsymptotics.CFSGGeneration

theorem matrix_model_twoGenerated (p n : ℕ) (a b : Array String) :
    TwoGenerated (CFSG.Models.MatrixData.Model p n a b) := by
  apply closure_of_two_fibres (CFSG.Models.MatrixData.generators p n a b)
    (fun g : Matrix.GeneralLinearGroup (Fin n) (ZMod p) =>
      (g : Matrix (Fin n) (Fin n) (ZMod p)))
    (fun _ _ he => Units.ext he)
    (CFSG.Models.MatrixData.matrix p n a) (CFSG.Models.MatrixData.matrix p n b)
  intro g hg
  exact hg

theorem mathieu22_twoGenerated : TwoGenerated CFSG.Models.Mathieu22 :=
