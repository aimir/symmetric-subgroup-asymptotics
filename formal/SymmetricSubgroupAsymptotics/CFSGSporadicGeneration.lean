/-- These six concrete constructions are not syntactically closures or
presentations on two displayed generators. This records a proof boundary,
not an additional classification or generation assumption. -/
def SporadicGenerationResidual : CFSG.Sporadic → Prop
  | .j4 | .fi22 | .fi23 | .fi24Prime | .babyMonster | .monster => True
  | _ => False

theorem sporadic_twoGenerated_or_residual (s : CFSG.Sporadic) :
    TwoGenerated s.Model ∨ SporadicGenerationResidual s := by
  cases s with
  | m11 => exact Or.inl m11_twoGenerated
  | m12 => exact Or.inl m12_twoGenerated
  | m22 => exact Or.inl mathieu22_twoGenerated
  | m23 => exact Or.inl m23_twoGenerated
  | m24 => exact Or.inl m24_twoGenerated
  | j1 => exact Or.inl j1_twoGenerated
  | j2 => exact Or.inl j2_twoGenerated
  | j3 => exact Or.inl j3_twoGenerated
  | j4 => exact Or.inr trivial
  | co1 => exact Or.inl co1_twoGenerated
  | co2 => exact Or.inl co2_twoGenerated
  | co3 => exact Or.inl co3_twoGenerated
  | fi22 => exact Or.inr trivial
  | fi23 => exact Or.inr trivial
  | fi24Prime => exact Or.inr trivial
  | hs => exact Or.inl hs_twoGenerated
  | mcl => exact Or.inl mcl_twoGenerated
  | he => exact Or.inl he_twoGenerated
  | ru => exact Or.inl ru_twoGenerated
  | suz => exact Or.inl suz_twoGenerated
  | onan => exact Or.inl onan_twoGenerated
  | hn => exact Or.inl hn_twoGenerated
  | ly => exact Or.inl ly_twoGenerated
  | th => exact Or.inl th_twoGenerated
  | babyMonster => exact Or.inr trivial
  | monster => exact Or.inr trivial

theorem sporadic_twoGenerated_of_not_residual (s : CFSG.Sporadic)
    (hs : ¬ SporadicGenerationResidual s) : TwoGenerated s.Model :=
  (sporadic_twoGenerated_or_residual s).resolve_right hs

/-- This is exactly the generating-set witness needed by the original
FiniteSimpleTwoGeneratorBound consumer after transporting a CFSG model
isomorphism. It does not change the original group. -/
theorem twoGenerated_of_mulEquiv_sporadic {G : Type} [Group G]
    (s : CFSG.Sporadic) (hs : ¬ SporadicGenerationResidual s)
    (e : G ≃* s.Model) : TwoGenerated G :=
  of_mulEquiv e.symm (sporadic_twoGenerated_of_not_residual s hs)

end SymmetricSubgroupAsymptotics.CFSGGeneration
