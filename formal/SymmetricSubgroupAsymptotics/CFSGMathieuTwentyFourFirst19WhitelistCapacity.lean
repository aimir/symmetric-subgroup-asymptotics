theorem first_card_le_sum [IsSimpleGroup CFSG.Models.Presentations.M24.Model] :
    Nat.card (firstSwapFibre selectedFirst) ≤ ∑ j : Second, (whitelist j).length :=
  firstSwapFibre_card_le_whitelist_sum selectedFirst failure whitelist all_batches

theorem first_card_le [IsSimpleGroup CFSG.Models.Presentations.M24.Model] :
    Nat.card (firstSwapFibre selectedFirst) ≤ literalWhitelistCount :=
  by
    calc
      _ ≤ ∑ j : Second, (whitelist j).length := first_card_le_sum
      _ = _ := whitelist_length_sum

