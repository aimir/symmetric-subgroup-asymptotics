import SymmetricSubgroupAsymptotics.CFSGNormTwoCoordinateExcludedHeight
import SymmetricSubgroupAsymptotics.CFSGNormTwoGeckOppositionDegree
import SymmetricSubgroupAsymptotics.CFSGNormTwoGeckQuadraticMembership
import SymmetricSubgroupAsymptotics.CFSGNormTwoGeckWeylWordDegree
import SymmetricSubgroupAsymptotics.CFSGGradedMatrixTriangularUnits
import SymmetricSubgroupAsymptotics.CFSGNormTwoGeckBorelEnvelope

/-! The literal positive subgroup meets the subgroup generated by the
negative subgroup and one positive simple root subgroup in EXACTLY that
simple root subgroup. Integer graded flags avoid torus eigenvalues,
finite-field restrictions and an assumed BN-pair. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
namespace SymmetricSubgroupAsymptotics.CFSGNormTwoCoordinateOppositeParabolicIntersection
open CFSGIntegerMatrixPairing CFSGNormTwoRootPairing
open CFSGNormTwoGeckIntegralRealization CFSGNormTwoGeckPositivePGroup
open CFSGNormTwoCoordinateExcludedHeight CFSGNormTwoGeckArbitraryHeightSupport
open CFSGNormTwoGeckHeightSupport CFSGSerreQuadraticMatrix
open CFSGNormTwoGeckQuadraticMembership CFSGNormTwoGeckOppositionDegree
open CFSGNormTwoGeckFieldOpposition CFSGGradedMatrixSubgroups
open CFSGNormTwoGeckWeylWordDegree
open CFSGGradedMatrixTriangularUnits
open CFSGNormTwoGeckBorelEnvelope CFSGNormTwoGeckParameterizedTorus
variable {r : ℕ} (A : Matrix (Fin r) (Fin r) ℤ) (hd : ∀j,A j j=2)
    (hs : A.transpose=A) (hp : (rationalMatrix A).PosDef)
    (ho : ∀i j,i≠j→A i j≤0)
    [Fintype (Roots A)] [DecidableEq (Roots A)] [(rootPairing A hs hp).IsIrreducible]
local notation "b₀" => coordinateBase A hd hs hp ho
local notation "s₀" => coordinateIndexEquiv A hd hs hp ho
local notation "D" => realizationData A hs hp b₀ s₀
local notation "w(" i ")" => weight A hs hp b₀ (excludedHeight i)

theorem positive_le_reverse_excluded_triangular (K : Type) [Field K] (i : Fin r) :
    rootGroup A hs hp b₀ s₀ K false≤triangularUnits (fun j=> -w(i) j) := by
  apply (Subgroup.closure_le _).mpr
  rintro _ ⟨⟨j,t⟩,rfl⟩
  by_cases hij : i=j
  · subst j
    intro x y hxy
    exact canonicalRoot_preserves A hs hp b₀ s₀ (excludedHeight i) K i t
      (excluded_simple_zero A hd hs hp ho i) x y (by
        change w(i) x≠w(i) y
        change -w(i) y < -w(i) x at hxy
        omega)
  · exact strict_le_reverse_triangular _
      (canonicalRoot_strict A hs hp b₀ s₀ (excludedHeight i) K j t
        (excluded_other_positive A hd hs hp ho i j hij))

theorem negative_le_excluded_triangular (K : Type) [Field K] (i : Fin r) :
    rootGroup A hs hp b₀ s₀ K true≤triangularUnits w(i) := by
  apply (Subgroup.closure_le _).mpr
  rintro _ ⟨⟨j,t⟩,rfl⟩
  have hpos := canonicalRoot_quadraticGrade A hs hp b₀ s₀ K j t
  have hneg := opposition_quadraticGrade A hs hp b₀ K (s₀ j : Roots A).val _ hpos
  rw [canonicalRoot_conjugate] at hneg
  by_cases hij : i=j
  · subst j
    apply preserving_le_triangular _
    exact quadratic_preserves A hs hp b₀ (excludedHeight i) K _ _ hneg (by
      rw [map_neg,excluded_simple_zero A hd hs hp ho i,neg_zero])
  · have hstrict := quadratic_strict A hs hp b₀ (-excludedHeight i) K _ _ hneg (by
        simp only [LinearMap.neg_apply,map_neg,neg_neg]
        exact excluded_other_positive A hd hs hp ho i j hij)
    have he : weight A hs hp b₀ (-excludedHeight i)=(fun j=> -w(i) j) := by
      funext j
      cases j <;> rfl
    rw [he] at hstrict
    simpa only [neg_neg] using strict_le_reverse_triangular (fun j=> -w(i) j) hstrict

theorem opposite_parabolic_intersection (K : Type) [Field K] (i : Fin r) :
    rootGroup A hs hp b₀ s₀ K false ⊓
      (rootGroup A hs hp b₀ s₀ K true⊔canonicalRootSubgroup D K false i)=
        canonicalRootSubgroup D K false i := by
  apply le_antisymm
  · have hP : rootGroup A hs hp b₀ s₀ K true⊔canonicalRootSubgroup D K false i≤
        triangularUnits w(i) := sup_le
      (negative_le_excluded_triangular A hd hs hp ho K i)
      ((CFSGNormTwoGeckComplementGrading.simple_le_preserving A hs hp b₀ s₀
        (excludedHeight i) i (excluded_simple_zero A hd hs hp ho i) K).trans
          (preserving_le_triangular _))
    intro g hg
    apply coordinate_positive_mem_simple_of_preserves A hd hs hp ho i K g hg.1
    exact (triangular_inf_reverse_eq_preserving w(i)).le
      ⟨hP hg.2,positive_le_reverse_excluded_triangular A hd hs hp ho K i hg.1⟩
  · apply le_inf _ le_sup_right
    rintro g ⟨t,rfl⟩
    exact Subgroup.subset_closure ⟨(i,t),rfl⟩

theorem torus_le_excluded_preserving (K : Type) [Field K] (i : Fin r) :
    torusGroup A hs hp b₀ s₀ K≤preservingUnits w(i) := by
  apply (Subgroup.closure_le _).mpr
  rintro _ ⟨⟨j,t⟩,rfl⟩
  intro x y hxy
  have hne : x≠y := by intro he; subst y; exact hxy rfl
  rw [CFSGNormTwoGeckDiagonalTorus.torus_diagonal]
  exact Matrix.diagonal_apply_ne _ hne

def oppositeBorel (K : Type) [Field K] :=
  rootGroup A hs hp b₀ s₀ K true⊔torusGroup A hs hp b₀ s₀ K

theorem opposite_borel_parabolic_intersection (K : Type) [Field K] (i : Fin r) :
    rootGroup A hs hp b₀ s₀ K false ⊓
      (oppositeBorel A hd hs hp ho K⊔canonicalRootSubgroup D K false i)=
        canonicalRootSubgroup D K false i := by
  apply le_antisymm
  · have hP : oppositeBorel A hd hs hp ho K⊔canonicalRootSubgroup D K false i≤
        triangularUnits w(i) := sup_le
      (sup_le (negative_le_excluded_triangular A hd hs hp ho K i)
        ((torus_le_excluded_preserving A hd hs hp ho K i).trans (preserving_le_triangular _)))
      ((CFSGNormTwoGeckComplementGrading.simple_le_preserving A hs hp b₀ s₀
        (excludedHeight i) i (excluded_simple_zero A hd hs hp ho i) K).trans
          (preserving_le_triangular _))
    intro g hg
    apply coordinate_positive_mem_simple_of_preserves A hd hs hp ho i K g hg.1
    exact (triangular_inf_reverse_eq_preserving w(i)).le
      ⟨hP hg.2,positive_le_reverse_excluded_triangular A hd hs hp ho K i hg.1⟩
  · apply le_inf _ le_sup_right
    rintro g ⟨t,rfl⟩
    exact Subgroup.subset_closure ⟨(i,t),rfl⟩

end SymmetricSubgroupAsymptotics.CFSGNormTwoCoordinateOppositeParabolicIntersection
