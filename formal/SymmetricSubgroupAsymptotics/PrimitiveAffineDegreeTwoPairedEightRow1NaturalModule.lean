def topAmbient (i : Fin 4) : Top := actionEquiv (PrimitiveAffineEightFrameRow0TopCertificate.ambient i)

theorem topAmbient_full :
    Subgroup.closure (Set.range topAmbient) = ⊤ := by
  apply top_unique
  intro y _hy
  obtain ⟨x, rfl⟩ := actionEquiv.surjective y
  have hx : x ∈ Subgroup.closure (Set.range PrimitiveAffineEightFrameRow0TopCertificate.ambient) := by
    rw [PrimitiveAffineEightFrameRow0TopCertificate.ambient_full]
    exact Subgroup.mem_top x
  induction hx using Subgroup.closure_induction with
  | mem x hx =>
      obtain ⟨i, rfl⟩ := hx
      exact Subgroup.subset_closure ⟨i, rfl⟩
  | one => exact Subgroup.one_mem _
  | mul x y _ _ hx hy => exact Subgroup.mul_mem _ hx hy
  | inv x _ hx => exact Subgroup.inv_mem _ hx

