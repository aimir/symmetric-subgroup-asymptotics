/-- Each stored cyclic state is exactly the orbit span of its displayed
representative.  This is public because the coupled Schur-row argument uses
the same literal cyclic states for the coinvariant kernels. -/
theorem canonical_span (i : Fin 10) :
    (states (cyclicState i)).toSubmodule =
      binaryOrbitSpan representation (cyclicRepresentative i) := by
  fin_cases i
  · exact C0.span_eq
  · exact C1.span_eq
  · exact C2.span_eq
  · exact C3.span_eq
  · exact C4.span_eq
  · exact C5.span_eq
  · exact C6.span_eq
  · exact C7.span_eq
  · exact C8.span_eq
  · exact C9.span_eq

/-- Every stored cyclic state is generated by one vector over the literal
top group algebra. -/
theorem cyclicState_generated (i : Fin 10) :
    RepresentationGeneratedBy
      (states (cyclicState i)).toRepresentation 1 := by
  apply representationGeneratedBy_of_iSup_binaryOrbitSpan
    representation (states (cyclicState i)) 1
      (fun _ ↦ cyclicRepresentative i)
  rw [canonical_span]
  apply le_antisymm
  · exact le_iSup (fun _ : Fin 1 ↦
      binaryOrbitSpan representation (cyclicRepresentative i)) 0
  · apply iSup_le
    intro j
    fin_cases j
    exact le_rfl

