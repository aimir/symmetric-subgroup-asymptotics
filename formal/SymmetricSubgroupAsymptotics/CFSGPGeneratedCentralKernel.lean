import SymmetricSubgroupAsymptotics.CFSGPerfectCentralKernel
import SymmetricSubgroupAsymptotics.CFSGCentralKernelPElements

/-! A central extension cannot hide another noncentral projective kernel
when the group is generated by p-subgroups and central kernel p-elements
are detected. This replaces a perfectness hypothesis by the actual root
p-group generation and one injective Sylow restriction. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
namespace SymmetricSubgroupAsymptotics.CFSGPGeneratedCentralKernel
variable {G H Q : Type*} [Group G] [Group H] [Group Q]

 theorem kernel_le_center_of_p_generated
    (p : ℕ) (f : G→*H) (hker : f.ker≤Subgroup.center G)
    (pi : G→*Q) (hpi : pi.ker≤(Subgroup.center H).comap f)
    (U V : Subgroup G) (hU : IsPGroup p U) (hV : IsPGroup p V)
    (hgen : U⊔V=⊤)
    (hkill : ∀z : G,z∈Subgroup.center G→pi z=1→(∃n : ℕ,z^p^n=1)→z=1) :
    pi.ker≤Subgroup.center G := by
  intro k hk
  let c : G→G := fun x=>k*x*k⁻¹*x⁻¹
  have hc (x : G) : c x∈Subgroup.center G := by
    apply hker
    change f (k*x*k⁻¹*x⁻¹)=1
    have hcx : Commute (f k) (f x) :=
      (Subgroup.mem_center_iff.mp (hpi hk) (f x)).symm
    simpa only [map_mul,map_inv,commutatorElement_def] using hcx.commutator_eq
  let chi : G→*G :=
    { toFun := c
      map_one' := by dsimp only [c];group
      map_mul' := by
        intro x y
        have he : x*c y*x⁻¹=c y := by
          rw [Subgroup.mem_center_iff.mp (hc y) x]
          group
        calc
          c (x*y)=c x*(x*c y*x⁻¹) := by dsimp only [c];group
          _=c x*c y := by rw [he] }
  have hpart (R : Subgroup G) (hR : IsPGroup p R) : R≤chi.ker := by
    intro x hx
    obtain ⟨n,hn⟩ := hR ⟨x,hx⟩
    have hxpow : x^p^n=1 := congrArg Subtype.val hn
    have hcPow : (chi x)^p^n=1 := by rw [←map_pow,hxpow,map_one]
    have hpiC : pi (chi x)=1 := by
      change pi (k*x*k⁻¹*x⁻¹)=1
      have hpk : pi k=1 := hk
      simp only [map_mul,map_inv,hpk,inv_one,one_mul,mul_one,mul_inv_cancel]
    exact hkill (chi x) (hc x) hpiC ⟨n,hcPow⟩
  have hwhole : (⊤ : Subgroup G)≤chi.ker := by
    rw [←hgen]
    exact sup_le (hpart U hU) (hpart V hV)
  apply Subgroup.mem_center_iff.mpr
  intro x
  have he : chi x=1 := hwhole (Subgroup.mem_top x)
  have hc1 : k*x*k⁻¹*x⁻¹=1 := he
  exact (commutatorElement_eq_one_iff_mul_comm.mp hc1).symm

theorem kernel_le_center_of_injective_sylow
    {p : ℕ} [Fact p.Prime] (f : G→*H) (hker : f.ker≤Subgroup.center G)
    (pi : G→*Q) (hpi : pi.ker≤(Subgroup.center H).comap f)
    (P : Sylow p G) (hP : Function.Injective (pi.comp (P : Subgroup G).subtype))
    (U V : Subgroup G) (hU : IsPGroup p U) (hV : IsPGroup p V) (hgen : U⊔V=⊤) :
    pi.ker≤Subgroup.center G := by
  apply kernel_le_center_of_p_generated p f hker pi hpi U V hU hV hgen
  intro z hz hpz hpow
  have hzP := CFSGCentralKernelPElements.central_p_element_mem P z hz hpow
  have he : pi.comp (P : Subgroup G).subtype ⟨z,hzP⟩=
      pi.comp (P : Subgroup G).subtype 1 := by
    change pi z=pi 1
    rw [map_one]
    exact hpz
  exact congrArg Subtype.val (hP he)

end SymmetricSubgroupAsymptotics.CFSGPGeneratedCentralKernel
