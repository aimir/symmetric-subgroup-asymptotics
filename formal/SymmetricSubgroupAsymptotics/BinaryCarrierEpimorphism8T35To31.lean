local instance : Group (FiniteGroupRow 128) := BinaryMenuCayley8T35.group

private def rowHom : FiniteGroupRow 128 →* Equiv.Perm (Fin 8) where
  toFun i := values i.index
  map_one' := values_identity
  map_mul' i j := by
    change values (BinaryMenuCayley8T35.certificate.walk i.index
      (BinaryMenuCayley8T35.certificate.words j.index)) = values i.index * values j.index
    exact BinaryMenuCayley8T35.certificate.values_walk values images transitions
      i.index (BinaryMenuCayley8T35.certificate.words j.index)

private def permutationHom : Source →* Equiv.Perm (Fin 8) :=
  rowHom.comp BinaryMenuCayley8T35.originalEquiv.symm.toMonoidHom

private theorem permutationHom_row (i : Fin 128) :
    permutationHom (BinaryMenuCayley8T35.originalEquiv ⟨i⟩) = values i := by
  change rowHom (BinaryMenuCayley8T35.originalEquiv.symm (BinaryMenuCayley8T35.originalEquiv ⟨i⟩)) = values i
  rw [MulEquiv.symm_apply_apply]
  rfl

/-- The target is the literal original closure, not an abstract replacement. -/
def hom : Source →* Target :=
  permutationHom.codRestrict Target (fun x =>
    values_mem (BinaryMenuCayley8T35.originalEquiv.symm x).index)

@[simp] theorem hom_row (i : Fin 128) :
    (hom (BinaryMenuCayley8T35.originalEquiv ⟨i⟩) : Equiv.Perm (Fin 8)) = values i :=
  permutationHom_row i

theorem hom_generator (j : Fin 3) :
    (hom ⟨BinaryMenuCayley8T35.generators j,
      Subgroup.subset_closure (Set.mem_range_self j)⟩ : Equiv.Perm (Fin 8)) =
      images j := by
  have he : BinaryMenuCayley8T35.originalEquiv
      ⟨BinaryMenuCayley8T35.certificate.next BinaryMenuCayley8T35.certificate.identity j⟩ =
      (⟨BinaryMenuCayley8T35.generators j,
        Subgroup.subset_closure (Set.mem_range_self j)⟩ : Source) := by
    apply Subtype.ext
    change BinaryMenuCayley8T35.certificate.toCayley.elements
      (BinaryMenuCayley8T35.certificate.toCayley.next BinaryMenuCayley8T35.certificate.toCayley.identity j) = _
    rw [BinaryMenuCayley8T35.certificate.toCayley.next_eq,
      BinaryMenuCayley8T35.certificate.toCayley.identity_eq, one_mul]
  rw [← he, hom_row, transitions, values_identity, one_mul]

private theorem target_generator_preimages :
    ∀ j : Fin 3, ∃ i : Fin 128, ∀ x : Fin 8,
      values i x = BinaryMenuCayley8T31.generators j x := by
  decide +kernel

theorem hom_surjective : Function.Surjective hom := by
  have hrange : Target ≤ permutationHom.range := by
    apply (Subgroup.closure_le _).mpr
    rintro y ⟨j, rfl⟩
    obtain ⟨i, hi⟩ := target_generator_preimages j
    refine ⟨BinaryMenuCayley8T35.originalEquiv ⟨i⟩, ?_⟩
    exact (permutationHom_row i).trans (Equiv.ext hi)
  intro y
  obtain ⟨x, hx⟩ := hrange y.property
  exact ⟨x, Subtype.ext hx⟩

end SymmetricSubgroupAsymptotics.BinaryCarrierEpimorphism8T35To31
