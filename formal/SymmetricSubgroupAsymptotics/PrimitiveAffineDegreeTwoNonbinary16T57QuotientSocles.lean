import SymmetricSubgroupAsymptotics.FiniteNormalRegistryQuotientSocle
import SymmetricSubgroupAsymptotics.PrimitiveAffineDegreeTwoBinaryKernelAnchor
import SymmetricSubgroupAsymptotics.PrimitiveAffineDegreeTwoNonbinary16T57Structural

/-!
# Quotient socles for the selected nonbinary row 16T57

The complete nine-state normal registry determines the relative minimal
normal states above every base state.  The displayed carrier and one
literal Cayley-row element normally generate their supremum modulo the base.
All finite subgroup relations are rechecked by `native_decide`; the JSON
normal list is not used as a theorem premise.
-/

set_option autoImplicit false
set_option maxRecDepth 100000
set_option maxHeartbeats 0
noncomputable section
open scoped Classical

namespace SymmetricSubgroupAsymptotics
namespace PrimitiveAffineDegreeTwoNonbinary16T57QuotientSocles

open PrimitiveAffineDegreeTwoNonbinary16T57ClassPilot
open PrimitiveAffineDegreeTwoNonbinary16T57Structural
open Non2UnipotentPrefixFiniteMenu
namespace RowNormals := PrimitiveAffineDegreeTwoNonbinary16T57Normals

local instance selectedSourceGroup : Group Source := group

/-- The executable-row version of one emitted normal state. -/
private def rowState (i : Fin 9) : Subgroup Source :=
  Subgroup.closure (Set.range (RowNormals.stateGenerators i))

private theorem row_state_injective : Function.Injective rowState := by
  native_decide

/-- Complete normal registry on the executable 48-element Cayley model.
All finite order and closure decisions below are performed on this model,
before transport to the literal permutation subgroup. -/
noncomputable def rowRegistry :
    FiniteNormalStateRegistry Source :=
  FiniteNormalStateRegistry.ofWordRegistry
    conjugacyChunk.toCardinalCover
    PrimitiveAffineDegreeTwoNonbinary16T57ClassPilot.ambient
    RowNormals.stateGenerators RowNormals.normalRegistry
    row_state_injective

/-- The same complete registry on the literal subgroup generated by the
catalogue permutations. -/
noncomputable def originalRegistry :
    FiniteNormalStateRegistry Original :=
  rowRegistry.mapEquiv originalEquiv

private abbrev RR := rowRegistry
private abbrev R := originalRegistry

private theorem rowRegistry_state (i : Fin 9) :
    RR.state i = rowState i := rfl

/-- Executable form of relative minimality, kept independent of the
noncomputable proof fields in `rowRegistry`. -/
private def RowIsMinimalStateAbove (base j : Fin 9) : Prop :=
  rowState base < rowState j ∧
    ∀ k : Fin 9, rowState base < rowState k →
      rowState k ≤ rowState j → rowState k = rowState j

private theorem rowRegistry_minimal_iff (base j : Fin 9) :
    RR.IsMinimalStateAbove base j ↔
      RowIsMinimalStateAbove base j := by
  rfl

/-- Preimage of the quotient socle, indexed by the nine checked normal
states: `4,6,6,7,8,7,8,8,8` in zero-based state numbering. -/
private def carrierState (i : Fin 9) : Fin 9 :=
  (#[4, 6, 6, 7, 8, 7, 8, 8, 8] : Array (Fin 9))[i.val]!

/-- One Cayley-row representative normally generating the quotient socle.
The top quotient uses the identity row `47`. -/
private def generatorRow (i : Fin 9) : Fin 48 :=
  (#[5, 19, 2, 3, 18, 3, 0, 18, 47] : Array (Fin 48))[i.val]!

private def rowGenerator (i : Fin 9) : Source := ⟨generatorRow i⟩

private theorem row_carrier_eq_checked : ∀ i : Fin 9,
    rowState (carrierState i) =
      ⨆ j : {j : Fin 9 // RowIsMinimalStateAbove i j}, rowState j.1 := by
  native_decide

private theorem row_generated_checked : ∀ i : Fin 9,
    Subgroup.normalClosure
        (Set.range (fun _ : Fin 1 ↦ rowGenerator i)) ⊔ rowState i =
      rowState (carrierState i) := by
  native_decide

/-- Relative-socle certificate for one checked executable-row state. -/
noncomputable def rowStateData (i : Fin 9) :
    FiniteRelativeSocleGeneratorData Source (RR.state i) :=
  RR.relativeSocleGeneratorDataOfStates i (carrierState i)
    {j : Fin 9 // RowIsMinimalStateAbove i j}
    Subtype.val
    (fun j ↦ (rowRegistry_minimal_iff i j).2 j.property)
    (fun j hj ↦
      ⟨⟨j, (rowRegistry_minimal_iff i j).1 hj⟩, rfl⟩)
    (by simpa only [rowRegistry_state] using row_carrier_eq_checked i)
    (rowGenerator i)
    (by simpa only [rowRegistry_state] using row_generated_checked i)

/-- Transported relative-socle certificate on the literal catalogue
subgroup.  No finite decision passes through the noncomputable
`originalEquiv`; only the already checked semantic certificate is mapped. -/
noncomputable def stateData (i : Fin 9) :
    FiniteRelativeSocleGeneratorData Original (R.state i) :=
  (rowStateData i).mapEquiv originalEquiv

/-- The complete nine-state family. -/
noncomputable def family : R.QuotientSocleGeneratorFamily where
  data := stateData

/-- Every literal quotient of 16T57 has a one-position socle normal
generator, dispatched through the checked complete normal registry. -/
noncomputable def quotientSocleGenerator
    (N : {N : Subgroup Original // N.Normal}) :
    SocleNormalGeneratorBound (Original ⨸ N.1) 1 :=
  family.dispatch N

/-- Consequently every literal quotient has the one-ordinary, zero-relative
binary-kernel anchor used by the universal degree-two pair lift. -/
noncomputable def quotientBinaryKernelAnchor
    (hZmud : ZmudFaithfulCharacterTupleInput)
    (N : {N : Subgroup Original // N.Normal}) :
    Non2UnipotentPrefixFiniteMenu.PrimitiveAffineImprimitiveBlockTransfer.
      DegreeTwoPairBinaryKernelAnchor (Original ⨸ N.1)
        (Non2UnipotentPrefixFiniteMenu.PrimitiveAffineImprimitiveBlockTransfer.
          degreeTwoPairGeneralProfile 1) :=
  Non2UnipotentPrefixFiniteMenu.PrimitiveAffineImprimitiveBlockTransfer.
    DegreeTwoPairBinaryKernelAnchor.ofSocleGeneratorBound hZmud
      (quotientSocleGenerator N)

end PrimitiveAffineDegreeTwoNonbinary16T57QuotientSocles
end SymmetricSubgroupAsymptotics

end
