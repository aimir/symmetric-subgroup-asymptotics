/-!
# Quotient socles for selected nonbinary action 16T57

Generated by `emit_lean_nonbinary_selected_quotient_socles.py` from the
explicit checked normal chunks `degree2_16T57_normals_socle_000.json, degree2_16T57_normals_socle_001.json, degree2_16T57_normals_socle_002.json`.  The generator
bound is `1`.  Producer indices are not theorem premises:
all subgroup order, minimality, supremum, and normal-closure claims below
are rechecked by `native_decide` on the executable Cayley group.
-/

set_option autoImplicit false
set_option maxRecDepth 100000
set_option maxHeartbeats 0
noncomputable section
open scoped Classical

namespace SymmetricSubgroupAsymptotics.PrimitiveAffineDegreeTwoNonbinary16T57QuotientSocles

open PrimitiveAffineDegreeTwoNonbinary16T57ClassPilot
open PrimitiveAffineDegreeTwoNonbinary16T57Structural
open Non2UnipotentPrefixFiniteMenu
namespace RowNormals := PrimitiveAffineDegreeTwoNonbinary16T57Normals

local instance selectedSourceGroup : Group Source := group

private def rowState (i : Fin 9) : Subgroup Source :=
  Subgroup.closure (Set.range (RowNormals.stateGenerators i))

private theorem row_state_injective : Function.Injective rowState := by
  native_decide

noncomputable def rowRegistry : FiniteNormalStateRegistry Source :=
  FiniteNormalStateRegistry.ofWordRegistry
    conjugacyChunk.toCardinalCover
    PrimitiveAffineDegreeTwoNonbinary16T57ClassPilot.ambient RowNormals.stateGenerators
    RowNormals.normalRegistry row_state_injective

noncomputable def originalRegistry : FiniteNormalStateRegistry Original :=
  rowRegistry.mapEquiv originalEquiv

private abbrev RR := rowRegistry
private abbrev R := originalRegistry

private theorem rowRegistry_state (i : Fin 9) :
    RR.state i = rowState i := rfl

private def RowIsMinimalStateAbove
    (base j : Fin 9) : Prop :=
  rowState base < rowState j ∧
    ∀ k : Fin 9, rowState base < rowState k →
      rowState k ≤ rowState j → rowState k = rowState j

private theorem rowRegistry_minimal_iff
    (base j : Fin 9) :
    RR.IsMinimalStateAbove base j ↔
      RowIsMinimalStateAbove base j := by
  rfl

private def carrierState (i : Fin 9) : Fin 9 :=
  (Fin.cases (4) (Fin.cases (6) (Fin.cases (6) (Fin.cases (7) (Fin.cases (8) (Fin.cases (7) (Fin.cases (8) (Fin.cases (8) (Fin.cases (8) (fun i => Fin.elim0 i))))))))))

private def state0SocleGenerators : Fin 1 → Source :=
  (Fin.cases (representative 6) (fun i => Fin.elim0 i))

private def state1SocleGenerators : Fin 1 → Source :=
  (Fin.cases (representative 10) (fun i => Fin.elim0 i))

private def state2SocleGenerators : Fin 1 → Source :=
  (Fin.cases (representative 6) (fun i => Fin.elim0 i))

private def state3SocleGenerators : Fin 1 → Source :=
  (Fin.cases (representative 4) (fun i => Fin.elim0 i))

private def state4SocleGenerators : Fin 1 → Source :=
  (Fin.cases (representative 8) (fun i => Fin.elim0 i))

private def state5SocleGenerators : Fin 1 → Source :=
  (Fin.cases (representative 3) (fun i => Fin.elim0 i))

private def state6SocleGenerators : Fin 1 → Source :=
  (Fin.cases (representative 1) (fun i => Fin.elim0 i))

private def state7SocleGenerators : Fin 1 → Source :=
  (Fin.cases (representative 8) (fun i => Fin.elim0 i))

private def state8SocleGenerators : Fin 1 → Source :=
  (Fin.cases ((1 : Source)) (fun i => Fin.elim0 i))

private def rowGenerator : Fin 9 → Fin 1 → Source :=
  (Fin.cases (state0SocleGenerators) (Fin.cases (state1SocleGenerators) (Fin.cases (state2SocleGenerators) (Fin.cases (state3SocleGenerators) (Fin.cases (state4SocleGenerators) (Fin.cases (state5SocleGenerators) (Fin.cases (state6SocleGenerators) (Fin.cases (state7SocleGenerators) (Fin.cases (state8SocleGenerators) (fun i => Fin.elim0 i))))))))))

private theorem row_carrier_eq_checked : ∀ i : Fin 9,
    rowState (carrierState i) = rowState i ⊔
      ⨆ j : {j : Fin 9 // RowIsMinimalStateAbove i j},
        rowState j.1 := by
  native_decide

private theorem row_generated_checked : ∀ i : Fin 9,
    Subgroup.normalClosure (Set.range (rowGenerator i)) ⊔ rowState i =
      rowState (carrierState i) := by
  native_decide

noncomputable def rowStateData (i : Fin 9) :
    FiniteRelativeSocleGeneratorData Source (RR.state i)
      1 :=
  RR.relativeSocleGeneratorDataOfStates i (carrierState i)
    1
    {j : Fin 9 // RowIsMinimalStateAbove i j}
    Subtype.val
    (fun j ↦ (rowRegistry_minimal_iff i j).2 j.property)
    (fun j hj ↦
      ⟨⟨j, (rowRegistry_minimal_iff i j).1 hj⟩, rfl⟩)
    (by simpa only [rowRegistry_state] using row_carrier_eq_checked i)
    (rowGenerator i)
    (by simpa only [rowRegistry_state] using row_generated_checked i)

noncomputable def stateData (i : Fin 9) :
    FiniteRelativeSocleGeneratorData Original (R.state i)
      1 :=
  (rowStateData i).mapEquiv originalEquiv

noncomputable def family :
    R.QuotientSocleGeneratorFamily 1 where
  data := stateData

/-- Every literal quotient of this selected action has its socle normally
generated by the displayed uniformly padded tuple. -/
noncomputable def quotientSocleGenerator
    (N : {N : Subgroup Original // N.Normal}) :
    SocleNormalGeneratorBound (Original ⨸ N.1) 1 :=
  family.dispatch N

/-- The published Žmud theorem turns the checked socle tuple into a
jointly faithful tuple of irreducible complex representations. -/
noncomputable def quotientCharacterCertificate
    (hZmud : ZmudFaithfulCharacterTupleInput)
    (N : {N : Subgroup Original // N.Normal}) :
    CharacterQuotientCertificate (Original ⨸ N.1) :=
  hZmud.generalCertificate (quotientSocleGenerator N)

/-- The same tuple is a zero-relative binary-kernel anchor when its pure
ordinary profile is available in a pair-row menu. -/
noncomputable def quotientBinaryKernelAnchor
    (hZmud : ZmudFaithfulCharacterTupleInput)
    (N : {N : Subgroup Original // N.Normal}) :
    PrimitiveAffineImprimitiveBlockTransfer.DegreeTwoPairBinaryKernelAnchor
      (Original ⨸ N.1)
      (PrimitiveAffineImprimitiveBlockTransfer.degreeTwoPairGeneralProfile
        1) :=
  PrimitiveAffineImprimitiveBlockTransfer.DegreeTwoPairBinaryKernelAnchor.
    ofSocleGeneratorBound hZmud (quotientSocleGenerator N)

end SymmetricSubgroupAsymptotics.PrimitiveAffineDegreeTwoNonbinary16T57QuotientSocles

