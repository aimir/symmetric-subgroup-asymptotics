import SymmetricSubgroupAsymptotics.CFSGOddGeneratedIndexTwo
import Mathlib.GroupTheory.PGroup
import Mathlib.GroupTheory.Commutator.Basic

/-! Two actual index-at-most-two layers yield an abelian quotient when
the lower subgroup is generated by odd torsion. This retains the extra
central-cocycle layer instead of identifying projective fixed lifts
with literal fixed elements. -/
set_option autoImplicit false
noncomputable section
open scoped commutatorElement
namespace SymmetricSubgroupAsymptotics.CFSGOddGeneratedDoubleIndex
variable {G : Type*} [Group G] [Finite G]

theorem commutative_of_card_dvd_four (hd : Nat.card G ∣ 4) : ∀ x y : G, x * y = y * x := by
  have hd' : Nat.card G ∣ 2 ^ 2 := by norm_num; exact hd
  obtain ⟨k, hk, he⟩ := (Nat.dvd_prime_pow (by decide : Nat.Prime 2)).mp hd'
  interval_cases k
  · letI : IsCyclic G := isCyclic_of_card_dvd_prime (p := 2) (by rw [he]; decide)
    letI : CommGroup G := IsCyclic.commGroup
    exact mul_comm
  · letI : IsCyclic G := isCyclic_of_card_dvd_prime (p := 2) (by rw [he]; decide)
    letI : CommGroup G := IsCyclic.commGroup
    exact mul_comm
  · exact IsPGroup.commutative_of_card_eq_prime_sq (p := 2) he

theorem index_dvd_two (A : Subgroup G) (hi : A.index ≤ 2) : A.index ∣ 2 := by
  have hn : A.index ≠ 0 := Subgroup.index_ne_zero_of_finite
  rcases (show A.index = 1 ∨ A.index = 2 by omega) with h | h <;> rw [h] <;> decide

theorem commutator_le_of_generated_odd_torsion (R H : Subgroup G) [H.Normal]
    (hRH : R ≤ H) (hR : (R.subgroupOf H).index ≤ 2) (hH : H.index ≤ 2)
    (S : Set G) (hS : R = Subgroup.closure S)
    (ht : ∀ x ∈ S, ∃ m : ℕ, Odd m ∧ x ^ m = 1) : commutator G ≤ R := by
  letI : R.Normal := CFSGOddGeneratedIndexTwo.normal_of_generated_odd_torsion R H hRH hR S hS ht
  have hcard : Nat.card (G ⧸ R) ∣ 4 := by
    change R.index ∣ 4
    rw [← Subgroup.relIndex_mul_index hRH]
    exact Nat.mul_dvd_mul (index_dvd_two (R.subgroupOf H) hR) (index_dvd_two H hH)
  have hc := commutative_of_card_dvd_four hcard
  rw [commutator_def]
  apply Subgroup.commutator_le.mpr
  intro x _ y _
  apply (QuotientGroup.eq_one_iff _).mp
  change (QuotientGroup.mk' R) ⁅x, y⁆ = 1
  rw [map_commutatorElement]
  exact commutatorElement_eq_one_iff_mul_comm.mpr (hc _ _)

end SymmetricSubgroupAsymptotics.CFSGOddGeneratedDoubleIndex
