import SymmetricSubgroupAsymptotics.CubicBinaryCoordinateUniform
import SymmetricSubgroupAsymptotics.BinaryThreeQuartetLiteralSocles
import SymmetricSubgroupAsymptotics.LinearSemidirectSubgroupSocles

/-! An ACTUAL correlated subgroup of two regular binary C3 modules has
all quotient-socles generated by two. Original affine offsets and kernel
correlations are unrestricted; only the actual cubic image is required. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open scoped Classical
namespace SymmetricSubgroupAsymptotics.BinaryThreeQuartetCubicImageSocles
open SemidirectProduct LinearSemidirectCoprimeSocleBounds LinearSemidirectSubgroupKernelChart

abbrev Bits := CubicBinaryCoordinateUniform.Points
abbrev Vector := Bits → ZMod 2
abbrev Plane := Fin 2 → ZMod 2

def linear : CyclicThree →* (Vector ≃ₗ[ZMod 2] Vector) where
  toFun g := {
    toFun := fun v x => v (g⁻¹ • x)
    invFun := fun v x => v (g • x)
    left_inv := by intro v; funext x; simp
    right_inv := by intro v; funext x; simp
    map_add' _ _ := rfl
    map_smul' _ _ := rfl }
  map_one' := by ext v x; simp
  map_mul' g h := by ext v x; simp [mul_inv_rev,mul_smul]

abbrev Model := LinearSemidirectCoprimeSocleBounds.Model linear

def wreathEmbedding : Model →*
    BinaryPlanePermutationWreathCoordinates.Model (R := CyclicThree) (I := CyclicThree) where
  toFun g := ⟨fun c => Multiplicative.ofAdd (fun i => g.left.toAdd (i,c)),⟨fun _ => 1,g.right⟩⟩
  map_one' := by
    apply SemidirectProduct.ext
    · rfl
    · apply PermutationalWreathProduct.ext <;> rfl
  map_mul' g h := by
    apply SemidirectProduct.ext
    · funext c
      apply Multiplicative.toAdd.injective
      funext i
      rfl
    · apply PermutationalWreathProduct.ext
      · funext c
        simp
      · rfl

def pointAction : Model →* Equiv.Perm (Plane × CyclicThree) :=
  BinaryPlanePermutationWreathCoordinates.pointAction.comp wreathEmbedding

def literalAction (e : Plane × CyclicThree ≃ Fin 12) : Model →* Equiv.Perm (Fin 12) :=
  e.permCongrHom.toMonoidHom.comp pointAction

theorem actual_socle_of_surjective (K : Subgroup Model)
    (hsurj : Function.Surjective (projection linear K))
    {Q : Type} [Group Q] (pi : K →* Q) (hpi : Function.Surjective pi) :
    SocleNormalGeneratorBound Q 2 := by
  have hincl : Function.Surjective (Image linear K).subtype := by
    intro c
    obtain ⟨k,hk⟩ := hsurj c
    exact ⟨⟨c,⟨k,hk⟩⟩,rfl⟩
  have hu : UniformSubrepresentationGeneratorBound (imageRepresentation linear K) 2 :=
    UniformSubrepresentationGeneratorBound.comp_of_surjective
      CubicBinaryCoordinateUniform.regular (Image linear K).subtype hincl
      CubicBinaryCoordinateUniform.regular_uniform
  let idMap : Representation.IntertwiningMap
      (imageRepresentation linear K) (imageRepresentation linear K) :=
    { toLinearMap := LinearMap.id
      isIntertwining' _ := rfl }
  have hg : RepresentationGeneratedBy (imageRepresentation linear K) 2 :=
    representationGeneratedBy_of_injective_of_uniform hu idMap (fun _ _ h => h)
  have hc3 : Nat.card CyclicThree = 3 := by
    rw [Nat.card_congr (Multiplicative.toAdd : CyclicThree ≃ ZMod 3),Nat.card_zmod]
  have hcop : Nat.Coprime 2 (Nat.card (Image linear K)) :=
    (show Nat.Coprime 2 (Nat.card CyclicThree) by rw [hc3]; decide).of_dvd_right
      (Image linear K).card_subgroup_dvd_card
  apply LinearSemidirectSubgroupSocles.coprime_socle_of_surjective linear K hcop 2 1 hg ?_ pi hpi
  intro H hH
  letI := hH
  exact CoprimeCyclicQuotientSocles.normalGen_le_one_of_isCyclic H

theorem quotientSocle {n : ℕ} (e : Plane × CyclicThree ≃ Fin 12)
    (lifted : Fin n → Model) (target : Fin n → Equiv.Perm (Fin 12))
    (hbinding : ∀ i, literalAction e (lifted i) = target i)
    (j : Fin n) (hj : (lifted j).right = Multiplicative.ofAdd (1 : ZMod 3))
    (N : Subgroup (Subgroup.closure (Set.range target))) [N.Normal] :
    SocleNormalGeneratorBound (Subgroup.closure (Set.range target) ⧸ N) 2 := by
  let K := Subgroup.closure (Set.range lifted)
  have hsurj : Function.Surjective (projection linear K) := by
    intro c
    have hp : ∃ m : Fin 3, (Multiplicative.ofAdd (1 : ZMod 3))^m.val = c := by
      revert c
      decide +kernel
    obtain ⟨m,hm⟩ := hp
    refine ⟨closureGenerators lifted j ^ m.val,?_⟩
    rw [map_pow]
    change (lifted j).right ^ m.val = c
    rw [hj,hm]
  let f : K →* Equiv.Perm (Fin 12) := (literalAction e).comp K.subtype
  let q := GeneratedLiteralImage.toTop f (closureGenerators lifted) target (Equiv.refl _)
    (closureGenerators_full lifted) hbinding
  have hq : Function.Surjective q := GeneratedLiteralImage.toTop_surjective
    f (closureGenerators lifted) target (Equiv.refl _) (closureGenerators_full lifted) hbinding
  exact actual_socle_of_surjective K hsurj ((QuotientGroup.mk' N).comp q)
    ((QuotientGroup.mk'_surjective N).comp hq)

end SymmetricSubgroupAsymptotics.BinaryThreeQuartetCubicImageSocles
end
