import SymmetricSubgroupAsymptotics.PrimitiveAffineDegreeTwoSixPairCatalogueDispatcher

/-!
# Registry-indexed quotient data for six-pair actions

The selected six-pair witness proves that its emitted normal states exhaust
all literal normal subgroups.  Quotient emitters should therefore attach
their data to those finite states, rather than repeat a dependent definition
on every arbitrary normal subgroup.

This file turns the checked normal registry into a genuinely surjective map
from its finite state index to the type of literal normal subgroups.  A
generic dependent dispatcher then transports any state-indexed payload to
every literal normal.  The payload is deliberately abstract: character,
binary-target, and repeated-head quotient rows all use the same theorem.

Nothing here identifies a literal action with a published catalogue row.
That remains the separate point-relabelled correspondence and 182-row
locator in `PrimitiveAffineDegreeTwoSixPairCatalogueDispatcher`.
-/

set_option autoImplicit false
noncomputable section
open scoped Classical

universe u v

namespace SymmetricSubgroupAsymptotics
namespace Non2UnipotentPrefixFiniteMenu

namespace PrimitiveAffineDegreeTwoSixPairCheckedLiteralAction

variable (D : PrimitiveAffineDegreeTwoSixPairCheckedLiteralAction)

/-- The block chart already contained in the checked literal pair frame,
with its binary coordinate written as `Fin 2` for the B6 interface. -/
def blockChart : Fin 12 ≃ Fin 6 × Fin 2 :=
  D.checked.pairFrame.frame.symm.trans
    (Equiv.prodCongr (Equiv.refl (Fin 6))
      (ZMod.finEquiv 2).symm.toEquiv)

@[simp] theorem blockChart_fst (x : Fin 12) :
    (D.blockChart x).1 = (D.checked.pairFrame.frame.symm x).1 :=
  rfl

/-- The checked pair frame proves preservation of its literal block chart. -/
theorem blockChart_preserves :
    ∀ u ∈ D.G, ∀ x y : Fin 12,
      (D.blockChart x).1 = (D.blockChart y).1 →
        (D.blockChart (u x)).1 = (D.blockChart (u y)).1 := by
  intro u hu x y hxy
  let g : D.G := ⟨u, hu⟩
  have hx := D.checked.pairFrame.intertwine g
    (D.checked.pairFrame.frame.symm x)
  have hy := D.checked.pairFrame.intertwine g
    (D.checked.pairFrame.frame.symm y)
  rw [D.blockChart_fst] at hxy ⊢
  calc
    (D.checked.pairFrame.frame.symm (u x)).1 =
        D.checked.pairFrame.top g
          (D.checked.pairFrame.frame.symm x).1 := by
      simpa only [D.checked.pairFrame.frame.apply_symm_apply] using hx
    _ = D.checked.pairFrame.top g
          (D.checked.pairFrame.frame.symm y).1 :=
      congrArg (D.checked.pairFrame.top g) hxy
    _ = (D.checked.pairFrame.frame.symm (u y)).1 := by
      simpa only [D.checked.pairFrame.frame.apply_symm_apply] using hy.symm

/-- The literal normal subgroup generated by one emitted registry state. -/
def normalState (i : Fin D.normalCount) : Subgroup D.G :=
  Subgroup.closure (Set.range (D.stateGenerators i))

/-- Every emitted state is normal because the selected witness checks its
conjugation words against a full ambient generating family. -/
noncomputable instance normalState_normal (i : Fin D.normalCount) :
    (D.normalState i).Normal := by
  unfold normalState
  exact D.checked.normalRegistry.toRegistry.normal i

/-- The normal subgroup, with its checked normality proof, named by one
finite registry state. -/
def normalStateIndex (i : Fin D.normalCount) :
    {N : Subgroup D.G // N.Normal} :=
  ⟨D.normalState i, inferInstance⟩

/-- The finite registry really covers every literal normal subgroup.  This
is a consequence of the checked conjugacy cover and normal-join words, not
an observed normal-list length or an asserted producer flag. -/
theorem normalStateIndex_surjective :
    Function.Surjective D.normalStateIndex := by
  intro N
  letI : N.1.Normal := N.2
  obtain ⟨i, hi⟩ := D.checked.normal_complete N.1
  refine ⟨i, Subtype.ext ?_⟩
  simpa only [normalState] using hi

/-- A fixed finite registry state for each literal normal subgroup.  This
choice is made only after surjectivity has been proved in Lean. -/
noncomputable def normalStateSection :
    {N : Subgroup D.G // N.Normal} → Fin D.normalCount :=
  Function.surjInv D.normalStateIndex_surjective

/-- The chosen registry state denotes exactly the requested literal normal
subgroup. -/
theorem normalStateSection_rightInverse
    (N : {N : Subgroup D.G // N.Normal}) :
    D.normalStateIndex (D.normalStateSection N) = N :=
  Function.rightInverse_surjInv D.normalStateIndex_surjective N

end PrimitiveAffineDegreeTwoSixPairCheckedLiteralAction

/-- A dependent payload checked only on the finitely emitted normal states
of one literal action.  No quotient shape is built into the structure. -/
structure PrimitiveAffineDegreeTwoSixPairNormalStateFamily
    (D : PrimitiveAffineDegreeTwoSixPairCheckedLiteralAction)
    (Payload : {N : Subgroup D.G // N.Normal} → Type u) : Type (max 1 u) where
  state : ∀ i : Fin D.normalCount, Payload (D.normalStateIndex i)

namespace PrimitiveAffineDegreeTwoSixPairNormalStateFamily

variable {D : PrimitiveAffineDegreeTwoSixPairCheckedLiteralAction}
  {Payload : {N : Subgroup D.G // N.Normal} → Type u}
  (F : PrimitiveAffineDegreeTwoSixPairNormalStateFamily D Payload)

/-- Transport the payload on the chosen finite state to an arbitrary literal
normal subgroup.  The only cast is along the equality supplied by the
kernel-checked normal registry. -/
noncomputable def dispatch (N : {N : Subgroup D.G // N.Normal}) : Payload N :=
  cast (congrArg Payload (D.normalStateSection_rightInverse N))
    (F.state (D.normalStateSection N))

include F in
/-- Every arbitrary literal normal subgroup receives the emitted payload. -/
theorem nonempty_payload (N : {N : Subgroup D.G // N.Normal}) :
    Nonempty (Payload N) :=
  ⟨dispatch F N⟩

/-- Change the payload attached to each finite normal state before applying
the common dispatcher. -/
def map
    {Target : {N : Subgroup D.G // N.Normal} → Type v}
    (f : ∀ N, Payload N → Target N) :
    PrimitiveAffineDegreeTwoSixPairNormalStateFamily D Target where
  state i := f (D.normalStateIndex i) (F.state i)

end PrimitiveAffineDegreeTwoSixPairNormalStateFamily

/-- The specialization consumed by the B6 action certificate.  Individual
states may use any constructor of `PreE7B6QuotientCertificate`, so the same
finite family covers character, binary-target, and repeated-head rows. -/
abbrev PrimitiveAffineDegreeTwoSixPairQuotientCertificateStateFamily
    (D : PrimitiveAffineDegreeTwoSixPairCheckedLiteralAction) :=
  PrimitiveAffineDegreeTwoSixPairNormalStateFamily D
    (fun N => PreE7B6QuotientCertificate (D.G ⧸ N.1))

namespace PrimitiveAffineDegreeTwoSixPairQuotientCertificateStateFamily

variable {D : PrimitiveAffineDegreeTwoSixPairCheckedLiteralAction}
  (F : PrimitiveAffineDegreeTwoSixPairQuotientCertificateStateFamily D)

/-- Install the finite quotient rows on every literal normal quotient. -/
noncomputable def quotient
    (N : {N : Subgroup D.G // N.Normal}) :
    PreE7B6QuotientCertificate (D.G ⧸ N.1) :=
  PrimitiveAffineDegreeTwoSixPairNormalStateFamily.dispatch F N

end PrimitiveAffineDegreeTwoSixPairQuotientCertificateStateFamily

/-- One fully checked literal action together with one quotient certificate
on each of its finite normal-registry states.  The varying action and normal
counts stay existentially packaged, so a later finite table can store rows
of different shapes uniformly. -/
structure PrimitiveAffineDegreeTwoSixPairCheckedLiteralQuotientAction where
  literal : PrimitiveAffineDegreeTwoSixPairCheckedLiteralAction
  certificates :
    PrimitiveAffineDegreeTwoSixPairQuotientCertificateStateFamily literal

namespace PrimitiveAffineDegreeTwoSixPairCheckedLiteralQuotientAction

variable (D : PrimitiveAffineDegreeTwoSixPairCheckedLiteralQuotientAction)

/-- Assemble the B6 certificate on the same literal permutation subgroup.
The arbitrary-normal quotient field is supplied only through the checked
normal-state dispatcher. -/
noncomputable def toB6ActionCertificate :
    PreE7B6ActionCertificate D.literal.G where
  blockChart := D.literal.blockChart
  preserves := D.literal.blockChart_preserves
  quotient := D.certificates.quotient

end PrimitiveAffineDegreeTwoSixPairCheckedLiteralQuotientAction

end Non2UnipotentPrefixFiniteMenu
end SymmetricSubgroupAsymptotics

end
