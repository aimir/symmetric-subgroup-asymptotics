import SymmetricSubgroupAsymptotics.CFSGIntravariantFrattini
import Mathlib.GroupTheory.Sylow
import Mathlib.GroupTheory.Solvable

/-! The elementary Sylow-normalizer part of soluble generation. The
classification-dependent simple-group task is isolated as actual generation
by two conjugate Sylow subgroups, together with solvability of the actual
normalizer. Intravariance and self-normalization are proved here. -/
set_option autoImplicit false
noncomputable section
open scoped Pointwise

namespace SymmetricSubgroupAsymptotics.CFSGReduction

theorem normalizer_intravariant {G : Type*} [Group G]
    (H : Subgroup G) (hH : Intravariant H) : Intravariant (Subgroup.normalizer (H : Set G)) := by
  intro a
  obtain ⟨g, hg⟩ := hH a
  refine ⟨g, ?_⟩
  rw [Subgroup.map_equiv_normalizer_eq, Subgroup.map_equiv_normalizer_eq, hg]

/-- Sylow conjugacy proves invariance of the original conjugacy class. -/
theorem sylow_intravariant {G : Type*} [Group G] {p : ℕ} [Fact p.Prime]
    [Finite (Sylow p G)] (P : Sylow p G) : Intravariant (P : Subgroup G) := by
  intro a
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq G P (a • P)
  refine ⟨g, ?_⟩
  have h := congrArg (fun Q : Sylow p G => (Q : Subgroup G)) hg
  simpa only [Sylow.smul_def, Sylow.pointwise_smul_def,
    Subgroup.pointwise_smul_def] using h.symm

theorem sylow_normalizer_intravariant {G : Type*} [Group G] {p : ℕ}
    [Fact p.Prime] [Finite (Sylow p G)] (P : Sylow p G) :
    Intravariant (Subgroup.normalizer (P : Set G)) :=
  normalizer_intravariant _ (sylow_intravariant P)

theorem sylow_normalizer_self_normalizing {G : Type*} [Group G] {p : ℕ}
    [Fact p.Prime] [Finite (Sylow p G)] (P : Sylow p G) :
    Subgroup.normalizer ((Subgroup.normalizer (P : Set G)) : Set G) = Subgroup.normalizer (P : Set G) :=
  Sylow.normalizer_normalizer P

/-- Two conjugate subgroups generating the group are contained in the
group generated by the first subgroup and the conjugating element. -/
theorem one_extra_generator_of_two_conjugates {G : Type*} [Group G]
    (H : Subgroup G) (g : G)
    (hgen : Subgroup.closure ((H : Set G) ∪ H.map (MulAut.conj g).toMonoidHom) = ⊤) :
    Subgroup.closure (({g} : Set G) ∪ H) = ⊤ := by
  let K := Subgroup.closure (({g} : Set G) ∪ H)
  have hg : g ∈ K := Subgroup.subset_closure (Or.inl rfl)
  have hH : H ≤ K := fun _ hx => Subgroup.subset_closure (Or.inr hx)
  apply top_unique
  rw [← hgen]
  apply (Subgroup.closure_le K).mpr
  intro x hx
  rcases hx with hx | ⟨y, hy, rfl⟩
  · exact hH hx
  · exact K.mul_mem (K.mul_mem hg (hH hy)) (K.inv_mem hg)

/-- The normalizer, its invariance and its self-normalization all belong
to the SAME actual Sylow subgroup. No simple-group classification is used. -/
theorem soluble_generation_from_two_sylows {G : Type*} [Group G]
    {p : ℕ} [Fact p.Prime] [Finite (Sylow p G)]
    (P : Sylow p G) (g : G) (hsol : IsSolvable (Subgroup.normalizer (P : Set G)))
    (hgen : Subgroup.closure ((P : Set G) ∪
      (P : Subgroup G).map (MulAut.conj g).toMonoidHom) = ⊤) :
    ∃ H : Subgroup G, IsSolvable H ∧ Intravariant H ∧ Subgroup.normalizer (H : Set G) = H ∧
      Subgroup.closure (({g} : Set G) ∪ H) = ⊤ := by
  refine ⟨Subgroup.normalizer (P : Set G), hsol, sylow_normalizer_intravariant P,
    sylow_normalizer_self_normalizing P, ?_⟩
  apply one_extra_generator_of_two_conjugates
  apply top_unique
  rw [← hgen]
  apply Subgroup.closure_mono
  apply Set.union_subset_union
  · exact Subgroup.le_normalizer
  · exact Subgroup.map_mono Subgroup.le_normalizer

end SymmetricSubgroupAsymptotics.CFSGReduction
