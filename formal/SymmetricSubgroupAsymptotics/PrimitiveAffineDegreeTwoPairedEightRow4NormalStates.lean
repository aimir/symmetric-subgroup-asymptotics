def normalMask (i : Fin 7) (x : Fin 96) : Bool :=
  ((#[1, 77371252455336267181735937, 18031990695559169, 105553116528641, 77371252473473810995929149, 87887672180456574807895999, 79228162514264337593543950335] : Array ℕ)[i.val]!).testBit x.val

private theorem mask_checked0 (x : Fin 96) :
    normalMask 0 x = true ↔ ∃ j, S0.certificate.rows j = x := by
  decide +kernel +revert

