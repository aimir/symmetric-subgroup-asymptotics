def normalMask (i : Fin 9) (x : Fin 48) : Bool :=
  ((#[1, 33, 65561, 137439674425, 18790823965, 23307075039, 193990252001341, 87498999282205, 281474976710655] : Array ℕ)[i.val]!).testBit x.val

private theorem mask_checked0 (x : Fin 48) :
    normalMask 0 x = true ↔ ∃ j, S0.certificate.rows j = x := by
  decide +kernel +revert

