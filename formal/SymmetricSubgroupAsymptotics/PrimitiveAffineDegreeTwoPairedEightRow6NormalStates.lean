theorem normalMask_mem (i : Fin 9) (x : Source) :
    normalMask i x.index = true ↔ x ∈ state i := by
  fin_cases i
  · exact (mask_checked0 x.index).trans (binaryNormalRow_mem_iff S0.certificate x).symm
  · exact (mask_checked1 x.index).trans (binaryNormalRow_mem_iff S1.certificate x).symm
  · exact (mask_checked2 x.index).trans (binaryNormalRow_mem_iff S2.certificate x).symm
  · exact (mask_checked3 x.index).trans (binaryNormalRow_mem_iff S3.certificate x).symm
  · exact (mask_checked4 x.index).trans (binaryNormalRow_mem_iff S4.certificate x).symm
  · exact (mask_checked5 x.index).trans (binaryNormalRow_mem_iff S5.certificate x).symm
  · exact (mask_checked6 x.index).trans (binaryNormalRow_mem_iff S6.certificate x).symm
  · exact (mask_checked7 x.index).trans (binaryNormalRow_mem_iff S7.certificate x).symm
  · exact (mask_checked8 x.index).trans (binaryNormalRow_mem_iff S8.certificate x).symm

abbrev MaskLE (i j : Fin 9) : Prop :=
  ∀ x : Fin 48, normalMask i x = true → normalMask j x = true

theorem state_le_iff_maskLE (i j : Fin 9) : state i ≤ state j ↔ MaskLE i j := by
  constructor
  · intro h x hx
    exact (normalMask_mem j (⟨x⟩ : Source)).mpr
      (h ((normalMask_mem i (⟨x⟩ : Source)).mp hx))
  · intro h x hx
    exact (normalMask_mem j x).mp (h x.index ((normalMask_mem i x).mpr hx))

theorem state_injective : Function.Injective state := by
  have h : ∀ i j : Fin 9, MaskLE i j → MaskLE j i → i = j := by
    decide +kernel
  intro i j hij
  exact h i j ((state_le_iff_maskLE i j).mp hij.le)
    ((state_le_iff_maskLE j i).mp hij.ge)

