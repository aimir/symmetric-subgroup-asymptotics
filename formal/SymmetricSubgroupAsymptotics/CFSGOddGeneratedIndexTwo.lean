import Mathlib.GroupTheory.IndexNormal
import Mathlib.GroupTheory.QuotientGroup.Basic
import Mathlib.Algebra.Group.Subgroup.Pointwise

/-! A subgroup generated by odd-order torsion, of relative index at
most two in a normal subgroup, is normal in the full group. The proof
uses the actual index-two quotient, without a characteristic-subgroup
recognition assumption. -/
set_option autoImplicit false
noncomputable section
open scoped Pointwise
namespace SymmetricSubgroupAsymptotics.CFSGOddGeneratedIndexTwo
variable {G : Type*} [Group G] [Finite G]

theorem normal_of_index_le_two (R : Subgroup G) (hi : R.index ≤ 2) : R.Normal := by
  have hn : R.index ≠ 0 := Subgroup.index_ne_zero_of_finite
  rcases (show R.index = 1 ∨ R.index = 2 by omega) with h | h
  · exact Subgroup.normal_of_index_eq_one h
  · exact Subgroup.normal_of_index_eq_two h

theorem mem_of_odd_power_eq_one (R : Subgroup G) (hi : R.index ≤ 2)
    (g : G) (m : ℕ) (hm : Odd m) (hg : g ^ m = 1) : g ∈ R := by
  letI : R.Normal := normal_of_index_le_two R hi
  let f := QuotientGroup.mk' R
  have hdiv : Nat.card (G ⧸ R) ∣ 2 := by
    change R.index ∣ 2
    have hn : R.index ≠ 0 := Subgroup.index_ne_zero_of_finite
    rcases (show R.index = 1 ∨ R.index = 2 by omega) with h | h <;> rw [h] <;> decide
  have hpow : (f g) ^ m = 1 := by rw [← map_pow, hg, map_one]
  have ho : orderOf (f g) = 1 := Nat.eq_one_of_dvd_coprimes
    (Nat.coprime_two_right.mpr hm) (orderOf_dvd_of_pow_eq_one hpow)
    ((orderOf_dvd_natCard (f g)).trans hdiv)
  exact (QuotientGroup.eq_one_iff _).mp (orderOf_eq_one_iff.mp ho)

theorem normal_of_generated_odd_torsion (R H : Subgroup G) [H.Normal]
    (hRH : R ≤ H) (hi : (R.subgroupOf H).index ≤ 2)
    (S : Set G) (hS : R = Subgroup.closure S)
    (ht : ∀ x ∈ S, ∃ m : ℕ, Odd m ∧ x ^ m = 1) : R.Normal := by
  constructor
  intro x hx g
  have hgen : Subgroup.closure S ≤ R.comap (MulAut.conj g).toMonoidHom := by
    apply (Subgroup.closure_le _).mpr
    intro y hy
    obtain ⟨m, hm, hmy⟩ := ht y hy
    have hyR : y ∈ R := by rw [hS]; exact Subgroup.subset_closure hy
    have hcH : (MulAut.conj g) y ∈ H := (inferInstance : H.Normal).conj_mem y (hRH hyR) g
    have hc : (⟨(MulAut.conj g) y, hcH⟩ : H) ^ m = 1 := by
      apply Subtype.ext
      change ((MulAut.conj g) y) ^ m = 1
      rw [← map_pow, hmy, map_one]
    exact mem_of_odd_power_eq_one (R.subgroupOf H) hi ⟨(MulAut.conj g) y, hcH⟩ m hm hc
  rw [← hS] at hgen
  exact hgen hx

end SymmetricSubgroupAsymptotics.CFSGOddGeneratedIndexTwo
