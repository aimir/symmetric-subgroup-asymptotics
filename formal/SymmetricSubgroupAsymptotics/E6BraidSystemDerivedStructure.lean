import SymmetricSubgroupAsymptotics.E6BraidSystemDerivedWords

/-! Structural facts about the derived subgroup of a group generated by
an actual E6 involution system. These are ordinary group-theoretic facts,
not a simplicity, finite-order, or whole ambient centralizer assertion. -/
set_option autoImplicit false
noncomputable section
namespace SymmetricSubgroupAsymptotics.E6BraidSystemDerivedStructure
open InvolutionBraidPresentation E6BraidSystemDerivedWords
open CFSGYE6SelectedWords (adjacent)

private structure Relations {H : Type*} [Group H] (q : Fin 6 → H) : Prop where
  zero : q 0=1
  one_cube : q 1^3=1
  two_square : q 2^2=1
  three_cube : q 3^3=1
  four_square : q 4^2=1
  five_cube : q 5^3=1
  one_two_cube : ((q 1)⁻¹*q 2)^3=1
  three_four_cube : ((q 3)⁻¹*q 4)^3=1
  one_three_square : ((q 1)⁻¹*q 3)^2=1
  one_five_square : ((q 1)⁻¹*q 5)^2=1
  one_four_square : ((q 1)⁻¹*q 4)^2=1
  two_three_square : ((q 2)⁻¹*q 3)^2=1
  two_five_square : ((q 2)⁻¹*q 5)^2=1

private theorem Relations.map {H K : Type*} [Group H] [Group K]
    {q : Fin 6 → H} (h : Relations q) (f : H →* K) : Relations (fun i => f (q i)) where
  zero := by rw [h.zero,map_one]
  one_cube := by rw [←map_pow,h.one_cube,map_one]
  two_square := by rw [←map_pow,h.two_square,map_one]
  three_cube := by rw [←map_pow,h.three_cube,map_one]
  four_square := by rw [←map_pow,h.four_square,map_one]
  five_cube := by rw [←map_pow,h.five_cube,map_one]
  one_two_cube := by rw [←map_inv,←map_mul,←map_pow,h.one_two_cube,map_one]
  three_four_cube := by rw [←map_inv,←map_mul,←map_pow,h.three_four_cube,map_one]
  one_three_square := by rw [←map_inv,←map_mul,←map_pow,h.one_three_square,map_one]
  one_five_square := by rw [←map_inv,←map_mul,←map_pow,h.one_five_square,map_one]
  one_four_square := by rw [←map_inv,←map_mul,←map_pow,h.one_four_square,map_one]
  two_three_square := by rw [←map_inv,←map_mul,←map_pow,h.two_three_square,map_one]
  two_five_square := by rw [←map_inv,←map_mul,←map_pow,h.two_five_square,map_one]

private theorem eq_one_of_square_cube {H : Type*} [Group H] (x : H)
    (h2 : x^2=1) (h3 : x^3=1) : x=1 := by
  have h : x^2*x=1 := by simpa only [pow_succ] using h3
  simpa only [h2,one_mul] using h

private theorem left_square {H : Type*} [CommGroup H] (x y : H)
    (hy : y^2=1) (hxy : (x⁻¹*y)^2=1) : x^2=1 := by
  rw [mul_pow,inv_pow,hy,mul_one] at hxy
  exact inv_eq_one.mp hxy

private theorem Relations.comm_trivial {H : Type*} [CommGroup H]
    {q : Fin 6 → H} (h : Relations q) : ∀ i, q i=1 := by
  have h1 : q 1=1 := eq_one_of_square_cube _
    (left_square _ _ h.four_square h.one_four_square) h.one_cube
  have h3 : q 3=1 := eq_one_of_square_cube _
    (by
      have hh := h.two_three_square
      rw [mul_pow,inv_pow,h.two_square,inv_one,one_mul] at hh
      exact hh) h.three_cube
  have h5 : q 5=1 := eq_one_of_square_cube _
    (by
      have hh := h.two_five_square
      rw [mul_pow,inv_pow,h.two_square,inv_one,one_mul] at hh
      exact hh) h.five_cube
  have h2 : q 2=1 := eq_one_of_square_cube _ h.two_square (by
    simpa only [h1,inv_one,one_mul] using h.one_two_cube)
  have h4 : q 4=1 := eq_one_of_square_cube _ h.four_square (by
    simpa only [h3,inv_one,one_mul] using h.three_four_cube)
  intro i
  fin_cases i
  · exact h.zero
  · exact h1
  · exact h2
  · exact h3
  · exact h4
  · exact h5

private theorem Relations.anchor_trivial {H : Type*} [Group H]
    {q : Fin 6 → H} (h : Relations q) (ha : (q 1)⁻¹*q 2=1) : ∀ i, q i=1 := by
  have h12 : q 1=q 2 := inv_mul_eq_one.mp ha
  have h1 : q 1=1 := eq_one_of_square_cube _ (h12.symm ▸ h.two_square) h.one_cube
  have h2 : q 2=1 := h12.symm.trans h1
  have h3 : q 3=1 := eq_one_of_square_cube _
    (by simpa only [h1,inv_one,one_mul] using h.one_three_square) h.three_cube
  have h5 : q 5=1 := eq_one_of_square_cube _
    (by simpa only [h1,inv_one,one_mul] using h.one_five_square) h.five_cube
  have h4 : q 4=1 := eq_one_of_square_cube _ h.four_square
    (by simpa only [h3,inv_one,one_mul] using h.three_four_cube)
  intro i
  fin_cases i
  · exact h.zero
  · exact h1
  · exact h2
  · exact h3
  · exact h4
  · exact h5

variable {G : Type*} [Group G] (S : System adjacent G)

/-- The five actual even products, with a redundant identity at index0. -/
def evenProduct (i : Fin 6) : commutator G :=
  ⟨S.generator 0*S.generator i,by
    rw [←Abelianization.ker_of G]
    change Abelianization.of (S.generator 0*S.generator i)=1
    rw [map_mul,abelianization_generators_equal S i,←map_mul,S.square,map_one]⟩

private theorem evenProduct_ratio (i j : Fin 6) :
    ((evenProduct S i)⁻¹*evenProduct S j).val=S.generator i*S.generator j := by
  change (S.generator 0*S.generator i)⁻¹*(S.generator 0*S.generator j)=_
  rw [mul_inv_rev]
  have hi : (S.generator i)⁻¹=S.generator i := inv_eq_of_mul_eq_one_right (S.square i)
  rw [hi]
  group

private theorem cube_of_braid {K : Type*} [Group K] (x y : K)
    (hx : x*x=1) (hy : y*y=1) (hxy : x*y*x=y*x*y) : (x*y)^3=1 := by
  calc
    (x*y)^3=(x*y*x)*(y*x*y) := by simp only [pow_succ,pow_zero,one_mul,mul_assoc]
    _=(y*x*y)*(y*x*y) := by rw [hxy]
    _=y*x*(y*y)*x*y := by group
    _=y*(x*x)*y := by rw [hy]; group
    _=1 := by rw [hx,mul_one,hy]

private theorem pair_square (i j : Fin 6) (h : adjacent i j=false) :
    (S.generator i*S.generator j)^2=1 := by
  rw [pow_two]
  calc
    _=S.generator i*(S.generator j*S.generator i)*S.generator j := by group
    _=S.generator i*(S.generator i*S.generator j)*S.generator j := by rw [S.commute i j h]
    _=(S.generator i*S.generator i)*(S.generator j*S.generator j) := by group
    _=1 := by rw [S.square,S.square,mul_one]

private theorem evenProduct_relations : Relations (evenProduct S) where
  zero := Subtype.ext (S.square 0)
  one_cube := Subtype.ext (cube_of_braid _ _ (S.square 0) (S.square 1) (S.braid 0 1 rfl))
  two_square := Subtype.ext (pair_square S 0 2 rfl)
  three_cube := Subtype.ext (cube_of_braid _ _ (S.square 0) (S.square 3) (S.braid 0 3 rfl))
  four_square := Subtype.ext (pair_square S 0 4 rfl)
  five_cube := Subtype.ext (cube_of_braid _ _ (S.square 0) (S.square 5) (S.braid 0 5 rfl))
  one_two_cube := by
    apply Subtype.ext
    change (((evenProduct S 1)⁻¹*evenProduct S 2).val)^3=1
    rw [evenProduct_ratio]
    exact cube_of_braid _ _ (S.square 1) (S.square 2) (S.braid 1 2 rfl)
  three_four_cube := by
    apply Subtype.ext
    change (((evenProduct S 3)⁻¹*evenProduct S 4).val)^3=1
    rw [evenProduct_ratio]
    exact cube_of_braid _ _ (S.square 3) (S.square 4) (S.braid 3 4 rfl)
  one_three_square := by apply Subtype.ext; change (((evenProduct S 1)⁻¹*evenProduct S 3).val)^2=1; rw [evenProduct_ratio]; exact pair_square S 1 3 rfl
  one_five_square := by apply Subtype.ext; change (((evenProduct S 1)⁻¹*evenProduct S 5).val)^2=1; rw [evenProduct_ratio]; exact pair_square S 1 5 rfl
  one_four_square := by apply Subtype.ext; change (((evenProduct S 1)⁻¹*evenProduct S 4).val)^2=1; rw [evenProduct_ratio]; exact pair_square S 1 4 rfl
  two_three_square := by apply Subtype.ext; change (((evenProduct S 2)⁻¹*evenProduct S 3).val)^2=1; rw [evenProduct_ratio]; exact pair_square S 2 3 rfl
  two_five_square := by apply Subtype.ext; change (((evenProduct S 2)⁻¹*evenProduct S 5).val)^2=1; rw [evenProduct_ratio]; exact pair_square S 2 5 rfl

/-- Whole generation is required only of this six-involution source itself.
Later the source can be the literal subgroup generated by the six actual
centralizer reflections; no generation of the full centralizer is assumed. -/
theorem evenProduct_generates
    (hgen : Subgroup.closure (Set.range S.generator)=⊤) :
    Subgroup.closure (Set.range (evenProduct S))=⊤ := by
  have hraw : Subgroup.closure (Set.range (fun i => S.generator 0*S.generator i))=commutator G := by
    apply le_antisymm
    · apply (Subgroup.closure_le _).mpr
      rintro _ ⟨i,rfl⟩
      exact (evenProduct S i).property
    · rw [CFSGGeneration.commutator_eq_involution_even_products S.generator 0 hgen S.square
        (abelianization_generators_equal S)]
      apply (Subgroup.closure_le _).mpr
      rintro _ ⟨i,rfl⟩
      exact Subgroup.subset_closure ⟨i.val,rfl⟩
  have hm : (Subgroup.closure (Set.range (evenProduct S))).map (commutator G).subtype=
      commutator G := by
    have him : (commutator G).subtype '' Set.range (evenProduct S)=
        Set.range (fun i => S.generator 0*S.generator i) := by
      ext x
      constructor
      · rintro ⟨y,⟨i,rfl⟩,rfl⟩
        exact ⟨i,rfl⟩
      · rintro ⟨i,rfl⟩
        exact ⟨evenProduct S i,⟨i,rfl⟩,rfl⟩
    rw [MonoidHom.map_closure,him]
    exact hraw
  apply top_unique
  intro x hx
  have hv : x.val∈(Subgroup.closure (Set.range (evenProduct S))).map (commutator G).subtype := by
    rw [hm]
    exact x.property
  rcases hv with ⟨y,hy,he⟩
  have hxy : y=x := Subtype.ext he
  simpa only [hxy] using hy

/-- The derived group of any generated E6 system is perfect. -/
theorem derived_perfect (hgen : Subgroup.closure (Set.range S.generator)=⊤) :
    commutator (commutator G)=⊤ := by
  have hq : ∀ i, Abelianization.of (evenProduct S i)=1 :=
    ((evenProduct_relations S).map Abelianization.of).comm_trivial
  have he : (Abelianization.of : commutator G →* Abelianization (commutator G))=1 := by
    apply MonoidHom.eq_of_eqOn_dense (evenProduct_generates S hgen)
    rintro _ ⟨i,rfl⟩
    exact hq i
  rw [←Abelianization.ker_of (commutator G),he]
  exact MonoidHom.ker_one

/-- Killing the anchored selected cube kills EVERY element of the actual
derived E6 image. This is a whole homomorphism statement, not an assertion
that a normal closure is an ordinary generating tuple. -/
theorem anchor_hom_trivial (hgen : Subgroup.closure (Set.range S.generator)=⊤)
    {K : Type*} [Group K] (f : commutator G →* K) (ha : f (a S)=1) : f=1 := by
  have hanchor : (evenProduct S 1)⁻¹*evenProduct S 2=a S := by
    apply Subtype.ext
    rw [evenProduct_ratio]
    exact (E6BraidSystemWordAlgebra.raw_a S).symm
  have hh : (f (evenProduct S 1))⁻¹*f (evenProduct S 2)=1 := by
    rw [←map_inv,←map_mul,hanchor]
    exact ha
  have hq : ∀ i, f (evenProduct S i)=1 :=
    ((evenProduct_relations S).map f).anchor_trivial hh
  apply MonoidHom.eq_of_eqOn_dense (evenProduct_generates S hgen)
  rintro _ ⟨i,rfl⟩
  exact hq i

end SymmetricSubgroupAsymptotics.E6BraidSystemDerivedStructure
