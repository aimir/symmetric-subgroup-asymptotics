import Mathlib.GroupTheory.Commutator.Basic

/-! A subgroup generated by a normalized factor and a commuting
factor has its entire commutator in the first factor. The displayed
factorization need not be unique, and the commuting factor need not
itself be contained in the larger subgroup. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
namespace SymmetricSubgroupAsymptotics.CFSGCommutatorOfCommutativeFactor
variable {G : Type*} [Group G]

theorem commutator_map_le_of_factor (L J D : Subgroup G) (hJL : J ≤ L)
    (hDN : D ⊓ L ≤ Subgroup.normalizer (J : Set G))
    (hcomm : ∀ d ∈ D, ∀ e ∈ D, d*e = e*d)
    (hfactor : ∀ g ∈ L, ∃ j ∈ J, ∃ d ∈ D, g = j*d) :
    (commutator L).map L.subtype ≤ J := by
  have hDL (g : G) (hg : g ∈ L) (j : G) (hj : j ∈ J)
      (d : G) (he : g = j*d) : d ∈ L := by
    have hh := L.mul_mem (L.inv_mem (hJL hj)) hg
    rw [he,inv_mul_cancel_left] at hh
    exact hh
  have hLN : L ≤ Subgroup.normalizer (J : Set G) := by
    intro g hg
    obtain ⟨j,hj,d,hd,he⟩ := hfactor g hg
    rw [he]
    exact (Subgroup.normalizer (J : Set G)).mul_mem
      (J.le_normalizer hj) (hDN ⟨hd,hDL g hg j hj d he⟩)
  letI : (J.subgroupOf L).Normal :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hJL).mpr hLN
  let DL := (D ⊓ L).subgroupOf L
  have hsup : J.subgroupOf L ⊔ DL = ⊤ := by
    apply top_unique
    intro g _
    obtain ⟨j,hj,d,hd,he⟩ := hfactor g.val g.property
    let jL : L := ⟨j,hJL hj⟩
    let dL : L := ⟨d,hDL g.val g.property j hj d he⟩
    have heL : g = jL*dL := Subtype.ext he
    rw [heL]
    apply (J.subgroupOf L ⊔ DL).mul_mem
    · exact (show J.subgroupOf L ≤ J.subgroupOf L ⊔ DL from le_sup_left)
        (show jL ∈ J.subgroupOf L from hj)
    · exact (show DL ≤ J.subgroupOf L ⊔ DL from le_sup_right)
        (show dL ∈ DL from ⟨hd,dL.property⟩)
  have hDLcomm : IsMulCommutative DL := by
    refine ⟨⟨?_⟩⟩
    intro a b
    apply Subtype.ext
    apply Subtype.ext
    exact hcomm a.val.val a.property.1 b.val.val b.property.1
  have hder : commutator L ≤ J.subgroupOf L :=
    Subgroup.Normal.commutator_le_of_self_sup_commutative_eq_top hsup hDLcomm
  rintro _ ⟨g,hg,rfl⟩
  exact hder hg

end SymmetricSubgroupAsymptotics.CFSGCommutatorOfCommutativeFactor
