def inputActual (i : Fin 300) : Offsets →ₗ[ZMod 2] ZMod 2 :=
  if h : i.val < 48 then
    (binaryRowFunctional (binaryVectorOfMask 16 (stateAnnihilator ⟨i.val % 8, by omega⟩))).comp
      (squareMap ⟨i.val / 8, by omega⟩)
  else
    (binaryRowFunctional (binaryVectorOfMask 16 (radicalAnnihilator ⟨(i.val - 48) % 12, by omega⟩))).comp
      (relatorMap ⟨(i.val - 48) / 12, by omega⟩)
def targetActual (j : Fin 72) : Offsets →ₗ[ZMod 2] ZMod 2 :=
  (binaryRowFunctional (binaryVectorOfMask 16 (radicalAnnihilator ⟨j.val % 12, by omega⟩))).comp
    (squareMap ⟨j.val / 12, by omega⟩)


