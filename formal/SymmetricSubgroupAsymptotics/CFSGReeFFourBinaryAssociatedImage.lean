import SymmetricSubgroupAsymptotics.CFSGReeFFourFixedPositiveAssociatedMiddle
import SymmetricSubgroupAsymptotics.CFSGReeFFourBinaryMiddleGenerators
import SymmetricSubgroupAsymptotics.FiniteCyclicNormalizerProduct

/-! The actual binary middle-parabolic associated image is generated by
the images of the actual four-cycle and order-five word. Their literal
relations make this image soluble of cardinal at most twenty, without
recognizing an abstract Suzuki or Levi group. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
open scoped Classical
namespace SymmetricSubgroupAsymptotics.CFSGReeFFourBinaryAssociatedImage
open CFSGReeFFourFixedPositiveAssociatedMiddle CFSGReeFFourBinaryMiddleGenerators
open CFSGReeFFourMiddleAssociatedQuotient CFSGReeFFourMiddleGradedKernel
open CFSGReeFFourMiddleParabolicFlag CFSGReeFFourMiddleDerivedFiveWord
open CFSGReeFFourFixedModelEquivalence CFSGReeFFourFixedPositiveFamilies
open CFSGReeFFourMiddleFixedSubgroup CFSGReeFFourRelativePositiveSubgroups
open CFSGReeFFourFixedBruhatCover CFSGReeFFourFixedAmbientHom
open CFSGGradedMatrixAssociatedUnitHom
private instance fixedFinite : Finite (originalModelFixed 0) :=
  Finite.of_injective (fixedAmbientHom 0) (fixedAmbientHom_injective 0)
private abbrev P := middleParabolic 0
private abbrev Image := (middleAssociatedHom 0).range
private abbrev f : P →* Image := (middleAssociatedHom 0).rangeRestrict
private instance imageFinite : Finite Image :=
  Finite.of_surjective f (middleAssociatedHom 0).rangeRestrict_surjective

def middleWeylInParabolic : P :=
  ⟨middleFixedWeyl 0,(show Subgroup.closure {middleFixedWeyl 0} ≤ P from le_sup_right)
    (Subgroup.subset_closure (Set.mem_singleton_iff.mpr rfl))⟩

def imageFourCycle : Image := f (fourCycleInParabolic 0)
def imageFiveWord : Image := f (fiveWordInParabolic 0)

private theorem map_conjugate {G H : Type*} [Group G] [Group H]
    (rho : G →* H) (r y : G) (h : y*r*y⁻¹=r^2) :
    rho y * rho r * (rho y)⁻¹ = (rho r)^2 := by
  calc
    rho y * rho r * (rho y)⁻¹ = rho (y*r*y⁻¹) := by rw [map_mul,map_mul,map_inv]
    _ = rho (r^2) := congrArg rho h
    _ = (rho r)^2 := map_pow rho r 2

private theorem map_period {G H : Type*} [Group G] [Group H]
    (rho : G →* H) (x : G) (n : ℕ) (h : x^n=1) : (rho x)^n=1 :=
  (map_pow rho x n).symm.trans ((congrArg rho h).trans (map_one rho))

theorem imageFourFive_conjugate :
    imageFourCycle * imageFiveWord * imageFourCycle⁻¹ = imageFiveWord^2 :=
  map_conjugate f (fiveWordInParabolic 0) (fourCycleInParabolic 0)
    (Subtype.ext (fiveWord_conjugate 0))

theorem imageFive_period : imageFiveWord^5=1 :=
  map_period f (fiveWordInParabolic 0) 5 (Subtype.ext (fiveWord_pow_five 0))

theorem imageFour_period : imageFourCycle^4=1 :=
  map_period f (fourCycleInParabolic 0) 4 (Subtype.ext (fourCycle_four 0))

theorem image_generated :
    Subgroup.zpowers imageFiveWord ⊔ Subgroup.zpowers imageFourCycle = ⊤ := by
  let L : Subgroup Image := Subgroup.zpowers imageFiveWord ⊔ Subgroup.zpowers imageFourCycle
  let S : Subgroup (originalModelFixed 0) := (L.comap f).map P.subtype
  have hrL : imageFiveWord ∈ L := Subgroup.mem_sup_left (Subgroup.mem_zpowers _)
  have hyL : imageFourCycle ∈ L := Subgroup.mem_sup_right (Subgroup.mem_zpowers _)
  have hU : fixedPositive 0 ≤ S := by
    intro u hu
    let U : P := ⟨u,positive_le_parabolic 0 hu⟩
    obtain ⟨b,hb⟩ := exists_middle_associated_value 0 U hu
    let B : P := ⟨b.val,positive_le_parabolic 0
      (middleFixedSubgroup_le_fixedPositive 0 b.property)⟩
    have hBval : middleAssociatedHom 0 B = fixedRawHom 0 b.val :=
      associatedUnit_eq_of_preserving middleWeight (parabolicToTriangular 0 B)
        (middleFixed_raw_preserving 0 b.val b.property)
    have hUB : f U=f B := Subtype.ext (hb.trans hBval.symm)
    have hbcyc : b.val ∈ Subgroup.zpowers (fourCycle 0) := by
      rw [← middleFixed_zero_eq_zpowers]
      exact b.property
    obtain ⟨n,hn⟩ := Subgroup.mem_zpowers_iff.mp hbcyc
    have hBpow : (fourCycleInParabolic 0)^n=B := Subtype.ext hn
    have hBL : f B ∈ L := by
      rw [← hBpow,map_zpow]
      exact L.zpow_mem hyL n
    refine ⟨U,?_,rfl⟩
    change f U ∈ L
    rw [hUB]
    exact hBL
  have hR : fiveWordInParabolic 0 = middleWeylInParabolic * (fourCycleInParabolic 0)^2 :=
    Subtype.ext rfl
  have hRval : imageFiveWord=f middleWeylInParabolic * imageFourCycle^2 := by
    change f (fiveWordInParabolic 0)=f middleWeylInParabolic * (f (fourCycleInParabolic 0))^2
    rw [hR,map_mul,map_pow]
  have hWval : f middleWeylInParabolic=imageFiveWord*(imageFourCycle^2)⁻¹ :=
    eq_mul_inv_iff_mul_eq.mpr hRval.symm
  have hWL : f middleWeylInParabolic ∈ L := by
    rw [hWval]
    exact L.mul_mem hrL (L.inv_mem (L.pow_mem hyL 2))
  have hPS : P ≤ S := by
    change (fixedPositive 0 ⊔ fixedDiagonal 0) ⊔ Subgroup.closure {middleFixedWeyl 0} ≤ S
    apply sup_le
    · apply sup_le hU
      rw [fixedDiagonal_zero_eq_bot]
      exact bot_le
    · apply (Subgroup.closure_le _).mpr
      intro x hx
      obtain rfl := Set.mem_singleton_iff.mp hx
      exact ⟨middleWeylInParabolic,hWL,rfl⟩
  apply top_unique
  intro x _
  obtain ⟨p,rfl⟩ := (middleAssociatedHom 0).rangeRestrict_surjective x
  have hpS : p.val ∈ S := hPS p.property
  obtain ⟨q,hq,hqp⟩ := hpS
  have he : q=p := Subtype.ext hqp
  exact he ▸ hq

theorem image_card_le_twenty : Nat.card Image ≤ 20 := by
  have hc := FiniteCyclicNormalizerProduct.card_join_le_mul imageFiveWord imageFourCycle 2
    imageFourFive_conjugate 5 4 (by decide) (by decide) imageFive_period imageFour_period
  have he : Nat.card ↥(Subgroup.zpowers imageFiveWord ⊔ Subgroup.zpowers imageFourCycle) =
      Nat.card Image := by
    rw [image_generated]
    exact Nat.card_congr (Subgroup.topEquiv : (⊤ : Subgroup Image) ≃* Image).toEquiv
  rw [he] at hc
  exact hc

theorem image_solvable : IsSolvable Image := by
  have hs := FiniteCyclicNormalizerProduct.join_solvable imageFiveWord imageFourCycle 2
    imageFourFive_conjugate
  rw [image_generated] at hs
  letI := hs
  exact solvable_of_surjective (f := (Subgroup.topEquiv : (⊤ : Subgroup Image) ≃* Image).toMonoidHom)
    (Subgroup.topEquiv : (⊤ : Subgroup Image) ≃* Image).surjective

end SymmetricSubgroupAsymptotics.CFSGReeFFourBinaryAssociatedImage
