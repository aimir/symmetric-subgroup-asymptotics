private def letters (i : Fin 12) : Fin 2 :=
  (if i.val < 6 then (if i.val < 3 then (if i.val < 1 then 1 else (if i.val < 2 then 1 else 0)) else (if i.val < 4 then 1 else (if i.val < 5 then 1 else 0))) else (if i.val < 9 then (if i.val < 7 then 1 else (if i.val < 8 then 1 else 0)) else (if i.val < 10 then 1 else (if i.val < 11 then 1 else 0))))

private def nextRow (i : Fin 12) (j : Fin 2) : Fin 12 :=
  ((if i.val < 6 then (if i.val < 3 then (if i.val < 1 then #[3,4] else (if i.val < 2 then #[4,5] else #[5,6])) else (if i.val < 4 then #[6,7] else (if i.val < 5 then #[7,8] else #[8,9]))) else (if i.val < 9 then (if i.val < 7 then #[9,10] else (if i.val < 8 then #[10,11] else #[11,0])) else (if i.val < 10 then #[0,1] else (if i.val < 11 then #[1,2] else #[2,3])))) : Array (Fin 12))[j.val]!

private def prevRow (i : Fin 12) (j : Fin 2) : Fin 12 :=
