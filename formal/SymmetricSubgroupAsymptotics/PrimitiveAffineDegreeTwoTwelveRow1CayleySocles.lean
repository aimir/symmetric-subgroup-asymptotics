private def codes (i : Fin 12) : Fin (12^12) :=
  (if i.val < 6 then (if i.val < 3 then (if i.val < 1 then 736867805641 else (if i.val < 2 then 804414021158 else 1553051243139)) else (if i.val < 4 then 2358446048992 else (if i.val < 5 then 3168570653501 else 3979089407898))) else (if i.val < 9 then (if i.val < 7 then 4789641008119 else (if i.val < 8 then 5600195345492 else 6410749910961)) else (if i.val < 10 then 7221304495438 else (if i.val < 11 then 8031859081499 else 8842413667692))))

private def ranks (i : Fin 12) : ℕ :=
  (if i.val < 6 then (if i.val < 3 then (if i.val < 1 then 9 else (if i.val < 2 then 10 else 1)) else (if i.val < 4 then 2 else (if i.val < 5 then 11 else 3))) else (if i.val < 9 then (if i.val < 7 then 4 else (if i.val < 8 then 5 else 6)) else (if i.val < 10 then 7 else (if i.val < 11 then 8 else 0))))

private def parents (i : Fin 12) : Fin 12 :=
