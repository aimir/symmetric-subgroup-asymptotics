private theorem parent_lt_checked : ∀ i : Fin 12,
    i ≠ 11 → ranks (parents i) < ranks i := (by decide +kernel)

private theorem parent_next_checked : ∀ i : Fin 12,
    i ≠ 11 → nextRow (parents i) (letters i) = i := (by decide +kernel)

def certificate : EncodedCayleyCertificate
    (permutationGeneratorEncoding generators) 12 where
  rows := codes
  identity := 11
  identity_eq := by decide +kernel
  next := nextRow
  next_eq := (by decide +kernel)
  rank := ranks
  parent i _ := parents i
  letter i _ := letters i
  parent_lt := parent_lt_checked
  parent_next := parent_next_checked

private theorem codes_strict : StrictMono codes :=
  Fin.strictMono_iff_lt_succ.mpr (by decide +kernel)

theorem rows_injective : Function.Injective certificate.rows :=
  codes_strict.injective

private theorem prev_checked : ∀ i j,
    certificate.next (prevRow i j) j = i := (by decide +kernel)

@[reducible] def group : Group (FiniteGroupRow 12) :=
  certificate.rowGroup rows_injective prevRow prev_checked

abbrev Source := FiniteGroupRow 12
local instance sourceGroup : Group Source := group

def originalEquiv : letI := group
    Source ≃* Catalogue.Row1Top :=
  certificate.rowEquiv rows_injective prevRow prev_checked

def ambient (j : Fin 2) : Source :=
  ⟨certificate.next certificate.identity j⟩

theorem ambient_full : Subgroup.closure (Set.range ambient) = ⊤ :=
  certificate.row_generators_full rows_injective prevRow prev_checked

theorem source_card : Nat.card Source = 12 := by
  rw [Nat.card_eq_fintype_card]
  rfl

private def state0Generators (j : Fin 6) : Source :=
  ⟨(if j.val < 3 then (if j.val < 1 then 2 else (if j.val < 2 then 3 else 11)) else (if j.val < 4 then 11 else (if j.val < 5 then 11 else 11)))⟩

private def state1Generators (j : Fin 6) : Source :=
  ⟨(if j.val < 3 then (if j.val < 1 then 11 else (if j.val < 2 then 1 else 3)) else (if j.val < 4 then 5 else (if j.val < 5 then 7 else 9)))⟩

private def state2Generators (j : Fin 6) : Source :=
  ⟨(if j.val < 3 then (if j.val < 1 then 11 else (if j.val < 2 then 5 else 11)) else (if j.val < 4 then 11 else (if j.val < 5 then 11 else 11)))⟩

private def state3Generators (j : Fin 6) : Source :=
  ⟨(if j.val < 3 then (if j.val < 1 then 11 else (if j.val < 2 then 2 else 5)) else (if j.val < 4 then 8 else (if j.val < 5 then 11 else 11)))⟩

private def state4Generators (j : Fin 6) : Source :=
  ⟨(if j.val < 3 then (if j.val < 1 then 11 else (if j.val < 2 then 3 else 7)) else (if j.val < 4 then 11 else (if j.val < 5 then 11 else 11)))⟩

private def state5Generators (j : Fin 6) : Source :=
  ⟨(if j.val < 3 then (if j.val < 1 then 11 else (if j.val < 2 then 11 else 11)) else (if j.val < 4 then 11 else (if j.val < 5 then 11 else 11)))⟩

def stateGenerators (i : Fin 6) : Fin 6 → Source :=
  (Fin.cases state0Generators (Fin.cases state1Generators (Fin.cases state2Generators (Fin.cases state3Generators (Fin.cases state4Generators (Fin.cases state5Generators (fun i => Fin.elim0 i)))))))

private def rowState (i : Fin 6) : Subgroup Source :=
  Subgroup.closure (Set.range (stateGenerators i))

private theorem rowState_normal : ∀ i : Fin 6,
    (rowState i).Normal := by
  native_decide

private theorem rowState_injective : Function.Injective rowState := by
  native_decide

private theorem rowState_complete :
    ∀ N : {N : Subgroup Source // N.Normal},
      ∃ i : Fin 6, rowState i = N.1 := by
  native_decide

noncomputable def rowRegistry : FiniteNormalStateRegistry Source where
  State := Fin 6
  state := rowState
  state_normal := rowState_normal
  state_injective := rowState_injective
  complete := by
    intro N hN
    letI : N.Normal := hN
    exact rowState_complete ⟨N, inferInstance⟩

noncomputable def topRegistry :
    FiniteNormalStateRegistry Catalogue.Row1Top :=
  rowRegistry.mapEquiv originalEquiv

private abbrev RR := rowRegistry

private theorem rowRegistry_state (i : Fin 6) :
    RR.state i = rowState i := rfl

private def RowIsMinimalStateAbove (base j : Fin 6) : Prop :=
  rowState base < rowState j ∧
    ∀ k : Fin 6, rowState base < rowState k →
      rowState k ≤ rowState j → rowState k = rowState j

private theorem rowRegistry_minimal_iff (base j : Fin 6) :
    RR.IsMinimalStateAbove base j ↔ RowIsMinimalStateAbove base j := by
  rfl

private def carrierState (i : Fin 6) : Fin 6 :=
  (if i.val < 3 then (if i.val < 1 then 0 else (if i.val < 2 then 0 else 0)) else (if i.val < 4 then 0 else (if i.val < 5 then 1 else 1)))

private def state0SocleGenerators : Fin 1 → Source :=
  fun j => (⟨11⟩ : Source)

private def state1SocleGenerators : Fin 1 → Source :=
  fun j => (⟨0⟩ : Source)

private def state2SocleGenerators : Fin 1 → Source :=
  fun j => (⟨0⟩ : Source)

private def state3SocleGenerators : Fin 1 → Source :=
  fun j => (⟨0⟩ : Source)

private def state4SocleGenerators : Fin 1 → Source :=
  fun j => (⟨1⟩ : Source)

private def state5SocleGenerators : Fin 1 → Source :=
  fun j => (⟨1⟩ : Source)

private def rowSocleGenerator (i : Fin 6) :
    Fin 1 → Source :=
  (Fin.cases state0SocleGenerators (Fin.cases state1SocleGenerators (Fin.cases state2SocleGenerators (Fin.cases state3SocleGenerators (Fin.cases state4SocleGenerators (Fin.cases state5SocleGenerators (fun i => Fin.elim0 i)))))))

private theorem row_carrier_eq_checked : ∀ i : Fin 6,
    rowState (carrierState i) = rowState i ⊔
      ⨆ j : {j : Fin 6 // RowIsMinimalStateAbove i j},
        rowState j.1 := by
  native_decide

private theorem row_generated_checked : ∀ i : Fin 6,
    Subgroup.normalClosure (Set.range (rowSocleGenerator i)) ⊔ rowState i =
      rowState (carrierState i) := by
  native_decide

noncomputable def rowStateData (i : Fin 6) :
    FiniteRelativeSocleGeneratorData Source (RR.state i) 1 :=
  RR.relativeSocleGeneratorDataOfStates i (carrierState i) 1
    {j : Fin 6 // RowIsMinimalStateAbove i j}
    Subtype.val
    (fun j ↦ (rowRegistry_minimal_iff i j).2 j.property)
    (fun j hj ↦ ⟨⟨j, (rowRegistry_minimal_iff i j).1 hj⟩, rfl⟩)
    (by simpa only [rowRegistry_state] using row_carrier_eq_checked i)
    (rowSocleGenerator i)
    (by simpa only [rowRegistry_state] using row_generated_checked i)

noncomputable def topStateData (i : Fin 6) :
    FiniteRelativeSocleGeneratorData Catalogue.Row1Top
      (topRegistry.state i) 1 :=
  (rowStateData i).mapEquiv originalEquiv

/-- Uniform quotient-socle tuples on the catalogue row's canonical normal
registry, transported from the checked selected Cayley source. -/
noncomputable def family :
    (Catalogue.row1Interface.normalRegistry).
      QuotientSocleGeneratorFamily 1 where
