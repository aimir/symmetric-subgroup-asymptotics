  fun j => (⟨11⟩ : Source)

private def state1SocleGenerators : Fin 1 → Source :=
  fun j => (⟨0⟩ : Source)

private def state2SocleGenerators : Fin 1 → Source :=
  fun j => (⟨0⟩ : Source)

private def state3SocleGenerators : Fin 1 → Source :=
  fun j => (⟨0⟩ : Source)

private def state4SocleGenerators : Fin 1 → Source :=
  fun j => (⟨1⟩ : Source)

private def state5SocleGenerators : Fin 1 → Source :=
  fun j => (⟨1⟩ : Source)

private def rowSocleGenerator (i : Fin 6) :
    Fin 1 → Source :=
  (Fin.cases (state0SocleGenerators) (Fin.cases (state1SocleGenerators) (Fin.cases (state2SocleGenerators) (Fin.cases (state3SocleGenerators) (Fin.cases (state4SocleGenerators) (Fin.cases (state5SocleGenerators) (fun i => Fin.elim0 i)))))))

private theorem row_carrier_eq_checked : ∀ i : Fin 6,
    rowState (carrierState i) = rowState i ⊔
      ⨆ j : {j : Fin 6 // RowIsMinimalStateAbove i j},
        rowState j.1 := by
  native_decide

private theorem row_generated_checked : ∀ i : Fin 6,
    Subgroup.normalClosure (Set.range (rowSocleGenerator i)) ⊔ rowState i =
      rowState (carrierState i) := by
  native_decide

noncomputable def rowStateData (i : Fin 6) :
    FiniteRelativeSocleGeneratorData Source (RR.state i) 1 :=
  RR.relativeSocleGeneratorDataOfStates i (carrierState i) 1
    {j : Fin 6 // RowIsMinimalStateAbove i j}
    Subtype.val
    (fun j ↦ (rowRegistry_minimal_iff i j).2 j.property)
    (fun j hj ↦ ⟨⟨j, (rowRegistry_minimal_iff i j).1 hj⟩, rfl⟩)
    (by simpa only [rowRegistry_state] using row_carrier_eq_checked i)
    (rowSocleGenerator i)
    (by simpa only [rowRegistry_state] using row_generated_checked i)

noncomputable def topStateData (i : Fin 6) :
    FiniteRelativeSocleGeneratorData Catalogue.Row1Top
      (topRegistry.state i) 1 :=
  (rowStateData i).mapEquiv originalEquiv

/-- Uniform quotient-socle tuples on the catalogue row's canonical normal
registry, transported from the checked selected Cayley source. -/
noncomputable def family :
    (Catalogue.row1Interface.normalRegistry).
      QuotientSocleGeneratorFamily 1 where
  data := by
    intro i
    let N := Catalogue.row1Interface.normalRegistry.state i
    letI : N.Normal :=
      Catalogue.row1Interface.normalRegistry.state_normal i
    obtain ⟨j, hj⟩ := topRegistry.complete N
    exact cast
      (congrArg
        (fun M : Subgroup Catalogue.Row1Top ↦
          FiniteRelativeSocleGeneratorData
            Catalogue.Row1Top M 1) hj)
      (topStateData j)

end PrimitiveAffineDegreeTwoTwelveRow1CayleySocles
end SymmetricSubgroupAsymptotics

