    let N := Catalogue.row1Interface.normalRegistry.state i
    letI : N.Normal :=
      Catalogue.row1Interface.normalRegistry.state_normal i
    obtain ⟨j, hj⟩ := topRegistry.complete N
    exact cast
      (congrArg
        (fun M : Subgroup Catalogue.Row1Top ↦
          FiniteRelativeSocleGeneratorData
            Catalogue.Row1Top M 1) hj)
      (topStateData j)

