import SymmetricSubgroupAsymptotics.MarkedC4SolubleReduction

/-!
# The published soluble-generation theorem supplies the literal RDT witness

Aschbacher–Guralnick, *Solvable generation of groups and Sylow subgroups
of the lower central series*, J. Algebra 77 (1982), 189–201; restated as
Theorem 8.4 of Roney-Dougal–Tracey, arXiv:2503.05416v1, p.32:
every finite group is generated by a soluble subgroup and one other element.
The proposition below contains exactly that ordinary group-theoretic
existence statement. The ambient recovery condition used by the marked
encoding is proved here; it is not part of the literature input.
-/
set_option autoImplicit false
noncomputable section
namespace SymmetricSubgroupAsymptotics.MarkedC4

/-- Theorem 8.4 of Roney-Dougal–Tracey v1, attributed there to
Aschbacher–Guralnick. No marked counts or encoding witnesses occur here. -/
def PublishedAschbacherGuralnickSolubleGeneration : Prop :=
  ∀ (G : Type) [Group G] [Finite G],
    ∃ (K : Subgroup G) (x : G), IsSolvable K ∧
      Subgroup.closure (({x} : Set G) ∪ K) = ⊤

/-- Generation inside a subgroup recovers that same literal ambient subgroup. -/
theorem ambient_recovery_of_soluble_generation {G : Type} [Group G]
    (J : Subgroup G) (K : Subgroup J) (x : J)
    (hgen : Subgroup.closure (({x} : Set J) ∪ K) = ⊤) :
    Subgroup.closure (({(x : G)} : Set G) ∪ K.map J.subtype) = J := by
  let T := Subgroup.closure (({(x : G)} : Set G) ∪ K.map J.subtype)
  apply le_antisymm
  · apply (Subgroup.closure_le _).mpr
    intro g hg
    rcases hg with hx | hk
    · have hgx : g=(x : G) := Set.mem_singleton_iff.mp hx
      exact hgx.symm ▸ x.property
    · obtain ⟨k,_,rfl⟩ := hk
      exact k.property
  · intro g hg
    let j : J := ⟨g,hg⟩
    have hle : Subgroup.closure (({x} : Set J) ∪ K) ≤ T.comap J.subtype := by
      apply (Subgroup.closure_le _).mpr
      intro k hk
      apply Subgroup.subset_closure
      rcases hk with hx | hk
      · left
        exact congrArg (fun z : J => (z : G)) (Set.mem_singleton_iff.mp hx)
      · right
        exact ⟨k,hk,rfl⟩
    rw [hgen] at hle
    exact hle (Subgroup.mem_top j)

/-- The ordinary published theorem constructs the existing literal input,
including the project-owned recovery equality. -/
theorem rdtOneGeneratorSolubleInput_of_aschbacherGuralnick
    (hAG : PublishedAschbacherGuralnickSolubleGeneration) :
    RDTOneGeneratorSolubleInput := by
  intro b J
  obtain ⟨K,x,hsol,hgen⟩ := hAG J
  refine ⟨?_⟩
  exact
    { K := K
      K_solvable := hsol
      x := x
      generates := hgen
      recover := ambient_recovery_of_soluble_generation J K x hgen }

end SymmetricSubgroupAsymptotics.MarkedC4
