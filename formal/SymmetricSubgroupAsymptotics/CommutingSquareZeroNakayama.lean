import Mathlib.LinearAlgebra.Quotient.Basic

/-! An elementary Nakayama argument for two commuting square-zero
operators. No quotient splitting or choice of a maximal submodule is
needed: three substitutions into the actual generating identity suffice. -/

set_option autoImplicit false
noncomputable section

namespace SymmetricSubgroupAsymptotics

/-- If the quotient by E is generated by the images of two commuting
square-zero operators, that actual quotient is zero. -/
theorem eq_top_of_commuting_square_zero_generators
    {k V : Type} [Field k] [AddCommGroup V] [Module k V]
    (D F : V →ₗ[k] V)
    (hD2 : ∀ v, D (D v) = 0) (hF2 : ∀ v, F (F v) = 0)
    (hcomm : ∀ v, D (F v) = F (D v))
    (E : Submodule k V)
    (hDE : ∀ v ∈ E, D v ∈ E) (hFE : ∀ v ∈ E, F v ∈ E)
    (hgenerate : ∀ x, ∃ e ∈ E, ∃ u v, x = e + D u + F v) : E = ⊤ := by
  have hDF : ∀ x, D (F x) ∈ E := by
    intro x
    obtain ⟨e, he, u, v, hx⟩ := hgenerate x
    rw [hx]
    simpa only [map_add, hcomm, hD2, hF2, map_zero, add_zero] using
      hFE (D e) (hDE e he)
  have hD : ∀ x, D x ∈ E := by
    intro x
    obtain ⟨e, he, u, v, hx⟩ := hgenerate x
    rw [hx, map_add, map_add, hD2, add_zero]
    exact E.add_mem (hDE e he) (hDF v)
  have hF : ∀ x, F x ∈ E := by
    intro x
    obtain ⟨e, he, u, v, hx⟩ := hgenerate x
    rw [hx, map_add, map_add, hF2, add_zero]
    exact E.add_mem (hFE e he) (by rw [← hcomm]; exact hDF u)
  apply top_unique
  intro x _
  obtain ⟨e, he, u, v, rfl⟩ := hgenerate x
  exact E.add_mem (E.add_mem he (hD u)) (hF v)

end SymmetricSubgroupAsymptotics

end
