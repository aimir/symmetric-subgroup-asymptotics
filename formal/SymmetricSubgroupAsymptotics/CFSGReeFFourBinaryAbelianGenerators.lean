import SymmetricSubgroupAsymptotics.CFSGReeFFourAbelianImageCardinality
import SymmetricSubgroupAsymptotics.CFSGReeFFourBinaryMiddleGenerators
import SymmetricSubgroupAsymptotics.CFSGReeFFourOuterThreeWord

/-! The actual binary abelian image is generated by the images of the
outer involution and middle four-cycle. The final lemma isolates one
precise, currently separate mixed-word relation which would reduce this
image to a single involution. No mixed-word period is asserted here. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
namespace SymmetricSubgroupAsymptotics.CFSGReeFFourBinaryAbelianGenerators
open CFSGReeFFourAbelianImageCardinality CFSGReeFFourBinaryMiddleGenerators
open CFSGReeFFourOuterThreeWord CFSGReeFFourMiddleDerivedFiveWord
open CFSGReeFFourFieldParameters CFSGReeFFourFixedModelEquivalence
open CFSGReeFFourRelativePositiveSubgroups CFSGReeFFourOuterFixedRoot
open CFSGReeFFourSimpleInversionBlocks CFSGReeFFourOuterFixedInversion
open CFSGReeFFourMiddleFixedInversion CFSGReeFFourMiddleFixedSubgroup

theorem outer_zero_range_eq_zpowers :
    (fixedOuterHom 0).range = Subgroup.zpowers (outerInvolution 0) := by
  apply le_antisymm
  · rintro x ⟨a, rfl⟩
    have ha2 : a.toAdd^2 = a.toAdd := by
      have h := field_cycle 0 a.toAdd
      norm_num at h
      exact h
    have hz : a.toAdd * (a.toAdd-1) = 0 := by
      calc
        _ = a.toAdd^2-a.toAdd := by ring
        _ = 0 := by rw [ha2, sub_self]
    rcases mul_eq_zero.mp hz with hzero | hone
    · have he : a = 1 := Multiplicative.toAdd.injective hzero
      rw [he, map_one]
      exact (Subgroup.zpowers (outerInvolution 0)).one_mem
    · have he : a = Multiplicative.ofAdd (1 : Field 0) :=
        Multiplicative.toAdd.injective (sub_eq_zero.mp hone)
      rw [he]
      exact Subgroup.mem_zpowers (outerInvolution 0)
  · apply Subgroup.zpowers_le.mpr
    exact ⟨Multiplicative.ofAdd 1, rfl⟩

theorem positiveBlock_false_eq_zpowers :
    positiveBlock 0 false = Subgroup.zpowers (outerInvolution 0) := by
  change _ = Subgroup.zpowers (outerInvolution 0)
  rw [positiveBlock, CFSGReeFFourMinimalParabolics.simpleWeyl, simple_inversion_eq_block]
  exact (fixedOuterInversion_eq_range 0).trans outer_zero_range_eq_zpowers

theorem positiveBlock_true_eq_zpowers :
    positiveBlock 0 true = Subgroup.zpowers (fourCycle 0) := by
  rw [positiveBlock, CFSGReeFFourMinimalParabolics.simpleWeyl, simple_inversion_eq_block]
  exact (fixedMiddleInversion_eq_middleFixedSubgroup 0).trans
    middleFixed_zero_eq_zpowers

variable {A : Type*} [CommGroup A]

theorem range_eq_two_zpowers (f : originalModelFixed 0 →* A) :
    f.range = Subgroup.zpowers (f (outerInvolution 0)) ⊔
      Subgroup.zpowers (f (fourCycle 0)) := by
  rw [range_eq_block_join, positiveBlock_false_eq_zpowers,
    positiveBlock_true_eq_zpowers, MonoidHom.map_zpowers, MonoidHom.map_zpowers]

theorem outerWeyl_image (m : ℕ) (f : originalModelFixed m →* A) :
    f (outerFixedWeyl m) = f (outerInvolution m) := by
  have hc : f (outerFixedWeyl m * outerInvolution m * (outerFixedWeyl m)⁻¹) =
      f (outerInvolution m) := by
    rw [map_mul, map_mul, map_inv, mul_comm (f (outerFixedWeyl m))
      (f (outerInvolution m)), mul_assoc, mul_inv_cancel, mul_one]
  calc
    f (outerFixedWeyl m) = f (outerInvolution m) *
        f (outerFixedWeyl m * outerInvolution m * (outerFixedWeyl m)⁻¹) *
          f (outerInvolution m) := by rw [← map_mul, ← map_mul, ← outerWeyl_three_word]
    _ = (f (outerInvolution m))^2 * f (outerInvolution m) := by rw [hc, pow_two]
    _ = f (outerInvolution m) := by
      rw [← map_pow, outerInvolution_square, map_one, one_mul]

theorem range_card_le_two_of_mixed_period (f : originalModelFixed 0 →* A)
    (n : ℕ) (hn : Nat.Coprime 4 n)
    (hperiod : (fourCycle 0 * outerFixedWeyl 0)^n = 1) :
    Nat.card f.range ≤ 2 := by
  let x := f (outerInvolution 0)
  let y := f (fourCycle 0)
  have hx : x^2 = 1 := by
    dsimp only [x]
    rw [← map_pow, outerInvolution_square, map_one]
  have hx4 : x^4 = 1 := by
    calc
      x^4 = (x^2)^2 := by rw [← pow_mul]
      _ = 1 := by rw [hx, one_pow]
  have hy : y^4 = 1 := by
    dsimp only [y]
    rw [← map_pow, fourCycle_four, map_one]
  have hz4 : (y*x)^4 = 1 := by rw [mul_pow, hy, hx4, one_mul]
  have hzn : (y*x)^n = 1 := by
    have h := congrArg f hperiod
    simpa only [map_pow, map_mul, map_one, outerWeyl_image, x, y] using h
  have hd : orderOf (y*x) ∣ Nat.gcd 4 n :=
    Nat.dvd_gcd (orderOf_dvd_of_pow_eq_one hz4) (orderOf_dvd_of_pow_eq_one hzn)
  rw [hn.gcd_eq_one] at hd
  have hz : y*x = 1 := orderOf_eq_one_iff.mp (Nat.dvd_one.mp hd)
  have hyx : y = x := by
    calc
      y = (y*x)*x := by rw [mul_assoc, ← pow_two, hx, mul_one]
      _ = x := by rw [hz, one_mul]
  have hr : f.range = Subgroup.zpowers x := by
    rw [range_eq_two_zpowers]
    change Subgroup.zpowers x ⊔ Subgroup.zpowers y = Subgroup.zpowers x
    rw [hyx, sup_idem]
  rw [hr, Nat.card_zpowers]
  exact Nat.le_of_dvd (by decide : 0 < 2) (orderOf_dvd_of_pow_eq_one hx)

end SymmetricSubgroupAsymptotics.CFSGReeFFourBinaryAbelianGenerators
