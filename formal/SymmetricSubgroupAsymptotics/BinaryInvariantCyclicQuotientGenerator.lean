import SymmetricSubgroupAsymptotics.BinaryInvariantCyclicGeneratorBound
import SymmetricSubgroupAsymptotics.RepresentationDualSubquotientGenerators

/-!
# Cyclic generators for one-step state quotients

The child table in a binary invariant-state registry records an equality

`B' = B ⊔ span(G · v)`.

Besides generating `B'` from generators of `B`, this equality says that the
literal quotient `B' / B` is generated by the image of the single displayed
vector.  This file packages that consequence once.  Finite catalogues may
therefore certify quotient layers by a child-table lookup instead of emitting
one proof for every simple row.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open scoped Classical MonoidAlgebra

namespace SymmetricSubgroupAsymptotics

variable {k G V I : Type*} [Field k] [Group G]
  [AddCommGroup V] [Module k V]

namespace BinaryInvariantCyclicOrbitRegistry

variable {rho : Representation k G V}
  {states : I → Subrepresentation rho}
  (C : BinaryInvariantCyclicOrbitRegistry rho states)

/-- The old state, regarded as an invariant subrepresentation of one of its
child states. -/
def childDenominator (i : I) (c : C.Cyclic) :
    Subrepresentation (states (C.child i c)).toRepresentation where
  toSubmodule := (states i).toSubmodule.comap
    (states (C.child i c)).toSubmodule.subtype
  apply_mem_toSubmodule g x hx := by
    change rho g x.1 ∈ states i
    exact (states i).apply_mem_toSubmodule g hx

/-- The literal one-step quotient represented by a child-table edge. -/
def childQuotientRepresentation (i : I) (c : C.Cyclic) :
    Representation k G
      ((states (C.child i c)).toSubmodule ⧸
        (C.childDenominator i c).toSubmodule) :=
  (states (C.child i c)).toRepresentation.quotient
    (C.childDenominator i c).toSubmodule (fun g x hx => by
      exact (C.childDenominator i c).apply_mem_toSubmodule g hx)

/-- Map the displayed cyclic orbit into the corresponding child quotient. -/
noncomputable def childOrbitQuotientIntertwiner (i : I) (c : C.Cyclic) :
    (orbitSubrepresentation rho (C.cyclicRepresentative c)).toRepresentation.
      IntertwiningMap (C.childQuotientRepresentation i c) where
  toLinearMap :=
    { toFun := fun x =>
        Submodule.Quotient.mk
          ⟨x.1, by
            rw [C.child_eq i c]
            exact le_sup_right x.2⟩
      map_add' := by intro x y; rfl
      map_smul' := by intro a x; rfl }
  isIntertwining' := by
    intro g
    apply LinearMap.ext
    intro x
    apply Submodule.Quotient.sound
    change rho g x.1 - rho g x.1 ∈
      (C.childDenominator i c).toSubmodule
    simp

/-- The cyclic-orbit map is onto: the child equality writes every child
vector as an old-state vector plus an orbit-span vector, and the old-state
summand dies in the quotient. -/
theorem childOrbitQuotientIntertwiner_surjective (i : I) (c : C.Cyclic) :
    Function.Surjective (C.childOrbitQuotientIntertwiner i c) := by
  intro y
  obtain ⟨b, rfl⟩ := (C.childDenominator i c).toSubmodule.mkQ_surjective y
  have hb : (b : V) ∈
      (states i).toSubmodule ⊔
        binaryOrbitSpan rho (C.cyclicRepresentative c) := by
    rw [← C.child_eq i c]
    exact b.2
  obtain ⟨a, ha, z, hz, hab⟩ := Submodule.mem_sup.mp hb
  let zC : (orbitSubrepresentation rho
      (C.cyclicRepresentative c)).toSubmodule := ⟨z, hz⟩
  refine ⟨zC, ?_⟩
  apply Submodule.Quotient.eq.mpr
  change (b : V) - z ∈ (states i).toSubmodule
  rw [← hab]
  simpa only [add_sub_cancel_right] using ha

/-- Every child-table quotient is generated by one element. -/
theorem childQuotientRepresentation_generated (i : I) (c : C.Cyclic) :
    RepresentationGeneratedBy (C.childQuotientRepresentation i c) 1 := by
  have horbit : RepresentationGeneratedBy
      (orbitSubrepresentation rho (C.cyclicRepresentative c)).toRepresentation 1 :=
    representationGeneratedBy_of_iSup_binaryOrbitSpan rho
      (orbitSubrepresentation rho (C.cyclicRepresentative c)) 1
      (fun _ => C.cyclicRepresentative c) (by
        simp only [orbitSubrepresentation, iSup_unique])
  exact representationGeneratedBy_of_surjective
    (orbitSubrepresentation rho (C.cyclicRepresentative c)).toRepresentation
    (C.childQuotientRepresentation i c)
    (C.childOrbitQuotientIntertwiner i c)
    (C.childOrbitQuotientIntertwiner_surjective i c) horbit

end BinaryInvariantCyclicOrbitRegistry

end SymmetricSubgroupAsymptotics

end
