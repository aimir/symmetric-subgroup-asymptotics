import SymmetricSubgroupAsymptotics.DerivedTwoCosetGeneratorContainment
import SymmetricSubgroupAsymptotics.MarkedC4GeneratorNumbers
import Mathlib.Data.Fintype.Sum

/-! If the original group is generated by d actual derived elements and
one further element y whose square is derived, its ACTUAL derived group
has at most2d+1 ordinary generators. The literal Schreier family consists
of those d elements, their y-conjugates and y². No index, splitting,
normal-generator count, simplicity or finite-group hypothesis is needed. -/
set_option autoImplicit false
noncomputable section
open scoped Classical
namespace SymmetricSubgroupAsymptotics.DerivedOneCosetOrdinaryGenerators
variable {G ι : Type*} [Group G] [Finite ι]

theorem exists_generating_finset (g : ι → commutator G) (y : G)
    (hgen : Subgroup.closure (Set.range (fun i => (g i : G)) ∪ {y}) = ⊤)
    (hsquare : y ^ 2 ∈ commutator G) :
    ∃ T : Finset (commutator G), Subgroup.closure (T : Set (commutator G)) = ⊤ ∧
      T.card ≤ 2 * Nat.card ι + 1 := by
  let D := commutator G
  let w : ι ⊕ (ι ⊕ Unit) → D := Sum.elim g (Sum.elim
    (fun i => ⟨y * (g i : G) * y⁻¹,
      (inferInstance : D.Normal).conj_mem _ (g i).property y⟩)
    (fun _ => ⟨y ^ 2, hsquare⟩))
  let H : Subgroup D := Subgroup.closure (Set.range w)
  have hmap : D ≤ H.map D.subtype := by
    apply (DerivedTwoCosetGeneratorContainment.commutator_le_generatedSubgroup
      (Set.range (fun i => (g i : G))) y hgen).trans
    apply (Subgroup.closure_le _).mpr
    intro z hz
    rcases hz with (⟨i, rfl⟩ | ⟨_, ⟨i, rfl⟩, rfl⟩) | hz
    · exact ⟨w (Sum.inl i), Subgroup.subset_closure ⟨Sum.inl i, rfl⟩, rfl⟩
    · exact ⟨w (Sum.inr (Sum.inl i)),
        Subgroup.subset_closure ⟨Sum.inr (Sum.inl i), rfl⟩, rfl⟩
    · have hz : z = y ^ 2 := hz
      subst z
      exact ⟨w (Sum.inr (Sum.inr ())),
        Subgroup.subset_closure ⟨Sum.inr (Sum.inr ()), rfl⟩, rfl⟩
  have hH : H = ⊤ := by
    apply top_unique
    intro z _
    obtain ⟨a, ha, he⟩ := hmap z.property
    have he' : a = z := Subtype.ext he
    exact he' ▸ ha
  letI : Fintype (ι ⊕ (ι ⊕ Unit)) := Fintype.ofFinite _
  let T : Finset D := Finset.univ.image w
  have hT : (T : Set D) = Set.range w := by
    simp only [T, Finset.coe_image, Finset.coe_univ, Set.image_univ]
  refine ⟨T, ?_, ?_⟩
  · rw [hT]
    exact hH
  · calc
      T.card ≤ Fintype.card (ι ⊕ (ι ⊕ Unit)) := Finset.card_image_le.trans_eq Finset.card_univ
      _ = 2 * Nat.card ι + 1 := by
        rw [← Nat.card_eq_fintype_card, Nat.card_sum, Nat.card_sum,
          show Nat.card Unit = 1 from Nat.card_unique]
        omega

theorem genRank_le (g : ι → commutator G) (y : G)
    (hgen : Subgroup.closure (Set.range (fun i => (g i : G)) ∪ {y}) = ⊤)
    (hsquare : y ^ 2 ∈ commutator G) :
    MarkedC4.genRank (commutator G) ≤ 2 * Nat.card ι + 1 := by
  obtain ⟨T, hT, hcard⟩ := exists_generating_finset g y hgen hsquare
  exact (MarkedC4.genRank_le hT).trans hcard

end SymmetricSubgroupAsymptotics.DerivedOneCosetOrdinaryGenerators
