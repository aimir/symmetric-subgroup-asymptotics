import SymmetricSubgroupAsymptotics.CFSGTwistedAUnitaryMiddleArrays
import SymmetricSubgroupAsymptotics.CFSGTwistedAUnitaryRadicalCommutator

/-! Exact action of the literal middle block on the two-step radical.
In particular its commutator has middle parameter (A-1)v. These symbolic
identities supply the genuine coinvariant mechanism; no assertion that
this parameter module is already generated by differences is supplied. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
open scoped BigOperators Matrix commutatorElement

namespace SymmetricSubgroupAsymptotics.CFSGTwistedAUnitaryUpperArrays
variable {K J : Type*} [CommRing K] [Fintype J] [DecidableEq J]

theorem middleArray_conjugate_upper (A B : Matrix J J K) (hAB : A * B = 1)
    (w v : J → K) (b : K) :
    middleArray A * upperArray w v b * middleArray B = upperArray (w ᵥ* B) (A *ᵥ v) b := by
  have hab (i j : J) : (∑ k, A i k * B k j) = if i = j then 1 else 0 := by
    have h := congrArg (fun M : Matrix J J K => M i j) hAB
    simpa only [Matrix.mul_apply, Matrix.one_apply] using h
  ext (u | (i | u)) (z | (j | z))
  all_goals simp [middleArray, upperArray, Matrix.mul_apply, Fintype.sum_sum_type,
    Matrix.vecMul, Matrix.mulVec, dotProduct, ite_mul, mul_ite, hab]

theorem middleUnit_conjugate_upper (A : (Matrix J J K)ˣ) (w v : J → K) (b : K) :
    middleUnit A * upperUnit w v b * (middleUnit A)⁻¹ =
      upperUnit (w ᵥ* ((A⁻¹ : (Matrix J J K)ˣ) : Matrix J J K))
        ((A : Matrix J J K) *ᵥ v) b := by
  apply Units.ext
  exact middleArray_conjugate_upper (A : Matrix J J K)
    ((A⁻¹ : (Matrix J J K)ˣ) : Matrix J J K) (Units.mul_inv A) w v b

theorem middleUnit_commutator_upper (A : (Matrix J J K)ˣ) (w v : J → K) (b : K) :
    ⁅middleUnit A, upperUnit w v b⁆ =
      upperUnit (w ᵥ* ((A⁻¹ : (Matrix J J K)ˣ) : Matrix J J K) - w)
        ((A : Matrix J J K) *ᵥ v - v)
        (dotProduct w v - dotProduct (w ᵥ* ((A⁻¹ : (Matrix J J K)ˣ) : Matrix J J K)) v) := by
  rw [commutatorElement_def, middleUnit_conjugate_upper, upperUnit_inv, upperUnit_mul]
  simp only [sub_eq_add_neg, dotProduct_neg]
  apply congrArg (upperUnit
    (w ᵥ* ((A⁻¹ : (Matrix J J K)ˣ) : Matrix J J K) + -w)
    ((A : Matrix J J K) *ᵥ v + -v))
  ring

end SymmetricSubgroupAsymptotics.CFSGTwistedAUnitaryUpperArrays
