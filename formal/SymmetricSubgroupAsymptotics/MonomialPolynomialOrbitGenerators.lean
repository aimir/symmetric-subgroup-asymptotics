import SymmetricSubgroupAsymptotics.TransitivePermutationModuleGenerators

/-! Arbitrary destination-dependent monomial scalars do not increase
cyclic polynomial generator counts. Every invariant subspace of a
monomial representation with transitive basis action is generated by at
most half the point degree, in every characteristic. The scalar is an
actual unit for each group element and point; no global character,
split extension, or invertible group-order assumption is used. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open scoped Classical Polynomial BigOperators
namespace SymmetricSubgroupAsymptotics.MonomialPolynomialOrbitGenerators
variable {k G X : Type} [Field k] [Group G] [Fintype X] [MulAction G X]
    (rho : Representation k G (X→k))
    (hdelta : ∀g:G,∀x:X,∃u:kˣ,
      rho g (Pi.single x 1)=(u:k) • (Pi.single (g • x) 1 : X→k))

include hdelta

theorem polynomial_span_orbitCover (g : G) {n : ℕ} (representative : Fin n→X)
    (hcover : ∀x:X,∃j:Fin n,∃m:ℕ,g^m • representative j=x) :
    Submodule.span k[X]
      (Set.range (fun j=>Module.AEval'.of (rho g) (Pi.single (representative j) 1)))=⊤ := by
  let polyEquiv := Module.AEval'.of (rho g)
  let code : Fin n→Module.AEval' (rho g) :=
    fun j=>polyEquiv (Pi.single (representative j) 1)
  let P : Submodule k[X] (Module.AEval' (rho g)) :=
    Submodule.span k[X] (Set.range code)
  have hpoint (x:X) : polyEquiv (Pi.single x (1:k))∈P := by
    obtain ⟨j,m,hm⟩ := hcover x
    have hj : code j∈P := Submodule.subset_span ⟨j,rfl⟩
    have hpow := P.smul_mem ((Polynomial.X:k[X])^m) hj
    have he : ((Polynomial.X:k[X])^m) • code j=
        polyEquiv (rho (g^m) (Pi.single (representative j) 1)) := by
      dsimp only [code,polyEquiv]
      rw [Module.AEval'.X_pow_smul_of,map_pow]
      rfl
    rw [he] at hpow
    obtain ⟨u,hu⟩ := hdelta (g^m) (representative j)
    rw [hu,hm,map_smul] at hpow
    have hscaled := P.smul_of_tower_mem (↑(u⁻¹):k) hpow
    have hinv : (↑(u⁻¹):k)*(u:k)=1 := by
      simpa only [Units.val_mul,Units.val_one] using
        congrArg (fun v:kˣ=>(v:k)) (inv_mul_cancel u)
    simpa only [smul_smul,hinv,one_smul] using hscaled
  have hall (v:X→k) : polyEquiv v∈P := by
    have hsum : (∑i,v i • (Pi.single i 1:X→k))=v := by
      calc
        (∑i,v i • (Pi.single i 1:X→k))=∑i,Pi.single i (v i) := by
          apply Finset.sum_congr rfl
          intro i _
          rw [←Pi.single_smul]
          simp
        _=v := LinearMap.sum_single_apply (fun _:X=>k) v
    have hmem : (∑i,v i • polyEquiv (Pi.single i 1))∈P :=
      P.sum_mem fun i _=>P.smul_of_tower_mem (v i) (hpoint i)
    have he : (∑i,v i • polyEquiv (Pi.single i 1))=polyEquiv v := by
      simpa only [map_sum,map_smul] using congrArg polyEquiv hsum
    exact he ▸ hmem
  apply top_unique
  intro x _
  simpa only [LinearEquiv.apply_symm_apply] using hall (polyEquiv.symm x)

theorem uniform_of_derangement [Finite G] [Nonempty X]
    (g:G) (hfree:MulAction.fixedBy X g=∅) :
    UniformSubrepresentationGeneratorBound rho (Nat.card X/2) := by
  obtain ⟨representative,hcover⟩ :=
    TransitivePermutationModuleGenerators.cyclic_orbit_cover (X:=X) g
  let O := MulAction.orbitRel.Quotient (Subgroup.zpowers g) X
  have hc : Nat.card O ≤ Nat.card X/2 := by
    have h := cyclicOrbitCount_mul_two_le_of_fixedBy_eq_empty g hfree
    change Nat.card O*2 ≤ Nat.card X at h
    omega
  let e : Fin (Nat.card O)↪Fin (Nat.card X/2) := Fin.castLEEmb hc
  let padded : Fin (Nat.card X/2)→X :=
    Function.extend e representative (fun _=>Classical.choice inferInstance)
  apply uniformSubrepresentationGeneratorBound_of_polynomial rho g
    (fun j=>Module.AEval'.of (rho g) (Pi.single (padded j) 1))
  apply polynomial_span_orbitCover rho hdelta g padded
  intro x
  obtain ⟨j,m,hm⟩ := hcover x
  refine ⟨e j,m,?_⟩
  change g^m • Function.extend e representative _ (e j)=x
  rw [e.injective.extend_apply]
  exact hm

theorem uniform_of_transitive [Finite G] [Nontrivial X]
    [MulAction.IsPretransitive G X] :
    UniformSubrepresentationGeneratorBound rho (Nat.card X/2) := by
  obtain ⟨g,hg⟩ := exists_fixedBy_eq_empty_of_pretransitive G X
  exact uniform_of_derangement rho hdelta g hg

end SymmetricSubgroupAsymptotics.MonomialPolynomialOrbitGenerators
