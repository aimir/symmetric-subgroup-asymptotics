import SymmetricSubgroupAsymptotics.PGroupCoinvariantGenerators
import SymmetricSubgroupAsymptotics.InducedTernaryRestrictionSection

/-!
# Actual generators from the ternary Sylow width

The Mackey calculation bounds the intrinsic head only after restricting an
induced module to a Sylow `3`-subgroup.  For a defining-characteristic
`3`-group, `PGroupCoinvariantGenerators` turns that head bound into actual
module generators.  A tuple which generates after restriction also
generates for the whole group.  Combining the three steps gives a uniform
generator theorem at the canonical integer ternary width.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open scoped Classical MonoidAlgebra

namespace SymmetricSubgroupAsymptotics

universe u

/-- A tuple which generates after restriction to a subgroup generates the
original representation with the same length. -/
theorem representationGeneratedBy_of_subgroup_restriction
    {k G V : Type u} [Field k] [Group G]
    [AddCommGroup V] [Module k V]
    (H : Subgroup G) (rho : Representation k G V)
    {n : ℕ}
    (hgen : RepresentationGeneratedBy (rho.comp H.subtype) n) :
    RepresentationGeneratedBy rho n := by
  let rhoH : Representation k H V := rho.comp H.subtype
  change RepresentationGeneratedBy rhoH n at hgen
  obtain ⟨v, hv⟩ := hgen
  let vG : Fin n → rho.asModule := fun i ↦
    rho.asModuleEquiv.symm (rhoH.asModuleEquiv (v i))
  let W : Submodule k[G] rho.asModule :=
    Submodule.span k[G] (Set.range vG)
  let M : Subrepresentation rho := Subrepresentation.ofSubmodule' W
  let MH : Subrepresentation rhoH :=
    { toSubmodule := M.toSubmodule
      apply_mem_toSubmodule := fun h x hx ↦ M.apply_mem_toSubmodule h.1 hx }
  have hle : Submodule.span k[H] (Set.range v) ≤ MH.asSubmodule := by
    apply Submodule.span_le.mpr
    rintro _ ⟨i, rfl⟩
    change rho.asModuleEquiv.symm
      (rhoH.asModuleEquiv (v i)) ∈ W
    exact Submodule.subset_span (Set.mem_range_self i)
  have hMH : MH.asSubmodule = ⊤ := by
    rw [hv] at hle
    exact top_unique hle
  have hM : M.toSubmodule = ⊤ := by
    apply SetLike.ext
    intro x
    have hx : x ∈ MH.asSubmodule ↔ x ∈ (⊤ : Submodule k[H]
        rhoH.asModule) := by rw [hMH]
    simpa only [Submodule.mem_top] using hx
  refine ⟨vG, ?_⟩
  change W = ⊤
  apply SetLike.ext
  intro x
  have hx : x ∈ M.toSubmodule ↔ x ∈ (⊤ : Submodule k V) := by
    rw [hM]
  simpa only [Submodule.mem_top] using hx

variable {G V : Type} [Group G] [Finite G]
  [AddCommGroup V] [Module (ZMod 3) V]
  [FiniteDimensional (ZMod 3) V]

/-- Every subrepresentation of a ternary induced module is generated by
`dim(V)` times the canonical Sylow-width.  This is the generator-strength
form of `inducedRestrictionTernary_head_le_widthCore`; no Tracey input is
used in this conversion. -/
theorem inducedTernary_uniformSubrepresentationGeneratorBound
    (H : Subgroup G) (rho : Representation (ZMod 3) H V) :
    ∀ M : Subrepresentation (Representation.ind H.subtype rho),
      RepresentationGeneratedBy M.toRepresentation
        (Module.finrank (ZMod 3) V *
          ternaryWidthCore H.index (H.index.factorization 3)) := by
  letI : Finite V := Module.finite_of_finite (ZMod 3)
  letI : FiniteDimensional (ZMod 3)
      (Representation.IndV H.subtype rho) := induced_finiteDimensional H rho
  letI : Finite (Representation.IndV H.subtype rho) :=
    Module.finite_of_finite (ZMod 3)
  intro M
  let P : Sylow 3 G := Classical.choice inferInstance
  let MP : Subrepresentation
      ((Representation.ind H.subtype rho).comp (P : Subgroup G).subtype) :=
    { toSubmodule := M.toSubmodule
      apply_mem_toSubmodule := fun g x hx ↦ M.apply_mem_toSubmodule g.1 hx }
  letI : Finite MP.toSubmodule := Finite.of_injective
    MP.toSubmodule.subtype MP.toSubmodule.injective_subtype
  have hhead : Module.finrank (ZMod 3)
      (MP.toRepresentation.IntertwiningMap
        (Representation.trivial (ZMod 3) P (ZMod 3))) ≤
      Module.finrank (ZMod 3) V *
        ternaryWidthCore H.index (H.index.factorization 3) :=
    inducedRestrictionTernary_head_le_widthCore H rho P MP
  have hgenP := pGroup_representationGeneratedBy_coinvariants
    P.isPGroup' MP.toRepresentation
  rw [← representationHead_finrank_eq_coinvariants] at hgenP
  have hgenP' := representationGeneratedBy_mono MP.toRepresentation
    hhead hgenP
  apply representationGeneratedBy_of_subgroup_restriction
    (P : Subgroup G) M.toRepresentation
  simpa only [MP, Subrepresentation.toRepresentation] using hgenP'

end SymmetricSubgroupAsymptotics

end
