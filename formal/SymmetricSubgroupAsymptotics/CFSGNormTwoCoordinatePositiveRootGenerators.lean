import SymmetricSubgroupAsymptotics.CFSGNormTwoCoordinateSimpleRootParametrization
import SymmetricSubgroupAsymptotics.CFSGNormTwoCoordinateWeylRootMembership

/-! The ACTUAL simple-positive-root generated subgroup equals the
subgroup generated by all original positive lattice root subgroups.
Membership is proved from the checked literal word-sign theorem, and
the inverse Weyl identity converts the negative selected parametrization.
This does not yet assert an ordered product normal form. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
namespace SymmetricSubgroupAsymptotics.CFSGNormTwoCoordinatePositiveRootGenerators
open CFSGIntegerMatrixPairing CFSGNormTwoRootPairing CFSGSerreQuadraticMatrix
open CFSGNormTwoGeckIntegralRealization CFSGNormTwoGeckLatticeDegree
open CFSGNormTwoGeckIntegralWord CFSGNormTwoGeckPositivePGroup
open CFSGNormTwoGeckWeylLatticeLinear CFSGNormTwoGeckWeylWordDegree
open CFSGNormTwoGeckWeylWordAlgebra CFSGNormTwoCoordinateRootSubgroup
open CFSGSerreQuadraticWeylWord CFSGSerreQuadraticWordRootTransport
open CFSGNormTwoCoordinateSelectedRootElement CFSGNormTwoCoordinateSimpleRootParametrization
variable {r : ℕ} (A : Matrix (Fin r) (Fin r) ℤ) (hd : ∀i,A i i=2)
    (hs : A.transpose=A) (hp : (rationalMatrix A).PosDef)
    (ho : ∀i j,i≠j→A i j≤0)
    [Fintype (Roots A)] [DecidableEq (Roots A)]
    [(rootPairing A hs hp).IsReduced] [(rootPairing A hs hp).IsIrreducible]

local notation "b₀" => coordinateBase A hd hs hp ho
local notation "s₀" => coordinateIndexEquiv A hd hs hp ho
local notation "D" => realizationData A hs hp b₀ s₀

abbrev PositiveRoot := {k : Roots A // ∀i,0≤k.val i}

theorem selected_positive_root_mem (K : Type) [Field K] (k : Roots A)
    (hk : ∀i,0≤k.val i) (a : K) :
    selectedRootElement A hd hs hp ho K k a∈rootGroup A hs hp b₀ s₀ K false := by
  let p := rootWitness A hd hs hp ho k
  let w := p.val.1++[p.val.2]
  have hroot : wordRoot A hs hp b₀ s₀ w (s₀ p.val.2)=k := by
    apply Subtype.ext
    calc
      _=wordLinear A hs hp b₀ s₀ w (s₀ p.val.2:Roots A).val :=
        (wordLinear_root A hs hp b₀ s₀ w (s₀ p.val.2)).symm
      _=wordLinear A hs hp b₀ s₀ p.val.1 (-(s₀ p.val.2:Roots A).val) := by
        dsimp only [w]
        rw [wordLinear_append]
        change wordLinear A hs hp b₀ s₀ p.val.1
          (reflectionEquiv A (s₀ p.val.2) (s₀ p.val.2:Roots A).val)=_
        congr 1
        change (s₀ p.val.2:Roots A).val-
          integerPairing A (s₀ p.val.2:Roots A).val (s₀ p.val.2:Roots A).val •
            (s₀ p.val.2:Roots A).val= -(s₀ p.val.2:Roots A).val
        rw [(s₀ p.val.2:Roots A).property]
        module
      _=k.val := p.property.symm
  have hpos : ∀j,0≤(wordRoot A hs hp b₀ s₀ w (s₀ p.val.2)).val j := by rw [hroot];exact hk
  have hmem := CFSGNormTwoCoordinateWeylRootMembership.positive_word_mem
    A hd hs hp ho K w p.val.2 (-a) hpos
  have hword : wordUnit A hs hp b₀ s₀ K w=
      canonicalWord D K p.val.1*canonicalWeyl D K p.val.2 := by
    dsimp only [w]
    rw [wordUnit_append]
    simp only [wordUnit,mul_one,word_eq_canonicalWord]
  have he : selectedRootElement A hd hs hp ho K k a=
      CFSGNormTwoCoordinateWeylRootMembership.rootWord A hd hs hp ho K w p.val.2 (-a) := by
    rw [CFSGNormTwoCoordinateWeylRootMembership.rootWord,hword]
    let u := canonicalWord D K p.val.1
    change u*canonicalRoot D K true p.val.2 a*u⁻¹=
      (u*canonicalWeyl D K p.val.2)*canonicalRoot D K false p.val.2 (-a)*
        (u*canonicalWeyl D K p.val.2)⁻¹
    have hs := CFSGNormTwoGeckSelfRootConjugation.self_root_word A hs hp b₀ s₀ K p.val.2 (-a)
    simp only [neg_neg] at hs
    rw [←hs]
    group
  rw [he]
  exact hmem

theorem positive_root_subgroup_le (K : Type) [Field K] (k : Roots A) (hk : ∀i,0≤k.val i) :
    rootSubgroup A hd hs hp ho K k≤rootGroup A hs hp b₀ s₀ K false := by
  intro x hx
  let p := rootWitness A hd hs hp ho k
  obtain ⟨a,ha⟩ := (mem_wordRootSubgroup_iff A hd hs hp ho K p.val.1 p.val.2 x).mp hx
  rw [←ha]
  exact selected_positive_root_mem A hd hs hp ho K k hk a

theorem positive_group_eq_iSup (K : Type) [Field K] :
    rootGroup A hs hp b₀ s₀ K false=
      ⨆k : PositiveRoot A,rootSubgroup A hd hs hp ho K k.val := by
  apply le_antisymm
  · apply (Subgroup.closure_le _).mpr
    rintro x ⟨⟨i,a⟩,rfl⟩
    have hk : ∀j,0≤(s₀ i:Roots A).val j := by
      intro j
      change 0≤(Pi.single i (1:ℤ) : Fin r→ℤ) j
      simp only [Pi.single_apply]
      split_ifs <;> omega
    let k : PositiveRoot A := ⟨s₀ i,hk⟩
    have hmem : canonicalRoot D K false i a∈rootSubgroup A hd hs hp ho K (s₀ i) := by
      obtain ⟨ε,hε,he⟩ := selected_simple_root_sign A hd hs hp ho i
      rcases hε with rfl|rfl
      · have hm := selectedRootElement_mem A hd hs hp ho K (s₀ i) a
        rw [he K a] at hm
        simpa only [Int.cast_one,one_mul] using hm
      · have hm := selectedRootElement_mem A hd hs hp ho K (s₀ i) (-a)
        rw [he K (-a)] at hm
        simpa only [Int.cast_neg,Int.cast_one,neg_one_mul,neg_neg] using hm
    exact (le_iSup (fun k : PositiveRoot A=>rootSubgroup A hd hs hp ho K k.val) k) hmem
  · exact iSup_le (fun k=>positive_root_subgroup_le A hd hs hp ho K k.val k.property)

end SymmetricSubgroupAsymptotics.CFSGNormTwoCoordinatePositiveRootGenerators
