private theorem row_mem (k : Fin 128) :
    BinaryMenuCayley8T35.certificate.toCayley.elements k ∈ H :=
  (BinaryMenuCayley8T35.certificate.toCayley.mem_closure_iff _).mpr ⟨k, rfl⟩

theorem step_mem (i : Fin 315) (j : Fin 7) :
    representatives i * generators j * (representatives (next i j))⁻¹ ∈ H := by
  have hrow : permutationCode (BinaryMenuCayley8T35.certificate.toCayley.elements (witness i j)) =
      BinaryMenuCayley8T35.certificate.rows (witness i j) :=
    BinaryMenuCayley8T35.certificate.encode_elements _
  have he := permutationCode_injective 8 ((step_checked i j).trans hrow.symm)
  rw [he]
  exact row_mem _

def certificate : FiniteLeftCosetCover generators H 315 where
  representatives := representatives
  identity := 0
  identity_mem := by
    have h : representatives 0 = 1 := by decide +kernel
    rw [h]
    exact H.one_mem
  next := next
  step_mem := step_mem
  prev := next
  inverse_step_mem i j := by
    simpa only [generators_inv j] using step_mem i j

theorem covers (g : Ambient) : ∃ i : Fin 315, g * (representatives i)⁻¹ ∈ H :=
  certificate.covers generators_full g

