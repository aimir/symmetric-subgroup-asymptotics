import SymmetricSubgroupAsymptotics.PrimitiveAffineDegreeTwoTwelveRow131AffineModel
import SymmetricSubgroupAsymptotics.PrimitiveAffineDegreeTwoTwelvePairFiniteCatalogueRows51To100

/-!
# Row 72 as an actual quotient of the row-131 block model

The map `v ↦ (∑ v)·1 - rotate₃(v)` is equivariant for the regular C4
action. It sends the local delta translation to the three simultaneous
translations in the original row-72 tuple. The induced semidirect map
fixes the four-cycle. Since the original model is generated by these two
elements, its image is exactly the literal row-72 top.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open scoped Classical BigOperators

namespace SymmetricSubgroupAsymptotics
namespace PrimitiveAffineDegreeTwoTwelveRow72Projection

open Non2UnipotentPrefixFiniteMenu.PrimitiveAffineImprimitiveBlockTransfer
open DegreeTwoTwelvePairFiniteCatalogue
open PrimitiveAffineDegreeTwoTwelveRow131AffineModel
open SemidirectProduct

def projection : Vector →ₗ[ZMod 3] Vector where
  toFun v i := (∑ j : Block, v j) - v ((Multiplicative.ofAdd 3 : Block)⁻¹ * i)
  map_add' := by
    intro v w
    funext i
    simp only [Pi.add_apply, Finset.sum_add_distrib]
    ring
  map_smul' := by
    intro a v
    funext i
    simp only [Pi.smul_apply, ← Finset.smul_sum, smul_sub, RingHom.id_apply]

theorem projection_rotation (c : Block) (v : Vector) :
    projection (linearAction c v) = linearAction c (projection v) := by
  funext i
  change (∑ j : Block, v (c⁻¹ * j)) -
      v (c⁻¹ * ((Multiplicative.ofAdd 3 : Block)⁻¹ * i)) =
    (∑ j : Block, v j) -
      v ((Multiplicative.ofAdd 3 : Block)⁻¹ * (c⁻¹ * i))
  have hsum : (∑ j : Block, v (c⁻¹ * j)) = ∑ j : Block, v j :=
    Fintype.sum_equiv (Equiv.mulLeft c⁻¹)
      (fun j : Block ↦ v (c⁻¹ * j)) v (fun _ ↦ rfl)
  rw [hsum]
  congr 1
  congr 1
  ac_rfl

def translationProjection : Translation →* Translation :=
  projection.toAddMonoidHom.toMultiplicative

def modelProjection : Model →* Model :=
  SemidirectProduct.map translationProjection (MonoidHom.id Block) (by
    intro c
    apply MonoidHom.ext
    intro v
    apply Multiplicative.toAdd.injective
    exact projection_rotation c v.toAdd)

def candidate : Model →* Equiv.Perm (Fin 12) := literalAction.comp modelProjection

/-- Only the original two permutations on the original twelve points are
reduced here; no generated group elements are enumerated. -/
theorem generators_binding (i : Fin 2) :
    candidate (modelGenerators i) = row72Generators i := by
  apply Equiv.ext
  intro x
  revert i x
  decide +kernel

theorem candidate_range : candidate.range = Row72Top := by
  apply le_antisymm
  · have hle : Subgroup.closure (Set.range modelGenerators) ≤ Row72Top.comap candidate := by
      apply (Subgroup.closure_le _).mpr
      rintro _ ⟨i, rfl⟩
      change candidate (modelGenerators i) ∈ Row72Top
      rw [generators_binding]
      exact Subgroup.subset_closure (Set.mem_range_self i)
    rintro _ ⟨g, rfl⟩
    apply hle
    rw [model_generated]
    exact Subgroup.mem_top g
  · apply (Subgroup.closure_le _).mpr
    rintro _ ⟨i, rfl⟩
    exact ⟨modelGenerators i, generators_binding i⟩

def modelToTop : Model →* Row72Top :=
  (MulEquiv.subgroupCongr candidate_range).toMonoidHom.comp candidate.rangeRestrict

theorem modelToTop_surjective : Function.Surjective modelToTop :=
  (MulEquiv.subgroupCongr candidate_range).surjective.comp candidate.rangeRestrict_surjective

/-- The source and target are both the literal original permutation tops. -/
def originalTopMap : Row131Top →* Row72Top :=
  modelToTop.comp modelEquiv.symm.toMonoidHom

theorem originalTopMap_surjective : Function.Surjective originalTopMap :=
  modelToTop_surjective.comp modelEquiv.symm.surjective

end PrimitiveAffineDegreeTwoTwelveRow72Projection
end SymmetricSubgroupAsymptotics

end
