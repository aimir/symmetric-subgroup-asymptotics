def generatorEnd (g : Fin 3) : Module.End (ZMod 2) ModelModule :=
  (forwardMatrix g).mulVecLin
def rowEnd (i : Fin 48) : Module.End (ZMod 2) ModelModule :=
  (rowMatrix i).mulVecLin

private theorem matrix_step_columns : ∀ i j k,
    rowColumns (PrimitiveAffineSixteenFrameRow2TopCertificate.certificate.next i j) k =
      binaryMaskLinearCombination 32 (rowColumns i) (forwardColumns j k) := by
  native_decide

private theorem matrix_step_matrix : ∀ i j,
    rowMatrix (PrimitiveAffineSixteenFrameRow2TopCertificate.certificate.next i j) =
      rowMatrix i * forwardMatrix j := by
  intro i j
  exact binaryMatrixOfColumnMasks_mul_of_columns 32
    (rowColumns i) (forwardColumns j)
    (rowColumns (PrimitiveAffineSixteenFrameRow2TopCertificate.certificate.next i j))
    (matrix_step_columns i j)

private theorem matrix_step : ∀ i j,
    rowEnd (PrimitiveAffineSixteenFrameRow2TopCertificate.certificate.next i j) = rowEnd i * generatorEnd j := by
  intro i j
  apply LinearMap.ext
  intro v
  change (rowMatrix (PrimitiveAffineSixteenFrameRow2TopCertificate.certificate.next i j)).mulVec v =
    (rowMatrix i).mulVec ((forwardMatrix j).mulVec v)
  rw [matrix_step_matrix, Matrix.mulVec_mulVec]

private theorem matrix_identity :
    rowEnd PrimitiveAffineSixteenFrameRow2TopCertificate.certificate.identity = 1 := by
  apply LinearMap.ext
  intro v
  change (rowMatrix PrimitiveAffineSixteenFrameRow2TopCertificate.certificate.identity).mulVec v = v
  have h : rowMatrix PrimitiveAffineSixteenFrameRow2TopCertificate.certificate.identity = 1 := by native_decide
  rw [h, Matrix.one_mulVec]

def representation : Representation (ZMod 2) Source ModelModule :=
  PrimitiveAffineSixteenFrameRow2TopCertificate.certificate.checkedHom rowEnd generatorEnd matrix_step
    PrimitiveAffineSixteenFrameRow2TopCertificate.rows_injective PrimitiveAffineSixteenFrameRow2TopCertificate.previousRow
    PrimitiveAffineSixteenFrameRow2TopCertificate.previous_checked matrix_identity

private def oddGeneratorIndex (j : Fin 1) : Fin 48 :=
  1
def oddGenerators (j : Fin 1) : Source := ⟨oddGeneratorIndex j⟩

private def oddEncoding : GeneratorEncoding oddGenerators (Fin 48) where
  encode x := x.index
  injective := fun _ _ h ↦ FiniteGroupRow.ext h
  one := PrimitiveAffineSixteenFrameRow2TopCertificate.certificate.identity
  encode_one := rfl
  step i j := PrimitiveAffineSixteenFrameRow2TopCertificate.certificate.rowMul i (oddGeneratorIndex j)
  encode_step := by intro x j; rfl

private def oddRows (i : Fin 3) : Fin 48 := (if i.val < 1 then 0 else (if i.val < 2 then 1 else 4))
private def oddRanks (i : Fin 3) : ℕ := (if i.val < 1 then 0 else (if i.val < 2 then 1 else 2))
private def oddParents (i : Fin 3) : Fin 3 := (if i.val < 1 then 0 else (if i.val < 2 then 0 else 1))
private def oddLetters (i : Fin 3) : Fin 1 := (if i.val < 1 then 0 else (if i.val < 2 then 0 else 0))
private def oddNext (i : Fin 3) (j : Fin 1) : Fin 3 := ((if i.val < 1 then #[1] else (if i.val < 2 then #[2] else #[0])) : Array (Fin 3))[j.val]!

private def oddCertificate : EncodedCayleyCertificate oddEncoding 3 where
  rows := oddRows
  identity := 0
  identity_eq := by native_decide
  next := oddNext
  next_eq := (by native_decide)
  rank := oddRanks
  parent i _ := oddParents i
  letter i _ := oddLetters i
  parent_lt := (by native_decide)
  parent_next := (by native_decide)

private theorem oddRows_injective : Function.Injective oddCertificate.rows := by
  native_decide

def oddSubgroup : Subgroup Source := Subgroup.closure (Set.range oddGenerators)

private theorem oddSubgroup_card : Nat.card oddSubgroup = 3 :=
  oddCertificate.card_closure oddRows_injective

def normalizerElement : Source := ⟨0⟩

private theorem normalizerElement_normalizes :
    normalizerElement ∈ Subgroup.normalizer (oddSubgroup : Set Source) := by
  apply Subgroup.mem_normalizer_fintype
  intro x hx
  change x ∈ Subgroup.closure (Set.range oddGenerators) at hx
  change normalizerElement * x * normalizerElement⁻¹ ∈
    Subgroup.closure (Set.range oddGenerators)
  rw [oddCertificate.mem_closure_iff] at hx ⊢
  obtain ⟨i, hi⟩ := hx
  have hxi : x = (⟨oddRows i⟩ : Source) := FiniteGroupRow.ext hi.symm
  subst x
  fin_cases i <;> native_decide

