        refine ⟨selectedMover x,?_⟩
        simpa [hx] using selectedMover_sends x
      · right
        apply Quotient.sound
        change x∈MulAction.orbit selectedAxis selectedRightRepresentative
        apply MulAction.mem_orbit_iff.mpr
        refine ⟨selectedMover x,?_⟩
        simpa [hx] using selectedMover_sends x

