import SymmetricSubgroupAsymptotics.PrimitiveAffineDegreeFourZeroCoreBinarySchurNumerics
import SymmetricSubgroupAsymptotics.SchurTargetExtension
import SymmetricSubgroupAsymptotics.SemisimpleModuleGenerators
import SymmetricSubgroupAsymptotics.Non2SchurMixedSocleDimension

/-!
# Assemble the two-layer noncentral binary Schur bound

The whole elementary binary socle is filtered by its intersection with the
retained translation image.  This module packages the algebraic part of the
argument: target left-exactness adds the translation and top multiplicities,
the audited small-power arithmetic bounds their sum, and Jacobson density
turns the resulting row bounds into one shared generating tuple.

The two exceptional scalar translation estimates remain explicit premises
here.  Downstream degree-four files prove them from the literal cyclic-seven
and cyclic-three action kernels of the actual induced two-space.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open scoped Classical MonoidAlgebra

namespace SymmetricSubgroupAsymptotics

variable {k B A : Type} [Field k] [Finite k] [Group B]
  [AddCommGroup A] [Module k A]

/-- Over any literal two-element field, every one-dimensional
representation is fixed.  Keeping the field type unchanged avoids a
dependent rewrite of the surrounding elementary chart. -/
theorem representationSubmoduleFixed_of_card_two_finrank_one
    (hcardk : Nat.card k = 2)
    (sigma : Representation k B A)
    (S : Submodule k[B] sigma.asModule)
    (hS : Module.finrank k S = 1) :
    representationSubmoduleFixed sigma S := by
  let rhoS : Representation k B S := Representation.ofModule' S
  intro g x
  obtain ⟨c, hc, _⟩ :=
    LinearMap.existsUnique_eq_smul_id_of_finrank_eq_one hS (rhoS g)
  letI : Nontrivial S := Module.nontrivial_of_finrank_pos (by
    rw [hS]
    decide)
  have hcne : c ≠ 0 := by
    intro hc0
    have hz : rhoS g = 0 := by
      rw [hc, hc0, zero_smul]
    obtain ⟨y, hy⟩ := exists_ne (0 : S)
    have hzero : y = 0 := by
      calc
        y = rhoS g (rhoS g⁻¹ y) := by simp [rhoS]
        _ = 0 := by rw [hz]; rfl
    exact hy hzero
  have hbits : ∀ z : k, z = 0 ∨ z = 1 := by
    obtain ⟨u, _hu, hu_unique⟩ :=
      (Nat.card_eq_two_iff' (0 : k)).mp hcardk
    intro z
    by_cases hz : z = 0
    · exact Or.inl hz
    · right
      exact (hu_unique z hz).trans
        (hu_unique 1 one_ne_zero).symm
  have hc1 : c = 1 := (hbits c).resolve_left hcne
  have hx := LinearMap.congr_fun hc x
  rw [hc1] at hx
  change rhoS g x = x
  simpa using hx

/-- A semisimple binary representation is generated by the exact
five-eighths slot budget once its translation/top filtration has the two
audited scalar-row refinements. -/
theorem degreeFourZeroCore_semisimple_generated_of_schur_filtration
    [FiniteDimensional k A]
    (hcardk : Nat.card k = 2)
    (sigma : Representation k B A)
    [IsSemisimpleModule k[B] sigma.asModule]
    (K : Submodule k[B] sigma.asModule)
    [FiniteDimensional k K]
    [FiniteDimensional k (sigma.asModule ⧸ K)]
    (s : ℕ) (hs : s = 8 ∨ s = 16)
    (hnonfixed : ∀ S : Submodule k[B] sigma.asModule,
      [IsSimpleModule k[B] S] →
      ¬ representationSubmoduleFixed sigma S)
    (htranslation : Module.finrank k K ≤ 2 * s)
    (htop : 2 * Module.finrank k (sigma.asModule ⧸ K) ≤ s)
    (hthree : ∀ S : Submodule k[B] sigma.asModule,
      [IsSimpleModule k[B] S] →
      Module.finrank k S = 3 →
      Module.finrank (Module.End k[B] S) S = 1 →
      3 * schurSocleMultiplicity
        (k := k) (R := k[B]) (A := K) (X := S) ≤ s)
    (htwo : ∀ S : Submodule k[B] sigma.asModule,
      [IsSimpleModule k[B] S] →
      Module.finrank k S = 2 →
      Module.finrank (Module.End k[B] S) S = 1 →
      8 * schurSocleMultiplicity
        (k := k) (R := k[B]) (A := K) (X := S) ≤ 3 * s) :
    RepresentationGeneratedBy sigma (degreeFourZeroCoreSchurSlots s) := by
  letI : Module k[B] sigma.asModule :=
    Representation.instModuleMonoidAlgebraAsModule sigma
  letI : IsScalarTower k k[B] sigma.asModule :=
    inferInstanceAs
      (IsScalarTower k k[B] (Representation.asModule sigma))
  apply semisimple_representationGeneratedBy_of_schurCapacity_le
    sigma (degreeFourZeroCoreSchurSlots s)
  unfold representationSchurCapacity schurCapacity
  apply csSup_le (Set.insert_nonempty _ _)
  rintro x (rfl | ⟨S, hS, rfl⟩)
  · positivity
  · letI : IsSimpleModule k[B] S := hS
    letI : Nontrivial S := IsSimpleModule.nontrivial k[B] S
    letI : FiniteDimensional k S :=
      FiniteDimensional.of_injective
        (S.subtype.restrictScalars k) S.subtype_injective
    let h := Module.finrank k S
    let e := Module.finrank (Module.End k[B] S) S
    let mE := schurSocleMultiplicity
      (k := k) (R := k[B]) (A := K) (X := S)
    let mT := schurSocleMultiplicity
      (k := k) (R := k[B])
      (A := sigma.asModule ⧸ K) (X := S)
    have hhpos : 0 < h := Module.finrank_pos (R := k) (M := S)
    have hhne : h ≠ 1 := by
      intro hh1
      exact hnonfixed S
        (representationSubmoduleFixed_of_card_two_finrank_one hcardk sigma S hh1)
    have hh : 2 ≤ h := by omega
    have htower : h =
        Module.finrank k (Module.End k[B] S) * e := by
      simpa only [h, e] using
        (schur_simple_finrank_tower
          (k := k) (R := k[B]) (X := S))
    have hepos : 0 < e := by
      by_contra he0
      have hezero : e = 0 := Nat.eq_zero_of_not_pos he0
      rw [htower, hezero, mul_zero] at hhpos
      omega
    have he : 1 ≤ e := hepos
    have hediv : e ∣ h := by
      exact ⟨Module.finrank k (Module.End k[B] S), by
        simpa only [Nat.mul_comm, h, e] using htower⟩
    have hE : h * mE ≤ 2 * s :=
      (finrank_mul_schurSocleMultiplicity_le
        (k := k) (R := k[B]) (A := K) (X := S)).trans
          htranslation
    have hT : 2 * h * mT ≤ s := by
      have hrow := finrank_mul_schurSocleMultiplicity_le
        (k := k) (R := k[B])
        (A := sigma.asModule ⧸ K) (X := S)
      calc
        2 * h * mT = 2 * (h * mT) := by simp only [Nat.mul_assoc]
        _ ≤ 2 * Module.finrank k (sigma.asModule ⧸ K) :=
          Nat.mul_le_mul_left 2 hrow
        _ ≤ s := htop
    have hsum : mE + mT ≤ degreeFourZeroCoreSchurSlots s * e :=
      degreeFourZeroCore_schurMultiplicity_add_le_slots_mul hs hh he hediv
        hE hT
        (by intro hh3 he1; exact hthree S hh3 he1)
        (by intro hh2 he1; exact htwo S hh2 he1)
    have hm := schurSocleMultiplicity_le_submodule_add_quotient
      (k := k) (R := k[B]) (A := sigma.asModule)
      (X := S) K
    have hm' : schurSocleMultiplicity
        (k := k) (R := k[B])
        (A := sigma.asModule) (X := S) ≤
          degreeFourZeroCoreSchurSlots s * e := hm.trans hsum
    rw [schurSimpleRatio_eq_multiplicity_division
      (k := k) (R := k[B])
      (A := sigma.asModule) (X := S)]
    have heR : (0 : ℝ) < e := by exact_mod_cast he
    apply (div_le_iff₀ heR).2
    exact_mod_cast hm'

end SymmetricSubgroupAsymptotics

end
