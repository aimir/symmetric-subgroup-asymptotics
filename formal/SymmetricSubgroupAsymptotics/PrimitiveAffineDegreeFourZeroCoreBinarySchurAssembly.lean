import SymmetricSubgroupAsymptotics.PrimitiveAffineDegreeFourZeroCoreBinarySchurNumerics
import SymmetricSubgroupAsymptotics.SchurTargetExtension
import SymmetricSubgroupAsymptotics.SemisimpleModuleGenerators
import SymmetricSubgroupAsymptotics.Non2SchurMixedSocleDimension

/-!
# Assemble the two-layer noncentral binary Schur bound

The whole elementary binary socle is filtered by its intersection with the
retained translation image.  This module packages the algebraic part of the
argument: target left-exactness adds the translation and top multiplicities,
the audited small-power arithmetic bounds their sum, and Jacobson density
turns the resulting row bounds into one shared generating tuple.

The two exceptional scalar translation estimates remain explicit premises
here.  Downstream degree-four files prove them from the literal cyclic-seven
and cyclic-three action kernels of the actual induced two-space.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open scoped Classical MonoidAlgebra

namespace SymmetricSubgroupAsymptotics

variable {B A : Type} [Group B]
  [AddCommGroup A] [Module (ZMod 2) A]

/-- A semisimple binary representation is generated by the exact
five-eighths slot budget once its translation/top filtration has the two
audited scalar-row refinements. -/
theorem degreeFourZeroCore_semisimple_generated_of_schur_filtration
    [FiniteDimensional (ZMod 2) A]
    (sigma : Representation (ZMod 2) B A)
    [IsSemisimpleModule (ZMod 2)[B] sigma.asModule]
    (K : Submodule (ZMod 2)[B] sigma.asModule)
    [FiniteDimensional (ZMod 2) K]
    [FiniteDimensional (ZMod 2) (sigma.asModule ⧸ K)]
    (s : ℕ) (hs : s = 8 ∨ s = 16)
    (hnonfixed : ∀ S : Submodule (ZMod 2)[B] sigma.asModule,
      [IsSimpleModule (ZMod 2)[B] S] →
      ¬ representationSubmoduleFixed sigma S)
    (htranslation : Module.finrank (ZMod 2) K ≤ 2 * s)
    (htop : 2 * Module.finrank (ZMod 2) (sigma.asModule ⧸ K) ≤ s)
    (hthree : ∀ S : Submodule (ZMod 2)[B] sigma.asModule,
      [IsSimpleModule (ZMod 2)[B] S] →
      Module.finrank (ZMod 2) S = 3 →
      Module.finrank (Module.End (ZMod 2)[B] S) S = 1 →
      3 * schurSocleMultiplicity
        (k := ZMod 2) (R := (ZMod 2)[B]) (A := K) (X := S) ≤ s)
    (htwo : ∀ S : Submodule (ZMod 2)[B] sigma.asModule,
      [IsSimpleModule (ZMod 2)[B] S] →
      Module.finrank (ZMod 2) S = 2 →
      Module.finrank (Module.End (ZMod 2)[B] S) S = 1 →
      8 * schurSocleMultiplicity
        (k := ZMod 2) (R := (ZMod 2)[B]) (A := K) (X := S) ≤ 3 * s) :
    RepresentationGeneratedBy sigma (degreeFourZeroCoreSchurSlots s) := by
  letI : Module (ZMod 2)[B] sigma.asModule :=
    Representation.instModuleMonoidAlgebraAsModule sigma
  letI : IsScalarTower (ZMod 2) (ZMod 2)[B] sigma.asModule :=
    inferInstanceAs
      (IsScalarTower (ZMod 2) (ZMod 2)[B] (Representation.asModule sigma))
  apply semisimple_representationGeneratedBy_of_schurCapacity_le
    sigma (degreeFourZeroCoreSchurSlots s)
  unfold representationSchurCapacity schurCapacity
  apply csSup_le (Set.insert_nonempty _ _)
  rintro x (rfl | ⟨S, hS, rfl⟩)
  · positivity
  · letI : IsSimpleModule (ZMod 2)[B] S := hS
    letI : Nontrivial S := IsSimpleModule.nontrivial (ZMod 2)[B] S
    letI : FiniteDimensional (ZMod 2) S :=
      FiniteDimensional.of_injective
        (S.subtype.restrictScalars (ZMod 2)) S.subtype_injective
    let h := Module.finrank (ZMod 2) S
    let e := Module.finrank (Module.End (ZMod 2)[B] S) S
    let mE := schurSocleMultiplicity
      (k := ZMod 2) (R := (ZMod 2)[B]) (A := K) (X := S)
    let mT := schurSocleMultiplicity
      (k := ZMod 2) (R := (ZMod 2)[B])
      (A := sigma.asModule ⧸ K) (X := S)
    have hhpos : 0 < h := Module.finrank_pos (R := ZMod 2) (M := S)
    have hhne : h ≠ 1 := by
      intro hh1
      exact hnonfixed S
        (representationSubmoduleFixed_of_binary_finrank_one sigma S hh1)
    have hh : 2 ≤ h := by omega
    have htower : h =
        Module.finrank (ZMod 2) (Module.End (ZMod 2)[B] S) * e := by
      simpa only [h, e] using
        (schur_simple_finrank_tower
          (k := ZMod 2) (R := (ZMod 2)[B]) (X := S))
    have hepos : 0 < e := by
      by_contra he0
      have hezero : e = 0 := Nat.eq_zero_of_not_pos he0
      rw [htower, hezero, mul_zero] at hhpos
      omega
    have he : 1 ≤ e := hepos
    have hediv : e ∣ h := by
      exact ⟨Module.finrank (ZMod 2) (Module.End (ZMod 2)[B] S), by
        simpa only [Nat.mul_comm, h, e] using htower⟩
    have hE : h * mE ≤ 2 * s :=
      (finrank_mul_schurSocleMultiplicity_le
        (k := ZMod 2) (R := (ZMod 2)[B]) (A := K) (X := S)).trans
          htranslation
    have hT : 2 * h * mT ≤ s := by
      have hrow := finrank_mul_schurSocleMultiplicity_le
        (k := ZMod 2) (R := (ZMod 2)[B])
        (A := sigma.asModule ⧸ K) (X := S)
      calc
        2 * h * mT = 2 * (h * mT) := by simp only [Nat.mul_assoc]
        _ ≤ 2 * Module.finrank (ZMod 2) (sigma.asModule ⧸ K) :=
          Nat.mul_le_mul_left 2 hrow
        _ ≤ s := htop
    have hsum : mE + mT ≤ degreeFourZeroCoreSchurSlots s * e :=
      degreeFourZeroCore_schurMultiplicity_add_le_slots_mul hs hh he hediv
        hE hT
        (by intro hh3 he1; exact hthree S hh3 he1)
        (by intro hh2 he1; exact htwo S hh2 he1)
    have hm := schurSocleMultiplicity_le_submodule_add_quotient
      (k := ZMod 2) (R := (ZMod 2)[B]) (A := sigma.asModule)
      (X := S) K
    have hm' : schurSocleMultiplicity
        (k := ZMod 2) (R := (ZMod 2)[B])
        (A := sigma.asModule) (X := S) ≤
          degreeFourZeroCoreSchurSlots s * e := hm.trans hsum
    rw [schurSimpleRatio_eq_multiplicity_division
      (k := ZMod 2) (R := (ZMod 2)[B])
      (A := sigma.asModule) (X := S)]
    have heR : (0 : ℝ) < e := by exact_mod_cast he
    apply (div_le_iff₀ heR).2
    exact_mod_cast hm'

end SymmetricSubgroupAsymptotics

end
