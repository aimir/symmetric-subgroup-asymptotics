def failureRelator (k : Third) (l : Fourth) (m : Fifth) : Fin 5 :=
  ⟨(failureCode k.val l.val m.val).val / 22,by
    have h := (failureCode k.val l.val m.val).isLt
    omega⟩

def failurePoint (k : Third) (l : Fourth) (m : Fifth) : Fin 22 :=
  ⟨(failureCode k.val l.val m.val).val % 22,Nat.mod_lt _ (by decide)⟩

theorem witness_moves : ∀ (k : Third) (l : Fourth) (m : Fifth),
    relationValue (failureRelator k l m) xSeed
      (decodedPermutation (selectedCode k l m)) (failurePoint k l m) ≠ failurePoint k l m := by
  decide +kernel

theorem accepts_pointwise (c : Code) (h : Accepts (decode c)) (r : Fin 5) (p : Fin 22) :
    relationValue r xSeed (decodedPermutation c) p = p := by
  have hh : (relationValue r firstElement (decode c)).val = (1 : Equiv.Perm (Fin 22)) :=
    congrArg (fun u : CFSG.Models.Mathieu22 => u.val) (h r)
  rw [relationValue_coe,firstElement_coe_eq,decode_coe_eq] at hh
  exact congrArg (fun q : Equiv.Perm (Fin 22) => q p) hh

theorem selected_prefix_excluded (k : Third) (l : Fourth) (m : Fifth) :
    ¬Accepts (decode (selectedCode k l m)) := by
  intro h
  exact witness_moves k l m
    (accepts_pointwise (selectedCode k l m) h (failureRelator k l m) (failurePoint k l m))

theorem excluded_of_prefix (c : Code) (hfirst : c.1.1 = 1) (hsecond : c.1.2.val = 1) :
    ¬Accepts (decode c) := by
  rcases c with ⟨⟨i,j⟩,⟨k,⟨l,m⟩⟩⟩
  change i = 1 at hfirst
  subst i
  have hj : j = (⟨1,by decide⟩ : Second) := Subtype.ext hsecond
  subst j
  exact selected_prefix_excluded k l m

theorem map_second_not_selected (f : MulAut CFSG.Models.Mathieu22)
    (hf : f firstElement = firstElement) (k : Third) (l : Fourth) (m : Fifth) :
    f secondElement ≠ decode (selectedCode k l m) := by
  intro he
  apply selected_prefix_excluded k l m
  rw [←he]
  exact accepts_of_fixed_first f hf

