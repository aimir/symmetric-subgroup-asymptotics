import SymmetricSubgroupAsymptotics.CFSGTwistedE6GeckFixedBruhatOppositeAlignment
import SymmetricSubgroupAsymptotics.CFSGTwistedE6GeckRootGeneratedPGroup
import SymmetricSubgroupAsymptotics.CFSGTwistedE6GeckFixedRangePreimage
import SymmetricSubgroupAsymptotics.CFSGSubgroupOppositeAlignmentRestriction

/-! Actual opposite alignment in the subgroup J generated by literal
fixed U and V. Its inclusion into raw matrices is injective, and its
positive part covers exactly fixed U. No equality between J and all
semilinear fixed matrices is asserted or used. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
open scoped Classical
namespace SymmetricSubgroupAsymptotics.CFSGTwistedE6GeckGeneratedOppositeAlignment
open CFSGTwistedE6GeckFixedBruhatOppositeAlignment CFSGTwistedE6GeckRootGeneratedPGroup
open CFSGTwistedE6GeckFixedRangePreimage CFSGTwistedE6GeckRelativeRootGenerated
open CFSGTwistedE6GeckDiagramCovariance CFSGSubgroupOppositeAlignmentRestriction

theorem rootPart_raw_image (K : Type) [Field K] (sigma : K≃+*K) (neg : Bool) :
    (rootPart K sigma neg).map (fixedRootGenerated K sigma).subtype=signedFixed K sigma neg :=
  Subgroup.map_subgroupOf_eq_of_le (signedFixed_le_generated K sigma neg)

theorem generated_opposite_conjugate_by_positive (K : Type) [Field K] [Finite K]
    (sigma : K≃+*K) (g : fixedRootGenerated K sigma)
    (hdisj : rootPart K sigma false⊓(rootPart K sigma false).map
      (MulAut.conj g).toMonoidHom=⊥) :
    ∃b∈rootPart K sigma false,(rootPart K sigma false).map (MulAut.conj g).toMonoidHom=
      (rootPart K sigma true).map (MulAut.conj b).toMonoidHom := by
  apply restrict_alignment (fixedRootGenerated K sigma).subtype Subtype.val_injective
    (rootPart K sigma false) (signedFixed K sigma false) (signedFixed K sigma true)
    (rootPart_raw_image K sigma false) ?_ g hdisj
  intro a ha
  exact fixed_opposite_conjugate_by_positive K sigma a.val
    (fixedRootGenerated_le_matrixGroup K sigma a.property)
    (fixedRootGenerated_le_fixed K sigma a.property) ha

end SymmetricSubgroupAsymptotics.CFSGTwistedE6GeckGeneratedOppositeAlignment
