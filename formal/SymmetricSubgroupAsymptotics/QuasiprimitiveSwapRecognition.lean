import Mathlib.GroupTheory.GroupAction.Primitive
import Mathlib.GroupTheory.Perm.ClosureSwap
import Mathlib.GroupTheory.Perm.Cycle.Type

/-! A quasiprimitive permutation group containing a transposition is
the full symmetric group. Its actual normal closure is transitive and
is generated by literal conjugate transpositions. No block-system or
action catalogue is used. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
namespace SymmetricSubgroupAsymptotics.QuasiprimitiveSwapRecognition

open MulAction Subgroup Equiv.Perm
variable {X : Type*} [Finite X] [DecidableEq X]

theorem eq_top_of_isSwap_mem (P : Subgroup (Equiv.Perm X))
    [MulAction.IsQuasiPreprimitive P X] (t : Equiv.Perm X)
    (ht : t.IsSwap) (htP : t∈P) : P=⊤ := by
  classical
  letI : Fintype X := Fintype.ofFinite X
  let a : P := ⟨t,htP⟩
  let N : Subgroup P := Subgroup.normalClosure ({a} : Set P)
  have haN : a∈N := Subgroup.subset_normalClosure (Set.mem_singleton a)
  have hnotfixed : MulAction.fixedPoints N X≠Set.univ := by
    obtain ⟨x,y,hxy,he⟩ := ht
    intro hfixed
    have hx : x∈MulAction.fixedPoints N X := hfixed.symm ▸ Set.mem_univ x
    have hh := MulAction.mem_fixedPoints.mp hx (⟨a,haN⟩ : N)
    change t x=x at hh
    rw [he,Equiv.swap_apply_left] at hh
    exact hxy hh.symm
  letI : MulAction.IsPretransitive N X :=
    MulAction.IsQuasiPreprimitive.isPretransitive_of_normal hnotfixed
  let f : N →* Equiv.Perm X := P.subtype.comp N.subtype
  let S : Set (Equiv.Perm X) := P.subtype '' Group.conjugatesOfSet ({a} : Set P)
  have hmap : f.range=N.map P.subtype := by
    ext g
    constructor
    · rintro ⟨n,rfl⟩
      exact ⟨n.val,n.property,rfl⟩
    · rintro ⟨n,hn,rfl⟩
      exact ⟨⟨n,hn⟩,rfl⟩
  have hclosure : f.range=Subgroup.closure S :=
    hmap.trans (P.subtype.map_closure (Group.conjugatesOfSet ({a} : Set P)))
  have htrans : MulAction.IsPretransitive f.range X := by
    constructor
    intro x y
    obtain ⟨n,hn⟩ := MulAction.exists_smul_eq N x y
    exact ⟨⟨f n,⟨n,rfl⟩⟩,hn⟩
  have htrans' : MulAction.IsPretransitive (Subgroup.closure S) X := by
    rw [←hclosure]
    exact htrans
  letI := htrans'
  have hswap : ∀ g∈S, Equiv.Perm.IsSwap g := by
    rintro _ ⟨g,hg,rfl⟩
    obtain ⟨b,hb,hconj⟩ := Group.mem_conjugatesOfSet_iff.mp hg
    have hb' : b=a := Set.mem_singleton_iff.mp hb
    subst b
    have hc : IsConj t (g : Equiv.Perm X) := P.subtype.map_isConj hconj
    have he := Equiv.Perm.isConj_iff_cycleType_eq.mp hc
    apply Equiv.Perm.isSwap_iff_cycleType.mpr
    change (g : Equiv.Perm X).cycleType={2}
    exact he.symm.trans (Equiv.Perm.isSwap_iff_cycleType.mp ht)
  have htop : Subgroup.closure S=⊤ :=
    closure_of_isSwap_of_isPretransitive hswap
  have hle : Subgroup.closure S≤P := by
    apply (Subgroup.closure_le P).2
    rintro _ ⟨g,_,rfl⟩
    exact g.property
  exact top_unique (htop ▸ hle)

end SymmetricSubgroupAsymptotics.QuasiprimitiveSwapRecognition
