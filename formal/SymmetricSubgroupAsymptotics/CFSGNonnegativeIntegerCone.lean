import SymmetricSubgroupAsymptotics.CFSGIntegerMatrixPairing
import Mathlib.Algebra.Group.Submonoid.Membership
import Mathlib.Algebra.Group.Submonoid.BigOperators
import Mathlib.Algebra.BigOperators.Pi

/-! Actual nonnegative integer coordinate vectors belong to the additive
monoid generated by the rational coordinate vectors. -/
set_option autoImplicit false
set_option Elab.async false
open scoped BigOperators
namespace SymmetricSubgroupAsymptotics.CFSGNonnegativeIntegerCone
open CFSGIntegerMatrixPairing
variable {n : Type*} [Fintype n] [DecidableEq n]

theorem cast_mem_closure (x : n→ℤ) (hx : ∀ i,0≤x i) :
    castVector x∈AddSubmonoid.closure (Set.range (fun i:n=>(Pi.single i 1:n→ℚ))) := by
  let S := AddSubmonoid.closure (Set.range (fun i:n=>(Pi.single i 1:n→ℚ)))
  have hm : (∑ i,(x i).toNat • (Pi.single i 1:n→ℚ))∈S := by
    apply sum_mem
    intro i _
    exact S.nsmul_mem (AddSubmonoid.subset_closure ⟨i,rfl⟩) _
  have he : (∑ i,(x i).toNat • (Pi.single i 1:n→ℚ))=castVector x := by
    ext j
    simp only [Finset.sum_apply,nsmul_eq_mul]
    change (∑ i,((x i).toNat:ℚ)*(Pi.single i 1:n→ℚ) j)=(x j:ℚ)
    simp only [Pi.single_apply,mul_ite,mul_one,mul_zero,
      Finset.sum_ite_eq',Finset.sum_ite_eq,Finset.mem_univ,if_true]
    change ((x j).toNat:ℚ)=(x j:ℚ)
    exact_mod_cast Int.toNat_of_nonneg (hx j)
  rw [he] at hm
  exact hm

end SymmetricSubgroupAsymptotics.CFSGNonnegativeIntegerCone
