import SymmetricSubgroupAsymptotics.SocleNormalGeneratorNumber

/-!
# Pairing normal generators across disjoint socle types

If two normal socle sums have no common ambient normal quotient, padded
normal-generating tuples can be paired coordinatewise.  The normal subgroup
generated by the pairs projects onto both sums.  The no-common-quotient
condition forces that subgroup to be the whole join, so the normal-generator
cost is the maximum of the two costs rather than their sum.

The relation below is the intrinsic Goursat formulation.  It mentions only
normal subgroups of the original ambient group; no abstract isomorphism-type
labels or chosen quotient equivalences enter its definition.
-/

set_option autoImplicit false
noncomputable section
open scoped Classical
open scoped commutatorElement

namespace SymmetricSubgroupAsymptotics

/-- `A` and `B` have no common nontrivial ambient normal quotient: every
ambient-normal subgroup of `A ⊔ B` which projects onto both factors is the
whole join.  The projection conditions are written intrinsically as joins,
so the definition also applies before an internal-product equivalence has
been selected. -/
def NoCommonNormalQuotient {G : Type} [Group G]
    (A B : Subgroup G) : Prop :=
  ∀ H : Subgroup G, H.Normal → H ≤ A ⊔ B →
    H ⊔ A = A ⊔ B → H ⊔ B = A ⊔ B → H = A ⊔ B

/-- Synonym emphasizing the section-theoretic use of
`NoCommonNormalQuotient`. -/
abbrev NoCommonNormalSection {G : Type} [Group G]
    (A B : Subgroup G) : Prop :=
  NoCommonNormalQuotient A B

theorem noCommonNormalQuotient_comm {G : Type} [Group G]
    (A B : Subgroup G) :
    NoCommonNormalQuotient A B ↔ NoCommonNormalQuotient B A := by
  constructor
  · intro h H hH hle hHB hHA
    have hle' : H ≤ A ⊔ B := by
      simpa only [sup_comm A B] using hle
    have hHA' : H ⊔ A = A ⊔ B := hHA.trans (sup_comm B A)
    have hHB' : H ⊔ B = A ⊔ B := hHB.trans (sup_comm B A)
    have hEq := h H hH hle' hHA' hHB'
    exact hEq.trans (sup_comm A B)
  · intro h H hH hle hHA hHB
    have hle' : H ≤ B ⊔ A := by
      simpa only [sup_comm A B] using hle
    have hHB' : H ⊔ B = B ⊔ A := hHB.trans (sup_comm A B)
    have hHA' : H ⊔ A = B ⊔ A := hHA.trans (sup_comm A B)
    have hEq := h H hH hle' hHB' hHA'
    exact hEq.trans (sup_comm B A)

/-- A concrete action-type separator implies the intrinsic Goursat
condition.  If an ambient normal subgroup `D` has full commutator on `A`
and centralizes `B`, then no nontrivial quotient type can be shared by the
two socle sums. -/
theorem noCommonNormalQuotient_of_commutator_full_central
    {G : Type} [Group G]
    (D A B : Subgroup G) [D.Normal] [A.Normal] [B.Normal]
    (hfull : ⁅D, A⁆ = A)
    (hcentral : B ≤ Subgroup.centralizer (D : Set G)) :
    NoCommonNormalQuotient A B := by
  intro H hH hHle hHA hHB
  letI : H.Normal := hH
  let q : G →* G ⧸ H := QuotientGroup.mk' H
  have hDB : ⁅D, B⁆ = ⊥ := by
    rw [Subgroup.commutator_comm]
    exact Subgroup.commutator_eq_bot_iff_le_centralizer.mpr hcentral
  have hmapH : H.map q = ⊥ := by
    apply (Subgroup.map_eq_bot_iff (H := H)).mpr
    simpa only [q, QuotientGroup.ker_mk'] using (le_refl H)
  have hmapSup : (H ⊔ B).map q = B.map q := by
    rw [Subgroup.map_sup, hmapH, bot_sup_eq]
  have hcommSup : ⁅D, H ⊔ B⁆ ≤ H := by
    have hmap : (⁅D, H ⊔ B⁆).map q = ⊥ := by
      rw [Subgroup.map_commutator, hmapSup, ← Subgroup.map_commutator,
        hDB, Subgroup.map_bot]
    have hle := (Subgroup.map_eq_bot_iff (H := ⁅D, H ⊔ B⁆)).mp hmap
    simpa only [q, QuotientGroup.ker_mk'] using hle
  have hA_le_sup : A ≤ H ⊔ B := by
    rw [hHB]
    exact le_sup_left
  have hA_le_H : A ≤ H := by
    rw [← hfull]
    exact (Subgroup.commutator_mono le_rfl hA_le_sup).trans hcommSup
  exact (sup_eq_left.mpr hA_le_H).symm.trans hHA

/-- A `Fin t` normal-generating tuple gives the corresponding numerical
upper bound. -/
theorem normalGen_le_of_fin_tuple
    {G : Type} [Group G] {N : Subgroup G} [N.Normal]
    {t : ℕ} (x : Fin t → G)
    (hx : Subgroup.normalClosure (Set.range x) = N) :
    MarkedC4.normalGen N ≤ t := by
  let s : Finset G := Finset.univ.image x
  have hs : (s : Set G) = Set.range x := by
    ext y
    constructor
    · intro hy
      obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp hy
      exact Set.mem_range_self i
    · rintro ⟨i, rfl⟩
      exact Finset.mem_image.mpr ⟨i, Finset.mem_univ i, rfl⟩
  have hsN : (s : Set G) ⊆ N := by
    rw [hs, ← hx]
    exact Subgroup.subset_normalClosure
  have hsClosure : Subgroup.normalClosure (s : Set G) = N := by
    rw [hs]
    exact hx
  calc
    MarkedC4.normalGen N ≤ s.card :=
      MarkedC4.normalGen_le hsN hsClosure
    _ ≤ Finset.univ.card := Finset.card_image_le
    _ = t := Finset.card_fin t

/-- **Paired normal generators.**  In the absence of a common ambient
normal quotient, the join of two normal subgroups needs at most the maximum
of their two normal-generator numbers. -/
theorem normalGen_sup_le_max_of_noCommonNormalQuotient
    {G : Type} [Group G] [Finite G]
    (A B : Subgroup G) [A.Normal] [B.Normal]
    (hNoCommon : NoCommonNormalQuotient A B) :
    MarkedC4.normalGen (A ⊔ B) ≤
      max (MarkedC4.normalGen A) (MarkedC4.normalGen B) := by
  let t := max (MarkedC4.normalGen A) (MarkedC4.normalGen B)
  obtain ⟨a, ha⟩ := exists_normal_generating_tuple_of_normalGen_le A
    (show MarkedC4.normalGen A ≤ t from le_max_left _ _)
  obtain ⟨b, hb⟩ := exists_normal_generating_tuple_of_normalGen_le B
    (show MarkedC4.normalGen B ≤ t from le_max_right _ _)
  let x : Fin t → G := fun i => a i * b i
  let H : Subgroup G := Subgroup.normalClosure (Set.range x)
  have haA (i : Fin t) : a i ∈ A := by
    rw [← ha]
    exact Subgroup.subset_normalClosure (Set.mem_range_self i)
  have hbB (i : Fin t) : b i ∈ B := by
    rw [← hb]
    exact Subgroup.subset_normalClosure (Set.mem_range_self i)
  have hxH (i : Fin t) : x i ∈ H :=
    Subgroup.subset_normalClosure (Set.mem_range_self i)
  have hHle : H ≤ A ⊔ B := by
    apply Subgroup.normalClosure_le_normal
    rintro y ⟨i, rfl⟩
    exact (A ⊔ B).mul_mem (Subgroup.mem_sup_left (haA i))
      (Subgroup.mem_sup_right (hbB i))
  have hAleHB : A ≤ H ⊔ B := by
    rw [← ha]
    apply Subgroup.normalClosure_le_normal
    rintro y ⟨i, rfl⟩
    rw [show a i = x i * (b i)⁻¹ by simp [x]]
    exact (H ⊔ B).mul_mem (Subgroup.mem_sup_left (hxH i))
      (Subgroup.mem_sup_right (B.inv_mem (hbB i)))
  have hBleHA : B ≤ H ⊔ A := by
    rw [← hb]
    apply Subgroup.normalClosure_le_normal
    rintro y ⟨i, rfl⟩
    rw [show b i = (a i)⁻¹ * x i by simp [x]]
    exact (H ⊔ A).mul_mem (Subgroup.mem_sup_right (A.inv_mem (haA i)))
      (Subgroup.mem_sup_left (hxH i))
  have hHA : H ⊔ A = A ⊔ B := by
    apply le_antisymm
    · exact sup_le hHle le_sup_left
    · exact sup_le le_sup_right hBleHA
  have hHB : H ⊔ B = A ⊔ B := by
    apply le_antisymm
    · exact sup_le hHle le_sup_right
    · exact sup_le hAleHB le_sup_right
  have hH : H = A ⊔ B :=
    hNoCommon H (inferInstance : H.Normal) hHle hHA hHB
  change MarkedC4.normalGen (A ⊔ B) ≤ t
  apply normalGen_le_of_fin_tuple x
  exact hH

/-! ## Canonical socle parts -/

private theorem finset_sup_normal {G : Type} [Group G]
    (S : Finset (Subgroup G)) (hS : ∀ M ∈ S, M.Normal) :
    (S.sup (fun M : Subgroup G => M)).Normal := by
  induction S using Finset.induction_on with
  | empty => simp
  | @insert M S hMS ih =>
      letI : M.Normal := hS M (Finset.mem_insert_self M S)
      letI : (S.sup (fun K : Subgroup G => K)).Normal := ih (fun K hK =>
        hS K (Finset.mem_insert_of_mem hK))
      simpa only [Finset.sup_insert, id_eq] using
        (inferInstance : (M ⊔ S.sup (fun K : Subgroup G => K)).Normal)

/-- The sum of the minimal normal subgroups selected by a predicate. -/
def minimalNormalSoclePart
    (G : Type) [Group G] [Finite G]
    (P : Subgroup G → Prop) : Subgroup G :=
  (Finset.univ.filter (fun M : Subgroup G =>
    IsMinimalNormalSubgroup M ∧ P M)).sup id

/-- To bound a selected socle part, it is enough to bound every selected
minimal normal subgroup. -/
theorem minimalNormalSoclePart_le_of
    (G : Type) [Group G] [Finite G]
    (P : Subgroup G → Prop) (K : Subgroup G)
    (h : ∀ M : Subgroup G, IsMinimalNormalSubgroup M → P M → M ≤ K) :
    minimalNormalSoclePart G P ≤ K := by
  unfold minimalNormalSoclePart
  apply Finset.sup_le
  intro M hM
  exact h M (Finset.mem_filter.mp hM).2.1
    (Finset.mem_filter.mp hM).2.2

instance minimalNormalSoclePart_normal
    (G : Type) [Group G] [Finite G]
    (P : Subgroup G → Prop) :
    (minimalNormalSoclePart G P).Normal := by
  unfold minimalNormalSoclePart
  apply finset_sup_normal
  intro M hM
  exact (Finset.mem_filter.mp hM).2.1.1

theorem minimalNormal_le_minimalNormalSoclePart
    {G : Type} [Group G] [Finite G]
    (P : Subgroup G → Prop) (M : Subgroup G)
    (hM : IsMinimalNormalSubgroup M) (hP : P M) :
    M ≤ minimalNormalSoclePart G P := by
  exact Finset.le_sup (f := id) (Finset.mem_filter.mpr
    ⟨Finset.mem_univ M, hM, hP⟩)

theorem minimalNormalSoclePart_le_finiteGroupSocle
    (G : Type) [Group G] [Finite G]
    (P : Subgroup G → Prop) :
    minimalNormalSoclePart G P ≤ finiteGroupSocle G := by
  unfold minimalNormalSoclePart
  apply Finset.sup_le
  intro M hM x hx
  have hmin : IsMinimalNormalSubgroup M := (Finset.mem_filter.mp hM).2.1
  exact Subgroup.subset_normalClosure ⟨M, hmin, hx⟩

/-- The selected socle sum depends only on the predicate's values on
ambient minimal normal subgroups. -/
theorem minimalNormalSoclePart_congr
    (G : Type) [Group G] [Finite G]
    (P Q : Subgroup G → Prop)
    (h : ∀ M : Subgroup G, IsMinimalNormalSubgroup M →
      (P M ↔ Q M)) :
    minimalNormalSoclePart G P = minimalNormalSoclePart G Q := by
  unfold minimalNormalSoclePart
  apply congrArg (fun S : Finset (Subgroup G) => S.sup id)
  ext M
  simp only [Finset.mem_filter, Finset.mem_univ, true_and]
  constructor
  · rintro ⟨hM, hP⟩
    exact ⟨hM, (h M hM).mp hP⟩
  · rintro ⟨hM, hQ⟩
    exact ⟨hM, (h M hM).mpr hQ⟩

/-- Complementary predicates partition the whole finite-group socle. -/
theorem minimalNormalSoclePart_sup_compl_eq_finiteGroupSocle
    (G : Type) [Group G] [Finite G]
    (P : Subgroup G → Prop) :
    minimalNormalSoclePart G P ⊔
      minimalNormalSoclePart G (fun M => ¬ P M) =
        finiteGroupSocle G := by
  apply le_antisymm
  · exact sup_le
      (minimalNormalSoclePart_le_finiteGroupSocle G P)
      (minimalNormalSoclePart_le_finiteGroupSocle G (fun M => ¬ P M))
  · rw [finiteGroupSocle]
    apply Subgroup.normalClosure_le_normal
    rintro x ⟨M, hM, hx⟩
    by_cases hP : P M
    · exact Subgroup.mem_sup_left
        (minimalNormal_le_minimalNormalSoclePart P M hM hP hx)
    · exact Subgroup.mem_sup_right
        (minimalNormal_le_minimalNormalSoclePart (fun K => ¬ P K)
          M hM hP hx)

/-! ## Canonical split by the action of a normal separator -/

/-- The sum of ambient minimal normal factors on which `D` has full
commutator. -/
abbrev nontrivialActionSoclePart
    (G : Type) [Group G] [Finite G] (D : Subgroup G) : Subgroup G :=
  minimalNormalSoclePart G (fun M => ⁅D, M⁆ = M)

/-- The complementary sum of ambient minimal normal factors on which `D`
does not have full commutator. -/
abbrev trivialActionSoclePart
    (G : Type) [Group G] [Finite G] (D : Subgroup G) : Subgroup G :=
  minimalNormalSoclePart G (fun M => ¬ ⁅D, M⁆ = M)

/-- On an ambient minimal normal subgroup, a normal separator acts either
fully or trivially. -/
theorem minimalNormal_commutator_full_or_trivial
    {G : Type} [Group G]
    (D M : Subgroup G) [D.Normal]
    (hM : IsMinimalNormalSubgroup M) :
    ⁅D, M⁆ = M ∨ ⁅D, M⁆ = ⊥ := by
  letI : M.Normal := hM.1
  by_cases hbot : ⁅D, M⁆ = ⊥
  · exact Or.inr hbot
  · exact Or.inl (hM.2.2 ⁅D, M⁆ inferInstance hbot
      (Subgroup.commutator_le_right D M))

/-- The selected nontrivial-action sum has full commutator with `D`. -/
theorem commutator_nontrivialActionSoclePart
    (G : Type) [Group G] [Finite G]
    (D : Subgroup G) [D.Normal] :
    ⁅D, nontrivialActionSoclePart G D⁆ =
      nontrivialActionSoclePart G D := by
  apply le_antisymm
  · exact Subgroup.commutator_le_right _ _
  · unfold nontrivialActionSoclePart minimalNormalSoclePart
    apply Finset.sup_le
    intro M hM
    have hMfull : ⁅D, M⁆ = M := (Finset.mem_filter.mp hM).2.2
    rw [← hMfull]
    exact Subgroup.commutator_mono le_rfl
      (Finset.le_sup (f := id) hM)

/-- The complementary action-type sum centralizes `D`. -/
theorem trivialActionSoclePart_le_centralizer
    (G : Type) [Group G] [Finite G]
    (D : Subgroup G) [D.Normal] :
    trivialActionSoclePart G D ≤ Subgroup.centralizer (D : Set G) := by
  apply minimalNormalSoclePart_le_of
  intro M hMmin hMnot
  have hMbot : ⁅D, M⁆ = ⊥ :=
    (minimalNormal_commutator_full_or_trivial D M hMmin).resolve_left hMnot
  apply Subgroup.commutator_eq_bot_iff_le_centralizer.mp
  rw [Subgroup.commutator_comm]
  exact hMbot

/-- The two action-type sums cover the ambient socle. -/
theorem nontrivialActionSoclePart_sup_trivialActionSoclePart
    (G : Type) [Group G] [Finite G]
    (D : Subgroup G) :
    nontrivialActionSoclePart G D ⊔ trivialActionSoclePart G D =
      finiteGroupSocle G :=
  minimalNormalSoclePart_sup_compl_eq_finiteGroupSocle G
    (fun M => ⁅D, M⁆ = M)

/-- The action split automatically has no shared ambient normal quotient. -/
theorem noCommonNormalQuotient_actionSocleParts
    (G : Type) [Group G] [Finite G]
    (D : Subgroup G) [D.Normal] :
    NoCommonNormalQuotient
      (nontrivialActionSoclePart G D)
      (trivialActionSoclePart G D) :=
  noCommonNormalQuotient_of_commutator_full_central D _ _
    (commutator_nontrivialActionSoclePart G D)
    (trivialActionSoclePart_le_centralizer G D)

/-- Normal generators of distinct `D`-action types share their tuple
coordinates automatically. -/
theorem normalGen_finiteGroupSocle_le_max_actionSocleParts
    (G : Type) [Group G] [Finite G]
    (D : Subgroup G) [D.Normal] :
    MarkedC4.normalGen (finiteGroupSocle G) ≤
      max
        (MarkedC4.normalGen (nontrivialActionSoclePart G D))
        (MarkedC4.normalGen (trivialActionSoclePart G D)) := by
  rw [← nontrivialActionSoclePart_sup_trivialActionSoclePart G D]
  exact normalGen_sup_le_max_of_noCommonNormalQuotient _ _
    (noCommonNormalQuotient_actionSocleParts G D)

/-- Canonical type-sharing form for a partition of the minimal normal
subgroups: once the two socle parts have no common ambient normal quotient,
the whole socle costs the maximum of their two costs. -/
theorem normalGen_finiteGroupSocle_le_max_of_noCommonNormalQuotient
    (G : Type) [Group G] [Finite G]
    (P : Subgroup G → Prop)
    (hNoCommon : NoCommonNormalQuotient
      (minimalNormalSoclePart G P)
      (minimalNormalSoclePart G (fun M => ¬ P M))) :
    MarkedC4.normalGen (finiteGroupSocle G) ≤
      max
        (MarkedC4.normalGen (minimalNormalSoclePart G P))
        (MarkedC4.normalGen
          (minimalNormalSoclePart G (fun M => ¬ P M))) := by
  rw [← minimalNormalSoclePart_sup_compl_eq_finiteGroupSocle G P]
  exact normalGen_sup_le_max_of_noCommonNormalQuotient _ _ hNoCommon

end SymmetricSubgroupAsymptotics

