import SymmetricSubgroupAsymptotics.External.CFSG.Models.Chevalley
import Mathlib.Algebra.Lie.Derivation.Basic

/-! Pointwise nilpotence is stable under Lie generation. These are actual
closure proofs, including the derivation Leibniz estimate for brackets. -/
set_option autoImplicit false
noncomputable section
open scoped Classical BigOperators
namespace SymmetricSubgroupAsymptotics.CFSGSerreLocalNilpotence

variable {R L : Type*} [CommRing R] [LieRing L] [LieAlgebra R L]

theorem end_pow_apply_zero_of_le (D : Module.End R L) {x : L} {k m : ℕ}
    (hk : (D ^ k) x = 0) (hkm : k ≤ m) : (D ^ m) x = 0 := by
  rw [show m = (m - k) + k from (Nat.sub_add_cancel hkm).symm,
    pow_add, Module.End.mul_apply, hk, map_zero]

def adDerivation (x : L) : LieDerivation R L L := -LieDerivation.inner R L L x

@[simp] theorem adDerivation_toLinearMap (x : L) :
    (adDerivation x).toLinearMap = LieAlgebra.ad R L x := by
  ext y
  change -⁅y, x⁆ = ⁅x, y⁆
  exact lie_skew x y

def locallyNilpotentSubalgebra (D : LieDerivation R L L) : LieSubalgebra R L where
  carrier := {x | ∃ k : ℕ, (D.toLinearMap ^ k) x = 0}
  zero_mem' := ⟨0, by simp⟩
  add_mem' := by
    rintro x y ⟨k, hk⟩ ⟨l, hl⟩
    refine ⟨k + l, ?_⟩
    rw [map_add, end_pow_apply_zero_of_le D.toLinearMap hk (Nat.le_add_right k l),
      end_pow_apply_zero_of_le D.toLinearMap hl (Nat.le_add_left l k), add_zero]
  smul_mem' := by
    rintro a x ⟨k, hk⟩
    exact ⟨k, by rw [map_smul, hk, smul_zero]⟩
  lie_mem' := by
    rintro x y ⟨k, hk⟩ ⟨l, hl⟩
    refine ⟨k + l, ?_⟩
    rw [Module.End.pow_apply]
    change D^[k + l] ⁅x, y⁆ = 0
    rw [LieDerivation.iterate_apply_lie]
    apply Finset.sum_eq_zero
    intro ij hij
    have hij' : ij.1 + ij.2 = k + l := Finset.mem_antidiagonal.mp hij
    by_cases hi : k ≤ ij.1
    · have hz : D^[ij.1] x = 0 := by
        simpa only [Module.End.pow_apply] using end_pow_apply_zero_of_le D.toLinearMap hk hi
      rw [hz, zero_lie, smul_zero]
    · have hj : l ≤ ij.2 := by omega
      have hz : D^[ij.2] y = 0 := by
        simpa only [Module.End.pow_apply] using end_pow_apply_zero_of_le D.toLinearMap hl hj
      rw [hz, lie_zero, smul_zero]

/-- Any surjective image of a free Lie algebra is Lie-generated by the
actual images of its actual generators. -/
theorem lieSpan_image_of_freeLie_surjective {X : Type*}
    (f : FreeLieAlgebra R X →ₗ⁅R⁆ L) (hf : Function.Surjective f) :
    LieSubalgebra.lieSpan R L (Set.range (fun x => f (FreeLieAlgebra.of R x))) = ⊤ := by
  let S := LieSubalgebra.lieSpan R L (Set.range (fun x => f (FreeLieAlgebra.of R x)))
  let generators : X → S := fun x =>
    ⟨f (FreeLieAlgebra.of R x), LieSubalgebra.subset_lieSpan ⟨x, rfl⟩⟩
  let h := FreeLieAlgebra.lift R generators
  have hhom : S.incl.comp h = f := by
    apply FreeLieAlgebra.hom_ext
    intro x
    change (h (FreeLieAlgebra.of R x)).val = f (FreeLieAlgebra.of R x)
    rw [FreeLieAlgebra.lift_of_apply]
  apply top_unique
  intro x _
  obtain ⟨y, rfl⟩ := hf x
  have he := congrArg (fun g : FreeLieAlgebra R X →ₗ⁅R⁆ L => g y) hhom
  change (h y).val = f y at he
  rw [← he]
  exact (h y).property

/-- Local nilpotence on Lie generators suffices for local nilpotence at
every point, with a point-dependent exponent. -/
theorem locallyNilpotent_of_lieSpan_generators (D : LieDerivation R L L) (s : Set L)
    (hs : LieSubalgebra.lieSpan R L s = ⊤)
    (hgen : ∀ x ∈ s, ∃ k : ℕ, (D.toLinearMap ^ k) x = 0) :
    ∀ x : L, ∃ k : ℕ, (D.toLinearMap ^ k) x = 0 := by
  have hle : LieSubalgebra.lieSpan R L s ≤ locallyNilpotentSubalgebra D :=
    LieSubalgebra.lieSpan_le.mpr hgen
  intro x
  apply hle
  rw [hs]
  trivial

end SymmetricSubgroupAsymptotics.CFSGSerreLocalNilpotence
