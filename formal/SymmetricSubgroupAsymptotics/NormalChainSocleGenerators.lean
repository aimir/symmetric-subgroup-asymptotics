import SymmetricSubgroupAsymptotics.FiniteTwoNormalSocleGenerators
import Mathlib.GroupTheory.QuotientGroup.Basic

/-!
# One socle generator for a chain of normal subgroups

When the normal subgroups are linearly ordered, all minimal normal
subgroups coincide. A nonidentity element of that subgroup normally
generates the socle. The property descends along any surjection, so one
checked normal-chain certificate covers every quotient simultaneously.
The theorem also handles a trivial socle and needs no finiteness hypothesis.
-/

set_option autoImplicit false
noncomputable section
open scoped Classical

namespace SymmetricSubgroupAsymptotics

/-- A chain of normal subgroups has a socle generated by one element. -/
theorem socleNormalGeneratorBound_one_of_normal_total
    {G : Type} [Group G]
    (hchain : ∀ N M : Subgroup G, N.Normal → M.Normal → N ≤ M ∨ M ≤ N) :
    SocleNormalGeneratorBound G 1 := by
  by_cases hminimal : ∃ N : Subgroup G, IsMinimalNormalSubgroup N
  · obtain ⟨N, hN⟩ := hminimal
    letI : N.Normal := hN.1
    have unique (M : Subgroup G) (hM : IsMinimalNormalSubgroup M) : M = N := by
      rcases hchain M N hM.1 hN.1 with hle | hle
      · exact hN.2.2 M hM.1 hM.2.1 hle
      · exact (hM.2.2 N hN.1 hN.2.1 hle).symm
    have hsocle : finiteGroupSocle G = N := by
      apply le_antisymm
      · apply Subgroup.normalClosure_le_normal
        rintro x ⟨M, hM, hx⟩
        rwa [unique M hM] at hx
      · intro x hx
        exact Subgroup.subset_normalClosure ⟨N, hN, hx⟩
    obtain ⟨x, hx, hxne⟩ := N.bot_or_exists_ne_one.resolve_left hN.2.1
    let generators : Fin 1 → G := fun _ ↦ x
    have hle : Subgroup.normalClosure (Set.range generators) ≤ N := by
      apply Subgroup.normalClosure_le_normal
      rintro y ⟨i, rfl⟩
      exact hx
    have hne : Subgroup.normalClosure (Set.range generators) ≠ ⊥ := by
      intro hbot
      apply hxne
      apply Subgroup.mem_bot.mp
      rw [← hbot]
      exact Subgroup.subset_normalClosure (Set.mem_range_self (0 : Fin 1))
    exact ⟨generators, (hN.2.2 _ inferInstance hne hle).trans hsocle.symm⟩
  · have hsocle : finiteGroupSocle G = ⊥ := by
      apply le_antisymm _ bot_le
      apply Subgroup.normalClosure_le_normal
      rintro x ⟨N, hN, _⟩
      exact (hminimal ⟨N, hN⟩).elim
    refine ⟨fun _ ↦ 1, ?_⟩
    rw [hsocle]
    apply le_antisymm _ bot_le
    apply Subgroup.normalClosure_le_normal
    rintro x ⟨i, rfl⟩
    exact one_mem _

/-- Surjections preserve comparability of normal subgroups. -/
theorem normalSubgroups_total_of_surjective
    {G H : Type} [Group G] [Group H]
    (f : G →* H) (hf : Function.Surjective f)
    (hchain : ∀ N M : Subgroup G, N.Normal → M.Normal → N ≤ M ∨ M ≤ N) :
    ∀ N M : Subgroup H, N.Normal → M.Normal → N ≤ M ∨ M ≤ N := by
  intro N M hN hM
  rcases hchain (N.comap f) (M.comap f) (hN.comap f) (hM.comap f) with h | h
  · left
    simpa only [Subgroup.map_comap_eq_self_of_surjective hf] using
      (Subgroup.map_mono (f := f) h)
  · right
    simpa only [Subgroup.map_comap_eq_self_of_surjective hf] using
      (Subgroup.map_mono (f := f) h)

/-- One normal-chain check gives the one-generator socle bound on every
literal normal quotient. -/
theorem quotientSocleNormalGeneratorBound_one_of_normal_total
    {G : Type} [Group G]
    (hchain : ∀ N M : Subgroup G, N.Normal → M.Normal → N ≤ M ∨ M ≤ N)
    (N : Subgroup G) [N.Normal] :
    SocleNormalGeneratorBound (G ⧸ N) 1 :=
  socleNormalGeneratorBound_one_of_normal_total
    (normalSubgroups_total_of_surjective (QuotientGroup.mk' N)
      (QuotientGroup.mk'_surjective N) hchain)

end SymmetricSubgroupAsymptotics

end
