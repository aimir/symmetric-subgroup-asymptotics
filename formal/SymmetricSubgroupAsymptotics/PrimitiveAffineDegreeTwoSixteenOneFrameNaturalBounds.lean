/-!
# Uniform natural-module bounds for all sixty-four one-frame tops

Each original point action is retained. Sixty-three entries use a literal
cyclic element with at most four point orbits; the first zero-core entry
uses a four-generator group-algebra polynomial certificate. Both routes
bound every invariant submodule, without listing invariant subspaces.

The remaining one-frame packages need only their original quotient-socle
families. This file does not assume or assert those remaining families.
-/

set_option autoImplicit false
noncomputable section

namespace SymmetricSubgroupAsymptotics
namespace PrimitiveAffineDegreeTwoSixteenOneFrameNaturalBounds

open Non2UnipotentPrefixFiniteMenu
open Non2UnipotentPrefixFiniteMenu.PrimitiveAffineImprimitiveBlockTransfer
open DegreeTwoSixteenOneFrameFiniteRows

/-- All 29 literal zero16 natural modules have generator bound four. -/
theorem zero16 (j : Fin 29) : UniformSubrepresentationGeneratorBound
    (permutationFunctionRepresentation (ZMod 2)
      (DegreeTwoSixteenPairFiniteCatalogue.catalogue.zero16 j).top (Fin 16)) 4 := by
  fin_cases j
  · exact PrimitiveAffineDegreeTwoZeroSixteenRow1AlgebraPolynomial.natural
  · exact PrimitiveAffineDegreeTwoZeroSixteenRow2OrbitWitness.natural
