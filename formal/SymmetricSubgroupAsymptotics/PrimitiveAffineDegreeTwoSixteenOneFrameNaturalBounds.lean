/-- Only the quotient-socle certificates remain to assemble all one-frame rows. -/
noncomputable def ofSocleFamilies
    (zeroSocle : ∀ j : Fin 29,
      (DegreeTwoSixteenPairFiniteCatalogue.catalogue.zero16 j).normalRegistry.QuotientSocleGeneratorFamily 2)
    (twoAffineSocle : ∀ j : Fin 15,
      (DegreeTwoSixteenPairFiniteCatalogue.catalogue.twoAffine16 j).normalRegistry.QuotientSocleGeneratorFamily 2)
    (primitiveSocle : ∀ j : Fin 20,
      (DegreeTwoSixteenPairFiniteCatalogue.catalogue.primitive16 j).normalRegistry.QuotientSocleGeneratorFamily 2) :
    Catalogue.DegreeTwoSixteenOneFrameFiniteCatalogueData where
  zero16 j := .ofCertificates (zeroSocle j) (zero16 j)
  twoAffine16 j := .ofCertificates (twoAffineSocle j) (twoAffine16 j)
  primitive16 j := .ofCertificates (primitiveSocle j) (primitive16 j)

end PrimitiveAffineDegreeTwoSixteenOneFrameNaturalBounds
