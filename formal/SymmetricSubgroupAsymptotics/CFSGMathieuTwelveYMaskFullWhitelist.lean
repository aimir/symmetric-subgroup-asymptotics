private def rawWhitelist : List ℕ := [0, 40, 80, 243, 283, 323, 324, 364, 404, 567, 607, 647, 648, 688, 728, 891, 931, 971, 972, 1012, 1052, 1215, 1255, 1295, 1296, 1336, 1376, 1539, 1579, 1619, 1620, 1660, 1700, 1863, 1903, 1943]

private def savedBlock (c : ℕ) : Block :=
  wittBlockAt ⟨savedBadIndices[c]!%132,Nat.mod_lt _ (by decide)⟩

private def rawCheck (c : ℕ) : Bool :=
  rawWhitelist.contains c || !(bitmap.testBit (∑ p ∈ savedBlock c, 2^(rawPoint c p.val)))

private def batchSize (b : Fin 31) : ℕ := if b.val < 30 then 64 else 24

private def batch (b : Fin 31) : Bool :=
  (List.range (batchSize b)).all (fun j => rawCheck (64*b.val+j))

