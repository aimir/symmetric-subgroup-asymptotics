private theorem raw_check (c : Fin 1944) : rawCheck c.val = true := by
  let b : Fin 31 := ⟨c.val/64,by have hc := c.isLt; omega⟩
  have hj : c.val%64 < batchSize b := by
    dsimp only [batchSize,b]
    split_ifs <;> have hc := c.isLt <;> omega
  have hm := List.all_eq_true.mp (batch_certificate b) (c.val%64) (List.mem_range.mpr hj)
  change rawCheck (64*b.val+c.val%64) = true at hm
  have he : 64*b.val+c.val%64 = c.val := by dsimp only [b]; omega
  rw [he] at hm
  exact hm

private def valueEmbedding : Fin 1944 ↪ ℕ := ⟨Fin.val,Fin.val_injective⟩

private theorem raw_whitelist_codes :
    rawWhitelist.toFinset = literalWhitelist.map valueEmbedding := by
  decide +kernel

private theorem raw_whitelist_mem (c : Fin 1944)
    (h : rawWhitelist.contains c.val = true) : c ∈ literalWhitelist := by
  have hm : c.val ∈ rawWhitelist.toFinset :=
    List.mem_toFinset.mpr (List.contains_iff_mem.mp h)
  rw [raw_whitelist_codes] at hm
  exact (Finset.mem_map' valueEmbedding).mp hm

theorem all_codes_witnesses (c : Fin 1944) : c ∈ literalWhitelist ∨
    ∃ k : Fin 132, blockMap (indexedChart c) (wittBlockAt k) ∉ wittBlocks := by
  have hm := raw_check c
  change (rawWhitelist.contains c.val || _) = true at hm
  rw [Bool.or_eq_true_eq_eq_true_or_eq_true] at hm
  rcases hm with hw | hn
  · exact Or.inl (raw_whitelist_mem c hw)
  · apply Or.inr
    refine ⟨⟨savedBadIndices[c.val]!%132,Nat.mod_lt _ (by decide)⟩,?_⟩
    apply rejects_of_raw_mask_false
    simpa only [Bool.not_eq_true'] using hn

theorem original_y_centralizer_card_le_thirtySix :
    Nat.card (Subgroup.centralizer ({y} : Set M12)) ≤ 36 := by
  calc
    Nat.card (Subgroup.centralizer ({y} : Set M12)) ≤ literalWhitelist.card := by
      apply CFSGMathieuTwelveWittCentralizerWhitelist.y_centralizer_card_le_of_bad_blocks
        indexedChart indexedChart_complete literalWhitelist
      intro c _ hnot
      rcases all_codes_witnesses c with hw | hb
      · exact (hnot hw).elim
      · exact hb
    _ = 36 := literal_whitelist_card

end SymmetricSubgroupAsymptotics.CFSGMathieuTwelveYMaskFullWhitelist
