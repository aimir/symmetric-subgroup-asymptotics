import Mathlib.Algebra.Lie.SerreConstruction
import Mathlib.LinearAlgebra.TensorProduct.Tower
import Mathlib.Algebra.Group.Subgroup.Basic
import Mathlib.GroupTheory.Commutator.Basic
import Mathlib.GroupTheory.QuotientGroup.Basic

/-!
# An integral adjoint construction from an explicit Cartan matrix

The rational Serre Lie algebra is reduced modulo a prime only *after* forming
an integral lattice stable under divided powers. Reducing the rational vector
space itself would give the zero tensor product in positive characteristic.
The construction uses simple positive and negative root operators, not two
unspecified generators. See the semantic audit for identification obligations.
-/

namespace CFSG.Models.Chevalley
noncomputable section
open scoped TensorProduct BigOperators

variable {n : ℕ} (A : Matrix (Fin n) (Fin n) ℤ)

abbrev RationalLie := Matrix.ToLieAlgebra ℚ A

/-- Images of the Serre generators in the rational quotient. -/
def generator (g : CartanMatrix.Generators (Fin n)) : RationalLie A :=
  LieSubmodule.Quotient.mk (FreeLieAlgebra.of ℚ g)

/-- `false` selects E, `true` selects F. -/
def rootVector (negative : Bool) (i : Fin n) : RationalLie A :=
  generator A (if negative then .F i else .E i)

/-- Divided powers are formed over Q, before reduction to the finite field. -/
def dividedPower (negative : Bool) (i : Fin n) (k : ℕ) :
    RationalLie A →ₗ[ℤ] RationalLie A :=
  (((k.factorial : ℚ)⁻¹ •
    (LieAlgebra.ad ℚ (RationalLie A) (rootVector A negative i)) ^ k)).restrictScalars ℤ

/-- The least integral submodule containing the Serre generators and stable
under all simple-root divided powers. No choice of a Chevalley basis is made. -/
def integralLattice : Submodule ℤ (RationalLie A) :=
  sInf {L | (∀ g, generator A g ∈ L) ∧
    ∀ negative i k x, x ∈ L → dividedPower A negative i k x ∈ L}

theorem dividedPower_mem (negative : Bool) (i : Fin n) (k : ℕ)
    (x : RationalLie A) (hx : x ∈ integralLattice A) :
    dividedPower A negative i k x ∈ integralLattice A := by
  rw [integralLattice, Submodule.mem_sInf] at hx ⊢
  intro L hL
  exact hL.2 negative i k x (hx L hL)

/-- The divided-power operator on the actual integral lattice. -/
def integralOperator (negative : Bool) (i : Fin n) (k : ℕ) :
    integralLattice A →ₗ[ℤ] integralLattice A :=
  (dividedPower A negative i k).restrict (dividedPower_mem A negative i k)

variable (K : Type) [Field K]

/-- Base change of the integral lattice, rather than the rational Lie algebra. -/
abbrev Space := K ⊗[ℤ] integralLattice A

/-- Adjoint root element. For finite crystallographic types ad(e)^4 = 0,
so terms k=0,1,2,3 suffice, including G2. -/
def rootOperator (negative : Bool) (i : Fin n) (t : K) :
    Space A K →ₗ[K] Space A K :=
  ∑ k ∈ Finset.range 4,
    t ^ k • (integralOperator A negative i k).baseChange K

/-- The ambient linear automorphism group. -/
abbrev Ambient := Space A K ≃ₗ[K] Space A K

/-- An element with the specified root-operator coordinates. -/
def IsRootElement (negative : Bool) (i : Fin n) (t : K) (g : Ambient A K) : Prop :=
  g.toLinearMap = rootOperator A K negative i t

/-- Elementary adjoint Chevalley group, generated by all simple root elements. -/
def subgroup : Subgroup (Ambient A K) :=
  Subgroup.closure {g | ∃ negative i t, IsRootElement A K negative i t g}

abbrev Model := ↥(subgroup A K)

/-- The diagonal homomorphism, used to read a generated graph as a fixed subgroup. -/
def diagonal : Ambient A K →* Ambient A K × Ambient A K where
  toFun g := (g, g)
  map_one' := rfl
  map_mul' _ _ := rfl

/-- Graph of a prescribed map on pinned simple-root elements. For the diagram
and field maps used in the classification this is the graph of the standard
Steinberg endomorphism. The subgroup definition itself needs no existence axiom. -/
def twistGraph (perm : Fin n → Fin n) (exponent : Fin n → ℕ) :
    Subgroup (Ambient A K × Ambient A K) :=
  Subgroup.closure {gh | ∃ negative i t,
    IsRootElement A K negative i t gh.1 ∧
    IsRootElement A K negative (perm i) (t ^ exponent i) gh.2}

/-- Fixed subgroup of the prescribed graph. The intersection makes its
containment in the elementary group explicit even for arbitrary input data. -/
def fixedSubgroup (perm : Fin n → Fin n) (exponent : Fin n → ℕ) :
    Subgroup (Ambient A K) :=
  subgroup A K ⊓ (twistGraph A K perm exponent).comap (diagonal A K)

/-- Derived subgroup of the fixed subgroup, with its actual center removed. -/
abbrev Twisted (perm : Fin n → Fin n) (exponent : Fin n → ℕ) :=
  let D := ↥(commutator ↥(fixedSubgroup A K perm exponent))
  D ⧸ Subgroup.center D

/-- Adjoint construction with the actual center removed explicitly. -/
abbrev Projective := Model A K ⧸ Subgroup.center (Model A K)

end
end CFSG.Models.Chevalley
