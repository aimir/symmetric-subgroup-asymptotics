  | 4 => [Gen.bInv, Gen.a, Gen.a, Gen.b, Gen.aInv, Gen.b, Gen.b, Gen.a, Gen.a]
  | 21 => [Gen.aInv, Gen.aInv, Gen.bInv, Gen.bInv, Gen.a, Gen.bInv, Gen.aInv, Gen.aInv, Gen.b]
  | _ => []

set_option maxRecDepth 400000 in
/-- The first-step certificate words send `22` to every point. -/
theorem levelOneWord_maps_last_all :
    ∀ x : Fin 23, (Word.eval (levelOneWord x)) (22 : Fin 23) = x := by
  decide

set_option maxRecDepth 400000 in
/-- The second-step certificate words fix `22`. -/
theorem levelTwoWord_fixes_last_all :
    ∀ x : Fin 23, x ≠ 22 → (Word.eval (levelTwoWord x)) (22 : Fin 23) = 22 := by
  decide

set_option maxRecDepth 400000 in
/-- The second-step certificate words send `0` to the requested point. -/
