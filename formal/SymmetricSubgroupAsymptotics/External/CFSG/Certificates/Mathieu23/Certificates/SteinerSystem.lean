/-- The candidate blocks as a `Finset`. -/
def heptads : Finset Block :=
  heptadList.toFinset

set_option maxRecDepth 400000 in
/-- The candidate block list has length 253. -/
theorem heptadList_length : heptadList.length = 253 := by
  decide

/-- The block with certificate index `i`. -/
def heptadAt (i : Fin 253) : Block :=
  heptadList.get ⟨i.1, by rw [heptadList_length]; exact i.2⟩

/-- Every indexed candidate block belongs to `heptads`. -/
theorem heptadAt_mem (i : Fin 253) : heptadAt i ∈ heptads := by
  rw [heptads]
  exact List.mem_toFinset.mpr (List.get_mem heptadList _)

/-- Membership in the listed blocks gives membership in the block finset. -/
theorem mem_heptads_of_mem_heptadList {B : Block} (hB : B ∈ heptadList) :
    B ∈ heptads := by
  rw [heptads]
  exact List.mem_toFinset.mpr hB

/-- Membership in the block finset comes from membership in the listed blocks. -/
theorem mem_heptadList_of_mem_heptads {B : Block} (hB : B ∈ heptads) :
    B ∈ heptadList := by
  rw [heptads] at hB
  exact List.mem_toFinset.mp hB

/-- Any member of `heptadList` is one of the indexed candidate blocks. -/
theorem exists_heptadAt_eq_get (i : Fin heptadList.length) :
    ∃ j : Fin 253, heptadList.get i = heptadAt j := by
  let j : Fin 253 := ⟨i.1, by simpa [heptadList_length] using i.2⟩
  refine ⟨j, ?_⟩
  unfold heptadAt
  congr

/-- Image of a block under a degree-23 permutation. -/
def blockMap (g : Perm23) (B : Block) : Block :=
  B.image g

@[simp]
theorem blockMap_one (B : Block) : blockMap (1 : Perm23) B = B := by
  ext x
  simp [blockMap]

@[simp]
theorem blockMap_mul (g h : Perm23) (B : Block) :
    blockMap (g * h) B = blockMap g (blockMap h B) := by
  ext x
  simp [blockMap]

@[simp]
theorem blockMap_inv_self (g : Perm23) (B : Block) :
    blockMap g⁻¹ (blockMap g B) = B := by
  ext x
  simp [blockMap]

/-- A permutation preserves the candidate block set. -/
def PreservesHeptads (g : Perm23) : Prop :=
  (∀ B ∈ heptadList, blockMap g B ∈ heptads) ∧
    (∀ B ∈ heptadList, blockMap g⁻¹ B ∈ heptads)


