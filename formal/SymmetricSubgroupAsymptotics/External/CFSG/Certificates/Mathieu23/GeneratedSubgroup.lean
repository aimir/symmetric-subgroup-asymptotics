import Mathlib.Algebra.Group.Subgroup.Finite
import SymmetricSubgroupAsymptotics.External.CFSG.Certificates.Mathieu23.Permutations

/-!
# The generated subgroup

This file defines the experimental `M23` as the subgroup of
`Equiv.Perm (Fin 23)` generated by the three explicit permutations in
`SporadicM23/Permutations.lean`.
-/

namespace CFSG.Certificates.Mathieu23

/-- The subgroup generated by the three degree-23 Mathieu generator
candidates. -/
def M23Subgroup : Subgroup Perm23 :=
  Subgroup.closure ({m23a, m23b, m23c} : Set Perm23)

/-- The experimental Mathieu group `M23`, as a type. -/
abbrev M23 : Type :=
  M23Subgroup

instance instGroupM23 : Group M23 :=
  inferInstance

noncomputable instance instFintypeM23 : Fintype M23 := by
  classical
  infer_instance

/-- The canonical embedding of `M23` into the ambient degree-23 permutation
group. -/
abbrev M23.toPerm (g : M23) : Perm23 :=
  g.1

/-- The first generator belongs to the generated subgroup. -/
theorem m23a_mem_M23Subgroup : m23a ∈ M23Subgroup :=
  Subgroup.subset_closure (by simp)

/-- The second generator belongs to the generated subgroup. -/
theorem m23b_mem_M23Subgroup : m23b ∈ M23Subgroup :=
  Subgroup.subset_closure (by simp)

/-- The third generator belongs to the generated subgroup. -/
theorem m23c_mem_M23Subgroup : m23c ∈ M23Subgroup :=
  Subgroup.subset_closure (by simp)

end CFSG.Certificates.Mathieu23
