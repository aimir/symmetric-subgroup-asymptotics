  | 8 => [Gen.d, Gen.c, Gen.c, Gen.d]
  | 9 => [Gen.dInv, Gen.c, Gen.c]
  | 10 => [Gen.dInv, Gen.cInv, Gen.cInv]
  | 11 => [Gen.dInv, Gen.cInv, Gen.dInv]
