  have hKP_21 : blockMap π ({1, 2, 5, 6, 11, 12, 22, 23} : Block)
      = ({1, 2, 5, 6, 11, 12, 22, 23} : Block) :=
    blockMap_eq_of_five π hpres atP_21 (by decide) (by decide) (by decide) (by decide) (by decide)
      h1 h2 h5 h22 h23 uniqP_21 atP_21
  have hKP_81 : blockMap π ({0, 1, 3, 5, 6, 17, 18, 23} : Block)
      = ({0, 1, 3, 5, 6, 17, 18, 23} : Block) :=
    blockMap_eq_of_five π hpres atP_81 (by decide) (by decide) (by decide) (by decide) (by decide)
      h0 h1 h3 h5 h23 uniqP_81 atP_81
  have hv6 : π 6 = 6 :=
    stepP_1 _ (mem_of_blockMap_eq π hKP_21 (by decide))
      (mem_of_blockMap_eq π hKP_81 (by decide)) (ne_of_value π h1 (by decide))
      (ne_of_value π h5 (by decide)) (ne_of_value π h23 (by decide))
  have hKP_10 : blockMap π ({0, 3, 6, 11, 14, 19, 22, 23} : Block)
      = ({0, 3, 6, 11, 14, 19, 22, 23} : Block) :=
