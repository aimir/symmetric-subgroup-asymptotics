/--
If a permutation has a verified block-index certificate, then it sends every
listed block to a listed block.
-/
theorem forall_mem_blockMap_mem_of_blockMapAt (g : Perm24) (index : Fin 759 → Fin 759)
    (h : ∀ i : Fin 759, blockMap g (octadAt i) = octadAt (index i)) :
    ∀ B ∈ octadList, blockMap g B ∈ octads := by
  intro B hB
  obtain ⟨i, rfl⟩ := mem_octadList_exists_at hB
  rw [h i]
  exact octadAt_mem (index i)

/--
A permutation preserves the candidate block set once both it and its inverse
have verified block-index certificates.
-/
theorem PreservesOctads.of_blockMapAt (g : Perm24)
    (index invIndex : Fin 759 → Fin 759)
    (h : ∀ i : Fin 759, blockMap g (octadAt i) = octadAt (index i))
    (hinv : ∀ i : Fin 759, blockMap g⁻¹ (octadAt i) = octadAt (invIndex i)) :
    PreservesOctads g :=
  ⟨forall_mem_blockMap_mem_of_blockMapAt g index h,
    forall_mem_blockMap_mem_of_blockMapAt g⁻¹ invIndex hinv⟩

theorem PreservesOctads.one : PreservesOctads (1 : Perm24) := by
  constructor <;> intro B hB
  · rw [blockMap_one]
    exact mem_octads_of_mem_octadList hB
  · change blockMap (1 : Perm24) B ∈ octads
    rw [blockMap_one]
    exact mem_octads_of_mem_octadList hB

theorem PreservesOctads.mul {g h : Perm24}
    (hg : PreservesOctads g) (hh : PreservesOctads h) :
    PreservesOctads (g * h) := by
  constructor
  · intro B hB
    rw [blockMap_mul]
    have hhB : blockMap h B ∈ octads := hh.1 B hB
    exact hg.1 (blockMap h B) (mem_octadList_of_mem_octads hhB)
  · intro B hB
    rw [show (g * h)⁻¹ = h⁻¹ * g⁻¹ by simp, blockMap_mul]
    have hgB : blockMap g⁻¹ B ∈ octads := hg.2 B hB
    exact hh.2 (blockMap g⁻¹ B) (mem_octadList_of_mem_octads hgB)

theorem PreservesOctads.inv {g : Perm24}
    (hg : PreservesOctads g) : PreservesOctads g⁻¹ := by
  constructor
  · exact hg.2
  · exact hg.1

/-- The first generator preserves the candidate block set. -/
theorem m24a_preserves_octads : PreservesOctads m24a :=
  PreservesOctads.of_blockMapAt m24a m24aBlockIndex m24aInvBlockIndex
    m24a_blockMapAt m24aInv_blockMapAt

/-- The second generator preserves the candidate block set. -/
theorem m24b_preserves_octads : PreservesOctads m24b :=
  PreservesOctads.of_blockMapAt m24b m24bBlockIndex m24bInvBlockIndex
    m24b_blockMapAt m24bInv_blockMapAt

/-- The third generator preserves the candidate block set. -/
theorem m24c_preserves_octads : PreservesOctads m24c :=
  PreservesOctads.of_blockMapAt m24c m24cBlockIndex m24cInvBlockIndex
    m24c_blockMapAt m24cInv_blockMapAt

/-- The fourth generator preserves the candidate block set. -/
theorem m24d_preserves_octads : PreservesOctads m24d :=
  PreservesOctads.of_blockMapAt m24d m24dBlockIndex m24dInvBlockIndex
    m24d_blockMapAt m24dInv_blockMapAt

/-- Every element of the generated subgroup preserves the candidate block set. -/
theorem M24_preserves_octads (g : M24) : PreservesOctads g.1 := by
  exact Subgroup.closure_induction
    (p := fun x hx => PreservesOctads x)
    (fun x hx => by
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rcases hx with rfl | rfl | rfl | rfl
      · exact m24a_preserves_octads
      · exact m24b_preserves_octads
      · exact m24c_preserves_octads
      · exact m24d_preserves_octads)
    PreservesOctads.one
    (fun x y _ _ hx hy => PreservesOctads.mul hx hy)
    (fun x _ hx => PreservesOctads.inv hx)
    g.2

/-- The block `B0` through the base points `23, 22, 0, 1, 2`. -/
def blockB0 : Block :=
  ({0, 1, 2, 3, 4, 21, 22, 23} : Block)

set_option maxRecDepth 1000000 in
/-- The block at index `0` is `B0`. -/
theorem octadAt_zero : octadAt (0 : Fin 759) = blockB0 := by
  decide

set_option maxHeartbeats 40000000 in
-- The indexed 759-block uniqueness certificate is intentionally checked by computation.
set_option maxRecDepth 4000000 in
/-- `B0` is the unique listed block through `0`, `1`, `2`, `22`, and `23`. -/
theorem unique_block_01_2_22_23 :
    ∀ i : Fin 759, (0 : Fin 24) ∈ octadAt i → (1 : Fin 24) ∈ octadAt i →
      (2 : Fin 24) ∈ octadAt i → (22 : Fin 24) ∈ octadAt i →
      (23 : Fin 24) ∈ octadAt i → i = 0 := by
  decide +kernel

/-- Membership of a point in the image block, given the point's image. -/
theorem mem_blockMap (g : Perm24) {B : Block} {x : Fin 24} (hx : x ∈ B)
    {v : Fin 24} (hv : g x = v) : v ∈ blockMap g B := by
  rw [← hv]
  exact Finset.mem_image_of_mem g hx

/-- Distinct points have distinct images. -/
theorem ne_of_value (g : Perm24) {u w : Fin 24} {e : Fin 24}
    (hu : g u = e) (hne : w ≠ u) : g w ≠ e := fun h =>
  hne (g.injective (h.trans hu.symm))

/--
A block with five known point images maps to the unique indexed block
through the images.
-/
theorem blockMap_eq_of_five (g : Perm24)
    (hpres : ∀ B ∈ octadList, blockMap g B ∈ octads)
    {B B' : Block} {i₀ : Fin 759} (hBat : octadAt i₀ = B)
    {x y z w u : Fin 24}
    (hx : x ∈ B) (hy : y ∈ B) (hz : z ∈ B) (hw : w ∈ B) (hu : u ∈ B)
    {ix iy iz iw iu : Fin 24}
    (hgx : g x = ix) (hgy : g y = iy) (hgz : g z = iz) (hgw : g w = iw)
    (hgu : g u = iu)
    {t : Fin 759}
    (huniq : ∀ i : Fin 759, ix ∈ octadAt i → iy ∈ octadAt i →
      iz ∈ octadAt i → iw ∈ octadAt i → iu ∈ octadAt i → i = t)
    (hat : octadAt t = B') :
    blockMap g B = B' := by
  have hBmem : B ∈ octadList :=
    mem_octadList_of_mem_octads (hBat ▸ octadAt_mem i₀)
  obtain ⟨i, hi⟩ := mem_octadList_exists_at
    (mem_octadList_of_mem_octads (hpres B hBmem))
  have h1 : ix ∈ octadAt i := by
    rw [← hi]
    exact mem_blockMap g hx hgx
  have h2 : iy ∈ octadAt i := by
    rw [← hi]
    exact mem_blockMap g hy hgy
  have h3 : iz ∈ octadAt i := by
    rw [← hi]
    exact mem_blockMap g hz hgz
  have h4 : iw ∈ octadAt i := by
    rw [← hi]
    exact mem_blockMap g hw hgw
  have h5 : iu ∈ octadAt i := by
    rw [← hi]
    exact mem_blockMap g hu hgu
  rw [hi, huniq i h1 h2 h3 h4 h5, hat]

/-- A member of a setwise-fixed block stays inside it. -/
theorem mem_of_blockMap_eq (g : Perm24) {B B' : Block}
    (hmap : blockMap g B = B') {w : Fin 24} (hw : w ∈ B) : g w ∈ B' := by
  rw [← hmap]
  exact Finset.mem_image_of_mem g hw

