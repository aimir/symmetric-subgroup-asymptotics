/-- The candidate blocks as a `Finset`. -/
def octads : Finset Block :=
  octadList.toFinset

set_option maxRecDepth 1000000 in
/-- The candidate block list has length 759. -/
theorem octadList_length : octadList.length = 759 := by
  decide

/-- The block with certificate index `i`.  The proof-free `getD` indexing is
deliberate: kernel-checked certificates over all 759 indices reduce with no
quadratic bound-proof terms (unlike `List.get` with a `Fin` index). -/
def octadAt (i : Fin 759) : Block :=
  octadList.getD i.1 ∅

theorem octadAt_eq_getElem (i : Fin 759) :
    octadAt i = octadList[i.1]'(by rw [octadList_length]; exact i.2) := by
  rw [octadAt, List.getD_eq_getElem?_getD,
    List.getElem?_eq_getElem (by rw [octadList_length]; exact i.2)]
  rfl

/-- Every indexed candidate block belongs to `octads`. -/
theorem octadAt_mem (i : Fin 759) : octadAt i ∈ octads := by
  rw [octads, octadAt_eq_getElem]
  exact List.mem_toFinset.mpr (List.getElem_mem _)

/-- Membership in the listed blocks gives membership in the block finset. -/
theorem mem_octads_of_mem_octadList {B : Block} (hB : B ∈ octadList) :
    B ∈ octads := by
  rw [octads]
  exact List.mem_toFinset.mpr hB

/-- Membership in the block finset comes from membership in the listed blocks. -/
theorem mem_octadList_of_mem_octads {B : Block} (hB : B ∈ octads) :
    B ∈ octadList := by
  rw [octads] at hB
  exact List.mem_toFinset.mp hB

/-- Every listed block is an indexed block. -/
theorem mem_octadList_exists_at {B : Block} (hB : B ∈ octadList) :
    ∃ i : Fin 759, B = octadAt i := by
  obtain ⟨n, hn, rfl⟩ := List.mem_iff_getElem.mp hB
  have hn' : n < 759 := by rwa [octadList_length] at hn
  exact ⟨⟨n, hn'⟩, (octadAt_eq_getElem ⟨n, hn'⟩).symm⟩

/-- Image of a block under a degree-24 permutation. -/
def blockMap (g : Perm24) (B : Block) : Block :=
  B.image g

@[simp]
theorem blockMap_one (B : Block) : blockMap (1 : Perm24) B = B := by
  ext x
  simp [blockMap]

@[simp]
theorem blockMap_mul (g h : Perm24) (B : Block) :
    blockMap (g * h) B = blockMap g (blockMap h B) := by
  ext x
  simp [blockMap]

@[simp]
theorem blockMap_inv_self (g : Perm24) (B : Block) :
    blockMap g⁻¹ (blockMap g B) = B := by
  ext x
  simp [blockMap]

/-- A permutation preserves the candidate block set. -/
def PreservesOctads (g : Perm24) : Prop :=
  (∀ B ∈ octadList, blockMap g B ∈ octads) ∧
    (∀ B ∈ octadList, blockMap g⁻¹ B ∈ octads)


