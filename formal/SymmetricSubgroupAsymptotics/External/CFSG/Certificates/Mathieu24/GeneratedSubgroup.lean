import Mathlib.Algebra.Group.Subgroup.Finite
import SymmetricSubgroupAsymptotics.External.CFSG.Certificates.Mathieu24.Permutations

/-!
# The generated subgroup

This file defines the experimental `M24` as the subgroup of
`Equiv.Perm (Fin 24)` generated by the four explicit permutations in
`SporadicM24/Permutations.lean`.
-/

namespace CFSG.Certificates.Mathieu24

/-- The subgroup generated by the four degree-24 Mathieu generator
candidates. -/
def M24Subgroup : Subgroup Perm24 :=
  Subgroup.closure ({m24a, m24b, m24c, m24d} : Set Perm24)

/-- The experimental Mathieu group `M24`, as a type. -/
abbrev M24 : Type :=
  M24Subgroup

instance instGroupM24 : Group M24 :=
  inferInstance

noncomputable instance instFintypeM24 : Fintype M24 := by
  classical
  infer_instance

/-- The canonical embedding of `M24` into the ambient degree-24 permutation
group. -/
abbrev M24.toPerm (g : M24) : Perm24 :=
  g.1

/-- The first generator belongs to the generated subgroup. -/
theorem m24a_mem_M24Subgroup : m24a ∈ M24Subgroup :=
  Subgroup.subset_closure (by simp)

/-- The second generator belongs to the generated subgroup. -/
theorem m24b_mem_M24Subgroup : m24b ∈ M24Subgroup :=
  Subgroup.subset_closure (by simp)

/-- The third generator belongs to the generated subgroup. -/
theorem m24c_mem_M24Subgroup : m24c ∈ M24Subgroup :=
  Subgroup.subset_closure (by simp)

/-- The fourth generator belongs to the generated subgroup. -/
theorem m24d_mem_M24Subgroup : m24d ∈ M24Subgroup :=
  Subgroup.subset_closure (by simp)

end CFSG.Certificates.Mathieu24
