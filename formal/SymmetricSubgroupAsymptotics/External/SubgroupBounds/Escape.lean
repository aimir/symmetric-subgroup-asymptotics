/-!
# Relative generation by escaping cosets

We formalize both literal tuples in the nonnormal coset set `K/H` and raw
element representatives.  An explicit equivalence proves that the raw count
is exactly the coset count multiplied by `|H|^r`; the escape tree may therefore
be constructed on representatives without changing the manuscript statement.
-/

namespace SharpIntermediateSubgroupBounds

open scoped BigOperators

noncomputable section

universe u

variable {G : Type u} [Group G] [Fintype G]

local instance subgroupDecidableEq : DecidableEq (Subgroup G) := Classical.decEq _

/-- The subgroup generated by `H` and the entries of a finite tuple. -/
def generatedFrom (H : Subgroup G) {r : ℕ} (x : Fin r → G) : Subgroup G :=
  H ⊔ Subgroup.closure (Set.range x)

/-- Multiplying tuple entries on the right by elements of `H` does not
change the subgroup generated relative to `H`. -/
theorem generatedFrom_mul_right (H : Subgroup G) {r : ℕ}
    (x : Fin r → G) (h : Fin r → H) :
    generatedFrom H (fun i => x i * (h i : G)) = generatedFrom H x := by
  apply le_antisymm
  · apply sup_le le_sup_left
    apply (Subgroup.closure_le _).2
    intro y hy
    obtain ⟨i, rfl⟩ := hy
    apply (generatedFrom H x).mul_mem
    · exact (show Subgroup.closure (Set.range x) ≤ generatedFrom H x from
        le_sup_right) (Subgroup.subset_closure ⟨i, rfl⟩)
    · exact (show H ≤ generatedFrom H x from le_sup_left) (h i).2
  · apply sup_le le_sup_left
    apply (Subgroup.closure_le _).2
    intro y hy
    obtain ⟨i, rfl⟩ := hy
    have hxmul : x i * (h i : G) ∈
        Subgroup.closure (Set.range (fun j => x j * (h j : G))) :=
      Subgroup.subset_closure ⟨i, rfl⟩
    have hh : ((h i : H) : G)⁻¹ ∈ H := H.inv_mem (h i).2
    have hprod : (x i * (h i : G)) * (h i : G)⁻¹ ∈
        generatedFrom H (fun j => x j * (h j : G)) :=
      (generatedFrom H (fun j => x j * (h j : G))).mul_mem
        ((show Subgroup.closure (Set.range (fun j => x j * (h j : G))) ≤
            generatedFrom H (fun j => x j * (h j : G)) from le_sup_right) hxmul)
        ((show H ≤ generatedFrom H (fun j => x j * (h j : G)) from
            le_sup_left) hh)
    simpa [generatedFrom] using hprod

/-- Raw element tuples in `K` which generate `K` relative to `H`. -/
def RawRelGen (H K : Subgroup G) (r : ℕ) :=
  {x : Fin r → G // (∀ i, x i ∈ K) ∧ generatedFrom H x = K}

/-- Tuples of left cosets of `H` inside `K`; no normality is assumed. -/
def CosetTuple (H K : Subgroup G) (r : ℕ) : Type u :=
  Fin r → (K ⧸ H.subgroupOf K)

/-- Canonical representatives of a coset tuple, viewed in the ambient
group. -/
def cosetRepTuple (H K : Subgroup G) {r : ℕ} (q : CosetTuple H K r) :
    Fin r → G :=
  fun i => ((Quotient.out (q i) : K) : G)

/-- Coset tuples which generate `K` relative to `H`.  The predicate uses
canonical representatives; `generatedFrom_cosetRep_raw` below proves that
it is independent of representatives. -/
def CosetRelGen (H K : Subgroup G) (r : ℕ) : Type u :=
  {q : CosetTuple H K r // generatedFrom H (cosetRepTuple H K q) = K}

/-- The coset tuple underlying a raw relative generating tuple. -/
def rawCosetTuple (H K : Subgroup G) {r : ℕ}
    (x : RawRelGen H K r) : CosetTuple H K r :=
  fun i => QuotientGroup.mk ⟨x.1 i, x.2.1 i⟩

/-- The unique right `H`-factor which carries the canonical representative
of the coset of `b` to `b`. -/
def cosetAdjustment (H K : Subgroup G) (b : K) : H := by
  let a : K := Quotient.out (QuotientGroup.mk b : K ⧸ H.subgroupOf K)
  refine ⟨((a⁻¹ * b : K) : G), ?_⟩
  apply Subgroup.mem_subgroupOf.mp
  apply QuotientGroup.leftRel_apply.mp
  exact Quotient.exact' (Quotient.out_eq'
    (QuotientGroup.mk b : K ⧸ H.subgroupOf K))

@[simp]
theorem cosetRep_mul_cosetAdjustment (H K : Subgroup G) (b : K) :
    ((Quotient.out (QuotientGroup.mk b : K ⧸ H.subgroupOf K) : K) : G) *
        (cosetAdjustment H K b : G) = (b : G) := by
  simp [cosetAdjustment]

/-- Replacing a raw tuple by the canonical representatives of its cosets
does not change the subgroup it generates relative to `H`. -/
theorem generatedFrom_cosetRep_raw (H K : Subgroup G) {r : ℕ}
    (x : RawRelGen H K r) :
    generatedFrom H (cosetRepTuple H K (rawCosetTuple H K x)) = K := by
  let h : Fin r → H := fun i =>
    cosetAdjustment H K ⟨x.1 i, x.2.1 i⟩
  have htuple :
      (fun i => cosetRepTuple H K (rawCosetTuple H K x) i * (h i : G)) =
        x.1 := by
    funext i
    exact cosetRep_mul_cosetAdjustment H K ⟨x.1 i, x.2.1 i⟩
  rw [← generatedFrom_mul_right H
    (cosetRepTuple H K (rawCosetTuple H K x)) h, htuple, x.2.2]

/-- Pass from raw representatives to their generating coset tuple. -/
def rawToCosetRelGen (H K : Subgroup G) {r : ℕ} :
    RawRelGen H K r → CosetRelGen H K r :=
  fun x => ⟨rawCosetTuple H K x, generatedFrom_cosetRep_raw H K x⟩

/-- Reconstruct a raw tuple from a generating coset tuple together with
one right `H`-factor for every entry. -/
def cosetRelGenProdToRaw {H K : Subgroup G} (hHK : H ≤ K) {r : ℕ} :
    CosetRelGen H K r × (Fin r → H) → RawRelGen H K r :=
  fun z => ⟨fun i => cosetRepTuple H K z.1.1 i * (z.2 i : G),
    fun i => K.mul_mem (Quotient.out (z.1.1 i) : K).2 (hHK (z.2 i).2), by
      rw [generatedFrom_mul_right H (cosetRepTuple H K z.1.1) z.2,
        z.1.2]⟩

/-- The cosets of a reconstructed tuple are exactly the prescribed cosets. -/
theorem rawCosetTuple_cosetRelGenProdToRaw {H K : Subgroup G}
    (hHK : H ≤ K) {r : ℕ} (z : CosetRelGen H K r × (Fin r → H)) :
    rawCosetTuple H K (cosetRelGenProdToRaw hHK z) = z.1.1 := by
  funext i
  let a : K := Quotient.out (z.1.1 i)
  let b : K := ⟨(a : G) * (z.2 i : G),
    K.mul_mem a.2 (hHK (z.2 i).2)⟩
  change QuotientGroup.mk b = z.1.1 i
  calc
    QuotientGroup.mk b = QuotientGroup.mk a := by
      apply Quotient.sound'
      apply QuotientGroup.leftRel_apply.mpr
      apply Subgroup.mem_subgroupOf.mpr
      change ((a : G) * (z.2 i : G))⁻¹ * (a : G) ∈ H
      simpa using H.inv_mem (z.2 i).2
    _ = z.1.1 i := Quotient.out_eq' _

/-- The adjustment recovered from a reconstructed entry is the prescribed
right `H`-factor. -/
theorem cosetAdjustment_reconstructed {H K : Subgroup G}
    (hHK : H ≤ K) (q : K ⧸ H.subgroupOf K) (h : H) :
    cosetAdjustment H K
        ⟨((Quotient.out q : K) : G) * (h : G),
          K.mul_mem (Quotient.out q : K).2 (hHK h.2)⟩ = h := by
  let a : K := Quotient.out q
  let b : K := ⟨(a : G) * (h : G), K.mul_mem a.2 (hHK h.2)⟩
  have hmk :
      (QuotientGroup.mk b : K ⧸ H.subgroupOf K) = q := by
    calc
      QuotientGroup.mk b = QuotientGroup.mk a := by
        apply Quotient.sound'
        apply QuotientGroup.leftRel_apply.mpr
        apply Subgroup.mem_subgroupOf.mpr
        change ((a : G) * (h : G))⁻¹ * (a : G) ∈ H
        simpa using H.inv_mem h.2
      _ = q := Quotient.out_eq' _
  have hout :
      Quotient.out (QuotientGroup.mk b : K ⧸ H.subgroupOf K) = a := by
    exact congrArg Quotient.out hmk
  apply Subtype.ext
  change (((Quotient.out (QuotientGroup.mk b : K ⧸ H.subgroupOf K) : K)⁻¹ *
    b : K) : G) = (h : G)
  rw [hout]
  simp [b]

/-- Raw relative generating tuples split canonically into a generating
coset tuple and one freely chosen right `H`-factor in every coordinate. -/
def rawRelGenEquivCosetRelGenProd {H K : Subgroup G} (hHK : H ≤ K)
    {r : ℕ} :
    RawRelGen H K r ≃ CosetRelGen H K r × (Fin r → H) where
  toFun x := ⟨rawToCosetRelGen H K x,
    fun i => cosetAdjustment H K ⟨x.1 i, x.2.1 i⟩⟩
  invFun := cosetRelGenProdToRaw hHK
  left_inv := by
    intro x
    apply Subtype.ext
    funext i
    exact cosetRep_mul_cosetAdjustment H K ⟨x.1 i, x.2.1 i⟩
  right_inv := by
    intro z
    apply Prod.ext
    · apply Subtype.ext
      exact rawCosetTuple_cosetRelGenProdToRaw hHK z
    · funext i
      exact cosetAdjustment_reconstructed hHK (z.1.1 i) (z.2 i)

/-- Exact representative multiplicity: every generating coset tuple has
exactly `|H|^r` raw representative tuples. -/
theorem rawRelGen_card_eq_cosetRelGen_card_mul_cardH_pow
    {H K : Subgroup G} (hHK : H ≤ K) (r : ℕ) :
    Nat.card (RawRelGen H K r) =
      Nat.card (CosetRelGen H K r) * Nat.card H ^ r := by
  calc
    Nat.card (RawRelGen H K r) =
        Nat.card (CosetRelGen H K r × (Fin r → H)) :=
      Nat.card_congr (rawRelGenEquivCosetRelGenProd hHK)
    _ = Nat.card (CosetRelGen H K r) * Nat.card (Fin r → H) :=
      Nat.card_prod _ _
    _ = Nat.card (CosetRelGen H K r) * Nat.card H ^ r := by
      rw [Nat.card_fun, Nat.card_fin]

/-- Symmetric form of the exact representative multiplicity. -/
theorem rawRelGen_card_eq_cardH_pow_mul_cosetRelGen_card
    {H K : Subgroup G} (hHK : H ≤ K) (r : ℕ) :
    Nat.card (RawRelGen H K r) =
      Nat.card H ^ r * Nat.card (CosetRelGen H K r) := by
  rw [rawRelGen_card_eq_cosetRelGen_card_mul_cardH_pow hHK r,
    Nat.mul_comm]

/-- Cardinality form of Lagrange's theorem for a subgroup tower. -/
theorem card_mul_relIndex {A B : Subgroup G} (hAB : A ≤ B) :
    Nat.card A * A.relIndex B = Nat.card B := by
  have h := (A.subgroupOf B).card_mul_index
  rw [show (A.subgroupOf B).index = A.relIndex B by rfl] at h
  rw [Nat.card_congr (A.subgroupOfEquivOfLe hAB).toEquiv] at h
  exact h

/-- Every strict subgroup step has index at least the least prime factor of
the original ambient index. -/
theorem minFac_le_relIndex_of_lt {H A B : Subgroup G}
    (hHA : H ≤ A) (hAB : A < B) :
    H.index.minFac ≤ A.relIndex B := by
  apply Nat.minFac_le_of_dvd
  · letI : A.IsFiniteRelIndex B := A.isFiniteRelIndex_of_finiteIndex
    have hzero : A.relIndex B ≠ 0 := Subgroup.relIndex_ne_zero
    have hone : A.relIndex B ≠ 1 := by
      intro h
      exact hAB.not_ge (Subgroup.relIndex_eq_one.mp h)
    omega
  · exact (A.relIndex_dvd_index_of_le hAB.le).trans
      (Subgroup.index_dvd_of_le hHA)

/-- States in the escape process are subgroups contained in the target. -/
abbrev EscapeState (K : Subgroup G) : Type u := Set.Iic K

/-- At a proper state choose an element outside it; after reaching `K`, any
element of `K` is allowed. -/
def EscapeChoice (K : Subgroup G) (s : EscapeState K) : Type u :=
  {x : K // s.1 = K ∨ (x.1 : G) ∉ s.1}

instance escapeChoiceFintype (K : Subgroup G) (s : EscapeState K) :
    Fintype (EscapeChoice K s) := by
  letI : Finite (EscapeChoice K s) := Finite.of_injective
    (fun x : EscapeChoice K s => (x.1.1 : G)) (by
      intro x y h
      exact Subtype.ext (Subtype.ext h))
  exact Fintype.ofFinite _

instance escapeChoiceNonempty (K : Subgroup G) (s : EscapeState K) :
    Nonempty (EscapeChoice K s) := by
  classical
  by_cases hs : s.1 = K
  · exact ⟨⟨1, Or.inl hs⟩⟩
  · have hlt : s.1 < K := lt_of_le_of_ne s.2 hs
    obtain ⟨x, hxK, hxM⟩ := SetLike.exists_of_lt hlt
    exact ⟨⟨⟨x, hxK⟩, Or.inr hxM⟩⟩

/-- Once the target has been reached, every element of the target is an
allowed choice. -/
theorem escapeChoice_card_of_eq (K : Subgroup G) (s : EscapeState K)
    (hs : s.1 = K) :
    Fintype.card (EscapeChoice K s) = Nat.card K := by
  letI : Fintype K := Fintype.ofFinite K
  let e : EscapeChoice K s ≃ K :=
    { toFun := fun x => x.1
      invFun := fun x => ⟨x, Or.inl hs⟩
      left_inv := by
        intro x
        apply Subtype.ext
        rfl
      right_inv := by intro x; rfl }
  rw [Fintype.card_congr e, Nat.card_eq_fintype_card]

/-- At a proper state, the allowed choices and the elements of the state
partition the target. -/
theorem escapeChoice_card_add (K : Subgroup G) (s : EscapeState K)
    (hs : s.1 ≠ K) :
    Fintype.card (EscapeChoice K s) + Nat.card s.1 = Nat.card K := by
  letI : Fintype K := Fintype.ofFinite K
  letI : Fintype s.1 := Fintype.ofFinite s.1
  letI : Fintype {x : K // (x.1 : G) ∈ s.1} := Fintype.ofFinite _
  letI : Fintype {x : K // (x.1 : G) ∉ s.1} := Fintype.ofFinite _
  let ecompl : EscapeChoice K s ≃ {x : K // (x.1 : G) ∉ s.1} :=
    { toFun := fun x => ⟨x.1, x.2.resolve_left hs⟩
      invFun := fun x => ⟨x.1, Or.inr x.2⟩
      left_inv := by
        intro x
        apply Subtype.ext
        rfl
      right_inv := by
        intro x
        apply Subtype.ext
        rfl }
  let emem : {x : K // (x.1 : G) ∈ s.1} ≃ s.1 :=
    { toFun := fun x => ⟨x.1.1, x.2⟩
      invFun := fun x => ⟨⟨x.1, s.2 x.2⟩, x.2⟩
      left_inv := by
        intro x
        apply Subtype.ext
        apply Subtype.ext
        rfl
      right_inv := by
        intro x
        apply Subtype.ext
        rfl }
  have hmem : Fintype.card {x : K // (x.1 : G) ∈ s.1} = Nat.card s.1 := by
    rw [Fintype.card_congr emem, Nat.card_eq_fintype_card]
  have hle : Fintype.card {x : K // (x.1 : G) ∈ s.1} ≤ Fintype.card K :=
    Fintype.card_subtype_le _
  rw [Fintype.card_congr ecompl, Fintype.card_subtype_compl, hmem]
  have hcancel := Nat.sub_add_cancel (by simpa [hmem] using hle)
  simpa only [Nat.card_eq_fintype_card] using hcancel

/-- Exact normalized branching degree at a proper state. -/
theorem escapeChoice_ratio_of_ne (K : Subgroup G) (s : EscapeState K)
    (hs : s.1 ≠ K) :
    (Fintype.card (EscapeChoice K s) : ℚ) / Nat.card K =
      1 - 1 / (s.1.relIndex K : ℚ) := by
  let c := Fintype.card (EscapeChoice K s)
  let a := Nat.card s.1
  let k := Nat.card K
  let t := s.1.relIndex K
  have hsumNat : c + a = k := escapeChoice_card_add K s hs
  have hprodNat : a * t = k := card_mul_relIndex s.2
  have haPos : 0 < a := Nat.card_pos
  have htPos : 0 < t := by
    letI : s.1.IsFiniteRelIndex K := s.1.isFiniteRelIndex_of_finiteIndex
    exact Nat.pos_of_ne_zero Subgroup.relIndex_ne_zero
  have hkPos : 0 < k := Nat.card_pos
  have hsum : (c : ℚ) + a = k := by exact_mod_cast hsumNat
  have hprod : (a : ℚ) * t = k := by exact_mod_cast hprodNat
  have hc : (c : ℚ) = k - a := eq_sub_of_add_eq hsum
  change (c : ℚ) / k = 1 - 1 / (t : ℚ)
  rw [hc, ← hprod]
  have ha : (a : ℚ) ≠ 0 := (Nat.cast_pos.mpr haPos).ne'
  have ht : (t : ℚ) ≠ 0 := (Nat.cast_pos.mpr htPos).ne'
  field_simp

/-- Product form of the finite Euler factor. -/
def gammaProdQ (p r : ℕ) : ℚ :=
  ∏ j ∈ Finset.range r, (1 - 1 / (p : ℚ) ^ (j + 1))

/-- The triangular-power denominator is the product of the individual
power denominators. -/
theorem gammaDen_eq_prod_pow (p r : ℕ) :
    gammaDen p r = ∏ j ∈ Finset.range r, p ^ (j + 1) := by
  rw [gammaDen, Finset.prod_pow_eq_pow_sum]
  congr 1
  rw [Finset.sum_add_distrib, Finset.sum_range_id]
  simp only [Finset.sum_const_nat, Finset.card_range, mul_one]
  have hsucc := Finset.sum_range_id (r + 1)
  simp only [Nat.add_sub_cancel] at hsucc
  have hr := Finset.sum_range_id r
  rw [Nat.mul_comm r (r + 1), ← hsucc, ← hr, Finset.sum_range_succ]

/-- The cleared-denominator definition agrees with the product definition. -/
theorem gammaQ_eq_gammaProdQ (p r : ℕ) (hp : 0 < p) :
    gammaQ p r = gammaProdQ p r := by
  rw [gammaQ, gammaNum, gammaDen_eq_prod_pow, gammaProdQ]
  rw [Nat.cast_prod, Nat.cast_prod, ← Finset.prod_div_distrib]
  apply Finset.prod_congr rfl
  intro j hj
  have hpow : 1 ≤ p ^ (j + 1) :=
    one_le_pow₀ (Nat.one_le_iff_ne_zero.mpr hp.ne')
  rw [Nat.cast_sub hpow, Nat.cast_one, Nat.cast_pow]
  have hne : (p : ℚ) ^ (j + 1) ≠ 0 :=
    pow_ne_zero _ (Nat.cast_ne_zero.mpr hp.ne')
  field_simp

@[simp]
theorem gammaQ_zero (p : ℕ) : gammaQ p 0 = 1 := by
  simp [gammaQ, gammaNum, gammaDen]

/-- Recurrence for the finite Euler factor. -/
theorem gammaQ_succ (p r : ℕ) (hp : 0 < p) :
    gammaQ p (r + 1) =
      gammaQ p r * (1 - 1 / (p : ℚ) ^ (r + 1)) := by
  rw [gammaQ_eq_gammaProdQ p (r + 1) hp,
    gammaQ_eq_gammaProdQ p r hp]
  simp [gammaProdQ, Finset.prod_range_succ]

/-- Each finite Euler factor is nonnegative when `p ≥ 2`. -/
theorem gammaQ_nonneg {p r : ℕ} (hp : 1 < p) : 0 ≤ gammaQ p r := by
  rw [gammaQ_eq_gammaProdQ p r (by omega)]
  apply Finset.prod_nonneg
  intro j hj
  apply sub_nonneg.mpr
  apply (div_le_one₀ (by positivity : (0 : ℚ) < (p : ℚ) ^ (j + 1))).2
  exact_mod_cast one_le_pow₀ hp.le

/-- The finite Euler factor is strictly positive for every base at least
two. -/
theorem gammaQ_pos {p r : ℕ} (hp : 1 < p) : 0 < gammaQ p r := by
  rw [gammaQ_eq_gammaProdQ p r (by omega)]
  apply Finset.prod_pos
  intro j hj
  apply sub_pos.mpr
  apply (div_lt_one₀ (by positivity :
    (0 : ℚ) < (p : ℚ) ^ (j + 1))).2
  exact one_lt_pow₀ (by exact_mod_cast hp : (1 : ℚ) < p) (by omega)

/-- Adding a factor can only decrease the finite Euler product. -/
theorem gammaQ_succ_le {p r : ℕ} (hp : 1 < p) :
    gammaQ p (r + 1) ≤ gammaQ p r := by
  rw [gammaQ_succ p r (by omega)]
  apply mul_le_of_le_one_right (gammaQ_nonneg hp)
  exact sub_le_self _ (by positivity)

/-- The finite Euler products are antitone in the length. -/
theorem gammaQ_antitone {p : ℕ} (hp : 1 < p) :
    Antitone (gammaQ p) :=
  antitone_nat_of_succ_le fun r => gammaQ_succ_le hp

/-- For fixed length the Euler factor increases with its base. -/
theorem gammaQ_mono_base {q p r : ℕ} (hq : 1 < q) (hqp : q ≤ p) :
    gammaQ q r ≤ gammaQ p r := by
  rw [gammaQ_eq_gammaProdQ q r (by omega),
    gammaQ_eq_gammaProdQ p r (lt_of_lt_of_le (by omega) hqp)]
  apply Finset.prod_le_prod
  · intro j hj
    apply sub_nonneg.mpr
    apply (div_le_one₀ (by positivity :
      (0 : ℚ) < (q : ℚ) ^ (j + 1))).2
    exact one_le_pow₀ (by exact_mod_cast hq.le : (1 : ℚ) ≤ q)
  · intro j hj
    have hpow : (q : ℚ) ^ (j + 1) ≤ (p : ℚ) ^ (j + 1) :=
      pow_le_pow_left₀ (by positivity) (by exact_mod_cast hqp) _
    have hinv := one_div_le_one_div_of_le
      (by positivity : (0 : ℚ) < (q : ℚ) ^ (j + 1)) hpow
    exact sub_le_sub_left hinv 1

/-- Adjoin the chosen element to the current state. -/
def escapeNext (K : Subgroup G) (s : EscapeState K) (x : EscapeChoice K s) :
    EscapeState K :=
  ⟨s.1 ⊔ Subgroup.closure {(x.1 : G)}, by
    change s.1 ⊔ Subgroup.closure {(x.1 : G)} ≤ K
    apply sup_le s.2
    apply (Subgroup.closure_le K).2
    intro y hy
    rw [Set.mem_singleton_iff] at hy
    subst y
    exact x.1.2⟩

@[simp]
theorem escapeNext_of_eq (K : Subgroup G) (s : EscapeState K)
    (hs : s.1 = K) (x : EscapeChoice K s) :
    (escapeNext K s x).1 = K := by
  apply le_antisymm (escapeNext K s x).2
  have hKs : K ≤ s.1 := hs.symm.le
  exact hKs.trans le_sup_left

theorem lt_escapeNext_of_ne (K : Subgroup G) (s : EscapeState K)
    (hs : s.1 ≠ K) (x : EscapeChoice K s) :
    s.1 < (escapeNext K s x).1 := by
  apply lt_of_le_of_ne le_sup_left
  intro heq
  have hxcl : (x.1 : G) ∈ Subgroup.closure ({(x.1 : G)} : Set G) :=
    Subgroup.subset_closure (Set.mem_singleton _)
  have hxnext : (x.1 : G) ∈ (escapeNext K s x).1 := by
    exact (show Subgroup.closure ({(x.1 : G)} : Set G) ≤
      s.1 ⊔ Subgroup.closure ({(x.1 : G)} : Set G) from le_sup_right) hxcl
  have hnot : (x.1 : G) ∉ s.1 := x.2.resolve_left hs
  let g : G := x.1
  have hxnext' : g ∈ (escapeNext K s x).1 := hxnext
  have hnot' : g ∉ s.1 := hnot
  apply hnot'
  rw [heq]
  exact hxnext'

/-- Escape paths are paths in the finite branching system above. -/
abbrev EscapePath (K : Subgroup G) (r : ℕ) (s : EscapeState K) : Type u :=
  BranchingTree.Path (EscapeChoice K) (escapeNext K) r s

/-- Add an initial choice to an escape path. -/
def escapeCons (K : Subgroup G) {r : ℕ} {s : EscapeState K}
    (x : EscapeChoice K s) (z : EscapePath K r (escapeNext K s x)) :
    EscapePath K (r + 1) s := by
  change Σ x : EscapeChoice K s, EscapePath K r (escapeNext K s x)
  exact ⟨x, z⟩

/-- The state at the end of an escape path. -/
def escapeEnd (K : Subgroup G) : ∀ {r : ℕ} {s : EscapeState K},
    EscapePath K r s → EscapeState K
  | 0, s, _ => s
  | _ + 1, _, ⟨x, z⟩ => escapeEnd K z

@[simp]
theorem escapeEnd_cons (K : Subgroup G) {r : ℕ} {s : EscapeState K}
    (x : EscapeChoice K s) (z : EscapePath K r (escapeNext K s x)) :
    escapeEnd K (escapeCons K x z) = escapeEnd K z := rfl

/-- Number of strict moves along an escape path. -/
def escapeStrictCount (K : Subgroup G) : ∀ {r : ℕ} {s : EscapeState K},
    EscapePath K r s → ℕ
  | 0, _, _ => 0
  | _ + 1, s, ⟨x, z⟩ =>
      if s.1 = K then escapeStrictCount K z else escapeStrictCount K z + 1

@[simp]
theorem escapeStrictCount_cons (K : Subgroup G) {r : ℕ} {s : EscapeState K}
    (x : EscapeChoice K s) (z : EscapePath K r (escapeNext K s x)) :
    escapeStrictCount K (escapeCons K x z) =
      if s.1 = K then escapeStrictCount K z else escapeStrictCount K z + 1 := rfl

theorem escapeStrictCount_le (K : Subgroup G) {r : ℕ} {s : EscapeState K}
    (z : EscapePath K r s) : escapeStrictCount K z ≤ r := by
  induction r generalizing s with
  | zero => simp [escapeStrictCount]
  | succ r ih =>
      obtain ⟨x, z⟩ := z
      change escapeStrictCount K (escapeCons K x z) ≤ r + 1
      rw [escapeStrictCount_cons]
      split_ifs <;> specialize ih z <;> omega

theorem escapeEnd_of_top (K : Subgroup G) {r : ℕ}
    (s : EscapeState K) (hs : s.1 = K) (z : EscapePath K r s) :
    (escapeEnd K z).1 = K := by
  induction r generalizing s with
  | zero => simpa [escapeEnd]
  | succ r ih =>
      obtain ⟨x, z⟩ := z
      change (escapeEnd K (escapeCons K x z)).1 = K
      rw [escapeEnd_cons]
      exact ih (escapeNext K s x) (escapeNext_of_eq K s hs x) z

theorem escapeStrictCount_eq_length_of_end_ne (K : Subgroup G)
    {r : ℕ} {s : EscapeState K} (z : EscapePath K r s)
    (hend : (escapeEnd K z).1 ≠ K) :
    escapeStrictCount K z = r := by
  induction r generalizing s with
  | zero => simp [escapeStrictCount]
  | succ r ih =>
      obtain ⟨x, z⟩ := z
      change (escapeEnd K (escapeCons K x z)).1 ≠ K at hend
      have hs : s.1 ≠ K := by
        intro hs
        exact hend (escapeEnd_of_top K s hs (escapeCons K x z))
      have hend' : (escapeEnd K z).1 ≠ K := hend
      change escapeStrictCount K (escapeCons K x z) = r + 1
      rw [escapeStrictCount_cons, if_neg hs]
      rw [ih z hend']

theorem escapeStrictCount_of_top (K : Subgroup G) {r : ℕ}
    (s : EscapeState K) (hs : s.1 = K) (z : EscapePath K r s) :
    escapeStrictCount K z = 0 := by
  induction r generalizing s with
  | zero => rfl
  | succ r ih =>
      obtain ⟨x, z⟩ := z
      change escapeStrictCount K (escapeCons K x z) = 0
      rw [escapeStrictCount_cons, if_pos hs]
      exact ih (escapeNext K s x) (escapeNext_of_eq K s hs x) z

/-- The tuple of elements labelling an escape path. -/
def escapeTuple (K : Subgroup G) : ∀ {r : ℕ} {s : EscapeState K},
    EscapePath K r s → Fin r → G
  | 0, _, _ => Fin.elim0
  | _ + 1, _, ⟨x, z⟩ => Fin.cons (x.1 : G) (escapeTuple K z)

@[simp]
theorem escapeTuple_cons (K : Subgroup G) {r : ℕ} {s : EscapeState K}
    (x : EscapeChoice K s) (z : EscapePath K r (escapeNext K s x)) :
    escapeTuple K (escapeCons K x z) =
      Fin.cons (x.1 : G) (escapeTuple K z) := rfl

theorem escapeTuple_mem (K : Subgroup G) {r : ℕ} {s : EscapeState K}
    (z : EscapePath K r s) (i : Fin r) : escapeTuple K z i ∈ K := by
  induction r generalizing s with
  | zero => exact Fin.elim0 i
  | succ r ih =>
      obtain ⟨x, z⟩ := z
      refine Fin.cases x.1.2 (fun j => ?_) i
      simpa [escapeTuple] using ih z j

theorem escapeTuple_injective (K : Subgroup G) {r : ℕ} {s : EscapeState K} :
    Function.Injective (escapeTuple K : EscapePath K r s → Fin r → G) := by
  induction r generalizing s with
  | zero =>
      intro x y _
      cases x
      cases y
      rfl
  | succ r ih =>
      rintro ⟨x, z⟩ ⟨y, w⟩ h
      have hxy : x = y := by
        apply Subtype.ext
        apply Subtype.ext
        simpa [escapeTuple] using congrFun h 0
      subst y
      have hzw : escapeTuple K z = escapeTuple K w := by
        funext i
        simpa [escapeTuple] using congrFun h i.succ
      have := ih (s := escapeNext K s x) hzw
      subst w
      rfl

/-- The terminal state is obtained by adjoining exactly the labels of the
path to its initial state. -/
theorem escapeEnd_eq_generated (K : Subgroup G) {r : ℕ}
    {s : EscapeState K} (z : EscapePath K r s) :
    (escapeEnd K z).1 = s.1 ⊔ Subgroup.closure (Set.range (escapeTuple K z)) := by
  induction r generalizing s with
  | zero =>
      have hrange : Set.range (escapeTuple K z) = ∅ := by
        ext y
        constructor
        · rintro ⟨i, -⟩
          exact Fin.elim0 i
        · simp
      rw [hrange]
      simp [escapeEnd]
  | succ r ih =>
      obtain ⟨x, z⟩ := z
      change (escapeEnd K (escapeCons K x z)).1 =
        s.1 ⊔ Subgroup.closure (Set.range (escapeTuple K (escapeCons K x z)))
      rw [escapeEnd_cons, ih z]
      simp only [escapeNext, escapeTuple_cons, Fin.range_cons, Set.insert_eq,
        Subgroup.closure_union]
      ac_rfl

/-- In particular, a path beginning at `H` ends at the subgroup generated
by `H` and its tuple. -/
theorem escapeEnd_eq_generatedFrom (K : Subgroup G) {H : Subgroup G}
    (hHK : H ≤ K) {r : ℕ} (z : EscapePath K r ⟨H, hHK⟩) :
    (escapeEnd K z).1 = generatedFrom H (escapeTuple K z) := by
  exact escapeEnd_eq_generated K z

/-- Along a path, each strict move contributes at least the least prime
factor of the original index.  The terminal relative index is retained as a
factor; this is the form needed for the endpoint contradiction. -/
theorem escape_chain_bound {H K : Subgroup G} (hHK : H ≤ K)
    {r : ℕ} {s : EscapeState K} (hHs : H ≤ s.1)
    (z : EscapePath K r s) :
    H.index.minFac ^ escapeStrictCount K z *
        (escapeEnd K z).1.relIndex K ≤ s.1.relIndex K := by
  induction r generalizing s with
  | zero => simp [escapeStrictCount, escapeEnd]
  | succ r ih =>
      obtain ⟨x, z⟩ := z
      change H.index.minFac ^ escapeStrictCount K (escapeCons K x z) *
        (escapeEnd K (escapeCons K x z)).1.relIndex K ≤ s.1.relIndex K
      by_cases hs : s.1 = K
      · have hend : (escapeEnd K (escapeCons K x z)).1 = K :=
          escapeEnd_of_top K s hs (escapeCons K x z)
        have hcount : escapeStrictCount K (escapeCons K x z) = 0 :=
          escapeStrictCount_of_top K s hs (escapeCons K x z)
        have hendz : (escapeEnd K z).1 = K := by
          simpa only [escapeEnd_cons] using hend
        simp [hcount, hendz, hs]
      · have hstrict : s.1 < (escapeNext K s x).1 :=
          lt_escapeNext_of_ne K s hs x
        have hHnext : H ≤ (escapeNext K s x).1 := hHs.trans le_sup_left
        have htail := ih hHnext z
        have hstep : H.index.minFac ≤
            s.1.relIndex (escapeNext K s x).1 :=
          minFac_le_relIndex_of_lt hHs hstrict
        have htower := Subgroup.relIndex_mul_relIndex s.1 (escapeNext K s x).1 K
          hstrict.le (escapeNext K s x).2
        rw [escapeStrictCount_cons, if_neg hs, escapeEnd_cons, pow_succ']
        calc
          H.index.minFac * H.index.minFac ^ escapeStrictCount K z *
                (escapeEnd K z).1.relIndex K =
              H.index.minFac *
                (H.index.minFac ^ escapeStrictCount K z *
                  (escapeEnd K z).1.relIndex K) := by ac_rfl
          _ ≤ s.1.relIndex (escapeNext K s x).1 *
                (escapeNext K s x).1.relIndex K :=
              Nat.mul_le_mul hstep htail
          _ = s.1.relIndex K := htower

/-- Under the band hypothesis every full escape path reaches the target. -/
theorem escapeEnd_eq_target {H K : Subgroup G} (hHK : H ≤ K)
    {r : ℕ}
    (hhi : H.relIndex K < H.index.minFac ^ (r + 1))
    (z : EscapePath K r ⟨H, hHK⟩) :
    (escapeEnd K z).1 = K := by
  by_contra hend
  have hcount : escapeStrictCount K z = r :=
    escapeStrictCount_eq_length_of_end_ne K z hend
  have hHend : H ≤ (escapeEnd K z).1 := by
    rw [escapeEnd_eq_generatedFrom K hHK z]
    exact le_sup_left
  have hendlt : (escapeEnd K z).1 < K :=
    lt_of_le_of_ne (escapeEnd K z).2 hend
  have hpEnd : H.index.minFac ≤ (escapeEnd K z).1.relIndex K :=
    minFac_le_relIndex_of_lt hHend hendlt
  have hchain := escape_chain_bound hHK (le_refl H) z
  rw [hcount] at hchain
  have : H.index.minFac ^ (r + 1) ≤ H.relIndex K := by
    rw [pow_succ]
    exact le_trans (Nat.mul_le_mul_left _ hpEnd) hchain
  omega

@[simp]
theorem escapeBranchProduct_cons (K : Subgroup G) {r : ℕ}
    {s : EscapeState K} (x : EscapeChoice K s)
    (z : EscapePath K r (escapeNext K s x)) :
    BranchingTree.branchProduct (EscapeChoice K) (escapeNext K)
        (escapeCons K x z) =
      Fintype.card (EscapeChoice K s) *
        BranchingTree.branchProduct (EscapeChoice K) (escapeNext K) z := rfl

/-- Pathwise lower bound for the product of the escape-tree branching
degrees.  The exponent in `gammaQ` records exactly the strict moves made
along the path. -/
theorem escape_path_branchProduct_bound {H K : Subgroup G}
    (hn : 1 < H.index) (hHK : H ≤ K) {r : ℕ}
    {s : EscapeState K} (hHs : H ≤ s.1) (z : EscapePath K r s) :
    gammaQ H.index.minFac (escapeStrictCount K z) *
        (Nat.card K : ℚ) ^ r ≤
      (BranchingTree.branchProduct (EscapeChoice K) (escapeNext K) z : ℚ) := by
  have hp : 1 < H.index.minFac :=
    (Nat.minFac_prime (by omega : H.index ≠ 1)).one_lt
  induction r generalizing s with
  | zero =>
      simp [escapeStrictCount, BranchingTree.branchProduct]
  | succ r ih =>
      obtain ⟨x, z⟩ := z
      change gammaQ H.index.minFac
          (escapeStrictCount K (escapeCons K x z)) *
            (Nat.card K : ℚ) ^ (r + 1) ≤
        (BranchingTree.branchProduct (EscapeChoice K) (escapeNext K)
          (escapeCons K x z) : ℚ)
      have hHnext : H ≤ (escapeNext K s x).1 := hHs.trans le_sup_left
      have htail := ih hHnext z
      by_cases hs : s.1 = K
      · have hcard : Fintype.card (EscapeChoice K s) = Nat.card K :=
          escapeChoice_card_of_eq K s hs
        rw [escapeStrictCount_cons, if_pos hs,
          pow_succ (Nat.card K : ℚ) r]
        calc
          gammaQ H.index.minFac (escapeStrictCount K z) *
                ((Nat.card K : ℚ) ^ r * Nat.card K) =
              (Nat.card K : ℚ) *
                (gammaQ H.index.minFac (escapeStrictCount K z) *
                  (Nat.card K : ℚ) ^ r) := by ring
          _ ≤ (Nat.card K : ℚ) *
                (BranchingTree.branchProduct (EscapeChoice K)
                  (escapeNext K) z : ℚ) :=
              mul_le_mul_of_nonneg_left htail (by positivity)
          _ = (BranchingTree.branchProduct (EscapeChoice K) (escapeNext K)
                (escapeCons K x z) : ℚ) := by
              simp only [escapeBranchProduct_cons, Nat.cast_mul, hcard]
      · have hchain := escape_chain_bound hHK hHs (escapeCons K x z)
        rw [escapeStrictCount_cons, if_neg hs] at hchain
        have hendPos : 0 < (escapeEnd K z).1.relIndex K := by
          letI : (escapeEnd K z).1.IsFiniteRelIndex K :=
            (escapeEnd K z).1.isFiniteRelIndex_of_finiteIndex
          exact Nat.pos_of_ne_zero Subgroup.relIndex_ne_zero
        have hpowLe : H.index.minFac ^ (escapeStrictCount K z + 1) ≤
            s.1.relIndex K := by
          apply le_trans (Nat.le_mul_of_pos_right _ hendPos)
          simpa only [escapeEnd_cons] using hchain
        have hpowPos : 0 < H.index.minFac ^ (escapeStrictCount K z + 1) :=
          pow_pos (by omega) _
        have hpowPosQ : (0 : ℚ) <
            (H.index.minFac : ℚ) ^ (escapeStrictCount K z + 1) := by
          exact_mod_cast hpowPos
        have hpowLeQ :
            (H.index.minFac : ℚ) ^ (escapeStrictCount K z + 1) ≤
              (s.1.relIndex K : ℚ) := by
          exact_mod_cast hpowLe
        have hinv :
            1 / (s.1.relIndex K : ℚ) ≤
              1 / (H.index.minFac : ℚ) ^ (escapeStrictCount K z + 1) := by
          exact one_div_le_one_div_of_le hpowPosQ hpowLeQ
        have hnormalized :
            1 - 1 / (H.index.minFac : ℚ) ^ (escapeStrictCount K z + 1) ≤
              (Fintype.card (EscapeChoice K s) : ℚ) / Nat.card K := by
          rw [escapeChoice_ratio_of_ne K s hs]
          exact sub_le_sub_left hinv 1
        have hkPos : (0 : ℚ) < (Nat.card K : ℚ) :=
          Nat.cast_pos.mpr Nat.card_pos
        have hfactor :
            (1 - 1 / (H.index.minFac : ℚ) ^
                (escapeStrictCount K z + 1)) * (Nat.card K : ℚ) ≤
              Fintype.card (EscapeChoice K s) :=
          (le_div_iff₀ hkPos).mp hnormalized
        rw [escapeStrictCount_cons, if_neg hs, gammaQ_succ,
          pow_succ (Nat.card K : ℚ) r]
        · calc
            (gammaQ H.index.minFac (escapeStrictCount K z) *
                  (1 - 1 / (H.index.minFac : ℚ) ^
                    (escapeStrictCount K z + 1))) *
                  ((Nat.card K : ℚ) ^ r * Nat.card K) =
                ((1 - 1 / (H.index.minFac : ℚ) ^
                    (escapeStrictCount K z + 1)) * Nat.card K) *
                  (gammaQ H.index.minFac (escapeStrictCount K z) *
                    (Nat.card K : ℚ) ^ r) := by ring
            _ ≤ (Fintype.card (EscapeChoice K s) : ℚ) *
                  (gammaQ H.index.minFac (escapeStrictCount K z) *
                    (Nat.card K : ℚ) ^ r) :=
                mul_le_mul_of_nonneg_right hfactor
                  (mul_nonneg (gammaQ_nonneg hp) (by positivity))
            _ ≤ (Fintype.card (EscapeChoice K s) : ℚ) *
                  (BranchingTree.branchProduct (EscapeChoice K)
                    (escapeNext K) z : ℚ) :=
                mul_le_mul_of_nonneg_left htail (by positivity)
            _ = (BranchingTree.branchProduct (EscapeChoice K) (escapeNext K)
                  (escapeCons K x z) : ℚ) := by
                simp only [escapeBranchProduct_cons, Nat.cast_mul]
        · omega

/-- Uniform pathwise bound at the prescribed depth. -/
theorem escape_path_full_gamma_bound {H K : Subgroup G}
    (hn : 1 < H.index) (hHK : H ≤ K) {r : ℕ}
    {s : EscapeState K} (hHs : H ≤ s.1) (z : EscapePath K r s) :
    gammaQ H.index.minFac r * (Nat.card K : ℚ) ^ r ≤
      (BranchingTree.branchProduct (EscapeChoice K) (escapeNext K) z : ℚ) := by
  apply le_trans
    (mul_le_mul_of_nonneg_right
      (gammaQ_antitone
        ((Nat.minFac_prime (by omega : H.index ≠ 1)).one_lt)
        (escapeStrictCount_le K z)) (by positivity))
  exact escape_path_branchProduct_bound hn hHK hHs z

/-- The escape tree has at least the Euler-factor fraction of all raw
tuples as leaves. -/
theorem escapePath_card_lower_bound {H K : Subgroup G}
    (hn : 1 < H.index) (hHK : H ≤ K) (r : ℕ) :
    gammaQ H.index.minFac r * (Nat.card K : ℚ) ^ r ≤
      (Fintype.card (EscapePath K r ⟨H, hHK⟩) : ℚ) := by
  apply BranchingTree.leaf_product_bound_sameUniverse
    (Choice := fun s : EscapeState K => EscapeChoice K s)
    (next := fun s x => escapeNext K s x)
  intro z
  exact escape_path_full_gamma_bound hn hHK (le_refl H) z

/-- A full escape path, under the upper band condition, gives a raw tuple
which generates the target relative to `H`. -/
def escapePathToRawRelGen {H K : Subgroup G} (hHK : H ≤ K) {r : ℕ}
    (hhi : H.relIndex K < H.index.minFac ^ (r + 1)) :
    EscapePath K r ⟨H, hHK⟩ → RawRelGen H K r :=
  fun z => ⟨escapeTuple K z, escapeTuple_mem K z, by
    rw [← escapeEnd_eq_generatedFrom K hHK z]
    exact escapeEnd_eq_target hHK hhi z⟩

theorem escapePathToRawRelGen_injective {H K : Subgroup G}
    (hHK : H ≤ K) {r : ℕ}
    (hhi : H.relIndex K < H.index.minFac ^ (r + 1)) :
    Function.Injective (escapePathToRawRelGen hHK hhi) := by
  intro z w h
  apply escapeTuple_injective K
  exact congrArg Subtype.val h

/-- Relative escape theorem, in exact rational form for raw element
tuples.  This is the coset-free form used by packing. -/
theorem relative_escape_raw {H K : Subgroup G}
    (hn : 1 < H.index) (hHK : H ≤ K) {r : ℕ}
    (hhi : H.relIndex K < H.index.minFac ^ (r + 1)) :
    gammaQ H.index.minFac r * (Nat.card K : ℚ) ^ r ≤
      (Nat.card (RawRelGen H K r) : ℚ) := by
  letI : Finite (RawRelGen H K r) :=
    Finite.of_injective Subtype.val Subtype.val_injective
  letI : Fintype (RawRelGen H K r) := Fintype.ofFinite _
  have hpaths := escapePath_card_lower_bound hn hHK r
  have hcard : Fintype.card (EscapePath K r ⟨H, hHK⟩) ≤
      Fintype.card (RawRelGen H K r) :=
    Fintype.card_le_of_injective (escapePathToRawRelGen hHK hhi)
      (escapePathToRawRelGen_injective hHK hhi)
  apply hpaths.trans
  rw [Nat.card_eq_fintype_card]
  exact_mod_cast hcard

/-- Denominator-cleared natural-number form of relative escape. -/
theorem relative_escape_raw_nat {H K : Subgroup G}
    (hn : 1 < H.index) (hHK : H ≤ K) {r : ℕ}
    (hhi : H.relIndex K < H.index.minFac ^ (r + 1)) :
    gammaNum H.index.minFac r * Nat.card K ^ r ≤
      gammaDen H.index.minFac r * Nat.card (RawRelGen H K r) := by
  have hpPos : 0 < H.index.minFac := Nat.minFac_pos _
  have hdenPos : 0 < gammaDen H.index.minFac r := by
    exact pow_pos hpPos _
  have h := relative_escape_raw hn hHK hhi
  rw [gammaQ] at h
  have hdenNe : (gammaDen H.index.minFac r : ℚ) ≠ 0 :=
    (Nat.cast_pos.mpr hdenPos).ne'
  have hq :
      (gammaNum H.index.minFac r : ℚ) * (Nat.card K : ℚ) ^ r ≤
        (gammaDen H.index.minFac r : ℚ) *
          (Nat.card (RawRelGen H K r) : ℚ) := by
    calc
      (gammaNum H.index.minFac r : ℚ) * (Nat.card K : ℚ) ^ r =
          (gammaDen H.index.minFac r : ℚ) *
            ((gammaNum H.index.minFac r : ℚ) /
              gammaDen H.index.minFac r * (Nat.card K : ℚ) ^ r) := by
        field_simp
      _ ≤ (gammaDen H.index.minFac r : ℚ) *
          (Nat.card (RawRelGen H K r) : ℚ) :=
        mul_le_mul_of_nonneg_left h (by positivity)
  exact_mod_cast hq

/-- **Relative escape for literal coset tuples (Proposition 2.3).**
No normality hypothesis is imposed on `H`: the quotient here is the type
of left cosets for the subgroup `H.subgroupOf K`. -/
theorem relative_escape_coset {H K : Subgroup G}
    (hn : 1 < H.index) (hHK : H ≤ K) {r : ℕ}
    (hhi : H.relIndex K < H.index.minFac ^ (r + 1)) :
    gammaQ H.index.minFac r * (H.relIndex K : ℚ) ^ r ≤
      (Nat.card (CosetRelGen H K r) : ℚ) := by
  have hraw := relative_escape_raw hn hHK hhi
  have hcardNat := card_mul_relIndex hHK
  have hcardQ :
      (Nat.card H : ℚ) * (H.relIndex K : ℚ) = Nat.card K := by
    exact_mod_cast hcardNat
  have hrawCardNat :=
    rawRelGen_card_eq_cardH_pow_mul_cosetRelGen_card hHK r
  have hrawCardQ :
      (Nat.card (RawRelGen H K r) : ℚ) =
        (Nat.card H : ℚ) ^ r *
          (Nat.card (CosetRelGen H K r) : ℚ) := by
    exact_mod_cast hrawCardNat
  have hmul :
      (Nat.card H : ℚ) ^ r *
          (gammaQ H.index.minFac r * (H.relIndex K : ℚ) ^ r) ≤
        (Nat.card H : ℚ) ^ r *
          (Nat.card (CosetRelGen H K r) : ℚ) := by
    calc
      (Nat.card H : ℚ) ^ r *
            (gammaQ H.index.minFac r * (H.relIndex K : ℚ) ^ r) =
          gammaQ H.index.minFac r *
            (((Nat.card H : ℚ) * H.relIndex K) ^ r) := by
              rw [mul_pow]
              ring
      _ = gammaQ H.index.minFac r * (Nat.card K : ℚ) ^ r := by
        rw [hcardQ]
      _ ≤ (Nat.card (RawRelGen H K r) : ℚ) := hraw
      _ = (Nat.card H : ℚ) ^ r *
          (Nat.card (CosetRelGen H K r) : ℚ) := hrawCardQ
  have hHpowPos : (0 : ℚ) < (Nat.card H : ℚ) ^ r := by
    exact pow_pos (Nat.cast_pos.mpr Nat.card_pos) _
  exact le_of_mul_le_mul_left hmul hHpowPos

/-- Denominator-cleared natural-number form of the literal coset escape
theorem. -/
theorem relative_escape_coset_nat {H K : Subgroup G}
    (hn : 1 < H.index) (hHK : H ≤ K) {r : ℕ}
    (hhi : H.relIndex K < H.index.minFac ^ (r + 1)) :
    gammaNum H.index.minFac r * H.relIndex K ^ r ≤
      gammaDen H.index.minFac r * Nat.card (CosetRelGen H K r) := by
  have hdenPos : 0 < gammaDen H.index.minFac r := by
    exact pow_pos (Nat.minFac_pos _) _
  have h := relative_escape_coset hn hHK hhi
  rw [gammaQ] at h
  have hq :
      (gammaNum H.index.minFac r : ℚ) * (H.relIndex K : ℚ) ^ r ≤
        (gammaDen H.index.minFac r : ℚ) *
          (Nat.card (CosetRelGen H K r) : ℚ) := by
    calc
      (gammaNum H.index.minFac r : ℚ) * (H.relIndex K : ℚ) ^ r =
          (gammaDen H.index.minFac r : ℚ) *
            ((gammaNum H.index.minFac r : ℚ) /
              gammaDen H.index.minFac r * (H.relIndex K : ℚ) ^ r) := by
        field_simp
      _ ≤ (gammaDen H.index.minFac r : ℚ) *
          (Nat.card (CosetRelGen H K r) : ℚ) :=
        mul_le_mul_of_nonneg_left h (by positivity)
  exact_mod_cast hq

/-- The manuscript's band-form statement of Proposition 2.3.  The lower
band inequality records that `K` is in band `r`; escape itself uses the
upper inequality. -/
theorem relative_escape_coset_band {H K : Subgroup G}
    (hn : 1 < H.index) (hHK : H ≤ K) {r : ℕ}
    (_hlo : H.index.minFac ^ r ≤ H.relIndex K)
    (hhi : H.relIndex K < H.index.minFac ^ (r + 1)) :
    gammaQ H.index.minFac r * (H.relIndex K : ℚ) ^ r ≤
      (Nat.card (CosetRelGen H K r) : ℚ) :=
  relative_escape_coset hn hHK hhi

end

