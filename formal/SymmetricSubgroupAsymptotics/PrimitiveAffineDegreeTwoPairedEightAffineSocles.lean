import SymmetricSubgroupAsymptotics.AffineSimpleComplementNormalChain
import SymmetricSubgroupAsymptotics.PrimitiveAffineDegreeTwoPairedEightAffineTops
import Mathlib.GroupTheory.SpecificGroups.Cyclic

/-!
# Quotient socles for the literal paired-eight affine tops

The row-18 complement is generated by the retained singer of prime order
seven. Its simplicity and the affine coordinates close the quotient-socle
bound without additional row hypotheses. The explicitly conditional row-20
interface awaits the separate selected stabilizer simplicity certificate.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open scoped Classical

namespace SymmetricSubgroupAsymptotics
namespace PrimitiveAffineDegreeTwoPairedEightAffineTops

open Non2UnipotentPrefixFiniteMenu.PrimitiveAffineImprimitiveBlockTransfer

theorem firstVector_ne_zero : firstVector ≠ 0 := by
  decide +kernel

/-- The retained singer returns every binary vector after seven steps. -/
theorem singer_pow_seven : singer ^ 7 = 1 := by
  apply LinearEquiv.ext
  intro v
  revert v
  decide +kernel

theorem singer_ne_one : singer ≠ 1 := by
  intro h
  have hmoved : singer firstVector ≠ firstVector := by decide +kernel
  apply hmoved
  rw [h]
  rfl

/-- The linear singer has exact prime order seven. -/
theorem singer_orderOf : orderOf singer = 7 := by
  letI : Fact (Nat.Prime 7) := ⟨by decide⟩
  exact orderOf_eq_prime singer_pow_seven singer_ne_one

namespace Row18

theorem linearGroup_eq_zpowers : linearGroup = Subgroup.zpowers singer := by
  have hgen : Set.range linearGenerators = {singer} := by
    ext g
    simp [linearGenerators, eq_comm]
  change Subgroup.closure (Set.range linearGenerators) = _
  rw [hgen, ← Subgroup.zpowers_eq_closure]

/-- The actual generated row-18 complement has cardinality seven. -/
theorem linearGroup_card : Nat.card linearGroup = 7 := by
  rw [linearGroup_eq_zpowers, Nat.card_zpowers, singer_orderOf]

theorem linearGroup_isSimpleGroup : IsSimpleGroup linearGroup := by
  letI : Fact (Nat.Prime 7) := ⟨by decide⟩
  exact isSimpleGroup_of_prime_card linearGroup_card

/-- The normal chain is transported to the original literal permutation top. -/
def normalChain : FiniteThreeNormalChainData Source := by
  letI : IsSimpleGroup linearGroup := linearGroup_isSimpleGroup
  exact (AffineModel.simpleComplementNormalChain linearGroup irreducible
    firstVector firstVector_ne_zero).mapEquiv modelEquiv.symm

/-- Every literal row-18 normal quotient has two socle-generator positions. -/
def topSocle (N : {N : Subgroup Source // N.Normal}) :
    SocleNormalGeneratorBound (Source ⧸ N.1) 2 :=
  normalChain.quotientSocleGeneratorBound_two N

end Row18

namespace Row20

/-- Internal integration interface: the separate order-168 stabilizer
certificate must supply the displayed simplicity instance. -/
def normalChainOfSimple [IsSimpleGroup linearGroup] :
    FiniteThreeNormalChainData Source :=
  (AffineModel.simpleComplementNormalChain linearGroup irreducible
    firstVector firstVector_ne_zero).mapEquiv modelEquiv.symm

/-- Conditional row-20 helper, awaiting the literal stabilizer certificate. -/
def topSocleOfSimple [IsSimpleGroup linearGroup]
    (N : {N : Subgroup Source // N.Normal}) :
    SocleNormalGeneratorBound (Source ⧸ N.1) 2 :=
  normalChainOfSimple.quotientSocleGeneratorBound_two N

end Row20

/-- Closed quotient-socle export for the retained row-18 top. -/
def row18TopSocle :
    ∀ N : {N : Subgroup DegreeTwoPairedEightSharedTops.Top18 // N.Normal},
      SocleNormalGeneratorBound (DegreeTwoPairedEightSharedTops.Top18 ⧸ N.1) 2 :=
  Row18.topSocle

end PrimitiveAffineDegreeTwoPairedEightAffineTops
end SymmetricSubgroupAsymptotics

end
