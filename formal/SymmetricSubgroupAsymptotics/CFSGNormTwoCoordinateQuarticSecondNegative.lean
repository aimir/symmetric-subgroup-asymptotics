import SymmetricSubgroupAsymptotics.CFSGNormTwoCoordinateQuarticSecond

/-! The negative quartic identity follows from the ACTUAL Geck opposition,
not from assuming a kernel element commutes with opposition. Both integral
identities therefore express divided-power second coefficients in the
associative algebra generated by the SAME original E/F matrices. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
namespace SymmetricSubgroupAsymptotics.CFSGNormTwoCoordinateQuarticSecondNegative
open CFSGIntegerMatrixPairing CFSGNormTwoRootPairing CFSGSerreQuadraticMatrix
open CFSGGeckOppositionAlgEquiv CFSGNormTwoGeckNegative
open CFSGNormTwoGeckIntegralQuadratic CFSGNormTwoCoordinateQuarticSecond
open CFSGNormTwoGeckIntegralRealization
variable {r : ℕ} (A : Matrix (Fin r) (Fin r) ℤ) (hd : ∀i,A i i=2)
    (hs : A.transpose=A) (hp : (rationalMatrix A).PosDef)
    (ho : ∀i j,i≠j→A i j≤0)
    [Fintype (Roots A)] [DecidableEq (Roots A)]
    [(rootPairing A hs hp).IsReduced] [(rootPairing A hs hp).IsIrreducible]
local notation "b₀" => coordinateBase A hd hs hp ho
local notation "s₀" => coordinateIndexEquiv A hd hs hp ho
local notation "D" => realizationData A hs hp b₀ s₀
private abbrev MatQ := Matrix ((b₀).support⊕Roots A) ((b₀).support⊕Roots A) ℚ

theorem rational_negative_quartic_eq_negative_second (i j : Fin r) (hij : i≠j)
    (hA : A i j= -1) (hA' : A j i= -1) :
    (⁅(RootPairing.GeckConstruction.f (s₀ i) : MatQ A hd hs hp ho),
      RootPairing.GeckConstruction.f (s₀ j)⁆ * RootPairing.GeckConstruction.e (s₀ j))^2=
        -negativeSecondMatrix A hs hp b₀ (s₀ i) := by
  have he := congrArg (opposition b₀)
    (rational_quartic_eq_negative_second A hd hs hp ho i j hij hA hA')
  simpa only [Ring.lie_def,map_pow,map_mul,map_sub,map_neg,
    opposition_E,opposition_F,negativeSecondMatrix] using he

theorem integral_negative_quartic_eq_negative_second (i j : Fin r) (hij : i≠j)
    (hA : A i j= -1) (hA' : A j i= -1) :
    (⁅CFSGGeckIntegralMatrices.F b₀ (s₀ i),CFSGGeckIntegralMatrices.F b₀ (s₀ j)⁆ *
      CFSGGeckIntegralMatrices.E b₀ (s₀ j))^2= -negativeSecond A hs hp b₀ (s₀ i) := by
  apply CFSGSerreSquareZeroMatrix.integerCast_injective ((b₀).support⊕Roots A)
  change (Int.castRingHom ℚ).mapMatrix _=(Int.castRingHom ℚ).mapMatrix _
  simp only [map_pow,map_mul,Ring.lie_def,map_sub,map_neg,
    CFSGGeckIntegralMatrices.map_E,CFSGGeckIntegralMatrices.map_F,map_negativeSecond]
  exact rational_negative_quartic_eq_negative_second A hd hs hp ho i j hij hA hA'

theorem field_positive_quartic (K : Type*) [CommRing K] (i j : Fin r) (hij : i≠j)
    (hA : A i j= -1) (hA' : A j i= -1) :
    (⁅fieldRoot D K false i,fieldRoot D K false j⁆*fieldRoot D K true j)^2=
      -fieldSecond D K false i := by
  have he := congrArg (Int.castRingHom K).mapMatrix
    (integral_quartic_eq_negative_second A hd hs hp ho i j hij hA hA')
  change (⁅(Int.castRingHom K).mapMatrix (CFSGGeckIntegralMatrices.E b₀ (s₀ i)),
      (Int.castRingHom K).mapMatrix (CFSGGeckIntegralMatrices.E b₀ (s₀ j))⁆ *
      (Int.castRingHom K).mapMatrix (CFSGGeckIntegralMatrices.F b₀ (s₀ j)))^2=
        -(Int.castRingHom K).mapMatrix (positiveSecond A hs hp b₀ (s₀ i))
  simpa only [map_pow,Ring.lie_def,map_sub,map_mul,map_neg] using he

theorem field_negative_quartic (K : Type*) [CommRing K] (i j : Fin r) (hij : i≠j)
    (hA : A i j= -1) (hA' : A j i= -1) :
    (⁅fieldRoot D K true i,fieldRoot D K true j⁆*fieldRoot D K false j)^2=
      -fieldSecond D K true i := by
  have he := congrArg (Int.castRingHom K).mapMatrix
    (integral_negative_quartic_eq_negative_second A hd hs hp ho i j hij hA hA')
  change (⁅(Int.castRingHom K).mapMatrix (CFSGGeckIntegralMatrices.F b₀ (s₀ i)),
      (Int.castRingHom K).mapMatrix (CFSGGeckIntegralMatrices.F b₀ (s₀ j))⁆ *
      (Int.castRingHom K).mapMatrix (CFSGGeckIntegralMatrices.E b₀ (s₀ j)))^2=
        -(Int.castRingHom K).mapMatrix (negativeSecond A hs hp b₀ (s₀ i))
  simpa only [map_pow,Ring.lie_def,map_sub,map_mul,map_neg] using he

end SymmetricSubgroupAsymptotics.CFSGNormTwoCoordinateQuarticSecondNegative
