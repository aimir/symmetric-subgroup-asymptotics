def stages (i : Fin 71) : Fin 26 → Element := fun j => ofBits (rawStages i j)

def stepLetter (i : Fin 70) : Bool × (Fin 4 × Fin 8) :=
  rootWord.reverse.get ⟨i.val, by change i.val < 70; exact i.isLt⟩

theorem stage_initial : stages 0 = vectors 0 := by decide +kernel

theorem stage_final : stages (Fin.last 70) = vectors 1 := by decide +kernel

theorem step_certificate : ∀ i : Fin 70, ∀ j : Fin 26,
    sparseStep Element (stepLetter i).1 (stepLetter i).2.1
      (ofBits (stepLetter i).2.2) (stages i.castSucc) j = stages i.succ j := by
  decide +kernel

end SymmetricSubgroupAsymptotics.CFSGReeFFourFieldEightKrylovFirstStep
