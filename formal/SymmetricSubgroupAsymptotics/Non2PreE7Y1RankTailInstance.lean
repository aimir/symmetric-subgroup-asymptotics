private theorem axis_cold {b : ℕ}
    (P : Subgroup (preE7NonPairAction w i × Equiv.Perm (Fin b)) → Prop)
    (N : {N : Subgroup (preE7NonPairAction w i) // N.Normal})
    (J : Subgroup (Equiv.Perm (Fin b)))
    (hJ : ¬ IndexThreeRankHot (51 / 200) J) :
    fusionSurvivingEpiCount (preE7NonPairAction w i) P N J ≤
      completeQuotientWeight (R := CyclicThree) J +
        156 * (2 : ℝ) ^ ((1 / 3 : ℝ) * b) := by
  have hw := S.degree
  subst w
  let actionEquiv : preE7NonPairAction 4 i ≃* NaturalA4RankTail.A4 :=
    MulEquiv.subgroupCongr S.alternating
  refine (fusionSurvivingEpiCount_le_groupEpimorphism_card _ _ N J).trans ?_
  haveI : N.1.Normal := N.2
  by_cases hN : N.1 = ⊥
  · let e : (preE7NonPairAction 4 i ⧸ N.1) ≃* NaturalA4RankTail.A4 :=
      (QuotientGroup.quotientMulEquivOfEq hN).trans
        ((QuotientGroup.quotientBot).trans actionEquiv)
    rw [fusionGroupEpimorphism_card_congr (MulEquiv.refl J) e]
    exact (NaturalA4RankTail.bottom_epi_cold J hJ).trans
      (le_add_of_nonneg_left (completeQuotientWeight_nonneg J))
  · let N' : Subgroup NaturalA4RankTail.A4 :=
      N.1.map actionEquiv.toMonoidHom
    haveI hN'normal : N'.Normal := N.2.map _ actionEquiv.surjective
    have hN' : N' ≠ ⊥ := by
      intro hb
      apply hN
      rw [eq_bot_iff]
      intro x hx
      have hx' : actionEquiv x ∈ N' := ⟨x, hx, rfl⟩
      rw [hb] at hx'
      exact (Subgroup.mem_bot).mpr
        (actionEquiv.injective ((Subgroup.mem_bot.mp hx').trans (map_one _).symm))
    let e : (preE7NonPairAction 4 i ⧸ N.1) ≃*
        (NaturalA4RankTail.A4 ⧸ N') :=
      QuotientGroup.congr N.1 N' actionEquiv rfl
    rw [fusionGroupEpimorphism_card_congr (MulEquiv.refl J) e]
    exact (NaturalA4RankTail.nonbottom_epi_le_weight
      ⟨N', hN'normal⟩ hN' J).trans (le_add_of_nonneg_right (by positivity))

private theorem completeSource_cold {b : ℕ}
    (P : Subgroup (preE7NonPairAction w i × Equiv.Perm (Fin b)) → Prop)
    (J : Subgroup (Equiv.Perm (Fin b)))
    (hJ : ¬ IndexThreeRankHot (51 / 200) J) :
    fusionCompleteSourceSum (preE7NonPairAction w i) P J ≤
      (PreE7B6ActionCertificate.normalCount (preE7NonPairAction w i) : ℝ) *
        completeQuotientWeight (R := CyclicThree) J +
      (156 * (PreE7B6ActionCertificate.normalCount
        (preE7NonPairAction w i) : ℝ)) *
          (2 : ℝ) ^ ((1 / 3 : ℝ) * b) := by
  unfold fusionCompleteSourceSum PreE7B6ActionCertificate.normalCount
  calc
    _ ≤ ∑ _N : {N : Subgroup (preE7NonPairAction w i) // N.Normal},
        (completeQuotientWeight (R := CyclicThree) J +
          156 * (2 : ℝ) ^ ((1 / 3 : ℝ) * b)) :=
      Finset.sum_le_sum (fun N _ => S.axis_cold P N J hJ)
    _ = _ := by
      rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul,
        Fintype.card_eq_nat_card]
      ring

private theorem completeSource_full {b : ℕ}
    (P : Subgroup (preE7NonPairAction w i × Equiv.Perm (Fin b)) → Prop)
    (J : Subgroup (Equiv.Perm (Fin b))) :
    fusionCompleteSourceSum (preE7NonPairAction w i) P J ≤
      (PreE7B6ActionCertificate.normalCount (preE7NonPairAction w i) : ℝ) *
        ((Nat.factorial b : ℕ) : ℝ) ^ 16 := by
  have hw := S.degree
  subst w
  unfold fusionCompleteSourceSum PreE7B6ActionCertificate.normalCount
  calc
    _ ≤ ∑ _N : {N : Subgroup (preE7NonPairAction 4 i) // N.Normal},
        ((Nat.factorial b : ℕ) : ℝ) ^ 16 := by
      apply Finset.sum_le_sum
      intro N _
      refine (fusionSurvivingEpiCount_le_groupEpimorphism_card _ _ N J).trans ?_
      have hU : Nat.card (preE7NonPairAction 4 i) ≤ 2 ^ 16 := by
        have h := Nat.card_le_card_of_injective
          (Subtype.val : preE7NonPairAction 4 i → Equiv.Perm (Fin 4))
          Subtype.val_injective
        rw [Nat.card_perm, Nat.card_fin] at h
        exact h.trans (by norm_num)
      have hQ : Nat.card (preE7NonPairAction 4 i ⧸ N.1) ≤ 2 ^ 16 :=
        (Nat.card_le_card_of_surjective _
          (QuotientGroup.mk_surjective (s := N.1))).trans hU
      exact_mod_cast groupEpimorphism_card_le_factorial_pow J hQ
    _ = _ := by
      rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul,
        Fintype.card_eq_nat_card]

/-- The actual natural `A4` action produces the complete correlated
rank-tail certificate. -/
def rankTailCertificate : PreE7NaturalA4RankTailCertificate w i where
  normalCount := PreE7B6ActionCertificate.normalCount (preE7NonPairAction w i)
  normalCount_nonneg := Nat.cast_nonneg _
  width_eq := S.degree
  summed := by
    intro b P
    let hot : Subgroup (Equiv.Perm (Fin b)) → Prop :=
      IndexThreeRankHot (51 / 200)
    let D : ℝ := PreE7B6ActionCertificate.normalCount
      (preE7NonPairAction w i)
    let tail : ℝ := (156 * D) * (2 : ℝ) ^ ((1 / 3 : ℝ) * b)
    let full : ℝ := D * ((Nat.factorial b : ℕ) : ℝ) ^ 16
    have hD : 0 ≤ D := by dsimp [D]; positivity
    have htail : 0 ≤ tail := by dsimp [tail]; positivity
    have hfull : 0 ≤ full := by dsimp [full]; positivity
    rw [← Finset.sum_filter_add_sum_filter_not Finset.univ hot]
    calc
      (∑ J ∈ Finset.univ.filter hot,
          fusionCompleteSourceSum (preE7NonPairAction w i) P J) +
          ∑ J ∈ Finset.univ.filter (fun J => ¬ hot J),
            fusionCompleteSourceSum (preE7NonPairAction w i) P J ≤
        full * ((Finset.univ.filter hot).card : ℝ) +
          ∑ J ∈ Finset.univ.filter (fun J => ¬ hot J),
            (D * completeQuotientWeight (R := CyclicThree) J + tail) := by
        apply add_le_add
        · calc
            _ ≤ ∑ _J ∈ Finset.univ.filter hot, full :=
              Finset.sum_le_sum (fun J _ => S.completeSource_full P J)
            _ = _ := by rw [Finset.sum_const, nsmul_eq_mul, mul_comm]
        · apply Finset.sum_le_sum
          intro J hJ
          exact S.completeSource_cold P J (Finset.mem_filter.mp hJ).2
      _ ≤ full * ((Finset.univ.filter hot).card : ℝ) +
          ∑ J : Subgroup (Equiv.Perm (Fin b)),
            (D * completeQuotientWeight (R := CyclicThree) J + tail) := by
        exact add_le_add (le_refl _)
          (Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
            (fun _ _ _ => add_nonneg
              (mul_nonneg hD (completeQuotientWeight_nonneg _)) htail))
      _ ≤ full *
            ((Nat.factorial b : ℝ) *
              ((2 : ℝ) ^ (-((rankTail51Tilt b : ℝ) * (51 / 200) * b)) *
                (subgroupCount (b + 2 * rankTail51Tilt b) : ℝ))) +
          ∑ J : Subgroup (Equiv.Perm (Fin b)),
            (D * completeQuotientWeight (R := CyclicThree) J + tail) := by
        exact add_le_add
          (mul_le_mul_of_nonneg_left
            ((indexThreeRankHot_card_le (51 / 200) b).trans
              (mul_le_mul_of_nonneg_left (binaryRankHot51_card_le b)
                (Nat.cast_nonneg _))) hfull) (le_refl _)
      _ = _ := by
        rw [Finset.sum_add_distrib, Finset.sum_const, Finset.card_univ,
          nsmul_eq_mul, Fintype.card_eq_nat_card]
        dsimp only [D, tail, full, subgroupCount]
        ring

