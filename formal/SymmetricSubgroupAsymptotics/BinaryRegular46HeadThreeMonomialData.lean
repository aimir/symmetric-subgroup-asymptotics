def step (c : Fin 36) (op : Op) (a : Fin 32) : Option (Fin 32) :=
 match op with
 | .shear k => if 16 ≤ a.val ∧ Disjoint (support (labels c k)) (support ⟨a.val % 16, Nat.mod_lt _ (by decide)⟩)
   then some ⟨(unionIndex (labels c k) ⟨a.val % 16, Nat.mod_lt _ (by decide)⟩).val, by omega⟩ else none
 | op => (topStep op ⟨a.val % 16, Nat.mod_lt _ (by decide)⟩).map
     (fun b => if 16 ≤ a.val then ⟨16 + b.val, by omega⟩ else ⟨b.val, by omega⟩)

