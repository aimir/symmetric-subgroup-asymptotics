/-! Thirty-six antichains of THREE individual leading labels. No module
or normal-subgroup family is enumerated. Each displayed successor path
uses derivatives, one extra actual top shear, or an actual kernel shear. -/
set_option autoImplicit false
set_option Elab.async false
namespace SymmetricSubgroupAsymptotics.BinaryRegular46HeadThreeMonomial
open BinaryElementaryPairMonomialWidth BinaryBooleanFourPolynomialCoordinates
inductive Op where
 | derivative (i : Fin 4)
 | extra
 | shear (k : Fin 3)
 deriving DecidableEq

def topStep (op : Op) (a : Fin 16) : Option (Fin 16) :=
 match op with
 | .derivative i => if i ∈ support a then some (removeIndex i a) else none
 | .extra => if h : a.val % 2 = 1 ∧ a.val < 8 then some ⟨a.val + 7, by omega⟩ else none
 | .shear _ => none
