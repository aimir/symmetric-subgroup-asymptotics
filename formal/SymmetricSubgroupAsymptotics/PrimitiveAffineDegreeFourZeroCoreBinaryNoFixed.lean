import SymmetricSubgroupAsymptotics.PrimitiveAffineDegreeFourZeroCoreBinarySection
import SymmetricSubgroupAsymptotics.PrimeRelativeHeadCommutatorFull
import SymmetricSubgroupAsymptotics.SemisimpleCoinvariantsNoFixedRow
import SymmetricSubgroupAsymptotics.RepresentationSectionSubrepresentationHead

/-!
# The noncentral binary socle has no fixed simple row

The selected socle is generated by its mixed commutators with the retained
quotient.  Its complete relative binary head therefore vanishes.  The
elementary chart identifies that relative head with the head of the literal
full socle module, and semisimplicity then rules out every fixed simple row.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open scoped Classical MonoidAlgebra commutatorElement

namespace SymmetricSubgroupAsymptotics
namespace Non2UnipotentPrefixFiniteMenu
namespace PrimitiveAffineImprimitiveBlockTransfer

private theorem primeRelativeCharacters_finrank_eq_of_subgroup_eq
    {p : ℕ} [Fact p.Prime]
    {G : Type} [Group G] [Finite G]
    (K L : Subgroup G) [K.Normal] [L.Normal] (h : K = L) :
    Module.finrank (ZMod p) (primeRelativeCharacters p K) =
      Module.finrank (ZMod p) (primeRelativeCharacters p L) := by
  subst L
  rfl

variable {w : ℕ} {U : PreE7NonPairActionClass w}
  {basePoint : Fin w}
  (block : OriginalMinimalBlock
    (A := preE7NonPairAction w U) basePoint)
  (P : PrimitiveAffineProfile block.Component block.Fibre)
  [Nontrivial block.Fibre]

omit [Nontrivial block.Fibre] in
/-- The literal quotient-conjugation module of the noncentral binary socle
has zero coinvariants. -/
theorem degreeFourBinarySocle_coinvariants_eq_zero
    (N : DegreeFourLiteralNormalAxis (w := w) (U := U)) :
    Module.finrank (ZMod P.p)
      (DegreeFourBinarySocleChart block P N).quotientRepresentation.ρ.Coinvariants = 0 := by
  letI : Fact P.p.Prime := ⟨P.p_prime⟩
  let Q := DegreeFourRetainedQuotient N
  let A := DegreeFourBinarySocle block P N
  let C := DegreeFourBinarySocleChart block P N
  have hCp : C.p = P.p := by
    dsimp only [C, DegreeFourBinarySocleChart,
      selectedPrimeSoclePartElementaryChart]
  letI : Fact C.p.Prime := C.primeFact
  let ARep := C.quotientRepresentation
  let sigma := ARep.ρ
  let W : Subrepresentation sigma :=
    C.originalKernelChart.normalSubrepresentation
      (QuotientGroup.mk' A) (QuotientGroup.mk'_surjective A) ARep A
  have hcomm : ⁅A, (⊤ : Subgroup Q)⁆ = A := by
    rw [Subgroup.commutator_comm,
      commutator_top_noncentralPrimeSoclePart P.p (G := Q)]
  have hrelative :
      Module.finrank (ZMod C.p) (primeRelativeCharacters C.p A) = 0 := by
    simpa only [hCp] using
      (primeRelativeHead_eq_zero_of_mixedCommutator_eq P.p A hcomm)
  letI : FiniteDimensional (ZMod C.p) ARep := C.finiteDimensional
  letI : Module (ZMod C.p) W.toSubmodule := W.toSubmodule.module
  letI : FiniteDimensional (ZMod C.p) W.toSubmodule :=
    FiniteDimensional.finiteDimensional_submodule W.toSubmodule
  have hWhead : Module.finrank (ZMod C.p)
      (W.toRepresentation.IntertwiningMap
        (Representation.trivial (ZMod C.p) (Q ⧸ A) (ZMod C.p))) = 0 := by
    calc
      _ = Module.finrank (ZMod C.p)
          (primeRelativeCharacters C.p (A ⊓ A)) :=
        (elementaryIntersectionRelativeCharacterEquiv A C A).finrank_eq.symm
      _ = Module.finrank (ZMod C.p)
          (primeRelativeCharacters C.p A) :=
        primeRelativeCharacters_finrank_eq_of_subgroup_eq
          (A ⊓ A) A (inf_idem A)
      _ = 0 := hrelative
  let inclusion : W.toRepresentation.IntertwiningMap sigma := {
    toLinearMap := W.toSubmodule.subtype
    isIntertwining' := by intro g; rfl }
  have hinclusion : Function.Surjective inclusion := by
    intro v
    let a : A := C.equiv.symm (Multiplicative.ofAdd v)
    have hva : (C.equiv a).toAdd = v := by
      dsimp only [a]
      rw [C.equiv.apply_symm_apply]
      rfl
    have hvW : v ∈ W := by
      rw [← hva]
      exact (elementaryIntersectionModule_mem_iff A C A a).2 a.2
    exact ⟨⟨v, hvW⟩, rfl⟩
  have hsigmaHead := representationHead_finrank_le_of_surjective
    inclusion hinclusion
  rw [hWhead] at hsigmaHead
  have hsigmaHeadZero : Module.finrank (ZMod C.p)
      (sigma.IntertwiningMap
        (Representation.trivial (ZMod C.p) (Q ⧸ A) (ZMod C.p))) = 0 :=
    Nat.eq_zero_of_le_zero hsigmaHead
  have hsigmaCoinv : Module.finrank (ZMod C.p) sigma.Coinvariants = 0 := by
    rw [← representationHead_finrank_eq_coinvariants sigma]
    exact hsigmaHeadZero
  simpa only [hCp] using hsigmaCoinv

omit [Nontrivial block.Fibre] in
/-- Every simple row of the selected noncentral binary socle is nonfixed. -/
theorem degreeFourBinarySocle_simpleRow_not_fixed
    (N : DegreeFourLiteralNormalAxis (w := w) (U := U))
    (S : Submodule
      (ZMod P.p)[DegreeFourRetainedQuotient N ⧸ DegreeFourBinarySocle block P N]
      (DegreeFourBinarySocleChart block P N).quotientRepresentation.ρ.asModule)
    [IsSimpleModule
      (ZMod P.p)[DegreeFourRetainedQuotient N ⧸ DegreeFourBinarySocle block P N] S] :
    ¬ representationSubmoduleFixed
      (DegreeFourBinarySocleChart block P N).quotientRepresentation.ρ S := by
  letI : Fact P.p.Prime := ⟨P.p_prime⟩
  let C := DegreeFourBinarySocleChart block P N
  have hCp : C.p = P.p := by
    dsimp only [C, DegreeFourBinarySocleChart,
      selectedPrimeSoclePartElementaryChart]
  let hsemiP : IsSemisimpleModule
      (ZMod P.p)[DegreeFourRetainedQuotient N ⧸ DegreeFourBinarySocle block P N]
      (DegreeFourBinarySocleChart block P N).quotientRepresentation.ρ.asModule :=
    selectedPrimeSoclePart_quotientRepresentation_isSemisimple
      P.p (G := DegreeFourRetainedQuotient N)
      (fun M ↦ ¬ M ≤ Subgroup.center (DegreeFourRetainedQuotient N))
  letI : IsSemisimpleModule
      (ZMod C.p)[DegreeFourRetainedQuotient N ⧸ DegreeFourBinarySocle block P N]
      C.quotientRepresentation.ρ.asModule := by
    simpa only [hCp, C] using hsemiP
  letI : FiniteDimensional (ZMod C.p) C.quotientRepresentation :=
    C.finiteDimensional
  let hsimpleP : IsSimpleModule
      (ZMod P.p)[DegreeFourRetainedQuotient N ⧸ DegreeFourBinarySocle block P N]
      S := inferInstance
  cases hCp
  letI : IsSimpleModule
      (ZMod C.p)[DegreeFourRetainedQuotient N ⧸ DegreeFourBinarySocle block P N]
      S := by
    simpa only [C] using hsimpleP
  exact not_representationSubmoduleFixed_of_semisimple_coinvariants_zero
    C.quotientRepresentation.ρ
    (degreeFourBinarySocle_coinvariants_eq_zero block P N) S

