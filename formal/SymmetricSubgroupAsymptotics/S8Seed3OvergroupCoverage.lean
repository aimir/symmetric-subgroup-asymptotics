theorem property_conjugate (c : Ambient) (hc : MulAut.conj c • H = H)
    (W : Subgroup Ambient) (hW : Property W) : Property (MulAut.conj c • W) :=
  NormalizerAdjunctionEscapeCoverage.conjugate 2 8 H c hc W hW

theorem adjoin_property (g : Ambient) : Property (H ⊔ Subgroup.closure {g}) := by
  obtain ⟨i,hi⟩ := S8Seed3LeftCosets.covers g
  have he := FiniteLeftCosetCover.adjoin_eq_of_same_left_coset
    (H := H) g (representatives i) hi
  have hp := S8Seed3NormalizerRoots.reduction.property_representative
    Property property_conjugate root_property i
  rw [←he] at hp
  exact hp

theorem complete (U : Subgroup Ambient) (hHU : H ≤ U) : Property U :=
  NormalizerAdjunctionEscapeCoverage.complete 2 8 H adjoin_property U hHU

