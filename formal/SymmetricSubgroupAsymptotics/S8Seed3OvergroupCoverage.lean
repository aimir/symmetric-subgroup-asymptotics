/-! Every actual adjunction above original regularE8 lies in its SAME
normalizer or contains an actual larger transitive binary subgroup. All
finite packets are imported proof obligations, never classification inputs. -/
set_option autoImplicit false
noncomputable section
open scoped Pointwise
namespace SymmetricSubgroupAsymptotics.S8Seed3OvergroupCoverage
open S8Seed3LeftCosets

abbrev Property (W : Subgroup Ambient) : Prop :=
  NormalizerAdjunctionEscapeCoverage.Property 2 8 H W

theorem escape_of_extension (P W : Subgroup Ambient) (hPW : P ≤ W)
    (hP : IsPGroup 2 P) (hHP : H ≤ P) (hcard : 8 < Nat.card P) :
    PermutationPrimePowerSeedEscape.ContainsAbove 2 8 W :=
  ⟨P,hPW,hP,permutationSubgroupTransitive_mono H P hHP
    BinaryEightSeed3Transitivity.transitive,hcard⟩

set_option maxRecDepth 10000 in
set_option maxHeartbeats 1000000 in
