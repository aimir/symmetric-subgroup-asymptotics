/-- Uniform semantic access; this proof references the21 checked960 batches.
It does not evaluate another universal/20160 numerical certificate. -/
theorem prefixSecondCheck_eq_true (j : Second) : prefixSecondCheck j.val.val = true := by
  rcases j with ⟨j,hj⟩
  fin_cases j
  · exact (hj rfl).elim
  · exact second1Check_eq_true
  · exact second2Check_eq_true
  · exact second3Check_eq_true
  · exact second4Check_eq_true
  · exact second5Check_eq_true
  · exact second6Check_eq_true
  · exact second7Check_eq_true
