def coordinateWhitelist (j k l m : ℕ) : Bool :=
  (j == 16) && ((k == 19) && ((l == 16) && (m == 21)))

def rawCodeCheck (j k l m : ℕ) : Bool :=
  coordinateWhitelist j k l m ||
    (let code := failureCode j k l m
     let r := (code / 22) % 5
     let p := code % 22
     !(packedScalarRelation r 1 j k l m p == p))

def prefixSecondCheck (j : ℕ) : Bool :=
  rawThirdDomain.all (fun k => rawFourthDomain.all (fun l => rawFifthDomain.all (rawCodeCheck j k l)))

