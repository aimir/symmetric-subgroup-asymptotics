theorem coordinateWhitelist_sound (j : Second) (k : Third) (l : Fourth) (m : Fifth)
    (h : coordinateWhitelist j.val.val k.val.val l.val.val m.val.val = true) :
    selectedCode j k l m = whitelistCode := by
  simp only [coordinateWhitelist,Bool.and_eq_true,Nat.beq_eq_true_eq] at h
  rcases h with ⟨hj,hk,hl,hm⟩
  have hj' : j = (⟨16,by decide⟩ : Second) := Subtype.ext (Fin.ext hj)
  have hk' : k = (⟨19,by decide⟩ : Third) := Subtype.ext (Fin.ext hk)
  have hl' : l = (⟨16,by decide⟩ : Fourth) := Subtype.ext (Fin.ext hl)
  have hm' : m = (⟨21,by decide⟩ : Fifth) := Subtype.ext (Fin.ext hm)
  subst j
  subst k
  subst l
  subst m
  rfl

def failureRelator (j : Second) (k : Third) (l : Fourth) (m : Fifth) : Fin 5 :=
  ⟨(failureCode j.val.val k.val.val l.val.val m.val.val / 22) % 5,
    Nat.mod_lt _ (by decide)⟩

def failurePoint (j : Second) (k : Third) (l : Fourth) (m : Fifth) : Fin 22 :=
  ⟨failureCode j.val.val k.val.val l.val.val m.val.val % 22,Nat.mod_lt _ (by decide)⟩

theorem scalar_certificate (j : Second) (k : Third) (l : Fourth) (m : Fifth) :
    selectedCode j k l m = whitelistCode ∨
      scalarRelation (failureRelator j k l m) (selectedCode j k l m)
        (failurePoint j k l m) ≠ failurePoint j k l m := by
  have hk := all_true_at rawThirdDomain _ (prefixSecondCheck_eq_true j)
    k.val.val (mem_rawThirdDomain k)
  have hl := all_true_at rawFourthDomain _ hk l.val.val (mem_rawFourthDomain l)
  have hm := all_true_at rawFifthDomain _ hl m.val.val (mem_rawFifthDomain m)
  change (coordinateWhitelist j.val.val k.val.val l.val.val m.val.val || _) = true at hm
  rw [Bool.or_eq_true_eq_eq_true_or_eq_true] at hm
  rcases hm with hw | hn
  · exact Or.inl (coordinateWhitelist_sound j k l m hw)
  · apply Or.inr
    intro he
    apply not_beq_sound _ _ hn
    exact (packedScalarRelation_eq (failureRelator j k l m) (selectedCode j k l m)
      (failurePoint j k l m)).trans (congrArg (fun p : Fin 22 => p.val) he)

theorem accepts_selected_eq_whitelist (j : Second) (k : Third) (l : Fourth) (m : Fifth)
    (h : Accepts (decode (selectedCode j k l m))) :
    selectedCode j k l m = whitelistCode := by
  rcases scalar_certificate j k l m with he | hm
  · exact he
  · exact (hm (accepts_scalarRelation (selectedCode j k l m) h
      (failureRelator j k l m) (failurePoint j k l m))).elim

theorem accepts_code_eq_whitelist (c : Code) (hfirst : c.1.1 = 1)
    (h : Accepts (decode c)) : c = whitelistCode := by
  rcases c with ⟨⟨i,j⟩,⟨k,⟨l,m⟩⟩⟩
  change i = 1 at hfirst
  subst i
  exact accepts_selected_eq_whitelist j k l m h

def acceptedElements : Finset CFSG.Models.Mathieu22 := by
  classical
  exact {decode whitelistCode}

theorem accepts_mem_acceptedElements (c : Code) (hfirst : c.1.1 = 1)
    (h : Accepts (decode c)) : decode c ∈ acceptedElements := by
  classical
  rw [accepts_code_eq_whitelist c hfirst h]
  exact Finset.mem_singleton_self _

theorem acceptedElements_card_le_one : acceptedElements.card ≤ 1 := by
  classical
  change ({decode whitelistCode} : Finset CFSG.Models.Mathieu22).card ≤ 1
  exact le_of_eq (Finset.card_singleton _)

theorem map_second_mem_acceptedElements (f : MulAut CFSG.Models.Mathieu22)
    (hf : f firstElement = firstElement) (c : Code)
    (hc : decode c = f secondElement) (hfirst : c.1.1 = 1) :
    f secondElement ∈ acceptedElements := by
  rw [← hc]
  apply accepts_mem_acceptedElements c hfirst
  rw [hc]
  exact accepts_of_fixed_first f hf

