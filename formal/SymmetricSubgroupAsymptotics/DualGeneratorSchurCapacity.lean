import SymmetricSubgroupAsymptotics.InducedSubrepresentationCount
import SymmetricSubgroupAsymptotics.RepresentationCoordinateHeads
import SymmetricSubgroupAsymptotics.RepresentationDualSubquotientGenerators
import SymmetricSubgroupAsymptotics.RepresentationHeadExact
import SymmetricSubgroupAsymptotics.SchurRepresentation

/-!
# Schur capacity from generators of the contragredient

Dualising an intertwiner embeds every simple-source Hom space into a Hom
space whose source is the contragredient target.  Consequently a generating
tuple for that contragredient bounds the Schur capacity.  This is the
algebraic step used by the affine normal-graph incidence.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open scoped Classical MonoidAlgebra

namespace SymmetricSubgroupAsymptotics

variable {k G V W : Type} [Field k] [Group G]
  [AddCommGroup V] [Module k V] [AddCommGroup W] [Module k W]

/-- A generated representation admits at most `H * dim W` intertwining maps
to a finite-dimensional target `W`. -/
theorem intertwiningMap_finrank_le_of_generated_source
    (rho : Representation k G V) (sigma : Representation k G W)
    [FiniteDimensional k W] (H : ℕ)
    (hgen : RepresentationGeneratedBy rho H) :
    Module.finrank k (rho.IntertwiningMap sigma) ≤
      H * Module.finrank k W := by
  obtain ⟨v, hv⟩ := hgen
  let ev : (rho.IntertwiningMap sigma) →ₗ[k] (Fin H → W) :=
    { toFun := fun f i ↦ f (v i)
      map_add' := by intro f g; funext i; rfl
      map_smul' := by intro a f; funext i; rfl }
  have hev : Function.Injective ev := by
    intro f g hfg
    apply Representation.IntertwiningMap.ext
    apply LinearMap.ext
    intro x
    let f' : rho.asModule →ₗ[k[G]] sigma.asModule :=
      Representation.IntertwiningMap.equivLinearMapAsModule rho sigma f
    let g' : rho.asModule →ₗ[k[G]] sigma.asModule :=
      Representation.IntertwiningMap.equivLinearMapAsModule rho sigma g
    have heq : f' = g' := LinearMap.ext_on_range hv (fun i ↦ congrFun hfg i)
    exact DFunLike.congr_fun heq x
  have h := ev.finrank_le_finrank_of_injective hev
  simpa only [Module.finrank_pi_fintype, Finset.sum_const,
    Finset.card_univ, Fintype.card_fin, Nat.nsmul_eq_mul] using h

/-- Dualisation is injective on the finite-dimensional intertwining-map
space. -/
private theorem dualIntertwiner_injective
    (rho : Representation k G V) (sigma : Representation k G W)
    [FiniteDimensional k W] :
    Function.Injective
      (fun f : rho.IntertwiningMap sigma ↦
        RepresentationHeadExact.dualMap f) := by
  intro f g hfg
  apply Representation.IntertwiningMap.ext
  have hdual : f.toLinearMap.dualMap = g.toLinearMap.dualMap :=
    congrArg Representation.IntertwiningMap.toLinearMap hfg
  apply LinearMap.ext
  intro x
  apply (Module.bijective_dual_eval k W).1
  ext l
  exact DFunLike.congr_fun (DFunLike.congr_fun hdual l) x

/-- If the contragredient is generated by `H` elements, the original
representation has Schur capacity at most `H`. -/
theorem representationSchurCapacity_le_of_dual_generated
    (sigma : Representation k G W) [FiniteDimensional k W]
    (H : ℕ) (hgen : RepresentationGeneratedBy sigma.dual H) :
    representationSchurCapacity sigma ≤ H := by
  unfold representationSchurCapacity schurCapacity
  apply csSup_le (Set.insert_nonempty _ _)
  rintro x (rfl | ⟨S, hS, rfl⟩)
  · positivity
  · letI : Module k[G] sigma.asModule :=
      Representation.instModuleMonoidAlgebraAsModule sigma
    letI : IsScalarTower k k[G] sigma.asModule :=
      inferInstanceAs (IsScalarTower k k[G] (Representation.asModule sigma))
    letI : IsSimpleModule k[G] S := hS
    haveI : Nontrivial S := IsSimpleModule.nontrivial k[G] S
    let tau : Representation k G
        (Subrepresentation.ofSubmodule' S).toSubmodule :=
      (Subrepresentation.ofSubmodule' S).toRepresentation
    letI : FiniteDimensional k S := FiniteDimensional.of_injective
      (S.subtype.restrictScalars k) S.subtype_injective
    letI : FiniteDimensional k
        (Subrepresentation.ofSubmodule' S).toSubmodule :=
      FiniteDimensional.of_injective
        (Subrepresentation.ofSubmodule' S).toSubmodule.subtype
        (Subrepresentation.ofSubmodule' S).toSubmodule.injective_subtype
    have hdual : Module.finrank k (tau.IntertwiningMap sigma) ≤
        Module.finrank k (sigma.dual.IntertwiningMap tau.dual) := by
      let d : (tau.IntertwiningMap sigma) →ₗ[k]
          (sigma.dual.IntertwiningMap tau.dual) :=
        { toFun := fun f ↦ RepresentationHeadExact.dualMap f
          map_add' := by
            intro f g
            apply Representation.IntertwiningMap.ext
            ext l v
            simp [RepresentationHeadExact.dualMap, LinearMap.dualMap_apply]
          map_smul' := by
            intro a f
            apply Representation.IntertwiningMap.ext
            ext l v
            simp [RepresentationHeadExact.dualMap, LinearMap.dualMap_apply] }
      exact d.finrank_le_finrank_of_injective
        (dualIntertwiner_injective tau sigma)
    have htarget : Module.finrank k (sigma.dual.IntertwiningMap tau.dual) ≤
        H * Module.finrank k S := by
      have h := intertwiningMap_finrank_le_of_generated_source
        sigma.dual tau.dual H hgen
      rw [Subspace.dual_finrank_eq] at h
      have hfin : Module.finrank k
          (Subrepresentation.ofSubmodule' S).toSubmodule =
          Module.finrank k S := by
        rw [← tau.asModuleEquiv.finrank_eq]
        exact ((submoduleRepresentationModuleEquiv sigma S).restrictScalars k).finrank_eq.symm
      simpa only [tau, hfin] using h
    have hhom : Module.finrank k (S →ₗ[k[G]] sigma.asModule) ≤
        H * Module.finrank k S := by
      have h := hdual.trans htarget
      rw [(Representation.IntertwiningMap.equivLinearMapAsModule tau sigma).finrank_eq]
        at h
      rw [(moduleHomDomainEquiv (k := k) (A := sigma.asModule)
        (submoduleRepresentationModuleEquiv sigma S)).finrank_eq]
      exact h
    have hpos : (0 : ℝ) < Module.finrank k S := by
      exact_mod_cast (Module.finrank_pos (R := k) (M := S))
    apply (div_le_iff₀ hpos).mpr
    exact_mod_cast hhom

/-- A dual-generator certificate may be transported across an equivariant
linear equivalence before applying the Schur-capacity bound.  This is useful
when a concrete section is presented by a quotient chart while the finite
certificate is stated for a literal coordinate quotient. -/
theorem representationSchurCapacity_le_of_equiv_dual_generated
    {U : Type} [AddCommGroup U] [Module k U]
    (rho : Representation k G V) (sigma : Representation k G U)
    [FiniteDimensional k U]
    (e : rho.Equiv sigma) (H : ℕ)
    (hgen : RepresentationGeneratedBy rho.dual H) :
    representationSchurCapacity sigma ≤ H := by
  let d : rho.dual.IntertwiningMap sigma.dual :=
    RepresentationHeadExact.dualMap e.symm.toIntertwiningMap
  have hd : Function.Surjective d :=
    LinearMap.dualMap_surjective_of_injective e.symm.injective
  have hgen' : RepresentationGeneratedBy sigma.dual H :=
    representationGeneratedBy_of_surjective rho.dual sigma.dual d hd hgen
  exact representationSchurCapacity_le_of_dual_generated sigma H hgen'

/-- If a quotient-group representation inflates to a representation
equivalent to one with a generated contragredient, then the quotient-group
representation has the same capacity bound.  Surjectivity of the acting
group map makes inflation capacity-neutral. -/
theorem representationSchurCapacity_le_of_comp_equiv_dual_generated
    {Q U : Type} [Group Q] [AddCommGroup U] [Module k U]
    (rho : Representation k G V) (sigma : Representation k Q U)
    [FiniteDimensional k U]
    (q : G →* Q) (hq : Function.Surjective q)
    (e : rho.Equiv (sigma.comp q)) (H : ℕ)
    (hgen : RepresentationGeneratedBy rho.dual H) :
    representationSchurCapacity sigma ≤ H := by
  have hcomp : representationSchurCapacity (sigma.comp q) ≤ H :=
    representationSchurCapacity_le_of_equiv_dual_generated
      rho (sigma.comp q) e H hgen
  rwa [representationSchurCapacity_comp q hq sigma] at hcomp

/-- An integral representation-capacity bound gives the corresponding
Schur-scaled multiplicity bound on every simple row. -/
theorem schurSocleMultiplicity_le_nat_mul_end_finrank_of_capacity_le
    (sigma : Representation k G W) [FiniteDimensional k W]
    (H : ℕ) (hcap : representationSchurCapacity sigma ≤ H)
    {X : Type} [AddCommGroup X] [Module k X]
    [Module k[G] X] [IsScalarTower k k[G] X]
    [FiniteDimensional k X] [IsSimpleModule k[G] X] :
    schurSocleMultiplicity
        (k := k) (R := k[G]) (A := sigma.asModule) (X := X) ≤
      H * Module.finrank (Module.End k[G] X) X := by
  have hdim : (0 : ℝ) < Module.finrank k X := by
    letI : Nontrivial X := IsSimpleModule.nontrivial k[G] X
    exact_mod_cast (Module.finrank_pos (R := k) (M := X))
  have hhom := schurHom_finrank_le_capacity
    (k := k) (R := k[G]) (A := sigma.asModule) (M := X)
  have hratio :
      (Module.finrank k (X →ₗ[k[G]] sigma.asModule) : ℝ) /
          Module.finrank k X ≤ H := by
    calc
      _ ≤ representationSchurCapacity sigma := by
        apply (div_le_iff₀ hdim).2
        simpa only [representationSchurCapacity] using hhom
      _ ≤ H := hcap
  rw [schurSimpleRatio_eq_multiplicity_division
      (k := k) (R := k[G]) (A := sigma.asModule) (X := X)] at hratio
  have hEnd : (0 : ℝ) < Module.finrank (Module.End k[G] X) X := by
    have htower := schur_simple_finrank_tower (k := k) (R := k[G]) (X := X)
    have hpositive : 0 < Module.finrank (Module.End k[G] X) X := by
      by_contra hn
      have hz := Nat.eq_zero_of_not_pos hn
      rw [htower, hz, mul_zero] at hdim
      norm_num at hdim
    exact_mod_cast hpositive
  have hmul :
      (schurSocleMultiplicity
        (k := k) (R := k[G]) (A := sigma.asModule) (X := X) : ℝ) ≤
        H * Module.finrank (Module.End k[G] X) X :=
    (div_le_iff₀ hEnd).mp hratio
  exact_mod_cast hmul

/-- A generated contragredient gives the integral Schur-scaled row bound
used by the coupled nonfixed argument.  For a simple source `X`, dualising
embeds `Hom(X, sigma)` into `Hom(sigma⁺, X⁺)`.  Evaluation on `H`
generators bounds the latter by `H * dim_k X`; the scalar-extension formula
`dim_k X = dim_k End(X) * dim_End(X) X` then cancels the first Schur factor. -/
theorem schurSocleMultiplicity_le_of_dual_generated
    (sigma : Representation k G W) [FiniteDimensional k W]
    (H : ℕ) (hgen : RepresentationGeneratedBy sigma.dual H)
    {X : Type} [AddCommGroup X] [Module k X]
    [Module k[G] X] [IsScalarTower k k[G] X]
    [FiniteDimensional k X] [IsSimpleModule k[G] X] :
    schurSocleMultiplicity
        (k := k) (R := k[G]) (A := sigma.asModule) (X := X) ≤
      H * Module.finrank (Module.End k[G] X) X := by
  exact schurSocleMultiplicity_le_nat_mul_end_finrank_of_capacity_le
    sigma H (representationSchurCapacity_le_of_dual_generated sigma H hgen)

end SymmetricSubgroupAsymptotics

end
