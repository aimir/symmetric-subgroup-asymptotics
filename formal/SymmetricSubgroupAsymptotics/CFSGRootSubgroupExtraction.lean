import Mathlib.GroupTheory.Commutator.Basic
import Mathlib.Tactic.Group
import Mathlib.Tactic.Ring

/-! A direct double-commutator identity extracting an actual root
parameter from a diagonal element and a twisted Weyl element. The
normalizer/scaling hypotheses are explicit algebraic relations, not a
finite-simple-group generation or classification premise. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
open scoped commutatorElement
namespace SymmetricSubgroupAsymptotics.CFSGRootSubgroupExtraction
variable {F G : Type*} [Field F] [Group G]

/-- Two commuting torus conjugates isolate a root element from the
actual word in `h` and `root 1*w`. -/
theorem double_commutator_identity (root : F→G)
    (hAdd : ∀ a b : F,root (a+b)=root a*root b) (hZero : root 0=1)
    (h w : G) (k l : F)
    (hScale : ∀ a : F,h*root a*h⁻¹=root (k*a))
    (hScale' : ∀ a : F,(w*h*w⁻¹)*root a*(w*h*w⁻¹)⁻¹=root (l*a))
    (hComm : Commute (w*h*w⁻¹) h) :
    ⁅(root 1*w)*h*(root 1*w)⁻¹,h⁆=root ((1-l)*(1-k)) := by
  have hNeg : ∀ a : F,root (-a)=(root a)⁻¹ := by
    intro a
    symm
    apply inv_eq_of_mul_eq_one_right
    rw [←hAdd,add_neg_cancel,hZero]
  let t := w*h*w⁻¹
  have hScaleT : ∀ a : F,t*root a*t⁻¹=root (l*a) := hScale'
  have ht : t*h*t⁻¹=h := by
    change (w*h*w⁻¹)*h*(w*h*w⁻¹)⁻¹=h
    rw [hComm.eq]
    group
  have hy : (root 1*w)*h*(root 1*w)⁻¹=root (1-l)*t := by
    calc
      (root 1*w)*h*(root 1*w)⁻¹ = root 1*t*root (-1) := by
        rw [hNeg]
        dsimp [t]
        group
      _ = root 1*(t*root (-1)*t⁻¹)*t := by group
      _ = root 1*root (l*(-1))*t := by rw [hScaleT]
      _ = root (1-l)*t := by
        rw [←hAdd,show (1 : F)+l*(-1)=1-l by ring]
  rw [hy,commutatorElement_def]
  calc
    (root (1-l)*t)*h*(root (1-l)*t)⁻¹*h⁻¹ =
        root (1-l)*(t*h*t⁻¹)*(root (1-l))⁻¹*h⁻¹ := by group
    _ = root (1-l)*h*(root (1-l))⁻¹*h⁻¹ := by rw [ht]
    _ = root (1-l)*(h*root (-(1-l))*h⁻¹) := by rw [hNeg];group
    _ = root (1-l)*root (k*(-(1-l))) := by rw [hScale]
    _ = root ((1-l)*(1-k)) := by
      rw [←hAdd,show (1-l)+k*(-(1-l))=(1-l)*(1-k) by ring]

/-- The extracted root is an actual member of the subgroup generated by
the two displayed elements, with no normalizer membership assumption. -/
theorem root_mem_of_twisted_torus (root : F→G)
    (hAdd : ∀ a b : F,root (a+b)=root a*root b) (hZero : root 0=1)
    (h w : G) (k l : F)
    (hScale : ∀ a : F,h*root a*h⁻¹=root (k*a))
    (hScale' : ∀ a : F,(w*h*w⁻¹)*root a*(w*h*w⁻¹)⁻¹=root (l*a))
    (hComm : Commute (w*h*w⁻¹) h)
    (H : Subgroup G) (hH : h∈H) (hS : root 1*w∈H) : root ((1-l)*(1-k))∈H := by
  rw [←double_commutator_identity root hAdd hZero h w k l hScale hScale' hComm,
    commutatorElement_def]
  have hy : (root 1*w)*h*(root 1*w)⁻¹∈H :=
    H.mul_mem (H.mul_mem hS hH) (H.inv_mem hS)
  exact H.mul_mem (H.mul_mem (H.mul_mem hy hH) (H.inv_mem hy)) (H.inv_mem hH)

end SymmetricSubgroupAsymptotics.CFSGRootSubgroupExtraction
