import SymmetricSubgroupAsymptotics.CFSGReeFFourMiddleDerivedFiveWord
import SymmetricSubgroupAsymptotics.CFSGReeFFourFixedDiagonalCardinality
import SymmetricSubgroupAsymptotics.CFSGReeFFourFixedAmbientHom

/-! At the literal binary parameter, the proved four-element middle
fixed subgroup is generated by the actual four-cycle and the fixed
diagonal is trivial. These follow from parameter injectivity and exact
source counts; no small-group recognition or subgroup census is used. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
namespace SymmetricSubgroupAsymptotics.CFSGReeFFourBinaryMiddleGenerators
open CFSGReeFFourMiddleDerivedFiveWord CFSGReeFFourMiddleFixedWords
open CFSGReeFFourMiddleFixedParameters CFSGReeFFourMiddleWordMultiplication
open CFSGReeFFourMiddleFixedSubgroup CFSGReeFFourFixedDiagonalCardinality
open CFSGReeFFourFixedModelEquivalence CFSGReeFFourFixedBruhatCover
open CFSGReeFFourFieldParameters CFSGFFourOriginalMiddleWords
open CFSGReeFFourFixedAmbientHom
local instance : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
private instance fixedFinite (m : ℕ) : Finite (originalModelFixed m) :=
  Finite.of_injective (fixedAmbientHom m) (fixedAmbientHom_injective m)

private theorem parameter_zero (m : ℕ) : fixedMiddleParameter m (0,0) = 1 := by
  apply Subtype.ext
  change fixedMiddleWord m 0 0 = 1
  simpa only [fixedMiddleWord,map_zero,zero_pow (by decide : 2 ≠ 0),
    zero_mul,add_zero] using middleWord_zero m

private theorem fourCycle_square_ne_one (m : ℕ) : (fourCycle m)^2 ≠ 1 := by
  intro h
  have he : fixedMiddleParameter m (0,1) = fixedMiddleParameter m (0,0) :=
    (fourCycle_square m).symm.trans (h.trans (parameter_zero m).symm)
  have hp := fixedMiddleParameter_injective m he
  exact one_ne_zero (congrArg Prod.snd hp)

theorem fourCycle_order_four (m : ℕ) : orderOf (fourCycle m) = 4 :=
  orderOf_eq_prime_pow (p := 2) (n := 1) (fourCycle_square_ne_one m) (fourCycle_four m)

theorem middleFixed_zero_eq_zpowers :
    middleFixedSubgroup 0 = Subgroup.zpowers (fourCycle 0) := by
  have hle : Subgroup.zpowers (fourCycle 0) ≤ middleFixedSubgroup 0 := by
    apply Subgroup.zpowers_le.mpr
    change fourCycle 0 ∈ (middleFixedSubgroup 0 : Set (originalModelFixed 0))
    rw [middleFixedSubgroup_set]
    exact ⟨(1,0),rfl⟩
  apply (Subgroup.eq_of_le_of_card_ge hle ?_).symm
  rw [middleFixedSubgroup_card,Nat.card_zpowers,fourCycle_order_four]
  norm_num

theorem fixedDiagonal_zero_eq_bot : fixedDiagonal 0 = ⊥ := by
  apply Subgroup.card_eq_one.mp
  rw [fixedDiagonal_card]
  norm_num

end SymmetricSubgroupAsymptotics.CFSGReeFFourBinaryMiddleGenerators
