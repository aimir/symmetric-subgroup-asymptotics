import SymmetricSubgroupAsymptotics.FiniteGeneratorWord
import SymmetricSubgroupAsymptotics.BinaryNormalGeneratorChecks
import Mathlib.Algebra.Group.Subgroup.Pointwise

/-!
# Word certificates for sparse normal-join registries

The selected finite emitter represents each normal state by a short generator
tuple.  Normality is checked on the ambient generators.  A transition is
checked by words in the old state generators and conjugates of one selected
class representative.  These local checks imply the exact join equality
required by `FiniteNormalJoinRegistry`.
-/

set_option autoImplicit false
noncomputable section

namespace SymmetricSubgroupAsymptotics

variable {G ι κ τ : Type*} [Group G]

/-- Compact word checks for normality of a generated subgroup. -/
structure FiniteNormalityWordCertificate
    (ambient : ι → G) (state : κ → G) where
  positiveWords : ι → κ → FiniteGeneratorWord κ
  positiveEquations : ∀ i j,
    (positiveWords i j).eval state =
      ambient i * state j * (ambient i)⁻¹
  negativeWords : ι → κ → FiniteGeneratorWord κ
  negativeEquations : ∀ i j,
    (negativeWords i j).eval state =
      (ambient i)⁻¹ * state j * ambient i

namespace FiniteNormalityWordCertificate

variable {ambient : ι → G} {state : κ → G}
    (C : FiniteNormalityWordCertificate ambient state)

include C

/-- The local conjugation words install the actual `Normal` instance on the
literal generated subgroup. -/
theorem normal (ambient_full :
    Subgroup.closure (Set.range ambient) = ⊤) :
    (Subgroup.closure (Set.range state)).Normal := by
  apply binaryNormal_of_generator_conjugates ambient ambient_full state
  · intro i j
    rw [← C.positiveEquations i j]
    exact (C.positiveWords i j).eval_mem_closure state
  · intro i j
    rw [← C.negativeEquations i j]
    exact (C.negativeWords i j).eval_mem_closure state

end FiniteNormalityWordCertificate

/-- A word in an old normal state and arbitrary ambient conjugates of one
new class representative.  This is exactly the algebra generated by
`old ⊔ normalClosure {representative}`. -/
inductive FiniteNormalJoinWord (κ G : Type*) where
  | one : FiniteNormalJoinWord κ G
  | parent : κ → FiniteNormalJoinWord κ G
  | conjugate : G → FiniteNormalJoinWord κ G
  | mul : FiniteNormalJoinWord κ G → FiniteNormalJoinWord κ G →
      FiniteNormalJoinWord κ G
  | inv : FiniteNormalJoinWord κ G → FiniteNormalJoinWord κ G

namespace FiniteNormalJoinWord

variable {parent : κ → G}

/-- Literal evaluation of a normal-join word. -/
def eval (representative : G) : FiniteNormalJoinWord κ G → G
  | .one => 1
  | .parent i => parent i
  | .conjugate g => g * representative * g⁻¹
  | .mul u v => u.eval representative * v.eval representative
  | .inv u => (u.eval representative)⁻¹

/-- Every normal-join word lies in the exact old-state/normal-closure join. -/
theorem eval_mem (representative : G) (w : FiniteNormalJoinWord κ G) :
    w.eval (parent := parent) representative ∈
      Subgroup.closure (Set.range parent) ⊔
        Subgroup.normalClosure ({representative} : Set G) := by
  induction w with
  | one =>
      exact (Subgroup.closure (Set.range parent) ⊔
        Subgroup.normalClosure ({representative} : Set G)).one_mem
  | parent i =>
      exact (show Subgroup.closure (Set.range parent) ≤
          Subgroup.closure (Set.range parent) ⊔
            Subgroup.normalClosure ({representative} : Set G) from
        le_sup_left) (Subgroup.subset_closure (Set.mem_range_self i))
  | conjugate g =>
      have hrep : representative ∈
          Subgroup.normalClosure ({representative} : Set G) :=
        Subgroup.subset_normalClosure (by simp)
      have hconj : g * representative * g⁻¹ ∈
          Subgroup.normalClosure ({representative} : Set G) :=
        Subgroup.Normal.conj_mem inferInstance representative hrep g
      exact (show Subgroup.normalClosure ({representative} : Set G) ≤
          Subgroup.closure (Set.range parent) ⊔
            Subgroup.normalClosure ({representative} : Set G) from
        le_sup_right) hconj
  | mul u v hu hv =>
      exact (Subgroup.closure (Set.range parent) ⊔
        Subgroup.normalClosure ({representative} : Set G)).mul_mem hu hv
  | inv u hu =>
      exact (Subgroup.closure (Set.range parent) ⊔
        Subgroup.normalClosure ({representative} : Set G)).inv_mem hu

end FiniteNormalJoinWord

/-- Proof-carrying sparse transition between two generated normal states. -/
structure FiniteNormalJoinTransitionCertificate
    (parent : κ → G) (representative : G) (child : τ → G) where
  parentToChild : FiniteGeneratorWordCertificate parent child
  representativeWord : FiniteGeneratorWord τ
  representativeEquation :
    representativeWord.eval child = representative
  childWords : τ → FiniteNormalJoinWord κ G
  childEquations : ∀ j,
    (childWords j).eval (parent := parent) representative = child j

namespace FiniteNormalJoinTransitionCertificate

variable {parent : κ → G} {representative : G} {child : τ → G}
    (C : FiniteNormalJoinTransitionCertificate parent representative child)

include C

/-- A checked transition is the literal join with the normal closure of the
selected class representative. -/
theorem join_eq [hchild : (Subgroup.closure (Set.range child)).Normal] :
    Subgroup.closure (Set.range parent) ⊔
        Subgroup.normalClosure ({representative} : Set G) =
      Subgroup.closure (Set.range child) := by
  apply le_antisymm
  · apply sup_le C.parentToChild.closure_le
    apply Subgroup.normalClosure_le_normal
    intro x hx
    have heq : x = representative := Set.mem_singleton_iff.mp hx
    subst x
    rw [← C.representativeEquation]
    exact C.representativeWord.eval_mem_closure child
  · apply (Subgroup.closure_le _).mpr
    rintro _ ⟨j, rfl⟩
    rw [← C.childEquations j]
    exact (C.childWords j).eval_mem representative

end FiniteNormalJoinTransitionCertificate

end SymmetricSubgroupAsymptotics

end
