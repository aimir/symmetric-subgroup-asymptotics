    rowEnd PrimitiveAffineSixteenFrameRow4TopCertificate.certificate.identity = 1 := by
  apply LinearMap.ext
  intro v
  change (rowMatrix PrimitiveAffineSixteenFrameRow4TopCertificate.certificate.identity).mulVec v = v
  have h : rowMatrix PrimitiveAffineSixteenFrameRow4TopCertificate.certificate.identity = 1 := by native_decide
  rw [h, Matrix.one_mulVec]

