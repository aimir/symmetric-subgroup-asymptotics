import Mathlib.GroupTheory.Abelianization.Defs
import Mathlib.GroupTheory.Subgroup.Centralizer
import Mathlib.GroupTheory.SpecificGroups.Cyclic.Basic
import Mathlib.Tactic.Group

/-! A two-coset Schreier containment without an index-two hypothesis.
If the original group is generated by `S` and `y`, its derived subgroup
lies in the closure of `S`, its conjugates by `y`, and `y²`.
The displayed closure is proved normal and its actual quotient cyclic;
no assumption places `y` outside the derived subgroup. -/
set_option autoImplicit false
noncomputable section
open scoped Classical IsMulCommutative
namespace SymmetricSubgroupAsymptotics.DerivedTwoCosetGeneratorContainment

variable {G : Type*} [Group G]

/-- The literal two-coset Schreier generator set in the original group. -/
def generatorSet (S : Set G) (y : G) : Set G :=
  S ∪ (fun s => y * s * y⁻¹) '' S ∪ {y ^ 2}

/-- Its closure retains the original ambient group and original generators. -/
def generatedSubgroup (S : Set G) (y : G) : Subgroup G :=
  Subgroup.closure (generatorSet S y)

private theorem original_mem {S : Set G} {y s : G} (hs : s ∈ S) :
    s ∈ generatedSubgroup S y :=
  Subgroup.subset_closure (Or.inl (Or.inl hs))

private theorem conjugate_mem {S : Set G} {y s : G} (hs : s ∈ S) :
    y * s * y⁻¹ ∈ generatedSubgroup S y :=
  Subgroup.subset_closure (Or.inl (Or.inr ⟨s, hs, rfl⟩))

private theorem square_mem (S : Set G) (y : G) :
    y ^ 2 ∈ generatedSubgroup S y :=
  Subgroup.subset_closure (Or.inr rfl)

/-- The extra square makes forward conjugation by `y` invertible on
this closure, even for an infinite original group. -/
theorem generatedSubgroup_normal (S : Set G) (y : G)
    (hgen : Subgroup.closure (S ∪ {y}) = ⊤) :
    (generatedSubgroup S y).Normal := by
  let H := generatedSubgroup S y
  have hsquare : y ^ 2 ∈ H := square_mem S y
  have hforward : ∀ z ∈ H, y * z * y⁻¹ ∈ H := by
    have hle : H ≤ H.comap (MulAut.conj y).toMonoidHom := by
      apply (Subgroup.closure_le _).mpr
      intro z hz
      change y * z * y⁻¹ ∈ H
      rcases hz with (hs | ⟨s, hs, rfl⟩) | hs
      · exact conjugate_mem hs
      · have hh := H.mul_mem (H.mul_mem hsquare (original_mem hs))
          (H.inv_mem hsquare)
        have he : y ^ 2 * s * (y ^ 2)⁻¹ =
            y * (y * s * y⁻¹) * y⁻¹ := by
          simp only [pow_two, mul_inv_rev, mul_assoc]
        rwa [he] at hh
      · have hz : z = y ^ 2 := hs
        subst z
        have he : y * y ^ 2 * y⁻¹ = y ^ 2 := by group
        rwa [he]
    intro z hz
    exact hle hz
  have hy : y ∈ Subgroup.normalizer (H : Set G) := by
    apply Subgroup.mem_normalizer_iff.mpr
    intro z
    constructor
    · exact hforward z
    · intro hz
      have hh := hforward _ hz
      have hm := H.mul_mem (H.mul_mem (H.inv_mem hsquare) hh) hsquare
      have he : (y ^ 2)⁻¹ * (y * (y * z * y⁻¹) * y⁻¹) * y ^ 2 = z := by group
      rwa [he] at hm
  apply Subgroup.normalizer_eq_top_iff.mp
  apply top_unique
  rw [← hgen]
  apply (Subgroup.closure_le _).mpr
  intro z hz
  rcases hz with hs | hs
  · exact H.le_normalizer (original_mem hs)
  · have hz : z = y := hs
    subst z
    exact hy

/-- Every commutator is generated by the original `S`, its actual
conjugates by `y`, and the actual square `y²`. -/
theorem commutator_le_generatedSubgroup (S : Set G) (y : G)
    (hgen : Subgroup.closure (S ∪ {y}) = ⊤) :
    commutator G ≤ generatedSubgroup S y := by
  let H := generatedSubgroup S y
  letI : H.Normal := generatedSubgroup_normal S y hgen
  let pi : G →* G ⧸ H := QuotientGroup.mk' H
  have hfull : (⊤ : Subgroup G) ≤ (Subgroup.zpowers (pi y)).comap pi := by
    rw [← hgen]
    apply (Subgroup.closure_le _).mpr
    intro z hz
    change pi z ∈ Subgroup.zpowers (pi y)
    rcases hz with hs | hs
    · have hz : pi z = 1 := (QuotientGroup.eq_one_iff _).mpr (original_mem hs)
      rw [hz]
      exact Subgroup.one_mem _
    · have hz : z = y := hs
      subst z
      exact Subgroup.mem_zpowers _
  have hle : (⊤ : Subgroup (G ⧸ H)) ≤ Subgroup.zpowers (pi y) := by
    intro q _
    obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective H q
    exact hfull (show g ∈ (⊤ : Subgroup G) from trivial)
  letI : IsCyclic (G ⧸ H) := isCyclic_iff_exists_zpowers_eq_top.mpr
    ⟨pi y, le_antisymm le_top hle⟩
  have hd := Abelianization.commutator_subset_ker pi
  simpa only [pi, QuotientGroup.ker_mk'] using hd

end SymmetricSubgroupAsymptotics.DerivedTwoCosetGeneratorContainment
