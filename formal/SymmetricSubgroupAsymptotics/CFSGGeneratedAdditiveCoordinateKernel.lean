import Mathlib.GroupTheory.Abelianization.Defs
import Mathlib.Algebra.Group.Subgroup.Lattice
import Mathlib.Algebra.BigOperators.Group.Finset.Basic
import Mathlib.Data.Fintype.Basic

/-! A group generated by additive root parametrizations, with genuine
independent additive coordinates on those generators, has precisely its
derived subgroup as coordinate kernel. This collects ACTUAL group words
in the abelianization, not only their surrounding matrix coefficients. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
namespace SymmetricSubgroupAsymptotics.CFSGGeneratedAdditiveCoordinateKernel
variable {G J K : Type*} [Group G] [Fintype J] [DecidableEq J] [AddCommGroup K]
    (root : J→K→G) (hzero : ∀i,root i 0=1)
    (hadd : ∀i a b,root i (a+b)=root i a*root i b)

def decode : Multiplicative (J→K)→*Abelianization G where
  toFun c := ∏i,Abelianization.of (root i (Multiplicative.toAdd c i))
  map_one' := by
    change (∏i,Abelianization.of (root i 0))=1
    simp only [hzero,map_one,Finset.prod_const_one]
  map_mul' := by
    intro c d
    change (∏i,Abelianization.of (root i (Multiplicative.toAdd c i+Multiplicative.toAdd d i)))=
      (∏i,Abelianization.of (root i (Multiplicative.toAdd c i)))*
        (∏i,Abelianization.of (root i (Multiplicative.toAdd d i)))
    simp only [hadd,map_mul,Finset.prod_mul_distrib]

theorem decode_single (i : J) (a : K) :
    decode root hzero hadd (Multiplicative.ofAdd (Pi.single i a : J→K))=
      Abelianization.of (root i a) := by
  change (∏j,Abelianization.of (root j ((Pi.single i a : J→K) j)))= _
  calc
    _=Abelianization.of (root i ((Pi.single i a : J→K) i)) := by
      apply Finset.prod_eq_single i
      · intro j hj hji
        simp [hji,hzero]
      · intro hi
        exact False.elim (hi (Finset.mem_univ i))
    _=_ := by simp only [Pi.single_apply,if_true]

variable (coord : G→*Multiplicative (J→K))
    (hcoord : ∀i a,coord (root i a)=Multiplicative.ofAdd (Pi.single i a : J→K))
    (hgen : Subgroup.closure (Set.range (fun z : J×K=>root z.1 z.2))=⊤)

include root hzero hadd hcoord hgen

theorem decode_coordinate (g : G) : decode root hzero hadd (coord g)=Abelianization.of g := by
  have hall : ∀x∈Subgroup.closure (Set.range (fun z : J×K=>root z.1 z.2)),
      decode root hzero hadd (coord x)=Abelianization.of x := by
    intro x hx
    induction hx using Subgroup.closure_induction with
    | mem x hx=>
      obtain ⟨⟨i,a⟩,rfl⟩ := hx
      rw [hcoord,decode_single]
    | one=>simp only [map_one]
    | mul x y hx hy ihx ihy=>rw [map_mul,map_mul,ihx,ihy,map_mul]
    | inv x hx ihx=>rw [map_inv,map_inv,ihx,map_inv]
  apply hall
  rw [hgen]
  trivial

theorem coordinate_kernel_eq_commutator : coord.ker=commutator G := by
  apply le_antisymm _ (Abelianization.commutator_subset_ker coord)
  intro g hg
  have hcoordg : coord g=1 := hg
  have ha : Abelianization.of g=1 := by
    rw [←decode_coordinate root hzero hadd coord hcoord hgen g,hcoordg,map_one]
  rw [←Abelianization.ker_of]
  exact ha

end SymmetricSubgroupAsymptotics.CFSGGeneratedAdditiveCoordinateKernel
