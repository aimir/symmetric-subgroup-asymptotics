import SymmetricSubgroupAsymptotics.CFSGExceptionalHeisenbergProduct
import SymmetricSubgroupAsymptotics.CFSGFiniteCommutingParameterRange

/-! The actual Heisenberg coordinate chart has exactly the subgroup
generated by its displayed root-parameter factors. This identification
uses the existing product law and explicit coordinate preimages only. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
namespace SymmetricSubgroupAsymptotics.CFSGExceptionalHeisenbergRootRange
open CFSGIntegerMatrixPairing CFSGNormTwoRootPairing CFSGHeisenbergCoordinateGroup
open CFSGExceptionalHeisenbergRootPilot CFSGExceptionalHeisenbergRootRelations
open CFSGExceptionalHeisenbergProduct CFSGFiniteCommutingParameterHom
open CFSGFiniteCommutingParameterRange
variable {r m : ℕ} (A : Matrix (Fin r) (Fin r) ℤ) (hd : ∀ i,A i i=2)
  (hs : A.transpose=A) (hp : (rationalMatrix A).PosDef)
  (ho : ∀ i j,i≠j→A i j≤0)
  [Fintype (Roots A)] [DecidableEq (Roots A)]
  [(rootPairing A hs hp).IsReduced] [(rootPairing A hs hp).IsIrreducible]
  (C : RootConfig A m)
private abbrev U (K : Type) [CommRing K] :=
  (Matrix ((coordinateBase A hd hs hp ho).support⊕Roots A)
    ((coordinateBase A hd hs hp ho).support⊕Roots A) K)ˣ
private abbrev Xh (K : Type) [CommRing K] : Multiplicative (Fin m → K) →* U A hd hs hp ho K :=
  X A hd hs hp ho C K
private abbrev Yh (K : Type) [CommRing K] : Multiplicative (Fin m → K) →* U A hd hs hp ho K :=
  Y A hd hs hp ho C K
private abbrev Zh (K : Type) [CommRing K] : Multiplicative K →* U A hd hs hp ho K :=
  zHom A hd hs hp ho C K
private abbrev Rh (K : Type) [CommRing K] : Element K m →* U A hd hs hp ho K :=
  rawHom A hd hs hp ho C K
private abbrev xh (K : Type) [CommRing K] (i : Fin m) : Multiplicative K →* U A hd hs hp ho K :=
  xHom A hd hs hp ho C K i
private abbrev yh (K : Type) [CommRing K] (i : Fin m) : Multiplicative K →* U A hd hs hp ho K :=
  yNegative A hd hs hp ho C K i

theorem rawHom_range_eq_factors (K : Type) [CommRing K] :
    (Rh A hd hs hp ho C K).range =
      (Xh A hd hs hp ho C K).range ⊔ (Yh A hd hs hp ho C K).range ⊔
        (Zh A hd hs hp ho C K).range := by
  let R := (Rh A hd hs hp ho C K).range
  let S := (Xh A hd hs hp ho C K).range ⊔ (Yh A hd hs hp ho C K).range ⊔
    (Zh A hd hs hp ho C K).range
  have hx : (Xh A hd hs hp ho C K).range ≤ R := by
    rintro x ⟨v,rfl⟩
    refine ⟨⟨v.toAdd,0,0⟩,?_⟩
    change Xh A hd hs hp ho C K v * Yh A hd hs hp ho C K 1 * Zh A hd hs hp ho C K 1 = _
    rw [map_one,map_one,mul_one,mul_one]
  have hy : (Yh A hd hs hp ho C K).range ≤ R := by
    rintro y ⟨v,rfl⟩
    refine ⟨⟨0,v.toAdd,0⟩,?_⟩
    change Xh A hd hs hp ho C K 1 * Yh A hd hs hp ho C K v * Zh A hd hs hp ho C K 1 = _
    rw [map_one,map_one,one_mul,mul_one]
  have hz : (Zh A hd hs hp ho C K).range ≤ R := by
    rintro z ⟨c,rfl⟩
    exact ⟨central c,rawHom_central A hd hs hp ho C K c⟩
  apply le_antisymm
  · have hX : (Xh A hd hs hp ho C K).range ≤ S := le_sup_left.trans le_sup_left
    have hY : (Yh A hd hs hp ho C K).range ≤ S := le_sup_right.trans le_sup_left
    have hZ : (Zh A hd hs hp ho C K).range ≤ S := le_sup_right
    rintro x ⟨g,rfl⟩
    change Xh A hd hs hp ho C K (Multiplicative.ofAdd g.a) *
      Yh A hd hs hp ho C K (Multiplicative.ofAdd g.b) *
      Zh A hd hs hp ho C K (Multiplicative.ofAdd g.c) ∈ S
    exact S.mul_mem (S.mul_mem (hX ⟨_,rfl⟩) (hY ⟨_,rfl⟩)) (hZ ⟨_,rfl⟩)
  · exact sup_le (sup_le hx hy) hz

theorem rawHom_range_eq_root_join (K : Type) [CommRing K] :
    (Rh A hd hs hp ho C K).range =
      (⨆ i, (xh A hd hs hp ho C K i).range) ⊔
      (⨆ i, (yh A hd hs hp ho C K i).range) ⊔ (Zh A hd hs hp ho C K).range := by
  have hx : (Xh A hd hs hp ho C K).range = ⨆ i, (xh A hd hs hp ho C K i).range := by
    change (parameterHom (xHom A hd hs hp ho C K) _).range = _
    exact parameterHom_range _ _
  have hy : (Yh A hd hs hp ho C K).range = ⨆ i, (yh A hd hs hp ho C K i).range := by
    change (parameterHom (yNegative A hd hs hp ho C K) _).range = _
    exact parameterHom_range _ _
  rw [rawHom_range_eq_factors,hx,hy]

end SymmetricSubgroupAsymptotics.CFSGExceptionalHeisenbergRootRange
