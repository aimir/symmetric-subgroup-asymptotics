import SymmetricSubgroupAsymptotics.CFSGTypeAElementaryMatrices
import Mathlib.Algebra.BigOperators.Pi
import Mathlib.Algebra.BigOperators.GroupWithZero.Finset
import Mathlib.Algebra.Group.Submonoid.Operations
import Mathlib.Algebra.Group.Submonoid.BigOperators

/-! Uniform elementary generation of the literal special linear group.
Diagonal factors are assembled in the commutative coordinate-function
monoid and then mapped to matrices, so no commutativity of SL is assumed. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
open scoped BigOperators
namespace SymmetricSubgroupAsymptotics.CFSGTypeAElementaryGeneration
open Matrix CFSGTypeAElementaryMatrices
variable {n : Type*} [Fintype n] [DecidableEq n] {F : Type*} [Field F]

/-- Every determinant-one diagonal matrix is generated by the actual
transvections. The distinguished coordinate is an arbitrary original
point of the matrix index set. -/
theorem diagonal_mem_of_transvections (K : Submonoid (Matrix n n F))
    (hK : ∀ i j : n,i≠j→∀ a : F,Matrix.transvection i j a∈K)
    (b : n) (D : n→F) (hD : ∏ i,D i=1) : Matrix.diagonal D∈K := by
  have hnonzero : ∀ i,D i≠0 := by
    have hp : (∏ i,D i)≠0 := by rw [hD];exact one_ne_zero
    exact fun i => (Finset.prod_ne_zero_iff.mp hp) i (Finset.mem_univ i)
  let r : n→n→F := fun i k => if k=i then D i else if k=b then (D i)⁻¹ else 1
  let L : Submonoid (n→F) := K.comap (Matrix.diagonalRingHom n F).toMonoidHom
  have hr : ∀ i,i≠b → r i∈L := by
    intro i hib
    change Matrix.diagonal (r i)∈K
    change Matrix.diagonal (fun k => if k=i then D i else if k=b then (D i)⁻¹ else 1)∈K
    rw [←diagonal_pair hib (D i) (hnonzero i)]
    exact K.mul_mem (K.mul_mem (K.mul_mem (hK i b hib _) (hK b i (Ne.symm hib) _))
      (hK i b hib _)) (hK b i (Ne.symm hib) _)
  have hmem : (∏ i∈Finset.univ.erase b,r i)∈L := by
    apply L.prod_mem
    intro i hi
    exact hr i (Finset.mem_erase.mp hi).1
  have heq : (∏ i∈Finset.univ.erase b,r i)=D := by
    funext k
    rw [Finset.prod_apply]
    by_cases hkb : k=b
    · subst k
      calc
        (∏ i∈Finset.univ.erase b,r i b) = ∏ i∈Finset.univ.erase b,(D i)⁻¹ := by
          apply Finset.prod_congr rfl
          intro i hi
          have hib := (Finset.mem_erase.mp hi).1
          simp [r,Ne.symm hib]
        _ = (∏ i∈Finset.univ.erase b,D i)⁻¹ := Finset.prod_inv_distrib _
        _ = D b := inv_eq_of_mul_eq_one_right
          ((Finset.prod_erase_mul Finset.univ D (Finset.mem_univ b)).trans hD)
    · calc
        (∏ i∈Finset.univ.erase b,r i k) = r k k := by
          apply Finset.prod_eq_single k
          · intro i hi hik
            simp [r,hkb,Ne.symm hik]
          · intro hk
            exact False.elim (hk (Finset.mem_erase.mpr ⟨hkb,Finset.mem_univ k⟩))
        _ = D k := by simp [r]
  rw [heq] at hmem
  exact hmem

/-- Any subgroup containing all actual elementary matrices is the full
special linear group, uniformly in the matrix dimension. -/
theorem eq_top_of_elementary (H : Subgroup (SL (n:=n) (F:=F)))
    (hH : ∀ i j : n,∀ (hij : i≠j) (a : F),elementary hij a∈H) : H=⊤ := by
  let K : Submonoid (Matrix n n F) := {
    carrier := {M | ∃ A : SL (n:=n) (F:=F),A∈H ∧ A.val=M}
    one_mem' := ⟨1,H.one_mem,rfl⟩
    mul_mem' := by
      rintro _ _ ⟨A,hA,rfl⟩ ⟨B,hB,rfl⟩
      exact ⟨A*B,H.mul_mem hA hB,rfl⟩ }
  have hK : ∀ i j : n,i≠j→∀ a : F,Matrix.transvection i j a∈K := by
    intro i j hij a
    exact ⟨elementary hij a,hH i j hij a,rfl⟩
  have allMatrices : ∀ M : Matrix n n F,M.det=1→M∈K := by
    intro M hM
    apply Matrix.diagonal_transvection_induction (fun T => T∈K) M
    · intro D hD
      have hp : ∏ i,D i=1 := by simpa only [Matrix.det_diagonal] using hD.trans hM
      rcases isEmpty_or_nonempty n with he|he
      · letI := he
        have hd : D=1 := by funext i;exact isEmptyElim i
        rw [hd,Matrix.diagonal_one']
        exact K.one_mem
      · exact diagonal_mem_of_transvections K hK (Classical.choice he) D hp
    · rintro ⟨i,j,hij,a⟩
      exact hK i j hij a
    · exact fun _ _ => K.mul_mem
  apply top_unique
  intro A _
  obtain ⟨B,hB,hBA⟩ := allMatrices A.val A.property
  exact (Subtype.ext hBA : B=A) ▸ hB

/-- The actual elementary matrices generate SL over any field. -/
theorem closure_elementary_eq_top :
    Subgroup.closure {g : SL (n:=n) (F:=F) | ∃ (i j : n) (hij : i≠j) (a : F),g=elementary hij a}=⊤ := by
  apply eq_top_of_elementary
  intro i j hij a
  exact Subgroup.subset_closure ⟨i,j,hij,a,rfl⟩

end SymmetricSubgroupAsymptotics.CFSGTypeAElementaryGeneration
