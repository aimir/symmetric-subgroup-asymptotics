import SymmetricSubgroupAsymptotics.CFSGNormTwoGeckDiagonalTorus
import SymmetricSubgroupAsymptotics.CFSGNormTwoGeckPositivePGroup
import SymmetricSubgroupAsymptotics.CFSGMatrixFlagSoluble

/-! A literal soluble subgroup of the canonical Geck matrix group,
generated by the positive root units and the actual rank-one torus
words. No Sylow-normalizer containment is inferred from triangularity. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
namespace SymmetricSubgroupAsymptotics.CFSGNormTwoGeckBorelEnvelope
open CFSGIntegerMatrixPairing CFSGNormTwoRootPairing CFSGNormTwoGeckIntegralRealization
open CFSGSerreQuadraticMatrix CFSGNormTwoGeckPositivePGroup
open CFSGNormTwoGeckParameterizedWeyl CFSGNormTwoGeckParameterizedTorus
open CFSGNormTwoGeckDiagonalTorus CFSGNormTwoGeckHeightSupport
variable {n : Type} [Fintype n] [DecidableEq n]
    (A : Matrix n n ℤ) (hs : A.transpose=A) (hp : (rationalMatrix A).PosDef)
    [Fintype (Roots A)] [DecidableEq (Roots A)] [(rootPairing A hs hp).IsIrreducible]
    (b : (rootPairing A hs hp).Base) {r : ℕ} (s : Fin r≃b.support)

def torusGroup (K : Type) [Field K] : Subgroup
    ((Matrix (b.support⊕Roots A) (b.support⊕Roots A) K)ˣ) :=
  Subgroup.closure (Set.range (fun z : Fin r×Kˣ=>parameterTorus A hs hp b s K z.1 z.2))

def borelEnvelope (K : Type) [Field K] : Subgroup
    ((Matrix (b.support⊕Roots A) (b.support⊕Roots A) K)ˣ) :=
  rootGroup A hs hp b s K false⊔torusGroup A hs hp b s K

theorem parameterWeyl_mem (K : Type) [Field K] (i : Fin r) (t : Kˣ) :
    parameterWeyl A hs hp b s K i t∈canonicalElementaryGroup (realizationData A hs hp b s) K := by
  exact (canonicalElementaryGroup (realizationData A hs hp b s) K).mul_mem
    ((canonicalElementaryGroup (realizationData A hs hp b s) K).mul_mem
      (canonicalElementaryRoot (realizationData A hs hp b s) K false i (t:K)).property
      (canonicalElementaryRoot (realizationData A hs hp b s) K true i (-(t:K)⁻¹)).property)
    (canonicalElementaryRoot (realizationData A hs hp b s) K false i (t:K)).property

theorem torusGroup_le_canonical (K : Type) [Field K] :
    torusGroup A hs hp b s K≤canonicalElementaryGroup (realizationData A hs hp b s) K := by
  apply (Subgroup.closure_le _).mpr
  rintro _ ⟨⟨i,t⟩,rfl⟩
  exact (canonicalElementaryGroup (realizationData A hs hp b s) K).mul_mem
    (parameterWeyl_mem A hs hp b s K i t)
    ((canonicalElementaryGroup (realizationData A hs hp b s) K).inv_mem
      (parameterWeyl_mem A hs hp b s K i 1))

theorem borelEnvelope_le_canonical (K : Type) [Field K] :
    borelEnvelope A hs hp b s K≤canonicalElementaryGroup (realizationData A hs hp b s) K := by
  apply sup_le
  · rw [←positive_sup_negative A hs hp b s K]
    exact le_sup_left
  · exact torusGroup_le_canonical A hs hp b s K

theorem borelEnvelope_soluble (height : (n→ℤ)→ₗ[ℤ]ℤ)
    (hheight : ∀i : b.support,height (i:Roots A).val=1)
    (K : Type) [Field K] : IsSolvable (borelEnvelope A hs hp b s K) := by
  obtain ⟨e,he⟩ := CFSGFiniteWeightFlag.exists_flag
    (CFSGNormTwoGeckHeightSupport.weight A hs hp b height)
  have hU : rootGroup A hs hp b s K false≤CFSGMatrixFlagSubgroups.borelUnits e := by
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨⟨i,t⟩,rfl⟩
    exact (CFSGWeightedRootPGroup.mem_unipotent_of_weight
      (CFSGNormTwoGeckHeightSupport.weight A hs hp b height) e he
      (canonicalRoot (realizationData A hs hp b s) K false i t)
      (CFSGWeightedRootPGroup.quadratic_identity_on_nonincreasing _ _ _ _ t
        (canonicalRoot_val (realizationData A hs hp b s) K false i t)
        (field_E_strict A hs hp b s height hheight K i)
        (field_second_strict A hs hp b s height hheight K i))).1
  have hT : torusGroup A hs hp b s K≤CFSGMatrixFlagSubgroups.borelUnits e := by
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨⟨i,t⟩,rfl⟩
    change (parameterTorus A hs hp b s K i t : Matrix
      (b.support⊕Roots A) (b.support⊕Roots A) K).BlockTriangular e
    rw [torus_diagonal]
    exact Matrix.blockTriangular_diagonal _
  have hB : borelEnvelope A hs hp b s K≤CFSGMatrixFlagSubgroups.borelUnits e := sup_le hU hT
  letI : IsSolvable (CFSGMatrixFlagSubgroups.borelUnits (K:=K) e) :=
    CFSGMatrixFlagSubgroups.borelUnits_soluble (K:=K) e
  exact solvable_of_solvable_injective (f:=Subgroup.inclusion hB) (Subgroup.inclusion_injective hB)

end SymmetricSubgroupAsymptotics.CFSGNormTwoGeckBorelEnvelope
