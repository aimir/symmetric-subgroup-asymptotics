import SymmetricSubgroupAsymptotics.PrimitiveAffineDegreeNineSocleGenerators
import Mathlib.Order.Preorder.Finite

/-! Genuine normal-subgroup inheritance inside the whole finite-group
socle. A maximal disjoint ambient-normal subgroup is a complement because
the socle is generated by minimal ambient-normal subgroups. This applies
to the actual original group; no prime decomposition or Maschke hypothesis
is needed, and no arbitrary-subgroup inheritance is asserted. -/
set_option autoImplicit false
noncomputable section
open scoped Classical
namespace SymmetricSubgroupAsymptotics

/-- Every ambient-normal subgroup of the whole finite-group socle has
an ambient-normal complement inside that same socle. -/
theorem exists_normal_socle_complement
    {G : Type} [Group G] [Finite G]
    (M : Subgroup G) [M.Normal] (hM : M ≤ finiteGroupSocle G) :
    ∃ H : Subgroup G, H.Normal ∧ H ≤ finiteGroupSocle G ∧
      M ⊓ H = ⊥ ∧ M ⊔ H = finiteGroupSocle G := by
  let s : Set (Subgroup G) := {H | H.Normal ∧ H ≤ finiteGroupSocle G ∧ M ⊓ H = ⊥}
  have hs : s.Nonempty := ⟨⊥, inferInstance, bot_le, inf_bot_eq M⟩
  obtain ⟨H, hmax⟩ := s.toFinite.exists_maximal hs
  have hH := hmax.prop
  letI : H.Normal := hH.1
  have hjoin : M ⊔ H = finiteGroupSocle G := by
    apply le_antisymm (sup_le hM hH.2.1)
    apply Subgroup.normalClosure_le_normal
    rintro x ⟨A, hA, hx⟩
    have hAle : A ≤ M ⊔ H := by
      by_contra hnot
      letI : A.Normal := hA.1
      have hAS : A ⊓ (M ⊔ H) = ⊥ := by
        by_contra hne
        have he : A ⊓ (M ⊔ H) = A :=
          hA.2.2 (A ⊓ (M ⊔ H)) inferInstance hne inf_le_left
        exact hnot (he ▸ (inf_le_right : A ⊓ (M ⊔ H) ≤ M ⊔ H))
      have hnewinf : M ⊓ (H ⊔ A) = ⊥ := by
        apply le_antisymm ?_ bot_le
        intro y hy
        obtain ⟨h, hh, a, ha, hha⟩ := Subgroup.mem_sup_of_normal_right.mp hy.2
        have haS : a ∈ M ⊔ H := by
          have he : a = h⁻¹*y := by rw [← hha]; group
          rw [he]
          exact (M ⊔ H).mul_mem
            ((M ⊔ H).inv_mem ((show H ≤ M ⊔ H from le_sup_right) hh)) ((show M ≤ M ⊔ H from le_sup_left) hy.1)
        have ha1 : a = 1 :=
          Subgroup.mem_bot.mp (hAS ▸ (show a ∈ A ⊓ (M ⊔ H) from ⟨ha, haS⟩))
        rw [ha1, mul_one] at hha
        have hyH : y ∈ H := hha ▸ hh
        exact Subgroup.mem_bot.mpr
          (Subgroup.mem_bot.mp (hH.2.2 ▸ (show y ∈ M ⊓ H from ⟨hy.1, hyH⟩)))
      have hAsocle : A ≤ finiteGroupSocle G := by
        intro a ha
        exact Subgroup.subset_normalClosure ⟨A, hA, ha⟩
      have hnew : H ⊔ A ∈ s :=
        ⟨inferInstance, sup_le hH.2.1 hAsocle, hnewinf⟩
      have hle : H ⊔ A ≤ H := hmax.2 hnew le_sup_left
      exact hnot ((le_sup_right.trans hle).trans le_sup_right)
    exact hAle hx
  exact ⟨H, inferInstance, hH.2.1, hH.2.2, hjoin⟩

namespace MarkedC4

/-- An actual ambient-normal complement gives generator inheritance;
this preliminary statement does not require the parent to be a socle. -/
theorem normalGen_le_of_normal_complement
    {G : Type} [Group G] [Finite G]
    (M H : Subgroup G) [M.Normal] [H.Normal]
    (hdisjoint : M ⊓ H = ⊥) : normalGen M ≤ normalGen (M ⊔ H) := by
  have hm : normalGen M ≤ normalGen (M.map (QuotientGroup.mk' H)) := by
    simpa only [hdisjoint, normalGen_bot, zero_add] using
      normalGen_normal_le_inter_add_image M H
  have himage : (M ⊔ H).map (QuotientGroup.mk' H) =
      M.map (QuotientGroup.mk' H) := by
    rw [Subgroup.map_sup]
    have hzero : H.map (QuotientGroup.mk' H) = ⊥ := by
      apply (Subgroup.map_eq_bot_iff (H := H)).mpr
      rw [QuotientGroup.ker_mk']
    rw [hzero, sup_bot_eq]
  exact hm.trans (himage ▸ normalGen_map_le (QuotientGroup.mk' H)
    (QuotientGroup.mk'_surjective H) (M ⊔ H))

/-- Generator inheritance for a normal subgroup contained in the whole
socle, with its normal complement constructed internally. -/
theorem normalGen_le_socle_of_normal_le
    {G : Type} [Group G] [Finite G]
    (M : Subgroup G) [M.Normal] (hM : M ≤ finiteGroupSocle G) :
    normalGen M ≤ normalGen (finiteGroupSocle G) := by
  obtain ⟨H, hH, _, hdisjoint, hjoin⟩ := exists_normal_socle_complement M hM
  letI : H.Normal := hH
  simpa only [hjoin] using normalGen_le_of_normal_complement M H hdisjoint

end MarkedC4
end SymmetricSubgroupAsymptotics
