private def dual (i : Fin 10) : ℕ := (if i.val < 5 then (if i.val < 2 then (if i.val < 1 then 256 else 512) else (if i.val < 3 then 4194304 else (if i.val < 4 then 8388608 else 67108864))) else (if i.val < 7 then (if i.val < 6 then 134217728 else 268435456) else (if i.val < 8 then 536870912 else (if i.val < 9 then 1073741824 else 2147483648))))
