/-! Every original overgroup is a displayed literal low row or contains
a larger ACTUAL transitive binary subgroup. Finite joins of four atoms
provide closure; no complete join table or numerical row matching is used. -/
set_option autoImplicit false
noncomputable section
open scoped Pointwise
namespace SymmetricSubgroupAsymptotics.S8Seed4OvergroupCoverage
open S8Seed4LeftCosets S8Seed4LowModels S8Seed4AtomRows

def LowOrEscape (W : Subgroup Ambient) : Prop := (∃ s, W = joined s) ∨ Escape W

theorem escape_of_extension (P W : Subgroup Ambient) (hPW : P ≤ W)
    (hP : IsPGroup 2 P) (hHP : H ≤ P) (hcard : 8 < Nat.card P) : Escape W :=
  ⟨P, hPW, hP, permutationSubgroupTransitive_mono H P hHP
    BinaryEightSeed4Transitivity.transitive, hcard⟩

