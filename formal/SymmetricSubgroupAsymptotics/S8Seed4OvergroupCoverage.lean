theorem edge_property (j : Fin 3) (W : Subgroup Ambient) (hW : LowOrEscape W) :
    LowOrEscape (MulAut.conj (S8Seed4NormalizerRoots.edgeConjugator j) • W) := by
  fin_cases j
  · change LowOrEscape (MulAut.conj (1 : Ambient) • W)
    simpa only [map_one, one_smul] using hW
  · change LowOrEscape (MulAut.conj (1 : Ambient) • W)
    simpa only [map_one, one_smul] using hW
  · rcases hW with ⟨s, rfl⟩ | he
    · exact Or.inl ⟨s.image atomPermutation, conjugates_joined s⟩
    · exact Or.inr (PermutationPrimePowerSeedEscape.conjugate 2 8 _ W he)

theorem adjoin_property (g : Ambient) : LowOrEscape (H ⊔ Subgroup.closure {g}) := by
  obtain ⟨i, hi⟩ := S8Seed4LeftCosets.covers g
  have he := FiniteLeftCosetCover.adjoin_eq_of_same_left_coset
    (H := H) g (representatives i) hi
  have hp := S8Seed4NormalizerRoots.reduction.edge_property_representative
    LowOrEscape (by
      intro a ha W hW
      change LowOrEscape (MulAut.conj
        (S8Seed4NormalizerRoots.edgeConjugator (S8Seed4NormalizerRoots.letters a)) • W)
      exact edge_property _ W hW) root_property i
  rw [←he] at hp
  exact hp

theorem complete (U : Subgroup Ambient) (hHU : H ≤ U) :
    (∃ i : Fin 9, U = rows i) ∨ Escape U := by
  have h := FiniteSeedJoinEscapePropertyCoverage.complete_above H Escape
    (fun V W hVW => PermutationPrimePowerSeedEscape.mono 2 8 V W hVW)
    joined (FiniteSeedAtomJoinRows.seed_le H atoms)
    ⟨∅, joined_empty.trans rows_zero⟩ adjoin_property
    (fun s t => Or.inl ⟨s ∪ t, joined_union s t⟩) U hHU
  rcases h with ⟨s, hs⟩ | he
  · rcases joined_is_model_or_escape s with ⟨i, hi⟩ | hescape
    · exact Or.inl ⟨i, hs.trans hi⟩
    · exact Or.inr (hs.symm ▸ hescape)
  · exact Or.inr he

theorem low_or_escape_of_conjugate (U Q : Subgroup Ambient) (hQU : Q ≤ U)
    (c : Ambient) (hc : MulAut.conj c • Q = H) :
    (∃ i : Fin 9, ∃ d : Ambient, MulAut.conj d • U = rows i) ∨ Escape U := by
  have hHU : H ≤ MulAut.conj c • U := by
    rw [←hc]
    change Q.map (MulAut.conj c).toMonoidHom ≤ U.map (MulAut.conj c).toMonoidHom
    exact Subgroup.map_mono hQU
  rcases complete (MulAut.conj c • U) hHU with ⟨i, hi⟩ | he
  · exact Or.inl ⟨i, c, hi⟩
  · right
    have h := PermutationPrimePowerSeedEscape.conjugate 2 8 c⁻¹ _ he
    simpa only [map_inv, inv_smul_smul] using h

