def normalizer : Ambient where
  toFun := ![1, 2, 3, 4, 5, 6, 7, 0]
  invFun := ![7, 0, 1, 2, 3, 4, 5, 6]
  left_inv := by decide +kernel
  right_inv := by decide +kernel

def normalizerCertificate : FiniteGeneratorEquivWordCertificate (MulAut.conj normalizer)
    BinaryMenuCayley8T30.generators BinaryMenuCayley8T30.generators where
  forward := {
    words := ![(.mul (.generator 2) (.mul (.generator 0) (.inv (.generator 2)))), (.mul (.mul (.generator 1) (.generator 0)) (.mul (.generator 2) (.generator 2))), (.mul (.generator 1) (.mul (.inv (.generator 2)) (.generator 1)))]
    equations := by
      intro j
      fin_cases j <;> apply Equiv.ext <;> intro x <;> revert x <;> decide +kernel }
  backward := {
    words := ![(.mul (.generator 1) (.mul (.generator 0) (.generator 1))), (.mul (.inv (.generator 2)) (.mul (.generator 1) (.generator 2))), (.mul (.generator 2) (.generator 0))]
    equations := by
      intro j
      fin_cases j <;> apply Equiv.ext <;> intro x <;> revert x <;> decide +kernel }

theorem normalizes_seed : MulAut.conj normalizer • H = H := by
  change H.map (MulAut.conj normalizer).toMonoidHom = H
