import SymmetricSubgroupAsymptotics.MarkedC4GeneratorNumbers

/-! A finite group is generated by generators of any maximal proper
subgroup and one element outside it. -/
set_option autoImplicit false
noncomputable section
open scoped Classical
namespace SymmetricSubgroupAsymptotics.MaximalSubgroupOrdinaryGenerators

theorem genRank_le_add_one {G : Type} [Group G] [Finite G]
    (H : Subgroup G) (hH : IsCoatom H) :
    MarkedC4.genRank G≤MarkedC4.genRank H+1 := by
  obtain ⟨g,hg⟩ : ∃g : G,g∉H := by
    by_contra! hh
    exact hH.ne_top (top_unique (fun z _ => hh z))
  obtain ⟨S,hcard,hS⟩ := MarkedC4.genRank_spec (G := H)
  let T : Finset G := insert g (S.image H.subtype)
  let K := Subgroup.closure (T : Set G)
  have hgK : g∈K := Subgroup.subset_closure (by simp [T])
  have hHK : H≤K := by
    have hSK : Subgroup.closure (S : Set H)≤K.comap H.subtype := by
      apply (Subgroup.closure_le _).mpr
      intro x hx
      exact Subgroup.subset_closure (by
        change (x : G)∈T
        exact Finset.mem_insert_of_mem (Finset.mem_image.mpr ⟨x,hx,rfl⟩))
    rw [hS] at hSK
    intro x hx
    exact hSK (show (⟨x,hx⟩ : H)∈(⊤ : Subgroup H) from trivial)
  have hK : K=⊤ := (hH.ne_iff_eq_top hHK).mp (by
    intro he
    exact hg (he ▸ hgK))
  calc
    MarkedC4.genRank G≤T.card := MarkedC4.genRank_le hK
    _≤(S.image H.subtype).card+1 := Finset.card_insert_le _ _
    _≤S.card+1 := Nat.add_le_add_right Finset.card_image_le _
    _=MarkedC4.genRank H+1 := by rw [hcard]

end SymmetricSubgroupAsymptotics.MaximalSubgroupOrdinaryGenerators
