import SymmetricSubgroupAsymptotics.CFSGTrialityGeckShortParameterWeyl
import SymmetricSubgroupAsymptotics.CFSGTrialityRelativeWordLanguage
import SymmetricSubgroupAsymptotics.CFSGCentralTwistedCommutatorLift

/-! Every displayed relative Weyl word belongs to the subgroup
generated by the genuinely fixed positive and negative root groups.
Only the literal rank-one words and parameter-one fixedness are used. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
open scoped Classical
namespace SymmetricSubgroupAsymptotics.CFSGTrialityGeckRelativeRootGenerated
open CFSGTrialityD4NormTwo CFSGTrialityGeckDiagramCovariance
open CFSGTrialityGeckMatrixTwist CFSGTrialityGeckRootSubgroupTwist
open CFSGTrialityGeckFixedRootWords CFSGTrialityGeckShortParameterWeyl
open CFSGTrialityRelativeWordLanguage CFSGNormTwoGeckPositivePGroup
open CFSGNormTwoGeckParameterizedWeyl CFSGNormTwoGeckWeylWordAlgebra
open CFSGNormTwoGeckWeylSquareTorus
open CFSGNormTwoGeckWeylWordDegree CFSGNormTwoGeckIntegralWord
open CFSGSerreQuadraticMatrix CFSGSerreQuadraticWeylWord
open CFSGCentralTwistedCommutatorLift
local notation "A" => CartanMatrix.D 4
local notation "hs" => CartanMatrix.D_transpose 4
local notation "hp" => D4_positive_definite

def signedFixed (K : Type) [Field K] (sigma : K ≃+* K) (neg : Bool) :
    Subgroup (Matrix GeckIndex GeckIndex K)ˣ :=
  rootGroup A hs hp Base Index K neg ⊓ fixedSubgroup (unitTwist K sigma)

def fixedRootGenerated (K : Type) [Field K] (sigma : K ≃+* K) :
    Subgroup (Matrix GeckIndex GeckIndex K)ˣ :=
  signedFixed K sigma false ⊔ signedFixed K sigma true

theorem signedFixed_le_generated (K : Type) [Field K] (sigma : K ≃+* K) (neg : Bool) :
    signedFixed K sigma neg ≤ fixedRootGenerated K sigma := by
  cases neg
  · exact le_sup_left
  · exact le_sup_right

theorem fixedRootGenerated_le_fixed (K : Type) [Field K] (sigma : K ≃+* K) :
    fixedRootGenerated K sigma ≤ fixedSubgroup (unitTwist K sigma) :=
  sup_le inf_le_right inf_le_right

theorem shortOrbit_mem_rootGroup (K : Type) [Field K] (sigma : K ≃+* K)
    (neg : Bool) (t : K) : shortOrbit K sigma neg t ∈ rootGroup A hs hp Base Index K neg := by
  apply (rootGroup A hs hp Base Index K neg).mul_mem
  · exact (rootGroup A hs hp Base Index K neg).mul_mem
      (Subgroup.subset_closure ⟨(0,t),rfl⟩)
      (Subgroup.subset_closure ⟨(2,sigma t),rfl⟩)
  · exact Subgroup.subset_closure ⟨(3,sigma (sigma t)),rfl⟩

theorem shortOrbit_mem_generated (K : Type) [Field K] (sigma : K ≃+* K)
    (neg : Bool) (t : K) (ht : sigma (sigma (sigma t)) = t) :
    shortOrbit K sigma neg t ∈ fixedRootGenerated K sigma :=
  signedFixed_le_generated K sigma neg
    ⟨shortOrbit_mem_rootGroup K sigma neg t,shortOrbit_fixed K sigma neg t ht⟩

theorem central_root_mem_generated (K : Type) [Field K] (sigma : K ≃+* K)
    (neg : Bool) (t : K) (ht : sigma t = t) :
    canonicalRoot rawData K neg 1 t ∈ fixedRootGenerated K sigma := by
  apply signedFixed_le_generated K sigma neg
  refine ⟨Subgroup.subset_closure ⟨(1,t),rfl⟩,?_⟩
  change unitTwist K sigma (canonicalRoot rawData K neg 1 t) = _
  rw [unitTwist_raw_root,ht]
  rfl

theorem shortWeyl_mem_generated (K : Type) [Field K] (sigma : K ≃+* K) :
    shortWeyl K ∈ fixedRootGenerated K sigma := by
  have he : shortWeylWord K sigma 1 = shortWeyl K := by
    rw [shortWeylWord_eq_product]
    simp only [map_one,parameterWeyl_one,shortWeyl,canonicalWord,mul_one,mul_assoc]
    rfl
  rw [←he]
  change shortOrbit K sigma false (1 : K) * shortOrbit K sigma true (-(1 : K)⁻¹) *
    shortOrbit K sigma false (1 : K) ∈ _
  exact (fixedRootGenerated K sigma).mul_mem
    ((fixedRootGenerated K sigma).mul_mem
      (shortOrbit_mem_generated K sigma false 1 (by simp))
      (shortOrbit_mem_generated K sigma true (-(1 : K)⁻¹) (by simp)))
    (shortOrbit_mem_generated K sigma false 1 (by simp))

theorem longWeyl_mem_generated (K : Type) [Field K] (sigma : K ≃+* K) :
    longWeyl K ∈ fixedRootGenerated K sigma := by
  change (canonicalRoot rawData K false 1 1 * canonicalRoot rawData K true 1 (-1) *
    canonicalRoot rawData K false 1 1)*1 ∈ _
  rw [mul_one]
  exact (fixedRootGenerated K sigma).mul_mem
    ((fixedRootGenerated K sigma).mul_mem
      (central_root_mem_generated K sigma false 1 (by simp))
      (central_root_mem_generated K sigma true (-1) (by simp)))
    (central_root_mem_generated K sigma false 1 (by simp))

theorem relativeWord_mem_generated (K : Type) [Field K] (sigma : K ≃+* K)
    (r : List Bool) : wordUnit A hs hp Base Index K (expandRelative r) ∈
      fixedRootGenerated K sigma := by
  induction r with
  | nil => exact (fixedRootGenerated K sigma).one_mem
  | cons neg r ih =>
    cases neg
    · rw [expandRelative,wordUnit_append]
      apply (fixedRootGenerated K sigma).mul_mem _ ih
      simpa only [word_eq_canonicalWord,shortWeyl] using shortWeyl_mem_generated K sigma
    · rw [expandRelative,wordUnit_append]
      apply (fixedRootGenerated K sigma).mul_mem _ ih
      simpa only [word_eq_canonicalWord,longWeyl] using longWeyl_mem_generated K sigma

end SymmetricSubgroupAsymptotics.CFSGTrialityGeckRelativeRootGenerated
