import SymmetricSubgroupAsymptotics.AffineIrreducibleNormalGenerators
import Mathlib.GroupTheory.SpecificGroups.Cyclic

/-!
# Two normal generators from an actual cyclic kernel and cyclic image

Restrict the displayed homomorphism to any subgroup. Its kernel embeds in
the original cyclic kernel, and its quotient embeds in the original cyclic
target. Each needs at most one ordinary generator. The existing extension
inequality therefore bounds every subgroup by two ordinary generators.
For a normal subgroup, the same generators normally generate it in the
original group. No normal-subgroup enumeration is involved.
-/

set_option autoImplicit false
noncomputable section
open scoped Classical

namespace SymmetricSubgroupAsymptotics

namespace MarkedC4

theorem genRank_le_one_of_isCyclic
    {G : Type*} [Group G] [IsCyclic G] : genRank G ≤ 1 := by
  obtain ⟨g, hg⟩ := isCyclic_iff_exists_zpowers_eq_top.mp (inferInstance : IsCyclic G)
  have hclosure : Subgroup.closure (({g} : Finset G) : Set G) = ⊤ := by
    simpa only [Finset.coe_singleton, ← Subgroup.zpowers_eq_closure] using hg
  simpa only [Finset.card_singleton] using genRank_le hclosure

/-- The map need not be onto: each actual subgroup's quotient embeds into
the displayed cyclic target. -/
theorem genRank_subgroup_le_two_of_cyclic_kernel
    {G Q : Type} [Group G] [Finite G] [Group Q] [IsCyclic Q]
    (f : G →* Q) [IsCyclic f.ker] (H : Subgroup G) : genRank H ≤ 2 := by
  let fH : H →* Q := f.comp H.subtype
  let κ : fH.ker →* f.ker :=
    (H.subtype.comp fH.ker.subtype).codRestrict f.ker (fun x ↦ x.2)
  have hκ : Function.Injective κ := by
    intro x y hxy
    apply Subtype.ext
    apply Subtype.ext
    have hval := congrArg (fun z : f.ker => (z : G)) hxy
    change ((x : H) : G) = ((y : H) : G) at hval
    exact hval
  letI : IsCyclic fH.ker := isCyclic_of_injective κ hκ
  letI : IsCyclic (H ⧸ fH.ker) :=
    isCyclic_of_injective (QuotientGroup.kerLift fH)
      (QuotientGroup.kerLift_injective fH)
  calc
    genRank H ≤ genRank fH.ker + genRank (H ⧸ fH.ker) :=
      genRank_le_of_normal fH.ker
    _ ≤ 1 + 1 := Nat.add_le_add genRank_le_one_of_isCyclic genRank_le_one_of_isCyclic
    _ = 2 := rfl

end MarkedC4

/-- Every actual ambient normal subgroup is normally generated by two
elements when the displayed map has cyclic kernel and cyclic target. -/
theorem normal_generating_pairs_of_cyclic_kernel
    {G Q : Type} [Group G] [Finite G] [Group Q] [IsCyclic Q]
    (f : G →* Q) [IsCyclic f.ker] :
    ∀ N : Subgroup G, N.Normal →
      ∃ x : Fin 2 → G, Subgroup.normalClosure (Set.range x) = N := by
  intro N hN
  letI := hN
  obtain ⟨S, hScard, hS⟩ := MarkedC4.genRank_spec (G := N)
  let T : Finset G := S.image N.subtype
  have hTN : (T : Set G) ⊆ N := by
    rintro x hx
    obtain ⟨y, _hy, rfl⟩ := Finset.mem_image.mp hx
    exact y.2
  have hclosure : Subgroup.closure (T : Set G) = N := by
    calc
      Subgroup.closure (T : Set G) =
          (Subgroup.closure (S : Set N)).map N.subtype := by
        rw [MonoidHom.map_closure, Finset.coe_image]
      _ = N := by rw [hS, ← MonoidHom.range_eq_map, Subgroup.range_subtype]
  have hnormal : Subgroup.normalClosure (T : Set G) = N := by
    apply le_antisymm (Subgroup.normalClosure_le_normal hTN)
    rw [← hclosure]
    exact Subgroup.closure_le_normalClosure
  apply exists_normal_generating_tuple_of_normalGen_le N
  calc
    MarkedC4.normalGen N ≤ T.card := MarkedC4.normalGen_le hTN hnormal
    _ ≤ S.card := Finset.card_image_le
    _ = MarkedC4.genRank N := hScard
    _ ≤ 2 := MarkedC4.genRank_subgroup_le_two_of_cyclic_kernel f N

theorem quotientSocle_two_of_cyclic_kernel
    {G Q : Type} [Group G] [Finite G] [Group Q] [IsCyclic Q]
    (f : G →* Q) [IsCyclic f.ker]
    (N : Subgroup G) [N.Normal] : SocleNormalGeneratorBound (G ⧸ N) 2 :=
  quotientSocleNormalGeneratorBound_of_normal_generating_tuples
    (normal_generating_pairs_of_cyclic_kernel f) N

namespace AffineModel

/-- A faithful irreducible affine extension of an actual metacyclic
complement still needs just two ambient normal generators. -/
theorem normal_generating_pairs_of_irreducible_cyclic_kernel
    {p d : ℕ} [Fact p.Prime] (R : Subgroup (GLV p d))
    (hirr : Irreducible R) (v : V p d) (hv : v ≠ 0)
    {Q : Type} [Group Q] [IsCyclic Q]
    (f : R →* Q) [IsCyclic f.ker] :
    ∀ N : Subgroup (Aff R), N.Normal →
      ∃ x : Fin 2 → Aff R, Subgroup.normalClosure (Set.range x) = N :=
  normal_generating_tuples_of_irreducible_complement R hirr v hv (by decide)
    (normal_generating_pairs_of_cyclic_kernel f)

end AffineModel
end SymmetricSubgroupAsymptotics

end
