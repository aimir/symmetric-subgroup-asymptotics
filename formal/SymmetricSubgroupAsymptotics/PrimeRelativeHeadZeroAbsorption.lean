import SymmetricSubgroupAsymptotics.PrimeRelativeRadicalPresentation
import SymmetricSubgroupAsymptotics.PrimeRelativeHeadChain

/-!
# Zero relative head absorbs an elementary normal section

For an ambient-normal subgroup of exponent `p`, the exact relative radical
identity reduces to

`R_p(N) = [N,G]`.

If the complete relative `p`-head vanishes, the radical has the same order as
`N`; hence `N = [N,G]`.  This is the action-theoretic absorption statement
needed by the small affine exceptional cells.  It uses the actual ambient
conjugation action and does not choose a semisimple complement or an abstract
replacement module.
-/

set_option autoImplicit false
noncomputable section
open scoped commutatorElement

namespace SymmetricSubgroupAsymptotics

variable (p : ℕ) [Fact p.Prime]
  {G : Type*} [Group G] [Finite G]
  (N : Subgroup G) [N.Normal]

/-- An exponent-`p` normal subgroup with zero complete relative `p`-head is
generated by its mixed commutators with the actual ambient group. -/
theorem le_mixedCommutator_of_exponent_prime_relativeHead_zero
    (hexponent : ∀ n : N, n ^ p = 1)
    (hzero : Module.finrank (ZMod p) (primeRelativeCharacters p N) = 0) :
    N ≤ ⁅N, (⊤ : Subgroup G)⁆ := by
  have hcard := primeRelativeRadical_card_factorization p N
  rw [hzero, pow_zero, one_mul] at hcard
  have hradical : primeRelativeRadical p N = N :=
    Subgroup.eq_of_le_of_card_ge (primeRelativeRadical_le p N) hcard.le
  have hpowers :
      Subgroup.closure (Set.range (fun n : N => (n : G) ^ p)) = ⊥ := by
    rw [eq_bot_iff]
    apply (Subgroup.closure_le _).mpr
    rintro x ⟨n, rfl⟩
    apply Subgroup.mem_bot.mpr
    exact congrArg (fun z : N => (z : G)) (hexponent n)
  rw [primeRelativeRadical_eq_powerCommutator,
    primeRelativePowerCommutator, hpowers, bot_sup_eq] at hradical
  exact hradical.ge

/-- Equality form of the absorption theorem. -/
theorem mixedCommutator_eq_of_exponent_prime_relativeHead_zero
    (hexponent : ∀ n : N, n ^ p = 1)
    (hzero : Module.finrank (ZMod p) (primeRelativeCharacters p N) = 0) :
    ⁅N, (⊤ : Subgroup G)⁆ = N := by
  apply le_antisymm
  · exact Subgroup.commutator_le_left N ⊤
  · exact le_mixedCommutator_of_exponent_prime_relativeHead_zero p N
      hexponent hzero

/-- Vanishing of a complete relative head descends to every literal normal
section.  The exact chain formula is used here, so no assertion that every
invariant character extends is introduced. -/
theorem normalChainQuotient_relativeHead_zero_of_source_zero
    (B C : Subgroup G) [B.Normal] [C.Normal] (hBC : B ≤ C)
    (hzero : Module.finrank (ZMod p) (primeRelativeCharacters p C) = 0) :
    Module.finrank (ZMod p)
      (primeRelativeCharacters p (normalChainQuotient B C)) = 0 := by
  have hchain := primeRelativeHead_chain_eq B C p hBC
  rw [hzero] at hchain
  omega

end SymmetricSubgroupAsymptotics

end
