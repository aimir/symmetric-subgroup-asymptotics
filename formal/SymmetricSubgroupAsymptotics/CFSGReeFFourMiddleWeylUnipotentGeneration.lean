import SymmetricSubgroupAsymptotics.CFSGReeFFourMiddleWeylConstantWord
import SymmetricSubgroupAsymptotics.CFSGReeFFourMiddleNegativeFamily

/-! The literal constant middle Weyl word belongs to the subgroup
generated by the actual opposite fixed unipotent subgroups. The
conjugated middle factor is negative by its checked root degrees, so
this proof does not presuppose Weyl membership or use a Suzuki4 model. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
namespace SymmetricSubgroupAsymptotics.CFSGReeFFourMiddleWeylUnipotentGeneration
open CFSGReeFFourFieldParameters CFSGReeFFourFixedModelEquivalence
open CFSGReeFFourMiddleFixedWords CFSGReeFFourMiddleFixedSubgroup
open CFSGReeFFourFixedPositiveFamilies CFSGReeFFourOppositionFixedPositiveNegative
open CFSGReeFFourOuterUnipotentGeneration CFSGReeFFourOppositeGenerationAssembly
open CFSGReeFFourMiddleNegativeFamily CFSGReeFFourMiddleWeylConstantWord

private theorem parameter_mem_middle (m : ℕ) (p : Field m×Field m) :
    fixedMiddleParameter m p∈middleFixedSubgroup m :=
  ⟨p.1,alpha m p.1,p.2,alpha m p.2+p.1^2*alpha m p.1,rfl⟩

theorem fixedMiddleWeyl_mem (m : ℕ) : fixedMiddleWeyl m∈oppositeGenerated m := by
  have hpositive (p : Field m×Field m) :
      fixedMiddleParameter m p∈oppositeGenerated m :=
    positive_le m (middleFixedSubgroup_le_fixedPositive m (parameter_mem_middle m p))
  have hnegative : fixedMiddleWeyl m*fixedMiddleParameter m (1,0)*(fixedMiddleWeyl m)⁻¹∈
      fixedNegative m := by
    apply middle_conjugate_middleFixedSubgroup_le m
    exact ⟨fixedMiddleParameter m (1,0),parameter_mem_middle m (1,0),rfl⟩
  have he : fixedMiddleWeyl m=fixedMiddleParameter m (0,1)*
      (fixedMiddleWeyl m*fixedMiddleParameter m (1,0)*(fixedMiddleWeyl m)⁻¹)*
        fixedMiddleParameter m (1,1) := by
    apply Subtype.ext
    change CFSGReeFFourRelativeSimpleWeyl.middleRelativeWeyl m=
      fixedMiddleWord m 0 1*(CFSGReeFFourRelativeSimpleWeyl.middleRelativeWeyl m*
        fixedMiddleWord m 1 0*(CFSGReeFFourRelativeSimpleWeyl.middleRelativeWeyl m)⁻¹)*
          fixedMiddleWord m 1 1
    exact middleRelativeWeyl_constant_factors m
  rw [he]
  exact (oppositeGenerated m).mul_mem
    ((oppositeGenerated m).mul_mem (hpositive (0,1)) (negative_le m hnegative))
    (hpositive (1,1))

end SymmetricSubgroupAsymptotics.CFSGReeFFourMiddleWeylUnipotentGeneration
