    rowColumns (PrimitiveAffineSixteenFrameRow3TopCertificate.certificate.next i j) k =
      binaryMaskLinearCombination 32 (rowColumns i) (forwardColumns j k) := by
  native_decide

private theorem matrix_step_matrix : ∀ i j,
    rowMatrix (PrimitiveAffineSixteenFrameRow3TopCertificate.certificate.next i j) =
      rowMatrix i * forwardMatrix j := by
  intro i j
  exact binaryMatrixOfColumnMasks_mul_of_columns 32
    (rowColumns i) (forwardColumns j)
    (rowColumns (PrimitiveAffineSixteenFrameRow3TopCertificate.certificate.next i j))
    (matrix_step_columns i j)

private theorem matrix_step : ∀ i j,
    rowEnd (PrimitiveAffineSixteenFrameRow3TopCertificate.certificate.next i j) = rowEnd i * generatorEnd j := by
  intro i j
  apply LinearMap.ext
  intro v
  change (rowMatrix (PrimitiveAffineSixteenFrameRow3TopCertificate.certificate.next i j)).mulVec v =
    (rowMatrix i).mulVec ((forwardMatrix j).mulVec v)
  rw [matrix_step_matrix, Matrix.mulVec_mulVec]

