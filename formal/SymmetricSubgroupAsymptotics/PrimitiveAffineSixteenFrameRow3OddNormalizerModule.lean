    rowEnd PrimitiveAffineSixteenFrameRow3TopCertificate.certificate.identity = 1 := by
  apply LinearMap.ext
  intro v
  change (rowMatrix PrimitiveAffineSixteenFrameRow3TopCertificate.certificate.identity).mulVec v = v
  have h : rowMatrix PrimitiveAffineSixteenFrameRow3TopCertificate.certificate.identity = 1 := by native_decide
  rw [h, Matrix.one_mulVec]

