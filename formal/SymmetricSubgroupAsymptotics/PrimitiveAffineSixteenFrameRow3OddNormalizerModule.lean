noncomputable def basisCertificate :
    SymmetricSubgroupAsymptotics.Non2UnipotentPrefixFiniteMenu.PrimitiveAffineImprimitiveBlockTransfer.BinaryOddNormalizerBasisCoordinateCertificate (w := 32) (r := 1) (d := 6) representation where
  A := oddSubgroup
  generators := oddGenerators
  generated := rfl
  odd_order := by rw [oddSubgroup_card]; native_decide
  g := normalizerElement
  g_normalizes := normalizerElement_normalizes
  g_order_two_power := ⟨1, by simpa using (orderOf_eq_prime (p := 2) (x := normalizerElement) (by native_decide) (by native_decide))⟩
  coordinates := coordinates
  correctionGenerator j := correction ⟨j.val, by omega⟩
  correctionNormalizer := correction ⟨1, by omega⟩
  basis_reconstruction := by
    intro i
    fin_cases i <;> native_decide
  coordinate_generator_fixed := by
    intro j i
    fin_cases j <;> fin_cases i <;> native_decide
  coordinate_normalizer_fixed := by
    intro i
    fin_cases i <;> native_decide

noncomputable def coordinateCertificate := basisCertificate.toCoordinateCertificate

noncomputable def oddNormalizerWitness :
    SymmetricSubgroupAsymptotics.Non2UnipotentPrefixFiniteMenu.PrimitiveAffineImprimitiveBlockTransfer.FiniteFrameOddNormalizerWitness representation :=
  coordinateCertificate.toOddNormalizerWitness

theorem witness_dimension : oddNormalizerWitness.dimension = 6 := rfl

end SymmetricSubgroupAsymptotics.PrimitiveAffineSixteenFrameRow3OddNormalizerModule
