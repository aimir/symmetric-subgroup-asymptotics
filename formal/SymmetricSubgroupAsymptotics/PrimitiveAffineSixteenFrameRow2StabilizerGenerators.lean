import SymmetricSubgroupAsymptotics.PrimitiveAffineSixteenFrameRow2InducedBinding
import SymmetricSubgroupAsymptotics.FiniteGeneratorWord

/-!
# Selected sixteen-frame row 2: point-stabilizer generators

Generated by `emit_lean_frames16_selected_stabilizer_generators.py` from the
explicit selected input `record02_prepared.json`.  Lean rechecks one short word for
each of the 3 literal point-stabilizer elements.
-/

set_option autoImplicit false
set_option maxRecDepth 100000
noncomputable section
open scoped Classical

namespace SymmetricSubgroupAsymptotics.PrimitiveAffineSixteenFrameRow2StabilizerGenerators

open PrimitiveAffineSixteenFrameRow2InducedBinding

/-- Concrete executable model used by grouped normal-lattice certificates. -/
abbrev ModelGroup := Source

@[reducible] def modelGroup : Group ModelGroup :=
  PrimitiveAffineSixteenFrameRow2TopCertificate.group

local instance sourceGroup : Group ModelGroup := modelGroup

/-- Concrete point stabilizer, kept outside the noncomputable grouped record. -/
abbrev PointStabilizer : Subgroup ModelGroup := sourceStabilizer

instance pointStabilizerMembership (x : ModelGroup) :
    Decidable (x ∈ PointStabilizer) := by
  change Decidable (PrimitiveAffineSixteenFrameRow2InducedBinding.inStabilizer x.index)
  unfold PrimitiveAffineSixteenFrameRow2InducedBinding.inStabilizer
  infer_instance

def generators (j : Fin 1) : sourceStabilizer :=
  ⟨⟨1⟩, by native_decide +revert⟩

private def elementIndex (j : Fin 3) : Fin 48 :=
  (if j.val < 1 then 0 else (if j.val < 2 then 1 else 4))

def elements (j : Fin 3) : sourceStabilizer :=
  ⟨⟨elementIndex j⟩, by native_decide +revert⟩

theorem elements_surjective : Function.Surjective elements := by
  native_decide +revert

private def elementWords (j : Fin 3) :
    FiniteGeneratorWord (Fin 1) :=
  (if j.val < 1 then FiniteGeneratorWord.one else (if j.val < 2 then FiniteGeneratorWord.mul (FiniteGeneratorWord.one) (FiniteGeneratorWord.generator 0) else FiniteGeneratorWord.mul (FiniteGeneratorWord.mul (FiniteGeneratorWord.one) (FiniteGeneratorWord.generator 0)) (FiniteGeneratorWord.generator 0)))

private theorem elementWords_checked : ∀ j : Fin 3,
    (elementWords j).eval generators = elements j := by
  native_decide +revert

private def wordCertificate :
    FiniteGeneratorWordCertificate elements generators where
  words := elementWords
  equations := elementWords_checked

theorem generators_full :
    Subgroup.closure (Set.range generators) = ⊤ := by
  apply top_unique
  have htop : Subgroup.closure (Set.range elements) = ⊤ := by
    rw [Set.range_eq_univ.mpr elements_surjective]
    exact Subgroup.closure_univ
  rw [← htop]
  exact wordCertificate.closure_le

end SymmetricSubgroupAsymptotics.PrimitiveAffineSixteenFrameRow2StabilizerGenerators

end
