import SymmetricSubgroupAsymptotics.CoprimeSemidirectSubgroupRetraction
import SymmetricSubgroupAsymptotics.GeneratedLiteralImage
import SymmetricSubgroupAsymptotics.DerivedGeneratorWords
import SymmetricSubgroupAsymptotics.PrimitiveAffineDegreeTwoTwelveMetacyclicImages

/-!
# Original row 11 quotients from a split affine subgroup

The three literal generators are the constant ternary translation, global
sign, and four-block rotation. Their lifts contain the whole C4 × C2
complement of the shared four-block model. Maschke retracts that model onto
the subgroup generated by these exact lifts, and their original point
action maps this subgroup onto the unchanged literal top. No translation
space or normal-subgroup enumeration enters the quotient-socle proof.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open scoped Classical

namespace SymmetricSubgroupAsymptotics
namespace PrimitiveAffineDegreeTwoTwelveRow11SplitSocles

open SemidirectProduct
open Non2UnipotentPrefixFiniteMenu.PrimitiveAffineImprimitiveBlockTransfer
open DegreeTwoTwelvePairFiniteCatalogue
open TernaryFourBlockMetacyclicModel
open PrimitiveAffineDegreeTwoTwelveRow131AffineModel (Block Vector Translation Points)

def liftedGenerators : Fin 3 → Model false true :=
  ![inl (Multiplicative.ofAdd (fun _ : Block ↦ (1 : ZMod 3))),
    inr (inr (Multiplicative.ofAdd (1 : ZMod 2))),
    inr (inl (Multiplicative.ofAdd (1 : ZMod 4)))]

abbrev CoordinateTop : Subgroup (Model false true) :=
  Subgroup.closure (Set.range liftedGenerators)

theorem complement_mem (h : Complement false) :
    (inr h : Model false true) ∈ CoordinateTop := by
  have hblock (c : Block) : (inr (inl c) : Model false true) ∈ CoordinateTop := by
    have hc : (Multiplicative.ofAdd (1 : ZMod 4)) ^ c.toAdd.val = c := by
      apply Multiplicative.toAdd.injective
      simp [toAdd_pow, nsmul_eq_mul]
    rw [← hc, map_pow, map_pow]
    exact CoordinateTop.pow_mem
      (Subgroup.subset_closure (Set.mem_range_self (2 : Fin 3))) _
  have hbit (b : Bit) : (inr (inr b) : Model false true) ∈ CoordinateTop := by
    have hb : (Multiplicative.ofAdd (1 : ZMod 2)) ^ b.toAdd.val = b := by
      apply Multiplicative.toAdd.injective
      simp [toAdd_pow, nsmul_eq_mul]
    rw [← hb, map_pow, map_pow]
    exact CoordinateTop.pow_mem
      (Subgroup.subset_closure (Set.mem_range_self (1 : Fin 3))) _
  rw [← inl_left_mul_inr_right h, map_mul]
  exact CoordinateTop.mul_mem (hblock h.left) (hbit h.right)

def literalAction : Model false true →* Equiv.Perm (Fin 12) :=
  PrimitiveAffineDegreeTwoTwelveMetacyclicImages.centeredPointEquiv.symm.permCongrHom.toMonoidHom.comp
    (TernaryMonomialSemidirect.action (blockAction false) (scalar false true))

theorem literal_binding (i : Fin 3) :
    literalAction (liftedGenerators i) = row11Generators i := by
  apply Equiv.ext
  intro x
  revert i x
  decide +kernel

def coordinateAction : CoordinateTop →* Equiv.Perm (Fin 12) :=
  literalAction.comp CoordinateTop.subtype

theorem coordinate_binding (i : Fin 3) :
    coordinateAction (closureGenerators liftedGenerators i) = row11Generators i :=
  literal_binding i

def toOriginal : CoordinateTop →* Row11Top :=
  GeneratedLiteralImage.toTop coordinateAction (closureGenerators liftedGenerators)
    row11Generators (Equiv.refl _) (closureGenerators_full liftedGenerators)
    coordinate_binding

theorem toOriginal_surjective : Function.Surjective toOriginal :=
  GeneratedLiteralImage.toTop_surjective coordinateAction
    (closureGenerators liftedGenerators) row11Generators (Equiv.refl _)
    (closureGenerators_full liftedGenerators) coordinate_binding

/-- Every original quotient retains the stored bound two. -/
theorem quotientSocle (N : Subgroup Row11Top) [N.Normal] :
    SocleNormalGeneratorBound (Row11Top ⧸ N) 2 :=
  CoprimeSemidirectSubgroupRetraction.socle_of_surjective
    (linearAction false true) CoordinateTop complement_mem
    (complement_coprime false) 1 2 (representation_generated false true)
    (complement_normalGen false) ((QuotientGroup.mk' N).comp toOriginal)
    ((QuotientGroup.mk'_surjective N).comp toOriginal_surjective)

def row11TopSocle : row11Interface.normalRegistry.QuotientSocleGeneratorFamily 2 :=
  .ofQuotientBounds _ (fun N ↦ by
    letI := N.2
    exact quotientSocle N.1)

end PrimitiveAffineDegreeTwoTwelveRow11SplitSocles
end SymmetricSubgroupAsymptotics

end
