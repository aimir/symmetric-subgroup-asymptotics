private theorem quotient_codes_surjective :
    Function.Surjective (fun n : Fin 64 => binaryVectorOfMask 6 n.val) := by
  change ∀ c : Fin 6 → ZMod 2, ∃ n : Fin 64, binaryVectorOfMask 6 n.val = c
  decide +kernel

theorem exists_three_literal_rows (c : Fin 6 → ZMod 2) (hc : c ≠ 0) :
    ∃ u : Fin 3 → Fin 256,
      (∀ i, topPermutation (u i) ∈ BinaryEightOriginalRowActions.heisenbergH) ∧
      (∀ i, destinationOffset (u i) ∈ (BinaryHeisenbergEightNaturalHeads.charts 14).2.space) ∧
      (∀ i j : Fin 3, i ≠ j →
        rowAction (u i) (sectionMap c) - rowAction (u j) (sectionMap c) ∉ radical.space) := by
  obtain ⟨n,rfl⟩ := quotient_codes_surjective c
  fin_cases n
  · exact False.elim (hc (by decide +kernel))
  · exact ⟨orbitRows_code_1, top_mem_code_1, offset_mem_code_1, orbit_separated_code_1⟩
