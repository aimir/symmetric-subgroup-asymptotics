import SymmetricSubgroupAsymptotics.BinaryInvariantRegistry

/-!
# Rebase a cyclic orbit span from one generator to another

The finite frame certificates choose one canonical generator for each
distinct cyclic submodule.  For every vector orbit it is enough to show that
the vector lies in the canonical stable space and that the canonical
generator is a finite orbit sum of the vector.  This file supplies the
generic conversion to equality of orbit spans.
-/

set_option autoImplicit false
noncomputable section

namespace SymmetricSubgroupAsymptotics

variable {k G V : Type*} [Field k] [Group G]
  [AddCommGroup V] [Module k V]

/-- Membership of `u` in the orbit span of `v` implies containment of the
whole orbit span generated by `u`. -/
theorem binaryOrbitSpan_le_of_mem
    (rho : Representation k G V) {u v : V}
    (hu : u ∈ binaryOrbitSpan rho v) :
    binaryOrbitSpan rho u ≤ binaryOrbitSpan rho v := by
  apply Submodule.span_le.mpr
  rintro _ ⟨g, rfl⟩
  induction hu using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨h, rfl⟩ := hx
      change rho g (rho h v) ∈ binaryOrbitSpan rho v
      rw [← Module.End.mul_apply, ← map_mul]
      exact Submodule.subset_span ⟨g * h, rfl⟩
  | zero => simp
  | add x y _ _ hx hy => simpa only [map_add] using
      (binaryOrbitSpan rho v).add_mem hx hy
  | smul a x _ hx => simpa only [map_smul] using
      (binaryOrbitSpan rho v).smul_mem a hx

/-- Rebase a cyclic orbit span through a common stable subrepresentation. -/
theorem binaryOrbitSpan_eq_of_canonical
    (rho : Representation k G V) (S : Subrepresentation rho)
    {u v : V}
    (canonical : S.toSubmodule = binaryOrbitSpan rho u)
    (hv : v ∈ S.toSubmodule)
    (hu : u ∈ binaryOrbitSpan rho v) :
    binaryOrbitSpan rho v = binaryOrbitSpan rho u := by
  apply le_antisymm
  · rw [← canonical]
    exact binaryOrbitSpan_le rho S hv
  · exact binaryOrbitSpan_le_of_mem rho hu

end SymmetricSubgroupAsymptotics

end
