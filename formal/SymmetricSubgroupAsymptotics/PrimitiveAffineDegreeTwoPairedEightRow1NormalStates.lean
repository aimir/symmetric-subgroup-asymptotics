def normalMask (i : Fin 6) (x : Fin 24) : Bool :=
  ((#[1, 17, 525, 529949, 158447, 16777215] : Array ℕ)[i.val]!).testBit x.val

private theorem mask_checked0 (x : Fin 24) :
    normalMask 0 x = true ↔ ∃ j, S0.certificate.rows j = x := by
  decide +kernel +revert

private theorem mask_checked1 (x : Fin 24) :
    normalMask 1 x = true ↔ ∃ j, S1.certificate.rows j = x := by
  decide +kernel +revert

private theorem mask_checked2 (x : Fin 24) :
    normalMask 2 x = true ↔ ∃ j, S2.certificate.rows j = x := by
  decide +kernel +revert

private theorem mask_checked3 (x : Fin 24) :
    normalMask 3 x = true ↔ ∃ j, S3.certificate.rows j = x := by
  decide +kernel +revert

private theorem mask_checked4 (x : Fin 24) :
    normalMask 4 x = true ↔ ∃ j, S4.certificate.rows j = x := by
  decide +kernel +revert

private theorem mask_checked5 (x : Fin 24) :
    normalMask 5 x = true ↔ ∃ j, S5.certificate.rows j = x := by
  decide +kernel +revert

theorem normalMask_mem (i : Fin 6) (x : Source) :
    normalMask i x.index = true ↔ x ∈ state i := by
  fin_cases i
  · exact (mask_checked0 x.index).trans (binaryNormalRow_mem_iff S0.certificate x).symm
  · exact (mask_checked1 x.index).trans (binaryNormalRow_mem_iff S1.certificate x).symm
  · exact (mask_checked2 x.index).trans (binaryNormalRow_mem_iff S2.certificate x).symm
  · exact (mask_checked3 x.index).trans (binaryNormalRow_mem_iff S3.certificate x).symm
  · exact (mask_checked4 x.index).trans (binaryNormalRow_mem_iff S4.certificate x).symm
  · exact (mask_checked5 x.index).trans (binaryNormalRow_mem_iff S5.certificate x).symm

abbrev MaskLE (i j : Fin 6) : Prop :=
  ∀ x : Fin 24, normalMask i x = true → normalMask j x = true

theorem state_le_iff_maskLE (i j : Fin 6) : state i ≤ state j ↔ MaskLE i j := by
  constructor
  · intro h x hx
    exact (normalMask_mem j (⟨x⟩ : Source)).mpr
      (h ((normalMask_mem i (⟨x⟩ : Source)).mp hx))
  · intro h x hx
    exact (normalMask_mem j x).mp (h x.index ((normalMask_mem i x).mpr hx))

private def stateOrder (i : Fin 6) : ℕ :=
  (#[1, 2, 4, 8, 12, 24] : Array ℕ)[i.val]!
private theorem state_card (i : Fin 6) : Nat.card (state i) = stateOrder i := by
  fin_cases i
  · exact S0.card
  · exact S1.card
  · exact S2.card
  · exact S3.card
  · exact S4.card
  · exact S5.card

theorem state_injective : Function.Injective state := by
  have hi : Function.Injective stateOrder := by decide +kernel
  intro i j h
  apply hi
  simpa only [state_card] using congrArg (fun H : Subgroup Source ↦ Nat.card H) h

