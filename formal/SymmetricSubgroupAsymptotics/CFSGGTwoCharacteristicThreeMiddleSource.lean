import SymmetricSubgroupAsymptotics.CFSGGTwoCharacteristicThreeMiddleNormalizers
import SymmetricSubgroupAsymptotics.CFSGGTwoCharacteristicThreeMiddleCentralCoordinates
import SymmetricSubgroupAsymptotics.CFSGGTwoOriginalHigherCollecting

/-! A genuine original source generated by the middle radical, positive
short roots and their Weyl word. It normalizes the same radical and
centralizes its highest-root line pointwise. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
namespace SymmetricSubgroupAsymptotics.CFSGGTwoCharacteristicThreeMiddleSource
open CFSG.Models.Chevalley CFSGGTwoOriginalPositiveRootWords
open CFSGGTwoPositiveCoordinateKernels CFSGGTwoPositiveWordSubgroup
open CFSGGTwoCharacteristicThreeMiddleCoordinateEquiv
open CFSGGTwoCharacteristicThreeMiddleCentralCoordinates
open CFSGGTwoCharacteristicThreeMiddleCentralWords
open CFSGGTwoCharacteristicThreeMiddleNormalizers
open CFSGGTwoOriginalHigherCollecting CFSGGTwoOriginalSimpleWeylTransport
open CFSGGTwoOriginalPositiveCollecting
variable (K : Type) [Field K] [CharP K 3] [Finite K]

def source : Subgroup (Model CartanMatrix.G₂ K) :=
  Middle K ⊔ Subgroup.closure {g | (∃ a : K, g=positiveModel K 0 a) ∨ g=shortWord K}

theorem middle_le_source : Middle K ≤ source K := le_sup_left

theorem positive_short_mem_source (a : K) : positiveModel K 0 a ∈ source K := by
  apply (show Subgroup.closure {g | (∃ b : K, g=positiveModel K 0 b) ∨ g=shortWord K} ≤
    source K from le_sup_right)
  exact Subgroup.subset_closure (Or.inl ⟨a,rfl⟩)

theorem shortWeyl_mem_source : shortWord K ∈ source K := by
  apply (show Subgroup.closure {g | (∃ b : K, g=positiveModel K 0 b) ∨ g=shortWord K} ≤
    source K from le_sup_right)
  exact Subgroup.subset_closure (Or.inr rfl)

theorem source_le_normalizer_middle : source K ≤
    Subgroup.normalizer (Middle K : Set (Model CartanMatrix.G₂ K)) := by
  apply sup_le (Middle K).le_normalizer
  apply (Subgroup.closure_le _).mpr
  intro g hg
  rcases hg with ⟨a,rfl⟩|rfl
  · exact positive_le_normalizer_middle K (positiveElement K 0 a).property
  · exact shortWeyl_normalizes_middle K

private theorem high_central_val (a : K) :
    (centralHom K (Multiplicative.ofAdd ![0,0,a])).val = positiveModel K 5 a := by
  rw [centralHom_val,centralWord_modelWord]
  change positiveModel K 0 0*positiveModel K 1 0*positiveModel K 2 0*
    positiveModel K 3 0*positiveModel K 4 0*positiveModel K 5 a = _
  simp only [positiveModel_zero,one_mul]

theorem source_centralizes_high (a : K) : source K ≤
    Subgroup.centralizer ({positiveModel K 5 a} : Set (Model CartanMatrix.G₂ K)) := by
  apply sup_le
  · intro u hu
    apply Subgroup.mem_centralizer_singleton_iff.mpr
    have hz : centralHom K (Multiplicative.ofAdd ![0,0,a]) ∈ Subgroup.center (Middle K) := by
      rw [center_eq_endpointKer]
      exact (centralHom_range K).le ⟨Multiplicative.ofAdd ![0,0,a],rfl⟩
    have hc := congrArg Subtype.val (Subgroup.mem_center_iff.mp hz (⟨u,hu⟩ : Middle K))
    change u*(centralHom K (Multiplicative.ofAdd ![0,0,a])).val =
      (centralHom K (Multiplicative.ofAdd ![0,0,a])).val*u at hc
    rw [high_central_val] at hc
    exact hc
  · apply (Subgroup.closure_le _).mpr
    intro g hg
    apply Subgroup.mem_centralizer_singleton_iff.mpr
    rcases hg with ⟨b,rfl⟩|rfl
    · have hc := (pair_commute K 4 a b).eq
      change positiveModel K 5 a*positiveModel K 0 b =
        positiveModel K 0 b*positiveModel K 5 a at hc
      exact hc.symm
    · exact mul_inv_eq_iff_eq_mul.mp (short_five K a)

end SymmetricSubgroupAsymptotics.CFSGGTwoCharacteristicThreeMiddleSource
