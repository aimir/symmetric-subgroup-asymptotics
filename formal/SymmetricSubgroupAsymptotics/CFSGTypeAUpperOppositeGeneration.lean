import SymmetricSubgroupAsymptotics.CFSGUpperUnitriangular
import SymmetricSubgroupAsymptotics.CFSGTypeAMonomialRootAction
import SymmetricSubgroupAsymptotics.CFSGTypeAElementaryGeneration
import SymmetricSubgroupAsymptotics.CFSGTypeACyclicCoordinates
import Mathlib.Data.Fin.Rev

/-! The literal upper-unitriangular subgroup and its conjugate by an
actual determinant-one reversing matrix generate SL in every dimension
at least two, over every field. Reversing the original coordinate order
turns a lower root into an upper root; its coefficient is rescaled by
the exact nonzero signed monomial weights. No finiteness, simplicity,
Sylow maximality, or normalizer assertion is assumed here. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
open scoped Classical
namespace SymmetricSubgroupAsymptotics.CFSGTypeAUpperOppositeGeneration
open CFSGTypeAElementaryMatrices CFSGTypeAMonomialMatrices
open CFSGTypeAMonomialRootAction CFSGTypeACyclicCoordinates
variable (F : Type*) [Field F] (n : ℕ) (hn : 2≤n)

/-- The sign correction is placed at the original coordinate zero. -/
def reversingLift : Matrix.SpecialLinearGroup (Fin n) F :=
  signedPermutation (F:=F) (⟨0,by omega⟩ : Fin n) Fin.revPerm

def reversingWeights : Fin n→F :=
  weights (F:=F) (⟨0,by omega⟩ : Fin n) Fin.revPerm

@[simp] theorem reversingLift_coe :
    (reversingLift F n hn).val=monomial Fin.revPerm (reversingWeights F n hn) := rfl

theorem reversingWeights_ne_zero (i : Fin n) : reversingWeights F n hn i≠0 :=
  weights_ne_zero (⟨0,by omega⟩ : Fin n) Fin.revPerm i

/-- Every lower elementary matrix belongs to the actual opposite
conjugate subgroup; the conjugating matrix itself is not assumed to lie
in the subgroup generated by the two unipotent subgroups. -/
theorem elementary_mem_opposite {i j : Fin n} (hji : j < i) (a : F) :
    elementary (ne_of_gt hji) a∈
      (CFSGUpperUnitriangular.upperUnitriangular F n).map
        (MulAut.conj (reversingLift F n hn)).toMonoidHom := by
  let W := reversingLift F n hn
  let d := reversingWeights F n hn
  have hd : ∀ k : Fin n,d k≠0 := reversingWeights_ne_zero F n hn
  have hrev : i.rev<j.rev := Fin.rev_lt_rev.mpr hji
  let b : F := d j*a/d i
  have hcoef : d i*b/d j=a := by
    dsimp only [b]
    field_simp [hd i,hd j]
  have hpre : elementary (ne_of_lt hrev) b∈CFSGUpperUnitriangular.upperUnitriangular F n :=
    CFSGUpperUnitriangular.elementary_mem_upperUnitriangular hrev b
  refine ⟨elementary (ne_of_lt hrev) b,hpre,?_⟩
  change W*elementary (ne_of_lt hrev) b*W⁻¹=elementary (ne_of_gt hji) a
  have hc := monomial_conjugation W (Fin.revPerm : Equiv.Perm (Fin n)) d
    (reversingLift_coe F n hn) (ne_of_lt hrev) b (hd _)
  simpa only [Fin.revPerm_symm,Fin.revPerm_apply,Fin.rev_rev,hcoef] using hc

/-- Exact subgroup supremum in the original special linear group. -/
theorem upper_opposite_sup :
    CFSGUpperUnitriangular.upperUnitriangular F n ⊔
      (CFSGUpperUnitriangular.upperUnitriangular F n).map
        (MulAut.conj (reversingLift F n hn)).toMonoidHom=⊤ := by
  apply CFSGTypeAElementaryGeneration.eq_top_of_elementary
  intro i j hij a
  rcases lt_or_gt_of_ne hij with hij'|hji
  · exact Subgroup.mem_sup_left
      (CFSGUpperUnitriangular.elementary_mem_upperUnitriangular hij' a)
  · exact Subgroup.mem_sup_right (elementary_mem_opposite F n hn hji a)

/-- The exact closure-of-two-conjugates interface used for soluble
Sylow-normalizer generation. -/
theorem upper_opposite_generate :
    Subgroup.closure
      ((CFSGUpperUnitriangular.upperUnitriangular F n : Set (Matrix.SpecialLinearGroup (Fin n) F)) ∪
        (CFSGUpperUnitriangular.upperUnitriangular F n).map
          (MulAut.conj (reversingLift F n hn)).toMonoidHom)=⊤ := by
  rw [←Subgroup.sup_eq_closure]
  exact upper_opposite_sup F n hn

include hn in
theorem exists_generating_upper_conjugate :
    ∃ W : Matrix.SpecialLinearGroup (Fin n) F,
      Subgroup.closure
        ((CFSGUpperUnitriangular.upperUnitriangular F n : Set (Matrix.SpecialLinearGroup (Fin n) F)) ∪
          (CFSGUpperUnitriangular.upperUnitriangular F n).map (MulAut.conj W).toMonoidHom)=⊤ :=
  ⟨reversingLift F n hn,upper_opposite_generate F n hn⟩

end SymmetricSubgroupAsymptotics.CFSGTypeAUpperOppositeGeneration
