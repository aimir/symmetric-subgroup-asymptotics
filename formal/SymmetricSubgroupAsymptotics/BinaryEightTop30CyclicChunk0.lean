private theorem point_mem : ∀ v : V, 0 ≤ binaryVectorMask v → binaryVectorMask v < 32 →
    v ∈ (charts (pointClass v)).2.space := by decide +kernel
private theorem point_basis_eq : ∀ v : V, 0 ≤ binaryVectorMask v → binaryVectorMask v < 32 → ∀ j,
    (charts (pointClass v)).2.inclusion (Pi.single j 1) =
      ((orbitWords v j).map (fun w => rho (word w) v)).sum := by decide +kernel

theorem point_span (v : V) (hlo : 0 ≤ binaryVectorMask v) (hhi : binaryVectorMask v < 32) :
    (states (pointClass v)).toSubmodule = binaryOrbitSpan rho v := by
  rw [states_space]
  apply le_antisymm
  · apply (charts (pointClass v)).2.le_of_basis_mem
    intro j
    rw [point_basis_eq v hlo hhi]
    apply (binaryOrbitSpan rho v).list_sum_mem
    intro x hx
    obtain ⟨w,_,rfl⟩ := List.mem_map.mp hx
    exact Submodule.subset_span ⟨word w,rfl⟩
  · exact binaryOrbitSpan_le rho (states (pointClass v)) (point_mem v hlo hhi)
