import SymmetricSubgroupAsymptotics.PrimeRelativeRadicalPresentation

/-!
# A full mixed commutator annihilates the relative prime head

This is the converse, requiring no exponent or finiteness hypothesis, to the
absorption direction used elsewhere.  If every element of an ambient-normal
subgroup already lies in its mixed commutator with the ambient group, then it
lies in the literal relative radical.  Hence every invariant prime character
vanishes.
-/

set_option autoImplicit false
noncomputable section
open scoped commutatorElement

namespace SymmetricSubgroupAsymptotics

variable (p : ℕ) [Fact p.Prime]
  {G : Type*} [Group G]
  (N : Subgroup G) [N.Normal]

/-- A subgroup generated by its mixed ambient commutators has zero complete
relative `p`-head, for every prime `p`. -/
theorem primeRelativeHead_eq_zero_of_le_mixedCommutator
    (hfull : N ≤ ⁅N, (⊤ : Subgroup G)⁆) :
    Module.finrank (ZMod p) (primeRelativeCharacters p N) = 0 := by
  have hradical : N ≤ primeRelativeRadical p N :=
    hfull.trans
      ((primeRelativePowerCommutator_commutator_le p N).trans
        (primeRelativePowerCommutator_le_radical p N))
  letI : Subsingleton (primeRelativeCharacters p N) := ⟨by
    intro chi psi
    apply Subtype.ext
    apply AddMonoidHom.ext
    intro a
    let n : N := a.toMul
    have hnradical : (n : G) ∈ primeRelativeRadical p N :=
      hradical n.2
    have hzero (theta : primeRelativeCharacters p N) :
        theta.1 (Additive.ofMul n) = 0 :=
      ((mem_primeRelativeRadical_iff p N (n : G)).mp hnradical).2 theta
    exact (hzero chi).trans (hzero psi).symm⟩
  exact Module.finrank_zero_of_subsingleton

/-- Equality form, convenient for socle components whose mixed commutator
identity is already available. -/
theorem primeRelativeHead_eq_zero_of_mixedCommutator_eq
    (hfull : ⁅N, (⊤ : Subgroup G)⁆ = N) :
    Module.finrank (ZMod p) (primeRelativeCharacters p N) = 0 :=
  primeRelativeHead_eq_zero_of_le_mixedCommutator p N hfull.ge

end SymmetricSubgroupAsymptotics

end
