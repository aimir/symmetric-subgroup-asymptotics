/-! Selected original8T11 normalizer forest. The actual normalizer
generator, both seed-word inclusions and every forest edge are checked. -/
set_option autoImplicit false
set_option maxRecDepth 100000
noncomputable section
open scoped Pointwise
namespace SymmetricSubgroupAsymptotics.S8Seed11NormalizerRoots
open S8Seed11LeftCosets

def normalizer : Ambient where
  toFun := ![1, 2, 3, 4, 5, 6, 7, 0]
  invFun := ![7, 0, 1, 2, 3, 4, 5, 6]
  left_inv := by decide +kernel
  right_inv := by decide +kernel

def normalizerCertificate : FiniteGeneratorEquivWordCertificate (MulAut.conj normalizer)
    BinaryMenuCayley8T11.generators BinaryMenuCayley8T11.generators where
  forward := {
    words := ![(.mul (.generator 0) (.mul (.generator 1) (.generator 1))), (.generator 1), (.mul (.generator 0) (.mul (.generator 1) (.inv (.generator 2))))]
    equations := by
      intro j
      fin_cases j <;> apply Equiv.ext <;> intro x <;> revert x <;> decide +kernel }
  backward := {
    words := ![(.mul (.generator 0) (.mul (.generator 1) (.generator 1))), (.generator 1), (.mul (.generator 0) (.mul (.generator 1) (.inv (.generator 2))))]
    equations := by
      intro j
      fin_cases j <;> apply Equiv.ext <;> intro x <;> revert x <;> decide +kernel }

theorem normalizes_seed : MulAut.conj normalizer • H = H := by
  change H.map (MulAut.conj normalizer).toMonoidHom = H
  exact normalizerCertificate.map_closure_eq

def edgeConjugator : Fin 4 → Ambient := ![1, 1, 1, normalizer]
def edgeFactor : Fin 4 → Ambient :=
  ![BinaryMenuCayley8T11.generators 0, BinaryMenuCayley8T11.generators 1, BinaryMenuCayley8T11.generators 2, 1]

theorem edge_normalizes (j : Fin 4) : MulAut.conj (edgeConjugator j) • H = H := by
  fin_cases j
  · change MulAut.conj (1 : Ambient) • H = H
    simp only [map_one, one_smul]
  · change MulAut.conj (1 : Ambient) • H = H
    simp only [map_one, one_smul]
  · change MulAut.conj (1 : Ambient) • H = H
    simp only [map_one, one_smul]
  · exact normalizes_seed

theorem edge_factor_mem (j : Fin 4) : edgeFactor j ∈ H := by
  fin_cases j
  · exact Subgroup.subset_closure (Set.mem_range_self 0)
  · exact Subgroup.subset_closure (Set.mem_range_self 1)
  · exact Subgroup.subset_closure (Set.mem_range_self 2)
  · exact H.one_mem

