def literalWhitelist : Finset RawTriple := savedWhitelist.toFinset

private def rawCode (i : ℕ) : RawTriple :=
  let q := pilotTriples[i]!
  (q.1%12,(q.2.1%12,q.2.2%12))

def pilotSeeds (i : Fin 64) : Fin 3 → Fin 12 :=
  let q := pilotTriples[i.val]!
  ![⟨q.1%12,Nat.mod_lt _ (by decide)⟩,
    ⟨q.2.1%12,Nat.mod_lt _ (by decide)⟩,
    ⟨q.2.2%12,Nat.mod_lt _ (by decide)⟩]

def coordinates (seed : Fin 3 → Fin 12) : RawTriple :=
  ((seed 0).val,((seed 1).val,(seed 2).val))

theorem pilot_separated (i : Fin 64) : CycleSeparated originalC.val 2 (pilotSeeds i) := by
  revert i
  decide +kernel

private def checkCode (q : RawTriple) (p : ℕ) : Bool :=
  savedWhitelist.contains q ||
    !(rawChart q.1 q.2.1 q.2.2 (rawC p) == rawC (rawChart q.1 q.2.1 q.2.2 p))

private def pilotCheck : Bool :=
  (List.range 64).all (fun i => checkCode (rawCode i) (failurePoints[i]!%12))

theorem pilot_check_eq_true : pilotCheck = true := by
  decide +kernel

private theorem commuting_raw_point (seed : Fin 3 → Fin 12)
    (hs : CycleSeparated originalC.val 2 seed)
    (hc : Commute (chart seed hs).val originalC.val) (p : Fin 12) :
    rawChart (seed 0).val (seed 1).val (seed 2).val (rawC p.val) =
      rawC (rawChart (seed 0).val (seed 1).val (seed 2).val p.val) := by
  calc
    _ = rawChart (seed 0).val (seed 1).val (seed 2).val (originalC.val p).val := by rw [rawC_eq]
    _ = ((chart seed hs).val (originalC.val p)).val := rawChart_eq seed hs _
    _ = (originalC.val ((chart seed hs).val p)).val :=
      congrArg Fin.val (congrArg (fun z : Perm12 => z p) hc.eq)
    _ = rawC ((chart seed hs).val p).val := (rawC_eq _).symm
    _ = _ := by rw [rawChart_eq]

theorem pilot_witnesses (i : Fin 64) : coordinates (pilotSeeds i) ∈ literalWhitelist ∨
    ¬Commute (chart (pilotSeeds i) (pilot_separated i)).val originalC.val := by
  have hm := List.all_eq_true.mp pilot_check_eq_true i.val (List.mem_range.mpr i.isLt)
  change (savedWhitelist.contains (coordinates (pilotSeeds i)) || _) = true at hm
  rw [Bool.or_eq_true_eq_eq_true_or_eq_true] at hm
  rcases hm with hw | hn
  · exact Or.inl (List.mem_toFinset.mpr (List.contains_iff_mem.mp hw))
  · apply Or.inr
    intro hc
    apply not_beq_sound _ _ hn
    exact commuting_raw_point (pilotSeeds i) (pilot_separated i) hc
      ⟨failurePoints[i.val]!%12,Nat.mod_lt _ (by decide)⟩

theorem literalWhitelist_card_le : literalWhitelist.card ≤ 240 := by
  exact (List.toFinset_card_le savedWhitelist).trans_eq (by decide +kernel)

