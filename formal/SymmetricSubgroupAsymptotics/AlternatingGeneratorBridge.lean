import SymmetricSubgroupAsymptotics.ChiefSeriesTransport
import Mathlib.GroupTheory.Perm.Closure
import Mathlib.Tactic.Group

/-! A symbolic bridge from the actual two-generator alternating actions.
An even generator and its commutator with an involution generate a normal
subgroup of the group generated by that generator and the involution.
For a full symmetric ambient group this proves the alternating subgroup
identity without computing its cardinality or enumerating its elements. -/
set_option autoImplicit false
noncomputable section
namespace SymmetricSubgroupAsymptotics

section Group
variable {G:Type*} [Group G]

theorem involutionCommutatorClosure_normal (g s:G) (hs:s⁻¹=s)
    (hgen:Subgroup.closure ({g,s}:Set G)=⊤) :
    (Subgroup.closure ({g,g⁻¹*s*g*s}:Set G)).Normal := by
  let u := g⁻¹*s*g*s
  let H := Subgroup.closure ({g,u}:Set G)
  have hg : g∈H := Subgroup.subset_closure (by simp)
  have hu : u∈H := Subgroup.subset_closure (by simp)
  have hsquare : s*s=1 := by simpa only [hs] using inv_mul_cancel s
  have hsg : s*g*s⁻¹=g*u := by dsimp [u]; rw [hs]; group
  have hsu : s*u*s⁻¹=u⁻¹ := by
    dsimp [u]
    simp only [mul_inv_rev,inv_inv,hs,mul_assoc,hsquare,mul_one]
  have hstab : H≤H.comap (MulAut.conj s).toMonoidHom := by
    apply (Subgroup.closure_le _).mpr
    intro x hx
    simp only [Set.mem_insert_iff,Set.mem_singleton_iff] at hx
    rcases hx with hx|hx
    · rw [hx]
      change s*g*s⁻¹∈H
      rw [hsg]
      exact H.mul_mem hg hu
    · rw [hx]
      change s*u*s⁻¹∈H
      rw [hsu]
      exact H.inv_mem hu
  have hsnorm : s∈Subgroup.normalizer (H : Set G) := by
    apply Subgroup.mem_normalizer_iff.mpr
    intro x
    constructor
    · exact fun hx=>hstab hx
    · intro hx
      have hh := hstab hx
      change s*(s*x*s⁻¹)*s⁻¹∈H at hh
      have he : s*(s*x*s⁻¹)*s⁻¹=x := by
        rw [hs]
        calc
          s*(s*x*s)*s=(s*s)*x*(s*s) := by group
          _=x := by rw [hsquare]; simp
      simpa only [he] using hh
  apply Subgroup.normalizer_eq_top_iff.mp
  apply top_unique
  rw [←hgen]
  apply (Subgroup.closure_le _).mpr
  intro x hx
  simp only [Set.mem_insert_iff,Set.mem_singleton_iff] at hx
  rcases hx with hx|hx
  · rw [hx]
    exact (Subgroup.le_normalizer (H := H)) hg
  · rw [hx]
    exact hsnorm

theorem closure_pair_top_of_mul_right (g s:G)
    (hgen:Subgroup.closure ({g*s,s}:Set G)=⊤) :
    Subgroup.closure ({g,s}:Set G)=⊤ := by
  let H := Subgroup.closure ({g,s}:Set G)
  have hg : g∈H := Subgroup.subset_closure (by simp)
  have hs : s∈H := Subgroup.subset_closure (by simp)
  apply top_unique
  rw [←hgen]
  apply (Subgroup.closure_le _).mpr
  intro x hx
  simp only [Set.mem_insert_iff,Set.mem_singleton_iff] at hx
  rcases hx with hx|hx
  · rw [hx]
    exact H.mul_mem hg hs
  · rw [hx]
    exact hs

theorem closure_pair_inv_right (g t:G) :
    Subgroup.closure ({g,t⁻¹}:Set G)=Subgroup.closure ({g,t}:Set G) := by
  apply le_antisymm
  · apply (Subgroup.closure_le _).mpr
    intro x hx
    simp only [Set.mem_insert_iff,Set.mem_singleton_iff] at hx
    rcases hx with hx|hx
    · rw [hx]
      exact Subgroup.subset_closure (by simp)
    · rw [hx]
      exact (Subgroup.closure ({g,t}:Set G)).inv_mem
        (Subgroup.subset_closure (show t∈({g,t}:Set G) by simp))
  · apply (Subgroup.closure_le _).mpr
    intro x hx
    simp only [Set.mem_insert_iff,Set.mem_singleton_iff] at hx
    rcases hx with hx|hx
    · rw [hx]
      exact Subgroup.subset_closure (by simp)
    · rw [hx]
      simpa only [inv_inv] using
        (Subgroup.closure ({g,t⁻¹}:Set G)).inv_mem
          (Subgroup.subset_closure (show t⁻¹∈({g,t⁻¹}:Set G) by simp))

end Group

section Permutations
variable {α:Type} [Fintype α] [DecidableEq α]

theorem involutionCommutatorClosure_eq_alternating (hα:5≤Nat.card α)
    (g s:Equiv.Perm α) (hs:s⁻¹=s)
    (hgen:Subgroup.closure ({g,s}:Set (Equiv.Perm α))=⊤)
    (hg:g∈alternatingGroup α) (hne:g≠1) :
    Subgroup.closure ({g,g⁻¹*s*g*s}:Set (Equiv.Perm α))=alternatingGroup α := by
  let H := Subgroup.closure ({g,g⁻¹*s*g*s}:Set (Equiv.Perm α))
  letI : H.Normal := involutionCommutatorClosure_normal g s hs hgen
  have hgmem : g∈H := Subgroup.subset_closure (by simp)
  have hHle : H≤alternatingGroup α := by
    apply (Subgroup.closure_le _).mpr
    intro x hx
    simp only [Set.mem_insert_iff,Set.mem_singleton_iff] at hx
    rcases hx with hx|hx
    · rw [hx]
      exact hg
    · rw [hx]
      apply Equiv.Perm.mem_alternatingGroup.mpr
      have hsg : Equiv.Perm.sign g=1 := Equiv.Perm.mem_alternatingGroup.mp hg
      have hsquare : s*s=1 := by simpa only [hs] using inv_mul_cancel s
      have hss : Equiv.Perm.sign s*Equiv.Perm.sign s=1 := by
        rw [←map_mul,hsquare,map_one]
      simpa only [map_mul,map_inv,hsg,inv_one,one_mul,mul_one] using hss
  have hnt : Nontrivial H := H.nontrivial_iff_ne_bot.mpr (by
    intro he
    rw [he] at hgmem
    exact hne hgmem)
  exact le_antisymm hHle (Equiv.Perm.alternatingGroup_le_of_normal hα hnt)

/-- Either orientation of the literal final three-cycle is sufficient. -/
theorem evenPairClosure_eq_alternating (hα:5≤Nat.card α)
    (g s t:Equiv.Perm α) (hs:s⁻¹=s)
    (hgen:Subgroup.closure ({g,s}:Set (Equiv.Perm α))=⊤)
    (hg:g∈alternatingGroup α) (hne:g≠1)
    (ht:g⁻¹*s*g*s=t ∨ g⁻¹*s*g*s=t⁻¹) :
    Subgroup.closure ({g,t}:Set (Equiv.Perm α))=alternatingGroup α := by
  have h := involutionCommutatorClosure_eq_alternating hα g s hs hgen hg hne
  rcases ht with ht|ht
  · simpa only [ht] using h
  · simpa only [ht,closure_pair_inv_right] using h

end Permutations

theorem alternatingPairChiefSeries_zero (n:ℕ) (hn:5≤n)
    (g s t:Equiv.Perm (Fin n)) (hs:s⁻¹=s)
    (hgen:Subgroup.closure ({g,s}:Set (Equiv.Perm (Fin n)))=⊤)
    (hg:g∈alternatingGroup (Fin n)) (hne:g≠1)
    (ht:g⁻¹*s*g*s=t ∨ g⁻¹*s*g*s=t⁻¹) :
    ∃z:ActualChiefSeries (Subgroup.closure ({g,t}:Set (Equiv.Perm (Fin n)))),
      actualChiefSeriesTernaryWeight z=0 := by
  let e := MulEquiv.subgroupCongr
    (evenPairClosure_eq_alternating (by simpa using hn) g s t hs hgen hg hne ht)
  exact alternatingChiefSeries_zero_of_equiv n hn e

end SymmetricSubgroupAsymptotics
