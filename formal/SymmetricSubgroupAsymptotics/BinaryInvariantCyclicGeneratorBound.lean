import SymmetricSubgroupAsymptotics.BinaryInvariantCyclicOrbitRegistry
import SymmetricSubgroupAsymptotics.InducedSubrepresentationCount
import SymmetricSubgroupAsymptotics.RepresentationCoordinateHeads

/-!
# Module-generator bounds from cyclic invariant-state registries

The finite pair-top producer already proves every local join

`W' = W ⊔ span(G · v)`.

For the relative affine lift we need the different, but closely related,
statement that every invariant state is generated by a bounded tuple as a
module over the group algebra.  This file is the semantic bridge.  A finite
certificate gives, for every emitted state, a padded tuple of cyclic columns
whose orbit spans join to that state.  Completeness of the existing registry
then gives the uniform generator bound for every literal subrepresentation.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open scoped Classical MonoidAlgebra

namespace SymmetricSubgroupAsymptotics

variable {k G V I : Type*} [Field k] [Group G]
  [AddCommGroup V] [Module k V]

/-- A tuple whose ordinary orbit spans join to an invariant state generates
the corresponding representation over the group algebra. -/
theorem representationGeneratedBy_of_iSup_binaryOrbitSpan
    (rho : Representation k G V) (W : Subrepresentation rho)
    (H : ℕ) (v : Fin H → V)
    (hW : W.toSubmodule = ⨆ j, binaryOrbitSpan rho (v j)) :
    RepresentationGeneratedBy W.toRepresentation H := by
  let code : Fin H → rho.asModule := fun j ↦ rho.asModuleEquiv.symm (v j)
  let P : Submodule k[G] rho.asModule :=
    Submodule.span k[G] (Set.range code)
  let Pbase : Submodule k V :=
    (P.restrictScalars k).comap rho.asModuleEquiv.symm.toLinearMap
  have horbit : ∀ j, binaryOrbitSpan rho (v j) ≤ Pbase := by
    intro j
    apply Submodule.span_le.mpr
    rintro _ ⟨g, rfl⟩
    change rho.asModuleEquiv.symm (rho g (v j)) ∈ P
    rw [Representation.asModuleEquiv_symm_map_rho]
    apply P.smul_mem
    exact Submodule.subset_span ⟨j, rfl⟩
  have hWPbase : W.toSubmodule ≤ Pbase := by
    rw [hW]
    exact iSup_le horbit
  have hPW : P ≤ W.asSubmodule := by
    apply Submodule.span_le.mpr
    rintro _ ⟨j, rfl⟩
    change v j ∈ W.toSubmodule
    rw [hW]
    exact (le_iSup (fun q ↦ binaryOrbitSpan rho (v q)) j)
      (binaryOrbitSpan_point rho (v j))
  have hspan :
      Submodule.span k[G] (Set.range code) = W.asSubmodule := by
    apply le_antisymm hPW
    intro x hx
    have hxW : rho.asModuleEquiv x ∈ W.toSubmodule := by
      exact hx
    have hxP := hWPbase hxW
    change rho.asModuleEquiv.symm (rho.asModuleEquiv x) ∈ P at hxP
    simpa only [LinearEquiv.symm_apply_apply] using hxP
  have hcode : ∀ j, code j ∈ W.asSubmodule := by
    intro j
    apply hPW
    exact Submodule.subset_span ⟨j, rfl⟩
  have hsubtype :
      Submodule.span k[G]
          (Set.range (fun j ↦ (⟨code j, hcode j⟩ : W.asSubmodule))) = ⊤ :=
    (Submodule.span_range_subtype_eq_top_iff W.asSubmodule hcode).2 hspan
  let e := submoduleRepresentationModuleEquiv rho W.asSubmodule
  refine ⟨fun j ↦ e ⟨code j, hcode j⟩, ?_⟩
  have hmap := congrArg (Submodule.map e.toLinearMap) hsubtype
  rw [Submodule.map_top, LinearEquiv.range_eq_top,
    Submodule.map_span, ← Set.range_comp] at hmap
  simpa only [Function.comp_apply, e] using hmap

/-- Finite padded cyclic generators for every state in a complete invariant
registry.  The generated source proves `state_eq` by following the already
checked child table from its certified bottom state. -/
structure BinaryInvariantCyclicGeneratorBound
    {rho : Representation k G V}
    {states : I → Subrepresentation rho}
    (C : BinaryInvariantCyclicOrbitRegistry rho states)
    (H : ℕ) where
  generator : I → Fin H → C.Cyclic
  state_eq : ∀ i,
    (states i).toSubmodule =
      ⨆ j, binaryOrbitSpan rho (C.cyclicRepresentative (generator i j))

namespace BinaryInvariantCyclicGeneratorBound

variable {rho : Representation k G V}
  {states : I → Subrepresentation rho}
  {C : BinaryInvariantCyclicOrbitRegistry rho states}
  {H : ℕ}
  (B : BinaryInvariantCyclicGeneratorBound C H)

/-- A complete cyclic-state registry with bounded generating tuples gives a
uniform generator theorem on the literal representation. -/
theorem uniform [Finite V] :
    UniformSubrepresentationGeneratorBound rho H := by
  intro W
  obtain ⟨i, rfl⟩ := C.complete W
  exact representationGeneratedBy_of_iSup_binaryOrbitSpan rho (states i) H
    (fun j ↦ C.cyclicRepresentative (B.generator i j))
    (B.state_eq i)

end BinaryInvariantCyclicGeneratorBound

namespace BinaryInvariantCyclicOrbitRegistry

variable {rho : Representation k G V}
  {states : I → Subrepresentation rho}
  (C : BinaryInvariantCyclicOrbitRegistry rho states)

/-- Follow a padded tuple of cyclic joins from the certified bottom state.
The last entry is applied last.  This convention lets a generated row pad a
short path by placing zero-orbit entries at the front. -/
def generatedState : {H : ℕ} → (Fin H → C.Cyclic) → I
  | 0, _ => C.bottom
  | H + 1, generator =>
      C.child
        (C.generatedState (fun j : Fin H ↦ generator j.castSucc))
        (generator (Fin.last H))

/-- The submodule at `generatedState` is exactly the join of the orbit spans
of the padded tuple.  Generated certificates therefore only have to check
the finite final-state equality. -/
theorem generatedState_eq : ∀ {H : ℕ} (generator : Fin H → C.Cyclic),
    (states (C.generatedState generator)).toSubmodule =
      ⨆ j, binaryOrbitSpan rho (C.cyclicRepresentative (generator j)) := by
  intro H
  induction H with
  | zero =>
      intro generator
      simpa [generatedState] using C.bottom_eq
  | succ H ih =>
      intro generator
      rw [generatedState, C.child_eq, ih]
      apply le_antisymm
      · apply sup_le
        · refine iSup_le fun j ↦ ?_
          exact le_iSup_of_le j.castSucc le_rfl
        · exact le_iSup_of_le (Fin.last H) le_rfl
      · refine iSup_le ?_
        intro j
        refine Fin.lastCases ?_ (fun q ↦ ?_) j
        · exact le_sup_right
        · exact le_sup_of_le_left (le_iSup_of_le q le_rfl)

/-- Build the uniform finite generator certificate by checking only that the
tuple's child-table fold ends at its requested state. -/
noncomputable def generatorBoundOfGeneratedState
    (H : ℕ) (generator : I → Fin H → C.Cyclic)
    (finalState : ∀ i, C.generatedState (generator i) = i) :
    BinaryInvariantCyclicGeneratorBound C H where
  generator := generator
  state_eq := fun i ↦ by
    rw [← finalState i]
    exact C.generatedState_eq (generator i)

end BinaryInvariantCyclicOrbitRegistry

end SymmetricSubgroupAsymptotics

end
