  exact congrArg (fun z : ℕ => (z : ZMod 3))
    (CFSGSuzFirstSquareRowZeroPilot.source_column_binding j i)

theorem i_raw_one : iDigit=(1 : Matrix (Fin 64) (Fin 64) ℕ) := by
  ext i j
  by_cases h : i=j
  · subst j
    simp only [iDigit,Matrix.one_apply,if_pos rfl]
  · have hv : i.val≠j.val := fun he => h (Fin.ext he)
    simp only [iDigit,Matrix.one_apply,if_neg hv,if_neg h]

theorem identity_cache_binding : iData.matrix 3=1 := by
  change castMatrix 3 64 iDigit=1
  rw [i_raw_one,castMatrix_one]

end SymmetricSubgroupAsymptotics.CFSGSuzFirstSquareKroneckerCaches
