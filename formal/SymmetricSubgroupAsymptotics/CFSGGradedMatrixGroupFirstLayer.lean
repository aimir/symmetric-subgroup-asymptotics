import SymmetricSubgroupAsymptotics.CFSGGradedMatrixLieFirstLayer
import SymmetricSubgroupAsymptotics.CFSGGradedMatrixSubgroups
import Mathlib.Tactic.NoncommRing
import Mathlib.Tactic.Abel

/-! The first height layer of an ACTUAL positive matrix group is additive.
For a group generated by positive root polynomials, that layer lies in
the linear span of their genuine first coefficients. This is a group-word
statement, independent of any logarithm or characteristic restriction. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
namespace SymmetricSubgroupAsymptotics.CFSGGradedMatrixGroupFirstLayer
open CFSGGradedMatrixLieFirstLayer CFSGGradedMatrixSubgroups
variable {I K : Type*} [Fintype I] [DecidableEq I] [Field K]

def firstLayer (weight : I→ℤ) (u : (Matrix I I K)ˣ) : Matrix I I K :=
  firstPart weight ((u : Matrix I I K)-1)

theorem deviation_positive (weight : I→ℤ) (u : (Matrix I I K)ˣ)
    (hu : u∈strictUnits weight) : Positive weight ((u : Matrix I I K)-1) := by
  intro i j hij
  rw [Matrix.sub_apply,hu i j hij,sub_self]

theorem firstPart_mul_zero (weight : I→ℤ) (M N : Matrix I I K)
    (hM : Positive weight M) (hN : Positive weight N) : firstPart weight (M*N)=0 := by
  apply Matrix.ext
  intro i j
  rw [firstPart_apply]
  by_cases hij : weight i=weight j+1
  · rw [if_pos hij,positive_mul_entry_zero weight M N hM hN i j (le_of_eq hij)]
    rfl
  · rw [if_neg hij]
    rfl

theorem firstLayer_one (weight : I→ℤ) : firstLayer weight (1 : (Matrix I I K)ˣ)=0 := by
  simp only [firstLayer,Units.val_one,sub_self,map_zero]

theorem firstLayer_mul (weight : I→ℤ) (u v : (Matrix I I K)ˣ)
    (hu : u∈strictUnits weight) (hv : v∈strictUnits weight) :
    firstLayer weight (u*v)=firstLayer weight u+firstLayer weight v := by
  have he : (u : Matrix I I K)*(v : Matrix I I K)-1=
      ((u : Matrix I I K)-1)+((v : Matrix I I K)-1)+
        ((u : Matrix I I K)-1)*((v : Matrix I I K)-1) := by noncomm_ring
  simp only [firstLayer,Units.val_mul]
  rw [he,map_add,map_add,firstPart_mul_zero weight _ _
    (deviation_positive weight u hu) (deviation_positive weight v hv),add_zero]

theorem firstLayer_inv (weight : I→ℤ) (u : (Matrix I I K)ˣ)
    (hu : u∈strictUnits weight) : firstLayer weight u⁻¹= -firstLayer weight u := by
  have hh := firstLayer_mul weight u u⁻¹ hu ((strictUnits weight).inv_mem hu)
  rw [mul_inv_cancel,firstLayer_one] at hh
  calc
    _=(firstLayer weight u+firstLayer weight u⁻¹)-firstLayer weight u := by abel
    _=0-firstLayer weight u := by rw [←hh]
    _=_ := zero_sub _

theorem generated_firstLayer_mem_span {J : Type*} (weight : I→ℤ)
    (root : J→(Matrix I I K)ˣ) (S : Set (Matrix I I K))
    (hroot : ∀j,root j∈strictUnits weight)
    (hfirst : ∀j,firstLayer weight (root j)∈Submodule.span K S)
    (u : (Matrix I I K)ˣ) (hu : u∈Subgroup.closure (Set.range root)) :
    u∈strictUnits weight ∧ firstLayer weight u∈Submodule.span K S := by
  induction hu using Subgroup.closure_induction with
  | mem u hu=>
    obtain ⟨j,rfl⟩ := hu
    exact ⟨hroot j,hfirst j⟩
  | one=>
    refine ⟨(strictUnits weight).one_mem,?_⟩
    rw [firstLayer_one]
    exact Submodule.zero_mem _
  | mul u v hu hv ihu ihv=>
    refine ⟨(strictUnits weight).mul_mem ihu.1 ihv.1,?_⟩
    rw [firstLayer_mul weight u v ihu.1 ihv.1]
    exact Submodule.add_mem _ ihu.2 ihv.2
  | inv u hu ihu=>
    refine ⟨(strictUnits weight).inv_mem ihu.1,?_⟩
    rw [firstLayer_inv weight u ihu.1]
    exact Submodule.neg_mem _ ihu.2

end SymmetricSubgroupAsymptotics.CFSGGradedMatrixGroupFirstLayer
