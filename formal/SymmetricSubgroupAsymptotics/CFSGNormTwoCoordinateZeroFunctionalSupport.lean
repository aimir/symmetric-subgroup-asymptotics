import SymmetricSubgroupAsymptotics.CFSGNormTwoCoordinateFunctionalRootTail
import SymmetricSubgroupAsymptotics.CFSGComplementGradingFactor
import Mathlib.Algebra.Group.Subgroup.Pointwise

/-! A nonnegative lattice functional splits the actual positive group
into its strict functional tail and the subgroup generated by its
zero-functional positive roots. Consequently a positive matrix which
preserves the functional blocks belongs to that zero-root subgroup.
This treats an arbitrary simple-root support, including folded pairs,
without assuming a BN-pair, a torus recognition theorem, or a field-size
restriction. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
open scoped Pointwise
namespace SymmetricSubgroupAsymptotics.CFSGNormTwoCoordinateZeroFunctionalSupport
open CFSGIntegerMatrixPairing CFSGNormTwoRootPairing
open CFSGNormTwoGeckIntegralRealization CFSGNormTwoGeckLatticeDegree CFSGNormTwoGeckPositivePGroup
open CFSGNormTwoCoordinateFunctionalRootTail CFSGNormTwoCoordinatePositiveRootGenerators
open CFSGNormTwoCoordinateSelectedRootElement CFSGNormTwoCoordinateRootElementRange
open CFSGNormTwoCoordinateRootCoefficientCoordinates CFSGNormTwoCoordinateRootBracketTransport
open CFSGNormTwoCoordinateRootHeightLeading CFSGSerreQuadraticMatrix
open CFSGGradedQuadraticUnit CFSGGradedMatrixSubgroups CFSGComplementGradingFactor
variable {r : ℕ} (A : Matrix (Fin r) (Fin r) ℤ) (hd : ∀ i, A i i = 2)
    (hs : A.transpose = A) (hp : (rationalMatrix A).PosDef)
    (ho : ∀ i j, i ≠ j → A i j ≤ 0)
    [Fintype (Roots A)] [DecidableEq (Roots A)]
    [(rootPairing A hs hp).IsReduced] [(rootPairing A hs hp).IsIrreducible]
local notation "b₀" => coordinateBase A hd hs hp ho
local notation "s₀" => coordinateIndexEquiv A hd hs hp ho
private abbrev Mat (K : Type) := Matrix ((b₀).support ⊕ Roots A) ((b₀).support ⊕ Roots A) K

def zeroFunctionalGenerators (K : Type) [Field K] (f : (Fin r → ℤ) →ₗ[ℤ] ℤ) :
    Set (Mat A hd hs hp ho K)ˣ :=
  {x | ∃ k : PositiveRoot A, f k.val.val = 0 ∧ ∃ a : K,
    selectedRootElement A hd hs hp ho K k.val a = x}

def zeroFunctionalGroup (K : Type) [Field K] (f : (Fin r → ℤ) →ₗ[ℤ] ℤ) :
    Subgroup (Mat A hd hs hp ho K)ˣ :=
  Subgroup.closure (zeroFunctionalGenerators A hd hs hp ho K f)

theorem root_mem_zeroFunctionalGroup (K : Type) [Field K]
    (f : (Fin r → ℤ) →ₗ[ℤ] ℤ) (k : PositiveRoot A) (hk : f k.val.val = 0) (a : K) :
    selectedRootElement A hd hs hp ho K k.val a ∈ zeroFunctionalGroup A hd hs hp ho K f :=
  Subgroup.subset_closure ⟨k, hk, a, rfl⟩

theorem zeroFunctionalGroup_le_positive (K : Type) [Field K]
    (f : (Fin r → ℤ) →ₗ[ℤ] ℤ) :
    zeroFunctionalGroup A hd hs hp ho K f ≤ rootGroup A hs hp b₀ s₀ K false := by
  apply (Subgroup.closure_le _).mpr
  rintro _ ⟨k, hk, a, rfl⟩
  exact selected_positive_root_mem A hd hs hp ho K k.val k.property a

private theorem selectedRoot_quadraticGrade (K : Type) [Field K]
    (k : Roots A) (a : K) :
    QuadraticGrade (latticeWeight A hs hp b₀) k.val
      (selectedRootElement A hd hs hp ho K k a) := by
  refine ⟨a • selectedFieldCoefficient A hd hs hp ho K k,
    a^2 • selectedSecondCoefficient A hd hs hp ho K k,
    selectedRootElement_expansion A hd hs hp ho K k a, ?_, ?_⟩
  · exact supported_smul _ _ _ (selectedFieldCoefficient_support A hd hs hp ho K k) a
  · exact supported_smul _ _ _ (selectedSecondCoefficient_support A hd hs hp ho K k) (a^2)

theorem zeroFunctionalGroup_le_preserving (K : Type) [Field K]
    (f : (Fin r → ℤ) →ₗ[ℤ] ℤ) :
    zeroFunctionalGroup A hd hs hp ho K f ≤
      preservingUnits (fun j => f (latticeWeight A hs hp b₀ j)) := by
  apply (Subgroup.closure_le _).mpr
  rintro _ ⟨k, hk, a, rfl⟩
  exact preserves_of_height_zero (latticeWeight A hs hp b₀) k.val.val f.toAddMonoidHom
    (selectedRootElement A hd hs hp ho K k.val a)
    (selectedRoot_quadraticGrade A hd hs hp ho K k.val a) hk

theorem positive_eq_functionalTail_sup_zero (K : Type) [Field K]
    (f : (Fin r → ℤ) →ₗ[ℤ] ℤ) (hf : ∀ k : PositiveRoot A, 0 ≤ f k.val.val) :
    rootGroup A hs hp b₀ s₀ K false =
      functionalTail A hd hs hp ho K f 1 ⊔ zeroFunctionalGroup A hd hs hp ho K f := by
  apply le_antisymm
  · rw [positive_group_eq_iSup A hd hs hp ho K]
    apply iSup_le
    intro k x hx
    obtain ⟨a, rfl⟩ := (mem_rootSubgroup_iff_selected A hd hs hp ho K k.val x).mp hx
    by_cases hk : f k.val.val = 0
    · exact (show zeroFunctionalGroup A hd hs hp ho K f ≤
          functionalTail A hd hs hp ho K f 1 ⊔ zeroFunctionalGroup A hd hs hp ho K f
          from le_sup_right) (root_mem_zeroFunctionalGroup A hd hs hp ho K f k hk a)
    · exact (show functionalTail A hd hs hp ho K f 1 ≤
          functionalTail A hd hs hp ho K f 1 ⊔ zeroFunctionalGroup A hd hs hp ho K f
          from le_sup_left) (root_mem_functionalTail A hd hs hp ho K f 1 k.val k.property (by
            have hnonneg := hf k
            omega) a)
  · exact sup_le (functionalTail_le_positive A hd hs hp ho K f 1)
      (zeroFunctionalGroup_le_positive A hd hs hp ho K f)

theorem positive_functional_factor (K : Type) [Field K]
    (f : (Fin r → ℤ) →ₗ[ℤ] ℤ) (hf : ∀ k : PositiveRoot A, 0 ≤ f k.val.val)
    (g : (Mat A hd hs hp ho K)ˣ) (hg : g ∈ rootGroup A hs hp b₀ s₀ K false) :
    ∃ n ∈ functionalTail A hd hs hp ho K f 1,
      ∃ l ∈ zeroFunctionalGroup A hd hs hp ho K f, g = n*l := by
  let N := functionalTail A hd hs hp ho K f 1
  let L := zeroFunctionalGroup A hd hs hp ho K f
  have hLN : L ≤ Subgroup.normalizer (N : Set (Mat A hd hs hp ho K)ˣ) :=
    (zeroFunctionalGroup_le_positive A hd hs hp ho K f).trans
      (positive_le_normalizer_functionalTail A hd hs hp ho K f 1 hf)
  have hmem : g ∈ N ⊔ L := by
    rw [← positive_eq_functionalTail_sup_zero A hd hs hp ho K f hf]
    exact hg
  change g ∈ (↑(N ⊔ L) : Set (Mat A hd hs hp ho K)ˣ) at hmem
  rw [Subgroup.coe_mul_of_right_le_normalizer_left N L hLN] at hmem
  obtain ⟨n, hn, l, hl, he⟩ := hmem
  exact ⟨n, hn, l, hl, he.symm⟩

theorem positive_mem_zeroFunctionalGroup_of_preserving (K : Type) [Field K]
    (f : (Fin r → ℤ) →ₗ[ℤ] ℤ) (hf : ∀ k : PositiveRoot A, 0 ≤ f k.val.val)
    (g : (Mat A hd hs hp ho K)ˣ) (hg : g ∈ rootGroup A hs hp b₀ s₀ K false)
    (hpres : g ∈ preservingUnits (fun j => f (latticeWeight A hs hp b₀ j))) :
    g ∈ zeroFunctionalGroup A hd hs hp ho K f := by
  obtain ⟨n, hn, l, hl, he⟩ := positive_functional_factor A hd hs hp ho K f hf g hg
  exact mem_right_of_factor
    (functionalTail_le_strict A hd hs hp ho K f 1 (by decide))
    (zeroFunctionalGroup_le_preserving A hd hs hp ho K f)
    (strict_inf_preserving (fun j => f (latticeWeight A hs hp b₀ j))) hn hl he hpres

theorem positive_inf_preserving_eq_zeroFunctionalGroup (K : Type) [Field K]
    (f : (Fin r → ℤ) →ₗ[ℤ] ℤ) (hf : ∀ k : PositiveRoot A, 0 ≤ f k.val.val) :
    rootGroup A hs hp b₀ s₀ K false ⊓
      preservingUnits (fun j => f (latticeWeight A hs hp b₀ j)) =
        zeroFunctionalGroup A hd hs hp ho K f := by
  apply le_antisymm
  · intro g hg
    exact positive_mem_zeroFunctionalGroup_of_preserving A hd hs hp ho K f hf g hg.1 hg.2
  · exact le_inf (zeroFunctionalGroup_le_positive A hd hs hp ho K f)
      (zeroFunctionalGroup_le_preserving A hd hs hp ho K f)

end SymmetricSubgroupAsymptotics.CFSGNormTwoCoordinateZeroFunctionalSupport
