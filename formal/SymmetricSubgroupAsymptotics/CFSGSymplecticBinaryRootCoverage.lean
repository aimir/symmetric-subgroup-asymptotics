import SymmetricSubgroupAsymptotics.CFSGSymplecticBinaryShortPropagation
import Mathlib.SetTheory.Cardinal.Finite

/-! Every literal elementary root belongs to the subgroup generated by
the actual binary pair. The only scalar specialization is the proved
cardinality-two field condition, which makes every parameter zero or one. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
open scoped CharTwo
namespace SymmetricSubgroupAsymptotics.CFSGSymplecticBinaryRootCoverage
open Matrix CFSGSymplecticSerreMatrices CFSGSymplecticBinaryRotationArrays
open CFSGSymplecticBinaryPairElements CFSGSymplecticBinaryArrayMembership
open CFSGSymplecticBinaryLongPropagation CFSGSymplecticBinaryShortPropagation
variable {K : Type} [Field K] [CharP K 2]

theorem chain_root_array (s : ℕ) (neg : Bool) (i : Fin (s+3)) (hi : i.val<s+2) :
    ((elementaryRoot K (s+3) neg i 1).val : Mat K (s+3))=shortArray
      (if neg then Sum.inr i else Sum.inl i)
      (if neg then Sum.inr (⟨i.val+1,by omega⟩ : Fin (s+3)) else Sum.inl ⟨i.val+1,by omega⟩) := by
  have hi' : i.val+1<s+3 := by omega
  cases neg <;>
    simp [elementaryRoot,rootTransvection,rootMatrix,negative,positive,hi',shortArray,paired,
      Matrix.transpose_sub,Matrix.transpose_single] <;>
      (ext a b; simp only [Matrix.add_apply,Matrix.sub_apply]; ring_nf <;> try simp)

theorem all_roots_one_mem (s : ℕ) (H : Subgroup ((Mat K (s+3))ˣ))
    (hX : (binaryFirst K s).val∈H) (hW : (binarySecond K s).val∈H)
    (neg : Bool) (i : Fin (s+3)) : (elementaryRoot K (s+3) neg i 1).val∈H := by
  apply (hasArray_iff_mem H _).mp
  by_cases hi : i.val<s+2
  · rw [chain_root_array s neg i hi]
    exact all_chain_short_mem s H hX hW neg i.val hi
  · have he : i=Fin.last (s+2) := Fin.ext (by simp only [Fin.val_last];omega)
    subst i
    cases neg
    · rw [terminal_positive_array]
      exact all_long_mem s H hX hW _
    · rw [terminal_negative_array]
      exact all_long_mem s H hX hW _

omit [CharP K 2] in
theorem eq_zero_or_one_of_card_two (hcard : Nat.card K=2) (a : K) : a=0 ∨ a=1 := by
  by_cases ha : a=0
  · exact Or.inl ha
  · right
    exact ((Nat.card_eq_two_iff' (0 : K)).mp hcard).unique ha one_ne_zero

theorem all_roots_mem (hcard : Nat.card K=2) (s : ℕ) (H : Subgroup ((Mat K (s+3))ˣ))
    (hX : (binaryFirst K s).val∈H) (hW : (binarySecond K s).val∈H)
    (neg : Bool) (i : Fin (s+3)) (a : K) : (elementaryRoot K (s+3) neg i a).val∈H := by
  rcases eq_zero_or_one_of_card_two hcard a with rfl|rfl
  · rw [elementaryRoot_zero]
    exact H.one_mem
  · exact all_roots_one_mem s H hX hW neg i

theorem elementary_le_of_pair (hcard : Nat.card K=2) (s : ℕ) (H : Subgroup ((Mat K (s+3))ˣ))
    (hX : (binaryFirst K s).val∈H) (hW : (binarySecond K s).val∈H) :
    elementaryRootGroup K (s+3)≤H := by
  apply (Subgroup.closure_le H).mpr
  rintro g ⟨neg,i,a,rfl⟩
  exact all_roots_mem hcard s H hX hW neg i a

end SymmetricSubgroupAsymptotics.CFSGSymplecticBinaryRootCoverage
