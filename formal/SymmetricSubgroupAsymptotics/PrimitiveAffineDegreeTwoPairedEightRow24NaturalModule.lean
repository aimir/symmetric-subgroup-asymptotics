  fin_cases i <;> fin_cases q <;> decide +kernel +revert

private theorem cyclic_mem_child : ∀ i q,
    cyclicRepresentative q ∈ (charts (child i q)).2.space := by
  intro i q
  apply ((charts (child i q)).2.mem_iff _).mpr
