def failure (j : Second) : Selector := rawFailure j.val.val
def whitelist (j : Second) : List RawTail := rawWhitelist j.val.val

theorem all_batches (j : Second) :
    batchCheck 21 j.val.val (failure j) (whitelist j)=true := by
  rcases j with ⟨j,hj⟩
  fin_cases j
