import SymmetricSubgroupAsymptotics.TernaryPlaneKleinNormalizerCardCertificate
import SymmetricSubgroupAsymptotics.TernaryPlaneKleinConjugacyCertificate

/-!
# Normal Klein four subgroups in `GL₂(3)`

A faithful Klein four subgroup of the ternary plane is the diagonal sign
group in a suitable basis.  Its full linear normalizer is dihedral of order
eight.  We reduce this to a finite statement about the two images of the
standard generators of `C₂²`; only pairs of literal matrices are checked,
rather than enumerating subgroups of `GL₂(3)`.
-/

set_option autoImplicit false
noncomputable section
open scoped Classical

namespace SymmetricSubgroupAsymptotics
namespace LinearThree

private abbrev C2 := Multiplicative (ZMod 2)
private abbrev V4 := C2 × C2
private abbrev D8 := DegreeSixS3Wreath.D8

private def firstBit : V4 := (Multiplicative.ofAdd 1, 1)
private def secondBit : V4 := (1, Multiplicative.ofAdd 1)

/-- A faithful image of `C₂²` is generated by the images of its two
standard bits. -/
theorem kleinRange_eq_pairSubgroup
    (f : V4 →* GL3) (_hf : Function.Injective f) :
    f.range = kleinPairSubgroup (f firstBit) (f secondBit) := by
  simpa only [firstBit, secondBit, kleinFirstBit, kleinSecondBit] using
    binaryKleinRange_eq_pairSubgroup f _hf

private theorem firstBit_ne_one : firstBit ≠ 1 := by decide
private theorem secondBit_ne_one : secondBit ≠ 1 := by decide
private theorem firstBit_ne_secondBit : firstBit ≠ secondBit := by decide
private theorem firstBit_square : firstBit ^ 2 = 1 := by decide
private theorem secondBit_square : secondBit ^ 2 = 1 := by decide

/-- The normalizer of every faithful `C₂²` matrix image has order eight. -/
theorem kleinRange_normalizer_card_eq_eight
    (f : V4 →* GL3) (hf : Function.Injective f) :
    Nat.card (Subgroup.normalizer (f.range : Set GL3)) = 8 := by
  rw [kleinRange_eq_pairSubgroup f hf]
  apply pair_normalizer_card_eq_eight_certificate
  · exact fun h => firstBit_ne_one (hf (h.trans (map_one f).symm))
  · exact fun h => secondBit_ne_one (hf (h.trans (map_one f).symm))
  · exact fun h => firstBit_ne_secondBit (hf h)
  · rw [← map_pow, firstBit_square, map_one]
  · rw [← map_pow, secondBit_square, map_one]
  · rw [← map_mul, mul_comm, map_mul]

end LinearThree

namespace DegreeSixS3Wreath

/-- The standard dihedral image exhausts the normalizer of its diagonal
Klein four.  Inclusion is structural; equality follows because both groups
have the certified order eight. -/
theorem standardD8LinearRange_eq_normalizer :
    standardD8LinearMap.range =
      Subgroup.normalizer (standardKleinLinearMap.range : Set LinearThree.GL3) := by
  apply Subgroup.eq_of_le_of_card_ge standardD8LinearRange_le_normalizer
  have hrange : Nat.card standardD8LinearMap.range = 8 := by
    calc
      Nat.card standardD8LinearMap.range = Nat.card D8 :=
        Nat.card_congr
          (MonoidHom.ofInjective standardD8LinearMap_injective).toEquiv.symm
      _ = 8 := card_D8
  have hnormal :
      Nat.card
        (Subgroup.normalizer
          (standardKleinLinearMap.range : Set LinearThree.GL3)) = 8 :=
    LinearThree.kleinRange_normalizer_card_eq_eight
      standardKleinLinearMap standardKleinLinearMap_injective
  rw [hrange, hnormal]

end DegreeSixS3Wreath

namespace LinearThree

/-- Action-compatible recognition of the normalizer of a faithful Klein
image.  The displayed change of basis carries every matrix in the source
normalizer to the standard matrix of its `D8` label. -/
structure KleinRangeD8Conjugacy
    (f : V4 →* GL3) where
  conjugator : GL3
  equiv : Subgroup.normalizer (f.range : Set GL3) ≃* D8
  matrix_eq : ∀ x,
    DegreeSixS3Wreath.standardD8LinearMap (equiv x) =
      conjugator * (x : GL3) * conjugator⁻¹

/-- Every faithful `C₂²` matrix image has an action-compatible
dihedral normalizer chart. -/
noncomputable def kleinRangeD8Conjugacy
    (f : V4 →* GL3) (hf : Function.Injective f) :
    KleinRangeD8Conjugacy f := by
  have ha : f firstBit ≠ 1 :=
    fun h => firstBit_ne_one (hf (h.trans (map_one f).symm))
  have hb : f secondBit ≠ 1 :=
    fun h => secondBit_ne_one (hf (h.trans (map_one f).symm))
  have hab : f firstBit ≠ f secondBit :=
    fun h => firstBit_ne_secondBit (hf h)
  have ha2 : (f firstBit) ^ 2 = 1 := by
    rw [← map_pow, firstBit_square, map_one]
  have hb2 : (f secondBit) ^ 2 = 1 := by
    rw [← map_pow, secondBit_square, map_one]
  have hcomm : f firstBit * f secondBit =
      f secondBit * f firstBit := by
    rw [← map_mul, mul_comm, map_mul]
  let hex := pair_conjugate_standardKlein_certificate
    (f firstBit) (f secondBit) ha hb hab ha2 hb2 hcomm
  let g := Classical.choose hex
  have hgPair := Classical.choose_spec hex
  have hg : f.range.map (MulAut.conj g).toMonoidHom =
      DegreeSixS3Wreath.standardKleinLinearMap.range := by
    rw [kleinRange_eq_pairSubgroup f hf]
    exact hgPair
  let N := Subgroup.normalizer (f.range : Set GL3)
  let SN := Subgroup.normalizer
    (DegreeSixS3Wreath.standardKleinLinearMap.range : Set GL3)
  have hnormal : N.map (MulAut.conj g).toMonoidHom = SN := by
    dsimp only [N, SN]
    rw [Subgroup.map_equiv_normalizer_eq, hg]
  let conjugateEquiv : N ≃* SN :=
    ((MulAut.conj g).subgroupMap N).trans
      (MulEquiv.subgroupCongr hnormal)
  have hstandard : DegreeSixS3Wreath.standardD8LinearMap.range = SN :=
    DegreeSixS3Wreath.standardD8LinearRange_eq_normalizer
  let standardEquiv : D8 ≃* SN :=
    (MonoidHom.ofInjective
      DegreeSixS3Wreath.standardD8LinearMap_injective).trans
        (MulEquiv.subgroupCongr hstandard)
  refine
    { conjugator := g
      equiv := conjugateEquiv.trans standardEquiv.symm
      matrix_eq := ?_ }
  intro x
  have hx := standardEquiv.apply_symm_apply (conjugateEquiv x)
  exact congrArg Subtype.val hx

/-- The normalizer of every faithful `C₂²` matrix image is the standard
dihedral group of order eight. -/
theorem kleinRange_normalizer_equiv_d8
    (f : V4 →* GL3) (hf : Function.Injective f) :
    Nonempty (Subgroup.normalizer (f.range : Set GL3) ≃* D8) :=
  ⟨(kleinRangeD8Conjugacy f hf).equiv⟩

/-- A subgroup normalizing the displayed faithful Klein image lies in its
full matrix normalizer. -/
theorem le_normalizer_of_normalizes_kleinRange
    (H : Subgroup GL3)
    (f : V4 →* GL3)
    (hKH : f.range ≤ H)
    (hnormal : (f.range.subgroupOf H).Normal) :
    H ≤ Subgroup.normalizer (f.range : Set GL3) := by
  intro h hh
  apply Subgroup.mem_normalizer_iff.mpr
  intro k
  constructor
  · intro hk
    exact (Subgroup.normal_subgroupOf_iff hKH).mp hnormal
      k h hk hh
  · intro hk
    have hback := (Subgroup.normal_subgroupOf_iff hKH).mp hnormal
      (h * k * h⁻¹) h⁻¹ hk (H.inv_mem hh)
    simpa only [inv_inv, mul_assoc, inv_mul_cancel_left,
      mul_inv_cancel_right, inv_mul_cancel, mul_one] using hback

/-- Any subgroup which normalizes a faithful `C₂²` matrix image has order
at most eight. -/
theorem card_le_eight_of_normalizes_kleinRange
    (H : Subgroup GL3)
    (f : V4 →* GL3) (hf : Function.Injective f)
    (hKH : f.range ≤ H)
    (hnormal : (f.range.subgroupOf H).Normal) :
    Nat.card H ≤ 8 := by
  have hle := le_normalizer_of_normalizes_kleinRange H f hKH hnormal
  calc
    Nat.card H ≤ Nat.card (Subgroup.normalizer (f.range : Set GL3)) :=
      Nat.card_le_card_of_injective
        (Subgroup.inclusion hle) (Subgroup.inclusion_injective hle)
    _ = 8 := kleinRange_normalizer_card_eq_eight f hf

/-- An order-eight subgroup normalizing a faithful `C₂²` image is the full
normalizer and hence is dihedral. -/
theorem equiv_d8_of_card_eight_of_normalizes_kleinRange
    (H : Subgroup GL3)
    (f : V4 →* GL3) (hf : Function.Injective f)
    (hKH : f.range ≤ H)
    (hnormal : (f.range.subgroupOf H).Normal)
    (hcard : Nat.card H = 8) :
    Nonempty (H ≃* D8) := by
  let N := Subgroup.normalizer (f.range : Set GL3)
  have hle : H ≤ N :=
    le_normalizer_of_normalizes_kleinRange H f hKH hnormal
  have hNcard : Nat.card N = 8 :=
    kleinRange_normalizer_card_eq_eight f hf
  let inc : H →* N := Subgroup.inclusion hle
  have hinc : Function.Bijective inc :=
    (Nat.bijective_iff_injective_and_card inc).mpr
      ⟨Subgroup.inclusion_injective hle, hcard.trans hNcard.symm⟩
  obtain ⟨d⟩ := kleinRange_normalizer_equiv_d8 f hf
  exact ⟨(MulEquiv.ofBijective inc hinc).trans d⟩

/-- Action-compatible form of the preceding order-eight recognition. -/
structure SubgroupD8Conjugacy
    (H : Subgroup GL3) where
  conjugator : GL3
  equiv : H ≃* D8
  matrix_eq : ∀ x,
    DegreeSixS3Wreath.standardD8LinearMap (equiv x) =
      conjugator * (x : GL3) * conjugator⁻¹

/-- An order-eight subgroup normalizing a faithful Klein image is carried
to the standard monomial `D8` by one change of ternary basis. -/
noncomputable def subgroupD8Conjugacy_of_card_eight_of_normalizes_kleinRange
    (H : Subgroup GL3)
    (f : V4 →* GL3) (hf : Function.Injective f)
    (hKH : f.range ≤ H)
    (hnormal : (f.range.subgroupOf H).Normal)
    (hcard : Nat.card H = 8) :
    SubgroupD8Conjugacy H := by
  let N := Subgroup.normalizer (f.range : Set GL3)
  have hle : H ≤ N :=
    le_normalizer_of_normalizes_kleinRange H f hKH hnormal
  have hNcard : Nat.card N = 8 :=
    kleinRange_normalizer_card_eq_eight f hf
  let inc : H →* N := Subgroup.inclusion hle
  have hinc : Function.Bijective inc :=
    (Nat.bijective_iff_injective_and_card inc).mpr
      ⟨Subgroup.inclusion_injective hle, hcard.trans hNcard.symm⟩
  let incEquiv : H ≃* N := MulEquiv.ofBijective inc hinc
  let D := kleinRangeD8Conjugacy f hf
  refine
    { conjugator := D.conjugator
      equiv := incEquiv.trans D.equiv
      matrix_eq := ?_ }
  intro x
  exact D.matrix_eq (incEquiv x)

end LinearThree
end SymmetricSubgroupAsymptotics

end
