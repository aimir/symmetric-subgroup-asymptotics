import SymmetricSubgroupAsymptotics.BinaryPairUniformQuotientSocles
import SymmetricSubgroupAsymptotics.OriginalKernelUniformDualSections

/-! Physical pair bits supply the exact original kernel chart at every
width. Uniform dual natural-module bounds descend to every original axis. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
namespace SymmetricSubgroupAsymptotics.BinaryPairFrame
variable {X I : Type} [Finite X] [Fintype I]
    {U : Subgroup (Equiv.Perm X)} (F : BinaryPairFrame U I)

def actualKernelModule : Rep (ZMod 2) F.top.range :=
  Rep.of F.kernelTopPermutationSubrepresentation.toRepresentation

private def actualRangeKernelEquiv : F.top.rangeRestrict.ker ≃* F.top.ker :=
  MulEquiv.subgroupCongr (by
    ext u
    change F.top.rangeRestrict u=1 ↔ F.top u=1
    constructor
    · exact fun h => congrArg Subtype.val h
    · exact fun h => Subtype.ext h)

/-- Exact original correlated kernel, not the full six-dimensional flip
space. Conjugation is the physical permutation of its coordinates. -/
def actualOriginalKernelChart : OriginalKernelModuleChart F.top.rangeRestrict (actualKernelModule F) where
  equiv := F.kernelChart.symm.trans (actualRangeKernelEquiv F).symm
  conjugate u v := by
    let k : F.top.ker := F.kernelChart.symm (Multiplicative.ofAdd v)
    have hk : F.bits k=v.val :=
      congrArg (fun z : F.kernelSpace => (z : I → ZMod 2))
        (congrArg Multiplicative.toAdd (F.kernelChart.apply_symm_apply (Multiplicative.ofAdd v)))
    have he : F.kernelChart (MulAut.conjNormal u k)=
        Multiplicative.ofAdd ((actualKernelModule F).ρ (F.top.rangeRestrict u) v) := by
      apply Multiplicative.toAdd.injective
      apply Subtype.ext
      funext i
      change F.bits (MulAut.conjNormal u k) i=v.val ((F.top u)⁻¹ i)
      rw [F.bits_conjNormal,hk]
    have hg : F.kernelChart.symm
        (Multiplicative.ofAdd ((actualKernelModule F).ρ (F.top.rangeRestrict u) v))=
          MulAut.conjNormal u k := by
      apply F.kernelChart.injective
      rw [F.kernelChart.apply_symm_apply]
      exact he.symm
    change ((F.kernelChart.symm
        (Multiplicative.ofAdd ((actualKernelModule F).ρ (F.top.rangeRestrict u) v)) : F.top.ker) : U)=
      u * ((F.kernelChart.symm (Multiplicative.ofAdd v) : F.top.ker) : U) * u⁻¹
    exact congrArg Subtype.val hg


def actualKernelInclusion : Representation.IntertwiningMap (F.actualKernelModule).ρ
    (permutationFunctionRepresentation (ZMod 2) F.top.range I) where
  toLinearMap := F.kernelSpace.subtype
  isIntertwining' _ := rfl

/-- Correlation only shrinks the actual original kernel; dual restriction
is onto, so uniform generation descends without paying its full dimension. -/
theorem actualKernelDualUniform {H : ℕ}
    (hdual : UniformSubrepresentationGeneratorBound
      (permutationFunctionRepresentation (ZMod 2) F.top.range I).dual H) :
    UniformSubrepresentationGeneratorBound (F.actualKernelModule).ρ.dual H := by
  have hi : Function.Injective F.actualKernelInclusion :=
    fun _ _ h => Subtype.ext h
  exact hdual.of_surjective (RepresentationHeadExact.dualMap F.actualKernelInclusion)
    (LinearMap.dualMap_surjective_of_injective hi)

/-- Every exact original quotient kernel is generated by H dual vectors
under its actual residual top. No N≤kernel condition is imposed. -/
theorem actualSectionDualGeneratedBy {H : ℕ}
    (hdual : UniformSubrepresentationGeneratorBound
      (permutationFunctionRepresentation (ZMod 2) F.top.range I).dual H)
    (N : Subgroup U) [N.Normal] :
    RepresentationGeneratedBy
      ((F.actualOriginalKernelChart).sectionRepresentation F.top.rangeRestrict
        F.actualKernelModule N).ρ.dual H :=
  (F.actualOriginalKernelChart).sectionDualGeneratedBy_of_uniform
    F.top.rangeRestrict F.actualKernelModule F.top.rangeRestrict_surjective
    (F.actualKernelDualUniform hdual) N

end SymmetricSubgroupAsymptotics.BinaryPairFrame
