import SymmetricSubgroupAsymptotics.BinaryPairFrames

/-! Construct the literal physical pair frame from its original generators.
Only the generator point images are checked. Subgroup closure propagates the
pair action, and the resulting top is exactly the group generated by the
retained top images. No enumeration of all source elements is required. -/
set_option autoImplicit false
noncomputable section
namespace SymmetricSubgroupAsymptotics.BinaryPairFrame

variable {X I : Type*} (frame : I × ZMod 2 ≃ X)

def Preserves (u : Equiv.Perm X) (p : Equiv.Perm I) : Prop :=
  ∀ x : I × ZMod 2, (frame.symm (u (frame x))).1 = p x.1

theorem preserves_unique {u : Equiv.Perm X} {p q : Equiv.Perm I}
    (hp : Preserves frame u p) (hq : Preserves frame u q) : p = q := by
  apply Equiv.ext
  intro i
  exact (hp (i,0)).symm.trans (hq (i,0))

theorem preserves_mul {u v : Equiv.Perm X} {p q : Equiv.Perm I}
    (hu : Preserves frame u p) (hv : Preserves frame v q) :
    Preserves frame (u*v) (p*q) := by
  intro x
  have h := hu (frame.symm (v (frame x)))
  simpa only [frame.apply_symm_apply, hv x, Equiv.Perm.mul_apply] using h

theorem preserves_inv {u : Equiv.Perm X} {p : Equiv.Perm I}
    (hu : Preserves frame u p) : Preserves frame u⁻¹ p⁻¹ := by
  intro x
  have h := hu (frame.symm (u⁻¹ (frame x)))
  simp only [frame.apply_symm_apply, Equiv.Perm.inv_def, Equiv.apply_symm_apply,
    frame.symm_apply_apply] at h
  exact p.injective (by simpa only [Equiv.Perm.inv_def, Equiv.apply_symm_apply] using h.symm)

def pairPreserving : Subgroup (Equiv.Perm X) where
  carrier := {u | ∃ p, Preserves frame u p}
  one_mem' := ⟨1, by intro x; simp⟩
  mul_mem' := by
    rintro u v ⟨p,hp⟩ ⟨q,hq⟩
    exact ⟨p*q,preserves_mul frame hp hq⟩
  inv_mem' := by
    rintro u ⟨p,hp⟩
    exact ⟨p⁻¹,preserves_inv frame hp⟩

def pairTop : pairPreserving frame →* Equiv.Perm I where
  toFun u := Classical.choose u.property
  map_one' := preserves_unique frame (Classical.choose_spec (1 : pairPreserving frame).property)
    (by intro x; simp)
  map_mul' u v := preserves_unique frame (Classical.choose_spec (u*v).property)
    (preserves_mul frame (Classical.choose_spec u.property) (Classical.choose_spec v.property))

theorem pairTop_spec (u : pairPreserving frame) :
    Preserves frame u (pairTop frame u) := Classical.choose_spec u.property

variable {ι : Type*} (generators : ι → Equiv.Perm X)
    (tops : ι → Equiv.Perm I)
    (h : ∀ i, Preserves frame (generators i) (tops i))

include h in
theorem generated_le_pairPreserving :
    Subgroup.closure (Set.range generators) ≤ pairPreserving frame := by
  apply (Subgroup.closure_le _).mpr
  rintro _ ⟨i,rfl⟩
  exact ⟨tops i,h i⟩

/-- Install the actual pair action on the original generated subgroup. -/
def ofGenerators : BinaryPairFrame (Subgroup.closure (Set.range generators)) I where
  frame := frame
  top := (pairTop frame).comp (Subgroup.inclusion
    (generated_le_pairPreserving frame generators tops h))
  intertwine u x := pairTop_spec frame
    ⟨u,generated_le_pairPreserving frame generators tops h u.property⟩ x

@[simp] theorem ofGenerators_top_generator (i : ι) :
    (ofGenerators frame generators tops h).top
      ⟨generators i,Subgroup.subset_closure ⟨i,rfl⟩⟩ = tops i := by
  exact preserves_unique frame (pairTop_spec frame _) (h i)

/-- The actual top range is exactly the retained generator-image group. -/
theorem ofGenerators_top_range :
    (ofGenerators frame generators tops h).top.range =
      Subgroup.closure (Set.range tops) := by
  apply le_antisymm
  · let V := Subgroup.closure (Set.range tops)
    let P := V.comap (pairTop frame)
    have hg : Subgroup.closure (Set.range generators) ≤ P.map (pairPreserving frame).subtype := by
      apply (Subgroup.closure_le _).mpr
      rintro _ ⟨i,rfl⟩
      refine ⟨⟨generators i,⟨tops i,h i⟩⟩,?_,rfl⟩
      change pairTop frame _ ∈ V
      rw [preserves_unique frame (pairTop_spec frame _) (h i)]
      exact Subgroup.subset_closure ⟨i,rfl⟩
    rintro _ ⟨u,rfl⟩
    obtain ⟨v,hv,he⟩ := hg u.property
    have huv : v = ⟨u,generated_le_pairPreserving frame generators tops h u.property⟩ :=
      Subtype.ext he
    simpa only [huv] using hv
  · apply (Subgroup.closure_le _).mpr
    rintro _ ⟨i,rfl⟩
    exact ⟨⟨generators i,Subgroup.subset_closure ⟨i,rfl⟩⟩,
      ofGenerators_top_generator frame generators tops h i⟩

end SymmetricSubgroupAsymptotics.BinaryPairFrame
