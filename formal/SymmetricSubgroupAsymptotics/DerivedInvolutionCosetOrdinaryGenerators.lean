import SymmetricSubgroupAsymptotics.DerivedTwoCosetGeneratorContainment
import SymmetricSubgroupAsymptotics.MarkedC4GeneratorNumbers
import Mathlib.Data.Fintype.Sum

/-! When the remaining coset generator is involutory, its square contributes
NO ordinary generator. The actual derived group is generated by the d
original derived elements and their d conjugates. No index-two, finite
ambient group, simplicity or splitting assumption is used. -/
set_option autoImplicit false
noncomputable section
open scoped Classical
namespace SymmetricSubgroupAsymptotics.DerivedInvolutionCosetOrdinaryGenerators
variable {G ι : Type*} [Group G] [Finite ι]

theorem exists_generating_finset (g : ι → commutator G) (y : G)
    (hgen : Subgroup.closure (Set.range (fun i => (g i : G)) ∪ {y}) = ⊤)
    (hsquare : y^2 = 1) :
    ∃ T : Finset (commutator G), Subgroup.closure (T : Set (commutator G)) = ⊤ ∧
      T.card ≤ 2*Nat.card ι := by
  let D := commutator G
  let w : ι ⊕ ι → D := Sum.elim g (fun i =>
    ⟨y*(g i : G)*y⁻¹,(inferInstance : D.Normal).conj_mem _ (g i).property y⟩)
  let H : Subgroup D := Subgroup.closure (Set.range w)
  have hmap : D ≤ H.map D.subtype := by
    apply (DerivedTwoCosetGeneratorContainment.commutator_le_generatedSubgroup
      (Set.range (fun i => (g i : G))) y hgen).trans
    apply (Subgroup.closure_le _).mpr
    intro z hz
    rcases hz with (⟨i,rfl⟩ | ⟨_,⟨i,rfl⟩,rfl⟩) | hz
    · exact ⟨w (Sum.inl i),Subgroup.subset_closure ⟨Sum.inl i,rfl⟩,rfl⟩
    · exact ⟨w (Sum.inr i),Subgroup.subset_closure ⟨Sum.inr i,rfl⟩,rfl⟩
    · have hz : z = y^2 := hz
      subst z
      rw [hsquare]
      exact (H.map D.subtype).one_mem
  have hH : H = ⊤ := by
    apply top_unique
    intro z _
    obtain ⟨a,ha,he⟩ := hmap z.property
    have he' : a = z := Subtype.ext he
    exact he' ▸ ha
  letI : Fintype (ι ⊕ ι) := Fintype.ofFinite _
  let T : Finset D := Finset.univ.image w
  have hT : (T : Set D) = Set.range w := by
    simp only [T,Finset.coe_image,Finset.coe_univ,Set.image_univ]
  refine ⟨T,?_,?_⟩
  · rw [hT]
    exact hH
  · calc
      T.card ≤ Fintype.card (ι ⊕ ι) := Finset.card_image_le.trans_eq Finset.card_univ
      _ = 2*Nat.card ι := by
        rw [← Nat.card_eq_fintype_card,Nat.card_sum]
        omega

theorem genRank_le (g : ι → commutator G) (y : G)
    (hgen : Subgroup.closure (Set.range (fun i => (g i : G)) ∪ {y}) = ⊤)
    (hsquare : y^2 = 1) : MarkedC4.genRank (commutator G) ≤ 2*Nat.card ι := by
  obtain ⟨T,hT,hcard⟩ := exists_generating_finset g y hgen hsquare
  exact (MarkedC4.genRank_le hT).trans hcard

end SymmetricSubgroupAsymptotics.DerivedInvolutionCosetOrdinaryGenerators
