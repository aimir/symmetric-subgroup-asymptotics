private theorem code_checked : ∀ i : Fin 192, permutationCode (sourceState i)=sourceCode i := by
  decide +kernel
private theorem code_strict : StrictMono sourceCode := by
  apply Fin.strictMono_iff_lt_succ.mpr
  decide +kernel
private theorem word_source : ∀ (i : Fin 192) (x : Fin 8),
    (((word i).map (fun j => (sourceGenerators j,targetGenerators j))).prod).1 x = sourceState i x := by
  decide +kernel
private theorem word_target : ∀ (i : Fin 192) (x : Fin 8),
    (((word i).map (fun j => (sourceGenerators j,targetGenerators j))).prod).2 x = targetState i x := by
  decide +kernel
private theorem step_source : ∀ (i : Fin 192) (j : Fin 5) (x : Fin 8),
    sourceState (step i j) x = (sourceState i * sourceGenerators j) x := by decide +kernel
private theorem step_target : ∀ (i : Fin 192) (j : Fin 5) (x : Fin 8),
    targetState (step i j) x = (targetState i * targetGenerators j) x := by decide +kernel
private theorem inverse_source : ∀ (i : Fin 192) (x : Fin 8),
    sourceState (inverse i) x = (sourceState i)⁻¹ x := by decide +kernel
private theorem inverse_target : ∀ (i : Fin 192) (x : Fin 8),
    targetState (inverse i) x = (targetState i)⁻¹ x := by decide +kernel
private theorem identity_source : ∀ x : Fin 8, sourceState 191 x = x := by decide +kernel
private theorem identity_target : ∀ x : Fin 8, targetState 191 x = x := by decide +kernel

def certificate : FiniteGeneratorGraphCertificate (I := Fin 192) sourceGenerators targetGenerators where
  state := state
  word := word
  word_eq i := Prod.ext (Equiv.ext (word_source i)) (Equiv.ext (word_target i))
  identity := 191
  identity_eq := Prod.ext (Equiv.ext identity_source) (Equiv.ext identity_target)
  step := step
  step_eq i j := Prod.ext (Equiv.ext (step_source i j)) (Equiv.ext (step_target i j))
  inverse := inverse
  inverse_eq i := Prod.ext (Equiv.ext (inverse_source i)) (Equiv.ext (inverse_target i))
  source_injective := by
    intro i j hij
    apply code_strict.injective
    rw [← code_checked i, ← code_checked j]
    exact congrArg permutationCode hij

abbrev Original := certificate.Source
abbrev Image := certificate.Target
def projection : Original →* Image := certificate.hom
theorem projection_surjective : Function.Surjective projection := certificate.hom_surjective

def centralFlip : Equiv.Perm (Fin 8) where
  toFun x := (#[1,0,3,2,5,4,7,6] : Array (Fin 8))[x.val]!
  invFun x := (#[1,0,3,2,5,4,7,6] : Array (Fin 8))[x.val]!
  left_inv := by decide +kernel
  right_inv := by decide +kernel
private theorem kernel_point_checked : ∀ i : Fin 192,
    (∀ x : Fin 8, targetState i x=x) ↔
      (∀ x : Fin 8, sourceState i x=x) ∨
      (∀ x : Fin 8, sourceState i x=centralFlip x) := by decide +kernel

/-- The actual projection kernel is precisely the original central flip,
not merely a kernel of matching order. -/
theorem kernel_mem_iff (x : Original) : x ∈ projection.ker ↔
    x=1 ∨ (x : Equiv.Perm (Fin 8))=centralFlip := by
  obtain ⟨i, rfl⟩ := certificate.sourceElement_surjective x
  have hprojection : (projection (certificate.sourceElement i) : Equiv.Perm (Fin 8)) =
      targetState i := certificate.hom_sourceElement i
  constructor
  · intro hx
    have ht : targetState i=1 := by
      have hh := congrArg Subtype.val (show projection (certificate.sourceElement i)=1 from hx)
      rwa [hprojection] at hh
    have hc : ∀ t : Fin 8, targetState i t=t := fun t => congrArg (fun p : Equiv.Perm (Fin 8) => p t) ht
    rcases (kernel_point_checked i).mp hc with hs | hs
    · left
      apply Subtype.ext
      exact Equiv.ext hs
    · right
      exact Equiv.ext hs
  · intro hx
    apply MonoidHom.mem_ker.mpr
    apply Subtype.ext
    rw [hprojection]
    apply Equiv.ext
    apply (kernel_point_checked i).mpr
    rcases hx with h1 | hz
    · left
      have he := congrArg Subtype.val h1
      intro t
      exact congrArg (fun p : Equiv.Perm (Fin 8) => p t) he
    · right
      intro t
      exact congrArg (fun p : Equiv.Perm (Fin 8) => p t) hz
