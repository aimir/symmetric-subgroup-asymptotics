import Mathlib.GroupTheory.Subgroup.Simple
import Mathlib.Algebra.Group.Subgroup.ZPowers.Basic

/-! In a simple group generated by an involution and a nonidentity element,
that element and its involution-conjugate generate the whole group.
No order or prime-power hypothesis on the second generator is needed. -/

set_option autoImplicit false
set_option Elab.async false

namespace SymmetricSubgroupAsymptotics.SimpleTwoGeneratorConjugateNormalClosure

variable {G : Type*} [Group G]

theorem pair_closure_normal (x y : G) (hx : x ^ 2 = 1)
    (hgen : Subgroup.closure ({x, y} : Set G) = ⊤) :
    (Subgroup.closure ({y, x * y * x⁻¹} : Set G)).Normal := by
  let H := Subgroup.closure ({y, x * y * x⁻¹} : Set G)
  have hxx : x * x = 1 := by simpa only [pow_two] using hx
  have hxinv : x⁻¹ = x := inv_eq_of_mul_eq_one_right hxx
  have hswap : x * (x * y * x⁻¹) * x⁻¹ = y := by
    calc
      x * (x * y * x⁻¹) * x⁻¹ = (x * x) * y * (x⁻¹ * x⁻¹) := by
        simp only [mul_assoc]
      _ = y := by rw [hxx, hxinv, hxx]; simp
  have hxN : x ∈ Subgroup.normalizer (H : Set G) := by
    apply Subgroup.normalizer_le_normalizer_closure ({y, x * y * x⁻¹} : Set G)
    apply Subgroup.mem_normalizer_iff_conj_image_eq.mpr
    rw [Set.image_insert_eq, Set.image_singleton]
    change ({x * y * x⁻¹, x * (x * y * x⁻¹) * x⁻¹} : Set G) =
      {y, x * y * x⁻¹}
    rw [hswap]
    exact Set.pair_comm _ _
  have hyH : y ∈ H := Subgroup.subset_closure (by simp)
  have hyN : y ∈ Subgroup.normalizer (H : Set G) := H.le_normalizer hyH
  have hN : Subgroup.normalizer (H : Set G) = ⊤ := by
    apply top_unique
    rw [← hgen]
    apply (Subgroup.closure_le _).mpr
    intro g hg
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
    rcases hg with rfl | rfl
    · exact hxN
    · exact hyN
  exact Subgroup.normalizer_eq_top_iff.mp hN

theorem pair_closure_eq_top [IsSimpleGroup G] (x y : G) (hx : x ^ 2 = 1)
    (hy : y ≠ 1) (hgen : Subgroup.closure ({x, y} : Set G) = ⊤) :
    Subgroup.closure ({y, x * y * x⁻¹} : Set G) = ⊤ := by
  rcases (pair_closure_normal x y hx hgen).eq_bot_or_eq_top with hbot | htop
  · have hyH : y ∈ Subgroup.closure ({y, x * y * x⁻¹} : Set G) :=
      Subgroup.subset_closure (by simp)
    rw [hbot, Subgroup.mem_bot] at hyH
    exact (hy hyH).elim
  · exact htop

theorem zpowers_sup_eq_top [IsSimpleGroup G] (x y : G) (hx : x ^ 2 = 1)
    (hy : y ≠ 1) (hgen : Subgroup.closure ({x, y} : Set G) = ⊤) :
    Subgroup.zpowers y ⊔ Subgroup.zpowers (x * y * x⁻¹) = ⊤ := by
  apply top_unique
  rw [← pair_closure_eq_top x y hx hy hgen]
  apply (Subgroup.closure_le _).mpr
  intro g hg
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
  rcases hg with hg | hg
  · subst g
    exact Subgroup.mem_sup_left (Subgroup.mem_zpowers y)
  · subst g
    exact Subgroup.mem_sup_right (Subgroup.mem_zpowers (x * y * x⁻¹))

end SymmetricSubgroupAsymptotics.SimpleTwoGeneratorConjugateNormalClosure
