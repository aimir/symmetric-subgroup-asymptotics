import SymmetricSubgroupAsymptotics.PrimitiveAffineDegreeTwoNonbinary16T57Normals
import SymmetricSubgroupAsymptotics.PrimitiveAffineDegreeTwoFiniteNormalImporter
import SymmetricSubgroupAsymptotics.FiniteConjugacyCentralizerCoordinateTransport
import SymmetricSubgroupAsymptotics.FiniteNormalJoinWordRegistryTransport

/-!
# Nonbinary degree-sixteen pilot 16T57: literal normal registry

This is the first end-to-end structural pilot for the 527-row nonbinary
catalogue.  The generated class and normal modules construct an executable
48-element row group.  Here both certificates are transported through the
checked Cayley equivalence to the literal subgroup generated by the two
degree-sixteen permutations in the pinned catalogue.

The exported `normalStateRegistry` is the exact width-independent input of
`PreE7FiniteMixedCharacterAxes`.  Its completeness is derived from the
conjugacy cover and normal-join words; the JSON normal list is not accepted as
a completeness premise.  Character and Zmud payloads are deliberately a
separate layer.
-/

set_option autoImplicit false
set_option maxRecDepth 100000
set_option maxHeartbeats 0
noncomputable section

namespace SymmetricSubgroupAsymptotics
namespace PrimitiveAffineDegreeTwoNonbinary16T57Structural

open PrimitiveAffineDegreeTwoNonbinary16T57ClassPilot
namespace RowNormals := PrimitiveAffineDegreeTwoNonbinary16T57Normals

local instance selectedSourceGroup : Group Source := group

/-- The literal catalogue subgroup generated by the pinned `16T57`
permutations. -/
abbrev Original : Subgroup (Equiv.Perm (Fin 16)) :=
  Subgroup.closure (Set.range generators)

/-- The two transported ambient generators. -/
def ambient (j : Fin 2) : Original :=
  originalEquiv (PrimitiveAffineDegreeTwoNonbinary16T57ClassPilot.ambient j)

/-- The sixteen transported conjugacy representatives. -/
def representative (i : Fin 16) : Original :=
  originalEquiv
    (PrimitiveAffineDegreeTwoNonbinary16T57ClassPilot.representative i)

/-- The nine transported normal states, each padded to three generators. -/
def stateGenerators (i : Fin 9) (j : Fin 3) : Original :=
  originalEquiv (RowNormals.stateGenerators i j)

/-- Reversible faithful-action centralizer coordinates on the literal
degree-sixteen subgroup. -/
noncomputable def conjugacy :
    FiniteConjugacyCentralizerCoordinateChunk representative 16 :=
  conjugacyChunk.mapEquiv originalEquiv

/-- Complete normal-join registry transported to the literal action. -/
noncomputable def normalRegistry : FiniteNormalJoinWordRegistryData
    conjugacy.toCardinalCover ambient stateGenerators :=
  RowNormals.normalRegistry.mapEquiv originalEquiv conjugacy.toCardinalCover

private theorem row_state_injective : Function.Injective
    (fun i : Fin 9 =>
      Subgroup.closure (Set.range (RowNormals.stateGenerators i))) := by
  native_decide

private theorem state_closure_eq_map (i : Fin 9) :
    Subgroup.closure (Set.range (stateGenerators i)) =
      (Subgroup.closure
        (Set.range (RowNormals.stateGenerators i))).map
          originalEquiv.toMonoidHom := by
  exact closure_range_map_equiv originalEquiv (RowNormals.stateGenerators i)

theorem state_injective : Function.Injective
    (fun i : Fin 9 => Subgroup.closure (Set.range (stateGenerators i))) := by
  intro i j hij
  apply row_state_injective
  apply Subgroup.map_injective originalEquiv.injective
  calc
    (Subgroup.closure (Set.range (RowNormals.stateGenerators i))).map
          originalEquiv.toMonoidHom =
        Subgroup.closure (Set.range (stateGenerators i)) :=
      (state_closure_eq_map i).symm
    _ = Subgroup.closure (Set.range (stateGenerators j)) := hij
    _ = (Subgroup.closure
          (Set.range (RowNormals.stateGenerators j))).map
            originalEquiv.toMonoidHom := state_closure_eq_map j

/-- Exact semantic enumeration of every literal normal subgroup of `16T57`.
This is the reusable bridge consumed by the degree-two finite character
importer. -/
noncomputable def normalStateRegistry :
    Non2UnipotentPrefixFiniteMenu.FiniteNormalStateRegistry Original :=
  Non2UnipotentPrefixFiniteMenu.FiniteNormalStateRegistry.ofWordRegistry
    conjugacy.toCardinalCover ambient stateGenerators normalRegistry
      state_injective

/-- Completeness of the nine emitted normal states on the literal subgroup. -/
theorem normal_complete (N : Subgroup Original) [N.Normal] :
    ∃ i, Subgroup.closure (Set.range (stateGenerators i)) = N :=
  normalRegistry.complete N

end PrimitiveAffineDegreeTwoNonbinary16T57Structural
end SymmetricSubgroupAsymptotics

end
