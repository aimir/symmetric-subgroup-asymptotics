import SymmetricSubgroupAsymptotics.BinaryInvariantCyclicQuotientGenerator
import SymmetricSubgroupAsymptotics.RepresentationSelfDualNestedQuotient

/-!
# Finite tables for self-dual nested quotients

A complete cyclic-state registry already proves that every invariant
subrepresentation occurs in a finite list and that every child edge is a
cyclic quotient.  For a self-dual representation, a finite producer can
therefore certify all nested dual quotients with only three further tables:

* the state reached by orthogonal complement;
* the dimension of every state; and
* for every nested pair, either a reversed child edge or the assertion that
  its dimension jump is at most two.

This file checks that compact table once and converts it to the semantic
``generated by one or dimension at most two`` statement.  Generated row
files retain only finite data and elementary finite checks.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open scoped Classical

namespace SymmetricSubgroupAsymptotics

variable {k G V I : Type} [Field k] [Group G]
  [AddCommGroup V] [Module k V] [Finite V] [FiniteDimensional k V]
  {rho : Representation k G V}
  {states : I → Subrepresentation rho}
  (C : BinaryInvariantCyclicOrbitRegistry rho states)
  (e : rho.Equiv rho.dual)

/-- Compact finite certificate for every nested quotient of a complete
self-dual invariant-state registry. -/
structure FiniteSelfDualNestedQuotientGeneratorData : Type 1 where
  orthogonalState : I → I
  orthogonalState_eq : ∀ i,
    selfDualOrthogonalSubrepresentation rho e (states i) =
      states (orthogonalState i)
  stateDimension : I → ℕ
  state_finrank : ∀ i,
    Module.finrank k (states i).toSubmodule = stateDimension i
  child_or_small : ∀ (i j : I), states i ≤ states j →
    (∃ c : C.Cyclic,
      C.child (orthogonalState j) c = orthogonalState i) ∨
    stateDimension j ≤ stateDimension i + 2

namespace FiniteSelfDualNestedQuotientGeneratorData

variable (D : FiniteSelfDualNestedQuotientGeneratorData C e)

include D

omit [Finite V] in
/-- Every nested quotient in the registry has cyclic dual, unless its
underlying vector-space dimension is at most two. -/
theorem nestedQuotient_generated_or_finrank_le_two
    (i j : I) (hij : states i ≤ states j) :
    RepresentationGeneratedBy
        (nestedQuotientRepresentation (states i) (states j) hij).dual 1 ∨
      Module.finrank k
        (nestedQuotientRepresentation
          (states i) (states j) hij).asModule ≤ 2 := by
  rcases D.child_or_small i j hij with ⟨c, hc⟩ | hsmall
  · left
    let horth := selfDualOrthogonalSubrepresentation_antitone rho e hij
    have hstate : states (D.orthogonalState j) ≤
        states (D.orthogonalState i) := by
      rw [← D.orthogonalState_eq, ← D.orthogonalState_eq]
      exact horth
    have transport (A B A' B' : Subrepresentation rho)
        (hA : A = A') (hB : B = B') (hAB : A ≤ B) (hA'B' : A' ≤ B')
        (hgen : RepresentationGeneratedBy (nestedQuotientRepresentation A B hAB) 1) :
        RepresentationGeneratedBy (nestedQuotientRepresentation A' B' hA'B') 1 := by
      subst A'
      subst B'
      exact hgen
    have hchild : states (D.orthogonalState j) ≤
        states (C.child (D.orthogonalState j) c) := by
      intro x hx
      change x ∈ (states (C.child (D.orthogonalState j) c)).toSubmodule
      rw [C.child_eq]
      exact Submodule.mem_sup_left hx
    have hchildGenerated : RepresentationGeneratedBy
        (nestedQuotientRepresentation (states (D.orthogonalState j))
          (states (C.child (D.orthogonalState j) c)) hchild) 1 :=
      C.childQuotientRepresentation_generated (D.orthogonalState j) c
    have hgenerated : RepresentationGeneratedBy
        (nestedQuotientRepresentation
          (states (D.orthogonalState j))
          (states (D.orthogonalState i)) hstate) 1 :=
      transport _ _ _ _ rfl (congrArg states hc) hchild hstate hchildGenerated
    have hgeneratedOrth : RepresentationGeneratedBy
        (nestedQuotientRepresentation
          (selfDualOrthogonalSubrepresentation rho e (states j))
          (selfDualOrthogonalSubrepresentation rho e (states i))
          horth) 1 :=
      transport _ _ _ _ (D.orthogonalState_eq j).symm
        (D.orthogonalState_eq i).symm hstate horth hgenerated
    let E := selfDualNestedQuotientEquiv rho e
      (states i) (states j) hij
    exact representationGeneratedBy_of_surjective
      _ _ E.toIntertwiningMap E.surjective hgeneratedOrth
  · right
    change Module.finrank k
      ((states j).toSubmodule ⧸
        (nestedSubrepresentation
          (states i) (states j) hij).toSubmodule) ≤ 2
    have hquot :=
      (nestedSubrepresentation (states i) (states j) hij).toSubmodule.finrank_quotient_add_finrank
    have hden := finrank_nestedSubrepresentation
      (states i) (states j) hij
    rw [hden, D.state_finrank, D.state_finrank] at hquot
    omega

/-- Catalogue-free form: completeness chooses the two finite states for an
arbitrary nested invariant pair before applying the compact table. -/
theorem subrepresentationQuotient_generated_or_finrank_le_two
    (A B : Subrepresentation rho) (hAB : A ≤ B) :
    RepresentationGeneratedBy
        (nestedQuotientRepresentation A B hAB).dual 1 ∨
      Module.finrank k
        (nestedQuotientRepresentation A B hAB).asModule ≤ 2 := by
  obtain ⟨i, rfl⟩ := C.complete A
  obtain ⟨j, rfl⟩ := C.complete B
  exact D.nestedQuotient_generated_or_finrank_le_two C e i j hAB

end FiniteSelfDualNestedQuotientGeneratorData
end SymmetricSubgroupAsymptotics

end
