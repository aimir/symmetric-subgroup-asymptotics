import SymmetricSubgroupAsymptotics.BinarySixPointSymmetricMatrixBlocks
import SymmetricSubgroupAsymptotics.SixPairCyclicSymmetricSocles
import SymmetricSubgroupAsymptotics.OddPrimeDihedralNormalChain
import SymmetricSubgroupAsymptotics.DerivedGeneratorWords

/-! Six physical pairs with actual regular S3 image. The binary regular
module has uniform generator bound one by its shared matrix-block proof.
The actual image is an explicit quotient of DihedralGroup 3, so its normal
subgroups are normally generated by one element. Their sum gives quotient
socle bound two, without assumptions on the pair-flip correlations. -/

set_option autoImplicit false
noncomputable section
open scoped Classical

namespace SymmetricSubgroupAsymptotics.SixPairRegularSymmetricSocles

abbrev ternary := BinarySixPointSymmetricMatrixBlocks.rotation
abbrev reversal := BinarySixPointSymmetricMatrixBlocks.reflection

def dihedralMap : DihedralGroup 3 →* Equiv.Perm (Fin 6) where
  toFun
    | .r i => ternary ^ i.val
    | .sr i => reversal * ternary ^ i.val
  map_one' := rfl
  map_mul' := by
    rintro (i | i) (j | j) <;>
      apply Equiv.ext <;> intro x <;> revert i j x <;> decide +kernel

theorem dihedralMap_rotation : dihedralMap (.r 1) = ternary := by decide +kernel
theorem dihedralMap_reflection : dihedralMap (.sr 0) = reversal := by decide +kernel

theorem generated_range {ι : Type*} (codes : ι → DihedralGroup 3) (ci bi : ι)
    (hc : codes ci = .r 1) (hb : codes bi = .sr 0) :
    Subgroup.closure (Set.range (fun i => dihedralMap (codes i))) = dihedralMap.range := by
  have hc' : ternary ∈ Subgroup.closure (Set.range (fun i => dihedralMap (codes i))) := by
    rw [← dihedralMap_rotation, ← hc]
    exact Subgroup.subset_closure ⟨ci, rfl⟩
  have hb' : reversal ∈ Subgroup.closure (Set.range (fun i => dihedralMap (codes i))) := by
    rw [← dihedralMap_reflection, ← hb]
    exact Subgroup.subset_closure ⟨bi, rfl⟩
  apply le_antisymm
  · apply (Subgroup.closure_le _).mpr
    rintro _ ⟨i, rfl⟩
    exact ⟨codes i, rfl⟩
  · rintro _ ⟨g, rfl⟩
    cases g with
    | r i => exact (Subgroup.closure _).pow_mem hc' i.val
    | sr i => exact (Subgroup.closure _).mul_mem hb' ((Subgroup.closure _).pow_mem hc' i.val)

theorem image_normalGen (L : Subgroup dihedralMap.range) (hL : L.Normal) :
    MarkedC4.normalGen L ≤ 1 := by
  letI := hL
  obtain ⟨x, hx⟩ := normal_generating_tuples_of_surjective dihedralMap.rangeRestrict
    dihedralMap.rangeRestrict_surjective
    (OddPrimeDihedralNormalChain.normal_generating_singletons (p := 3) (by decide : 2 < 3)) L hL
  exact normalGen_le_of_fin_tuple x hx

theorem quotientSocle {U : Subgroup (Equiv.Perm (Fin 12))}
    (F : BinaryPairFrame U (Fin 6)) (c b : U)
    (hc : F.top c = ternary) (hb : F.top b = reversal)
    (himage : F.top.range = dihedralMap.range)
    (N : Subgroup U) [N.Normal] : SocleNormalGeneratorBound (U ⧸ N) 2 := by
  apply F.quotientSocle_of_uniform_pair_action 1 1
    (BinarySixPointSymmetricMatrixBlocks.uniform_subgroup F.top.range
      (F.top.rangeRestrict c) (F.top.rangeRestrict b) hc hb) ?_ N
  intro L hL
  letI := hL
  let e : F.top.range ≃* dihedralMap.range := MulEquiv.subgroupCongr himage
  exact CoprimeKernelQuotientSocles.normalGen_image_bound
    e.symm.toMonoidHom e.symm.surjective 1 image_normalGen L

theorem quotientSocle_of_generators {ι : Type*} (generators : ι → Equiv.Perm (Fin 12))
    (codes : ι → DihedralGroup 3) (ci bi : ι)
    (hc : codes ci = .r 1) (hb : codes bi = .sr 0)
    (hp : ∀ i, BinaryPairFrame.Preserves SixPairCyclicSymmetricSocles.pointChart
      (generators i) (dihedralMap (codes i)))
    (N : Subgroup (Subgroup.closure (Set.range generators))) [N.Normal] :
    SocleNormalGeneratorBound ((Subgroup.closure (Set.range generators)) ⧸ N) 2 := by
  let F := BinaryPairFrame.ofGenerators SixPairCyclicSymmetricSocles.pointChart generators
    (fun i => dihedralMap (codes i)) hp
  apply quotientSocle F (closureGenerators generators ci) (closureGenerators generators bi)
  · exact (BinaryPairFrame.ofGenerators_top_generator _ _ _ hp ci).trans
      (by rw [hc]; exact dihedralMap_rotation)
  · exact (BinaryPairFrame.ofGenerators_top_generator _ _ _ hp bi).trans
      (by rw [hb]; exact dihedralMap_reflection)
  · exact (BinaryPairFrame.ofGenerators_top_range _ _ _ hp).trans
      (generated_range codes ci bi hc hb)

end SymmetricSubgroupAsymptotics.SixPairRegularSymmetricSocles

end
