import Mathlib.Algebra.Group.Submonoid.Units
import Mathlib.Algebra.Group.Subgroup.Map
import Mathlib.GroupTheory.DedekindFinite
import Mathlib.GroupTheory.OrderOfElement

/-! Units of a generated submonoid and the subgroup generated by genuine
unit lifts of the SAME seeds. The general theorem uses Dedekind finiteness
and finite order of the unit seeds. A finite ambient monoid supplies both.
No invertibility of a nonunit seed, group order, or model identification is
assumed. The equivalence preserves the actual value in the ambient monoid. -/
set_option autoImplicit false
noncomputable section
namespace SymmetricSubgroupAsymptotics.FiniteMonoidGeneratedUnitsEquivalence

variable {M : Type*} [Monoid M]

/-- All genuine units whose actual ambient value belongs to the seed set. -/
def unitSeeds (S : Set M) : Set Mˣ := {u | (u : M) ∈ S}

/-- The subgroup generated by those genuine unit lifts. -/
def unitClosure (S : Set M) : Subgroup Mˣ := Subgroup.closure (unitSeeds S)

/-- A unit in the positive-word closure has a word in genuine unit seeds.
Dedekind finiteness is what permits extracting unit factors from a product. -/
theorem value_mem_unitClosure [IsDedekindFiniteMonoid M]
    (S : Set M) (u : Mˣ) (hu : (u : M) ∈ Submonoid.closure S) :
    u ∈ unitClosure S := by
  have h : ∀ x : M, x ∈ Submonoid.closure S →
      IsUnit x → x ∈ (unitClosure S).ofUnits := by
    intro x hx
    induction hx using Submonoid.closure_induction with
    | mem x hx =>
        intro hxunit
        obtain ⟨v, rfl⟩ := hxunit
        exact ⟨v, Subgroup.subset_closure hx, rfl⟩
    | one =>
        intro _
        exact (unitClosure S).ofUnits.one_mem
    | mul x y hx hy ihx ihy =>
        intro hxy
        exact (unitClosure S).ofUnits.mul_mem
          (ihx (isUnit_of_mul_isUnit_left hxy))
          (ihy (isUnit_of_mul_isUnit_right hxy))
  exact (unitClosure S).mem_of_mem_val_ofUnits (h u hu u.isUnit)

/-- A finite-order unit in a submonoid has its inverse there, since the
inverse is a nonnegative power of the same actual unit. -/
theorem inv_value_mem_of_finite_order (K : Submonoid M) (u : Mˣ)
    (hu : IsOfFinOrder u) (hval : (u : M) ∈ K) :
    ((u⁻¹ : Mˣ) : M) ∈ K := by
  have hp : 1 ≤ orderOf u := hu.orderOf_pos
  have he : u ^ (orderOf u - 1) = u⁻¹ := by
    apply eq_inv_iff_mul_eq_one.mpr
    rw [← pow_succ, Nat.sub_add_cancel hp, pow_orderOf_eq_one]
  have hh : ((u ^ (orderOf u - 1) : Mˣ) : M) ∈ K := by
    change (u : M) ^ (orderOf u - 1) ∈ K
    exact K.pow_mem hval _
  rw [he] at hh
  exact hh

/-- Equality of the actual subgroups of ambient units. Only the unit seeds
need finite order; the positive-word closure itself need not be finite. -/
theorem units_closure_eq_of_seed_finite_order [IsDedekindFiniteMonoid M]
    (S : Set M) (horder : ∀ u ∈ unitSeeds S, IsOfFinOrder u) :
    (Submonoid.closure S).units = unitClosure S := by
  apply le_antisymm
  · intro u hu
    exact value_mem_unitClosure S u hu.1
  · apply (Subgroup.closure_le _).mpr
    intro u hu
    have hv : (u : M) ∈ Submonoid.closure S := Submonoid.subset_closure hu
    exact ⟨hv, inv_value_mem_of_finite_order (Submonoid.closure S) u (horder u hu) hv⟩

/-- The promised equivalence under the precise seed-order hypotheses. -/
def equiv_of_seed_finite_order [IsDedekindFiniteMonoid M]
    (S : Set M) (horder : ∀ u ∈ unitSeeds S, IsOfFinOrder u) :
    (Submonoid.closure S)ˣ ≃* unitClosure S :=
  (Submonoid.unitsEquivUnitsType (Submonoid.closure S)).symm.trans
    (MulEquiv.subgroupCongr (units_closure_eq_of_seed_finite_order S horder))

/-- In a finite ambient monoid there are no remaining seed hypotheses. -/
def equiv_finite [Finite M] (S : Set M) :
    (Submonoid.closure S)ˣ ≃* unitClosure S := by
  letI : Finite Mˣ := Finite.of_injective (fun u : Mˣ => (u : M)) Units.val_injective
  exact equiv_of_seed_finite_order S (fun u _ => isOfFinOrder_of_finite u)

/-- Semantic fidelity: the equivalence retains the actual ambient value. -/
theorem equiv_finite_value [Finite M] (S : Set M)
    (x : (Submonoid.closure S)ˣ) :
    (((equiv_finite S x : unitClosure S) : Mˣ) : M) = ((x : Submonoid.closure S) : M) := by
  rfl

/-- The inverse equivalence retains that same value as well. -/
theorem equiv_finite_symm_value [Finite M] (S : Set M) (x : unitClosure S) :
    ((((equiv_finite S).symm x : (Submonoid.closure S)ˣ) : Submonoid.closure S) : M) =
      ((x : Mˣ) : M) := by
  have h := equiv_finite_value S ((equiv_finite S).symm x)
  simpa only [MulEquiv.apply_symm_apply] using h.symm

end SymmetricSubgroupAsymptotics.FiniteMonoidGeneratedUnitsEquivalence
