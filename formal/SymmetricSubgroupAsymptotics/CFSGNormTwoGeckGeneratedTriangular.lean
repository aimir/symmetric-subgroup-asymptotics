import SymmetricSubgroupAsymptotics.CFSGNormTwoGeckGeneratedBasis
import SymmetricSubgroupAsymptotics.CFSGLieBasisTriangularDecomposition

/-! Triangular decomposition inside the SAME original rational matrix
Lie algebra generated by Geck's H/E/F. Both nilpotent summands are
transported from genuine subtype Lie-span membership. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
namespace SymmetricSubgroupAsymptotics.CFSGNormTwoGeckGeneratedTriangular
open CFSGIntegerMatrixPairing CFSGNormTwoRootPairing
open CFSGNormTwoGeckGeneratedBasis
variable {n : Type} [Fintype n] [DecidableEq n]
    (A : Matrix n n ℤ) (hd : ∀i,A i i=2)
    (hs : A.transpose=A) (hp : (rationalMatrix A).PosDef)
    [Fintype (Roots A)] [DecidableEq (Roots A)]
    [(rootPairing A hs hp).IsReduced] [(rootPairing A hs hp).IsIrreducible]
    (b : (rootPairing A hs hp).Base)

local notation "Mat" => Matrix (b.support⊕Roots A) (b.support⊕Roots A) ℚ
local notation "L" => RootPairing.GeckConstruction.lieAlgebra b

include hd in
theorem matrix_decomposition (X : Mat) (hx : X∈L) :
    ∃h∈Submodule.span ℚ (Set.range (fun i : b.support=>RootPairing.GeckConstruction.h i)),
      ∃f∈LieSubalgebra.lieSpan ℚ Mat (Set.range (fun i : b.support=>RootPairing.GeckConstruction.f i)),
      ∃e∈LieSubalgebra.lieSpan ℚ Mat (Set.range (fun i : b.support=>RootPairing.GeckConstruction.e i)),
      h+f+e=X := by
  let B := generatedLieBasis A hd hs hp b
  obtain ⟨h,hh,f,hf,e,he,hsum⟩ :=
    CFSGLieBasisTriangularDecomposition.decompose B (⟨X,hx⟩ : L)
  refine ⟨(h:Mat),?_,(f:Mat),?_,(e:Mat),?_,?_⟩
  · exact hh
  · have hf' : f∈(LieSubalgebra.lieSpan ℚ Mat
        (Set.range (fun i : b.support=>(B.f i:Mat)))).comap (L).incl := by
      change f∈(LieSubalgebra.lieSpan ℚ Mat
        (Set.range ((Subtype.val : L→Mat) ∘ B.f))).comap (L).incl
      rw [LieSubalgebra.comap_lieSpan_range_eq]
      exact hf
    exact hf'
  · have he' : e∈(LieSubalgebra.lieSpan ℚ Mat
        (Set.range (fun i : b.support=>(B.e i:Mat)))).comap (L).incl := by
      change e∈(LieSubalgebra.lieSpan ℚ Mat
        (Set.range ((Subtype.val : L→Mat) ∘ B.e))).comap (L).incl
      rw [LieSubalgebra.comap_lieSpan_range_eq]
      exact he
    exact he'
  · exact congrArg (fun v : L=>(v:Mat)) hsum

end SymmetricSubgroupAsymptotics.CFSGNormTwoGeckGeneratedTriangular
