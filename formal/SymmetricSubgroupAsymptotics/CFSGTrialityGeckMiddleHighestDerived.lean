import SymmetricSubgroupAsymptotics.CFSGTrialityGeckMiddleFixedCommutators
import SymmetricSubgroupAsymptotics.CFSGTrialityGeckFixedLongLine
import SymmetricSubgroupAsymptotics.CFSGTrialityGeckSectionQuotientCoordinates

/-! The fixed highest root line is generated by ACTUAL fixed positive
commutators in the long A2 subsystem. All parameters are in the literal
fixed field. In particular this uses no cubic trace and no division by
three; it remains valid at q=2 and in characteristic three. -/
set_option autoImplicit false
set_option Elab.async false
set_option backward.isDefEq.respectTransparency false
noncomputable section
namespace SymmetricSubgroupAsymptotics.CFSGTrialityGeckMiddleHighestDerived
open CFSGTrialityGeckDiagramCovariance CFSGTrialityD4PositiveRootOrbits
open CFSGTrialityGeckMiddleRadicalQuotient CFSGTrialityGeckMiddleFixedCommutators
open CFSGTrialityGeckFixedRootSections CFSGTrialityGeckLongA2Commutator
open CFSGTrialityGeckFixedPositiveRaw CFSGTrialityGeckPositiveTwist
open CFSGTrialityGeckSectionQuotientCoordinates CFSGTrialityGeckFixedLongLine
open CFSGTrialityGeckSectionParameterRanges CFSGTrialityGeckMatrixTwist
open CFSGTrialityFixedField CFSGSerreOrdinaryTwists
local instance : DecidableEq (CFSGNormTwoRootPairing.Roots (CartanMatrix.D 4)) := Classical.decEq _
local instance : DecidableEq GeckIndex := inferInstance

theorem longSection_mem_fixedPositive (q : CFSG.PrimePower) (s : Fin 3) (b : fixedField q) :
    longSection (q.Extension 3) s false b.val ∈ fixedPositiveRaw q := by
  apply (mem_fixedPositiveRaw_iff q _).mpr
  refine ⟨?_,longSection_fixed _ _ s false b.val b.property⟩
  have hm : (longPositiveSection (q.Extension 3) s (Multiplicative.ofAdd b.val)).val ∈
      Positive (q.Extension 3) := (longPositiveSection _ s (Multiplicative.ofAdd b.val)).property
  rwa [longPositiveSection_val] at hm

theorem highest_fixed_parameter_mem_derived (q : CFSG.PrimePower) (b : fixedField q) :
    longSection (q.Extension 3) 2 false b.val ∈ positiveDerived q := by
  obtain ⟨epsilon,hsign,hword⟩ := long_commutator_sign
  let a : fixedField q := (epsilon : fixedField q)*b
  let g : fixedPositiveRaw q := ⟨longSection (q.Extension 3) 0 false a.val,
    longSection_mem_fixedPositive q 0 a⟩
  let x : fixedPositiveRaw q := ⟨longSection (q.Extension 3) 1 false 1,
    longSection_mem_fixedPositive q 1 1⟩
  have hm := CFSGHomDerivedRange.commutator_mem (fixedPositiveRaw q).subtype g x
  change longSection (q.Extension 3) 0 false a.val * longSection (q.Extension 3) 1 false 1 *
    (longSection (q.Extension 3) 0 false a.val)⁻¹ *
      (longSection (q.Extension 3) 1 false 1)⁻¹ ∈ positiveDerived q at hm
  rw [hword] at hm
  have ha : (epsilon : q.Extension 3)*(a.val*1) = b.val := by
    rcases hsign with rfl | rfl <;> simp [a]
  rwa [ha] at hm

theorem highest_fixed_mem_derived (q : CFSG.PrimePower) (u : Raw (q.Extension 3))
    (hu : u ∈ highestLine (q.Extension 3))
    (hfixed : unitTwist (q.Extension 3) (definingFieldAutomorphism q 3) u = u) :
    u ∈ positiveDerived q := by
  obtain ⟨t,ht⟩ := longParameter_surjective (q.Extension 3) 2 ⟨u,hu⟩
  have he : longSection (q.Extension 3) 2 false t = u := congrArg Subtype.val ht
  have hts : longSection (q.Extension 3) 2 false (definingFieldAutomorphism q 3 t) =
      longSection (q.Extension 3) 2 false t :=
    (highest_long_twist q t).symm.trans
      ((congrArg (unitTwist (q.Extension 3) (definingFieldAutomorphism q 3)) he).trans
        (hfixed.trans he.symm))
  have hf : definingFieldAutomorphism q 3 t = t :=
    (longParameter_bijective (q.Extension 3) 2).1 (Subtype.ext hts)
  rw [← he]
  exact highest_fixed_parameter_mem_derived q ⟨t,hf⟩

end SymmetricSubgroupAsymptotics.CFSGTrialityGeckMiddleHighestDerived
