import SymmetricSubgroupAsymptotics.BinaryPairAffineGeneratorNormalForm
import SymmetricSubgroupAsymptotics.BinaryRegularEightOffsetGauge

/-! The regular K46 affine gauge is bound to the original pair action.
The conclusion is literal point-conjugacy of the whole original source
with the action generated by the same kernel and zero-offset top lifts. -/
set_option autoImplicit false
noncomputable section
namespace SymmetricSubgroupAsymptotics.BinaryPairFrame

variable {X J : Type} {w : ℕ} {U : Subgroup (Equiv.Perm X)}
  (F : BinaryPairFrame U (Fin w))

/-- Source-coordinate orientation gauges give the destination-coordinate
witness required by the actual affine conjugation formula. -/
theorem physical_conjugate_eq_zero_offset_model_of_source_orientation
    (u : J → U)
    (hgen : Subgroup.closure (Set.range fun i => F.top (u i)) = F.top.range)
    (a : Fin w → ZMod 2)
    (hsource : ∀ i, F.offset (u i) + (fun j => a (F.top (u i) j)) - a ∈ F.kernelSpace) :
    U.map (MulAut.conj (F.physicalFlip a)).toMonoidHom =
      F.affineGeneratedModel F.kernelSpace (fun i => F.top (u i)) (fun _ => 0) := by
  apply F.physical_conjugate_eq_affineGeneratedModel u hgen a (fun _ => 0)
  intro i
  have hk := F.kernelTopPermutationSubrepresentation.apply_mem_toSubmodule
    (F.top.rangeRestrict (u i)) (hsource i)
  have he : permutationFunctionRepresentation (ZMod 2) F.top.range (Fin w)
      (F.top.rangeRestrict (u i))
      (F.offset (u i) + (fun j => a (F.top (u i) j)) - a) =
      F.affineTranslation (u i) + a -
        permutationFunctionRepresentation (ZMod 2) F.top.range (Fin w)
          (F.top.rangeRestrict (u i)) a := by
    funext j
    change F.offset (u i) ((F.top (u i))⁻¹ j) +
      a (F.top (u i) ((F.top (u i))⁻¹ j)) - a ((F.top (u i))⁻¹ j) =
      F.offset (u i) ((F.top (u i))⁻¹ j) + a j - a ((F.top (u i))⁻¹ j)
    rw [Equiv.Perm.inv_def, Equiv.apply_symm_apply]
  change permutationFunctionRepresentation (ZMod 2) F.top.range (Fin w)
    (F.top.rangeRestrict (u i))
    (F.offset (u i) + (fun j => a (F.top (u i) j)) - a) ∈ F.kernelSpace at hk
  rw [he] at hk
  simpa only [sub_zero] using hk

end SymmetricSubgroupAsymptotics.BinaryPairFrame

namespace SymmetricSubgroupAsymptotics.BinaryPairFrame

open BinaryRegularEightSquareCarry RegularEightCarries

variable {X : Type} {U : Subgroup (Equiv.Perm X)} (F : BinaryPairFrame U (Fin 8))

/-- The same original regular-top extension becomes the literal zero
model. The only carry premise refers to its actual derived subgroup. -/
theorem regular46_exists_physical_conjugate_zero_offset_model
    (u : Fin 3 → U)
    (hp : ∀ i j, F.top (u i) j = generatorImages i j)
    (hgen : Subgroup.closure (Set.range fun i => F.top (u i)) = F.top.range)
    (hK : F.kernelSpace = K46)
    (hderived : ∀ k : F.top.ker, (k : U) ∈ commutator U → F.bits k ∈ R46) :
    ∃ a : V, U.map (MulAut.conj (F.physicalFlip a)).toMonoidHom =
      F.affineGeneratedModel F.kernelSpace (fun i => F.top (u i)) (fun _ => 0) := by
  have hsquare (i : Fin 3) : squareDisplacement i (actualOffsets F u) ∈ K46 := by
    rw [squareDisplacement_actualOffsets F u hp]
    rw [← hK]
    exact ⟨Additive.ofMul _, rfl⟩
  have hcomm (p : Fin 3) :
      commutatorDisplacement (pairs p).1 (pairs p).2 (actualOffsets F u) ∈ R46 := by
    rw [commutatorDisplacement_actualOffsets F u hp]
    exact hderived _ (F.carryDifference_mem_commutator _ _ _)
  obtain ⟨a, ha⟩ := BinaryRegularEightOffsetGauge.exists_source_orientation
    (actualOffsets F u) hsquare hcomm
  refine ⟨a, F.physical_conjugate_eq_zero_offset_model_of_source_orientation u hgen a ?_⟩
  intro i
  rw [hK]
  have hi := ha i
  rw [offsetProjection_actualOffsets] at hi
  simpa only [hp] using hi

end SymmetricSubgroupAsymptotics.BinaryPairFrame
