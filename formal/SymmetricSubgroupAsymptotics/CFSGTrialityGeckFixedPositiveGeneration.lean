import SymmetricSubgroupAsymptotics.CFSGTrialityGeckFixedHeightPeeling
import SymmetricSubgroupAsymptotics.CFSGNormTwoCoordinatePositiveHeightNormalForm

/-! The entire fixed positive Geck group is generated by the displayed
long and short orbit sections.  The proof peels the actual finite height
filtration using proved fixed representatives, rather than assuming
surjectivity of fixed points onto successive quotient fixed points. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
open scoped Classical
namespace SymmetricSubgroupAsymptotics.CFSGTrialityGeckFixedPositiveGeneration
open CFSGTrialityGeckFixedHeightPeeling CFSGTrialityGeckFixedHeightClassLifting
open CFSGTrialityGeckFixedCoordinateParameters CFSGTrialityGeckFixedCoordinateDecomposition
open CFSGTrialityGeckSectionQuotientCoordinates CFSGTrialityGeckWordCoordinateTwist
open CFSGTrialityGeckWordRootIndex CFSGTrialityGeckHeightQuotientTwist
open CFSGTrialityGeckPositiveTwist CFSGTrialityD4NormTwo
open CFSGFiniteQuotientFamilyProduct CFSGNormTwoCoordinateRootHeightFiltration
open CFSGNormTwoCoordinateRootHeightBound CFSGNormTwoCoordinatePositiveHeightNormalForm

abbrev PositiveGroup (K : Type) [Field K] :=
  CFSGNormTwoCoordinateRootHeightQuotient.PositiveGroup (CartanMatrix.D 4)
    (CartanMatrix.D_diag 4) (CartanMatrix.D_transpose 4) D4_positive_definite
    (CartanMatrix.D_off_diag_nonpos 4) K

def fixedPositive (K : Type) [Field K] [Finite K] (σ : K ≃+* K) :
    Subgroup (PositiveGroup K) :=
  (show PositiveGroup K →* PositiveGroup K from (positiveTwist K σ).toMonoidHom).eqLocus
    (MonoidHom.id (PositiveGroup K))

def sectionGenerated (K : Type) [Field K] [Finite K] (σ : K ≃+* K) :
    Subgroup (PositiveGroup K) :=
  Subgroup.closure {u | (∃ (s : Fin 3) (t : Multiplicative K),σ t.toAdd = t.toAdd ∧
      u = longPositiveSection K s t) ∨
    (∃ (s : Fin 3) (t : Multiplicative K),σ (σ (σ t.toAdd)) = t.toAdd ∧
      u = shortPositiveSection K σ s t)}

theorem sectionGenerated_le_fixed (K : Type) [Field K] [Finite K] (σ : K ≃+* K) :
    sectionGenerated K σ ≤ fixedPositive K σ := by
  apply (Subgroup.closure_le _).mpr
  rintro u (⟨s,t,ht,rfl⟩ | ⟨s,t,ht,rfl⟩)
  · exact longPositiveSection_fixed K σ s t ht
  · exact shortPositiveSection_fixed K σ s t ht

private theorem ordered_mem {G I : Type*} [Group G] [Fintype I]
    (S : Subgroup G) (f : I → G) (hf : ∀ i,f i ∈ S) : orderedFamilyProduct f ∈ S := by
  apply S.list_prod_mem
  intro x hx
  obtain ⟨i,hi,rfl⟩ := List.mem_map.mp hx
  exact hf i

theorem sectionRepresentative_mem_generated (K : Type) [Field K] [Finite K] (σ : K ≃+* K)
    (h : ℤ) (c : WordHeightIndex h → Multiplicative K)
    (hc : coordinateTwist K σ h c = c) :
    (sectionRepresentative K σ h c).val ∈ sectionGenerated K σ := by
  let T := (sectionGenerated K σ).comap (TailInPositive K h).subtype
  have hlong (s : LongAt h) : longTailElement K h c s ∈ T := by
    change (show PositiveGroup K from
      longPositiveSection K s.val (c (longHeightIndex s.val s.property))) ∈ sectionGenerated K σ
    exact Subgroup.subset_closure (Or.inl ⟨s.val,_,
      fixed_long_parameter K σ h c hc s.val s.property,rfl⟩)
  have hshort (s : ShortAt h) : shortTailElement K σ h c s ∈ T := by
    change (show PositiveGroup K from
      shortPositiveSection K σ s.val (c (shortHeightIndex s.val 0 s.property))) ∈
        sectionGenerated K σ
    exact Subgroup.subset_closure (Or.inr ⟨s.val,_,
      fixed_short_parameter_thrice K σ h c hc s.val s.property,rfl⟩)
  exact T.mul_mem (ordered_mem T _ hlong) (ordered_mem T _ hshort)

theorem first_tail_eq_top (K : Type) [Field K] : TailInPositive K 1 = ⊤ := by
  apply le_antisymm le_top
  intro u hu
  change u.val ∈ heightTail (CartanMatrix.D 4) (CartanMatrix.D_diag 4)
    (CartanMatrix.D_transpose 4) D4_positive_definite (CartanMatrix.D_off_diag_nonpos 4) K 1
  rw [heightTail_one_eq_positive]
  exact u.property

theorem terminal_tail_eq_bot (K : Type) [Field K] :
    TailInPositive K ((rootHeightBound (CartanMatrix.D 4) : ℤ) + 1) = ⊥ := by
  apply le_antisymm
  · intro u hu
    change u.val ∈ heightTail (CartanMatrix.D 4) (CartanMatrix.D_diag 4)
      (CartanMatrix.D_transpose 4) D4_positive_definite (CartanMatrix.D_off_diag_nonpos 4)
      K ((rootHeightBound (CartanMatrix.D 4) : ℤ) + 1) at hu
    rw [final_heightTail_eq_bot,Subgroup.mem_bot] at hu
    apply Subtype.ext
    exact hu
  · exact bot_le

theorem fixedPositive_eq_sectionGenerated (K : Type) [Field K] [Finite K] (σ : K ≃+* K) :
    fixedPositive K σ = sectionGenerated K σ := by
  apply le_antisymm
  · let B := rootHeightBound (CartanMatrix.D 4)
    have hall : ∀ m n : ℕ,m+n = B → ∀ u : PositiveGroup K,
        u ∈ TailInPositive K ((n : ℤ) + 1) → positiveTwist K σ u = u →
        u ∈ sectionGenerated K σ := by
      intro m
      induction m with
      | zero =>
        intro n hn u hu hfix
        have hnB : n = B := by omega
        rw [hnB,terminal_tail_eq_bot,Subgroup.mem_bot] at hu
        rw [hu]
        exact (sectionGenerated K σ).one_mem
      | succ m ih =>
        intro n hn u hu hfix
        obtain ⟨c,hc,v,hv,hvf,he⟩ :=
          exists_fixed_height_factor K σ ((n : ℤ) + 1) (by omega) u hu hfix
        have hnext : v ∈ TailInPositive K (((n + 1 : ℕ) : ℤ) + 1) := by
          simpa only [Nat.cast_add,Nat.cast_one] using hv
        have hvg := ih (n+1) (by omega) v hnext hvf
        rw [he]
        exact (sectionGenerated K σ).mul_mem
          (sectionRepresentative_mem_generated K σ _ c hc) hvg
    intro u hu
    exact hall B 0 (by omega) u (by
      change u ∈ TailInPositive K 1
      rw [first_tail_eq_top]
      exact Subgroup.mem_top u) hu
  · exact sectionGenerated_le_fixed K σ

end SymmetricSubgroupAsymptotics.CFSGTrialityGeckFixedPositiveGeneration
