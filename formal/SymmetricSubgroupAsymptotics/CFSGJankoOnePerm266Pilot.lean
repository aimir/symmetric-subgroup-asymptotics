import SymmetricSubgroupAsymptotics.FiniteRawPermutationReflection

/-! ONE bounded pilot: genuine explicit Perm266 tables, one whole first
relator a^2=1, and one moved point. No other original relator is proved here.
Generated data are not proof until the primary capped kernel check passes. -/
set_option autoImplicit false
set_option Elab.async false
namespace SymmetricSubgroupAsymptotics.CFSGJankoOnePerm266Pilot
open FiniteRawPermutationReflection SignedPermutationWordPointEvaluation

def packedGet (row p : ℕ) : ℕ := row / 2 ^ (9 * p) % 512

private def aForwardCode : ℕ := 

private def aInverseCode : ℕ := 

private def bForwardCode : ℕ := 

private def bInverseCode : ℕ := 

def af (p : ℕ) : ℕ := packedGet aForwardCode p
def ai (p : ℕ) : ℕ := packedGet aInverseCode p
def bf (p : ℕ) : ℕ := packedGet bForwardCode p
def bi (p : ℕ) : ℕ := packedGet bInverseCode p

theorem a_inverse_check : inverseCheck 266 af ai = true := by decide +kernel
theorem b_inverse_check : inverseCheck 266 bf bi = true := by decide +kernel

theorem a_valid : Valid 266 af ai := valid_of_inverseCheck a_inverse_check
theorem b_valid : Valid 266 bf bi := valid_of_inverseCheck b_inverse_check

def a : Equiv.Perm (Fin 266) := permutation a_valid
def b : Equiv.Perm (Fin 266) := permutation b_valid

theorem first_relator_check : wordCheck 266 af ai bf bi [Letter.first, Letter.first] = true := by
  decide +kernel

theorem a_square : a ^ 2 = 1 := by
  have h := eval_eq_one_of_wordCheck a_valid b_valid
    [Letter.first, Letter.first] first_relator_check
  simp only [eval, value, mul_one] at h
  change a * a = 1 at h
  simpa only [pow_two] using h

theorem a_zero_value : (a 0).val = 238 := by
  change af 0 = 238
  decide +kernel

theorem a_ne_one : a ≠ 1 := by
  intro h
  have hm := congrArg (fun u : Equiv.Perm (Fin 266) => (u 0).val) h
  change (a 0).val = 0 at hm
  rw [a_zero_value] at hm
  exact (by decide : (238 : ℕ) ≠ 0) hm

end SymmetricSubgroupAsymptotics.CFSGJankoOnePerm266Pilot
