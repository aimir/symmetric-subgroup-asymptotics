import SymmetricSubgroupAsymptotics.BinaryPairSplitAffineRows
import SymmetricSubgroupAsymptotics.BinaryCoordinateSpaces

/-! A full original zero model is generated by literal kernel basis flips
and zero lifts of top generators. Sparse words for those basis flips suffice;
no multiplication table or full list of original source elements is needed. -/
set_option autoImplicit false
noncomputable section
namespace SymmetricSubgroupAsymptotics.BinaryPairFrame

variable {X : Type} {w : ℕ} {U : Subgroup (Equiv.Perm X)}
    (F : BinaryPairFrame U (Fin w))

/-- Literal zero-offset lifts multiply without introducing kernel shifts. -/
def zeroTopPermutationHom : Equiv.Perm (Fin w) →* Equiv.Perm X where
  toFun t := F.affinePermutation t 0
  map_one' := by
    apply Equiv.ext
    intro x
    obtain ⟨⟨i,b⟩,rfl⟩ := F.frame.surjective x
    rw [F.affinePermutation_apply_frame]
    simp
  map_mul' t s := by
    rw [F.affinePermutation_mul_formula]
    rfl

@[simp] theorem physicalFlip_zero_eq_one : F.physicalFlip 0 = 1 :=
  F.zeroTopPermutationHom.map_one

theorem physicalFlip_add_eq_mul (a b : Fin w → ZMod 2) :
    F.physicalFlip (a+b) = F.physicalFlip a * F.physicalFlip b := by
  exact (F.affinePermutation_mul_formula 1 1 a b).symm

/-- Original flips which lie in a supplied original ambient subgroup form
an actual binary submodule, so containment is certified on a vector basis. -/
def physicalFlipSubmodule (C : Subgroup (Equiv.Perm X)) :
    Submodule (ZMod 2) (Fin w → ZMod 2) where
  carrier := {a | F.physicalFlip a ∈ C}
  zero_mem' := by
    change F.physicalFlip 0 ∈ C
    rw [F.physicalFlip_zero_eq_one]
    exact C.one_mem
  add_mem' := by
    intro a b ha hb
    change F.physicalFlip (a+b) ∈ C
    rw [F.physicalFlip_add_eq_mul]
    exact C.mul_mem ha hb
  smul_mem' := by
    intro c a ha
    fin_cases c
    · change F.physicalFlip (0 • a) ∈ C
      rw [zero_smul,F.physicalFlip_zero_eq_one]
      exact C.one_mem
    · change F.physicalFlip (1 • a) ∈ C
      simpa only [one_smul] using ha

/-- Kernel basis words and top generator words cover the whole literal
zero model, including all correlated original kernel coordinates. -/
theorem splitAffineAction_le_of_kernel_basis_and_top {J : Type} {d : ℕ}
    (C : Subgroup (Equiv.Perm X)) (K : BinaryCoordinateSpace w d)
    (hK : F.kernelSpace = K.space)
    (t : J → Equiv.Perm (Fin w))
    (ht : Subgroup.closure (Set.range t) = F.top.range)
    (hflip : ∀ j, F.physicalFlip (K.inclusion (Pi.single j 1)) ∈ C)
    (htop : ∀ j, F.affinePermutation (t j) 0 ∈ C) : F.splitAffineAction ≤ C := by
  have hk : F.kernelSpace ≤ F.physicalFlipSubmodule C := by
    rw [hK]
    exact K.le_of_basis_mem _ hflip
  have htop' : F.top.range ≤ C.comap F.zeroTopPermutationHom := by
    rw [← ht]
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨j,rfl⟩
    exact htop j
  apply (Subgroup.closure_le _).mpr
  rintro _ ⟨s,a,ha,rfl⟩
  have he : F.physicalFlip a * F.affinePermutation s.val 0 = F.affinePermutation s.val a := by
    simpa only [add_zero] using F.physicalFlip_mul_affinePermutation a 0 s.val
  rw [← he]
  exact C.mul_mem (hk ha) (htop' s.property)

end SymmetricSubgroupAsymptotics.BinaryPairFrame
