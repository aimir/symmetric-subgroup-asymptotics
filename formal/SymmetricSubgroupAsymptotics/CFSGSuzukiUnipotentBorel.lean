import SymmetricSubgroupAsymptotics.CFSGSuzukiUnipotentGroup
import SymmetricSubgroupAsymptotics.CFSGUpperTriangularSoluble

/-! The actual subgroup generated by the pinned Suzuki unipotents and tori
is soluble. We retain it as a literal subgroup of the original GL(4), using
the displayed reversal matrix to give a faithful upper-triangular action.
No assertion about the whole Suzuki group or its order is used. -/
set_option autoImplicit false
noncomputable section
open scoped Classical BigOperators
namespace SymmetricSubgroupAsymptotics.CFSGSuzukiUnipotent
open Matrix CFSG.Models.SuzukiConstruction

private def upperMatrixGroup (K : Type*) [Field K] (n : ℕ) :
    Subgroup (Matrix.GeneralLinearGroup (Fin n) K) where
  carrier := {A | (A : Matrix (Fin n) (Fin n) K).BlockTriangular id}
  one_mem' := Matrix.blockTriangular_one
  mul_mem' := fun hA hB => hA.mul hB
  inv_mem' := by
    intro A hA
    letI suzukiBorel_matrixInvertible : Invertible (A : Matrix (Fin n) (Fin n) K) := A.invertible
    have hi : (A : Matrix (Fin n) (Fin n) K)⁻¹ =
        ((A⁻¹ : Matrix.GeneralLinearGroup (Fin n) K) : Matrix (Fin n) (Fin n) K) :=
      Matrix.inv_eq_left_inv (congrArg (fun g : Matrix.GeneralLinearGroup (Fin n) K =>
        (g : Matrix (Fin n) (Fin n) K)) (inv_mul_cancel A))
    have h := Matrix.blockTriangular_inv_of_blockTriangular hA
    rw [hi] at h
    exact h

private def reversal (m : ℕ) : Ambient m :=
  ⟨weyl m, weyl m, weyl_sq m, weyl_sq m⟩

private theorem reversal_sq (m : ℕ) : reversal m * reversal m = 1 := by
  apply Units.ext
  exact weyl_sq m

private theorem reversal_inv (m : ℕ) : (reversal m)⁻¹ = reversal m :=
  inv_eq_of_mul_eq_one_right (reversal_sq m)

private theorem weyl_unipotent_upper (m : ℕ) (a b : CFSG.Models.SuzukiConstruction.Field m) :
    (weyl m * unipotent m a b * weyl m).BlockTriangular id := by
  intro i j hij
  change j < i at hij
  fin_cases i <;> fin_cases j <;>
    simp_all [weyl, unipotent, Matrix.mul_apply, Fin.sum_univ_succ]

private theorem weyl_torus_upper (m : ℕ) (c : (CFSG.Models.SuzukiConstruction.Field m)ˣ) :
    (weyl m * torus m c * weyl m).BlockTriangular id := by
  intro i j hij
  change j < i at hij
  fin_cases i <;> fin_cases j <;>
    simp_all [weyl, torus, Matrix.mul_apply, Fin.sum_univ_succ, Matrix.vecMul_diagonal]

def borelEnvelope (m : ℕ) : Subgroup (Ambient m) :=
  Subgroup.closure ((unipotentSubgroup m : Set (Ambient m)) ∪
    {g | ∃ c : (CFSG.Models.SuzukiConstruction.Field m)ˣ, (g : Mat m) = torus m c})

theorem unipotentSubgroup_le_borelEnvelope (m : ℕ) :
    unipotentSubgroup m ≤ borelEnvelope m :=
  fun _ hg => Subgroup.subset_closure (Or.inl hg)

theorem torus_mem_borelEnvelope (m : ℕ) (g : Ambient m)
    (c : (CFSG.Models.SuzukiConstruction.Field m)ˣ) (hg : (g : Mat m) = torus m c) :
    g ∈ borelEnvelope m := Subgroup.subset_closure (Or.inr ⟨c, hg⟩)

theorem borelEnvelope_le_model (m : ℕ) : borelEnvelope m ≤ subgroup m := by
  apply (Subgroup.closure_le _).mpr
  intro g hg
  rcases hg with hu | ⟨c, hc⟩
  · exact unipotentSubgroup_le_model m hu
  · exact Subgroup.subset_closure (Or.inr (Or.inl ⟨c, hc⟩))

theorem borelEnvelope_soluble (m : ℕ) : IsSolvable (borelEnvelope m) := by
  let e := MulAut.conj (reversal m)
  have hle : borelEnvelope m ≤ (upperMatrixGroup (CFSG.Models.SuzukiConstruction.Field m) 4).comap
      e.toMonoidHom := by
    apply (Subgroup.closure_le _).mpr
    intro g hg
    change (((reversal m * g) * (reversal m)⁻¹ : Ambient m) : Mat m).BlockTriangular id
    rw [reversal_inv]
    rcases hg with hu | ⟨c, hc⟩
    · obtain ⟨a, b, rfl⟩ := hu
      exact weyl_unipotent_upper m a b
    · change (weyl m * (g : Mat m) * weyl m).BlockTriangular id
      rw [hc]
      exact weyl_torus_upper m c
  let rho : borelEnvelope m →* Mat m :=
    (Units.coeHom (Mat m)).comp (e.toMonoidHom.comp (borelEnvelope m).subtype)
  apply CFSGUpperUnitriangular.soluble_of_faithful_upper_matrix
    (CFSG.Models.SuzukiConstruction.Field m) 4 (borelEnvelope m) rho
  · intro x y h
    apply Subtype.ext
    apply e.injective
    exact Units.ext h
  · intro g
    exact hle g.property

end SymmetricSubgroupAsymptotics.CFSGSuzukiUnipotent
