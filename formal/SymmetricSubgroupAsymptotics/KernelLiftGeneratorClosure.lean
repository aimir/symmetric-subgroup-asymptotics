import Mathlib.Algebra.Group.Subgroup.Ker

/-! The literal image of a group is generated by its actual homomorphism
kernel together with any original lifts of quotient generators. -/
set_option autoImplicit false
noncomputable section
namespace SymmetricSubgroupAsymptotics

variable {G Q H J : Type} [Group G] [Group Q] [Group H]

/-- This is an equality of actual subgroups in the displayed ambient H;
it does not replace the original source by an abstract extension. -/
theorem range_eq_closure_kernel_and_actual_lifts
    (f : G →* Q) (j : G →* H) (u : J → G)
    (hgen : Subgroup.closure (Set.range fun i => f (u i)) = ⊤) :
    j.range = Subgroup.closure
      (Set.range (fun k : f.ker => j (k : G)) ∪ Set.range fun i => j (u i)) := by
  let C := Subgroup.closure
    (Set.range (fun k : f.ker => j (k : G)) ∪ Set.range fun i => j (u i))
  have hker : f.ker ≤ C.comap j := by
    intro k hk
    exact Subgroup.subset_closure (Or.inl ⟨⟨k, hk⟩, rfl⟩)
  have hmap : (C.comap j).map f = ⊤ := by
    apply top_unique
    rw [← hgen]
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨i, rfl⟩
    exact ⟨u i, Subgroup.subset_closure (Or.inr ⟨i, rfl⟩), rfl⟩
  apply le_antisymm
  · rintro _ ⟨g, rfl⟩
    obtain ⟨a, ha, he⟩ :=
      show f g ∈ (C.comap j).map f by rw [hmap]; trivial
    have hk : g * a⁻¹ ∈ f.ker := by
      change f (g * a⁻¹) = 1
      rw [map_mul, map_inv, he, mul_inv_cancel]
    have hg : (g * a⁻¹) * a ∈ C.comap j :=
      (C.comap j).mul_mem (hker hk) ha
    simpa only [inv_mul_cancel_right] using hg
  · apply (Subgroup.closure_le _).mpr
    rintro h (⟨k, rfl⟩ | ⟨i, rfl⟩)
    · exact ⟨(k : G), rfl⟩
    · exact ⟨u i, rfl⟩

end SymmetricSubgroupAsymptotics
