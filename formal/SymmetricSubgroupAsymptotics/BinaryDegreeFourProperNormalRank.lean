import SymmetricSubgroupAsymptotics.BinaryTransitiveProperNormalQuarterPlusOne
import Mathlib.Data.Fintype.Perm

/-! The first proper-normal sharp base is intrinsic: an original
transitive four-point binary group has no excessive proper normal.
No finite catalogue or published excess classification is used. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open scoped Classical

namespace SymmetricSubgroupAsymptotics

/-- A proper subgroup of a group of order at most two is trivial even for
ambient normal generation. This uses the literal subgroup index. -/
theorem normalGen_eq_zero_of_proper_card_le_two
    {G : Type} [Group G] [Finite G] (hcard : Nat.card G ≤ 2)
    (N : Subgroup G) [N.Normal] (hproper : N ≠ ⊤) :
    MarkedC4.normalGen N = 0 := by
  have hind : 2 ≤ N.index := N.one_lt_index_of_ne_top hproper
  have hm := N.card_mul_index
  have hpos : 0 < Nat.card N := Nat.card_pos
  have hN : Nat.card N ≤ 1 := by nlinarith
  have hp := MarkedC4.ActualNormalGeneratorDensity.two_pow_normalGen_le_card N
  have hpzero : 2 ^ MarkedC4.normalGen N ≤ 2 ^ 0 := by
    simpa only [pow_zero] using hp.trans hN
  have hzero := (Nat.pow_le_pow_iff_right (by decide : 1 < 2)).mp hpzero
  omega

/-- Every literal proper normal in an original transitive four-point
binary action is generated by at most one ambient normal generator. -/
theorem twoGroup_transitive_degree_four_proper_normalGen_le_one
    {X : Type} [Finite X] (hX : Nat.card X = 4)
    (U : Subgroup (Equiv.Perm X)) [MulAction.IsPretransitive U X]
    (hU : IsPGroup 2 U) (N : Subgroup U) [N.Normal] (hproper : N ≠ ⊤) :
    MarkedC4.normalGen N ≤ 1 := by
  letI : Nontrivial X := Finite.one_lt_card_iff_nontrivial.mp (by omega)
  let x : X := Classical.choice inferInstance
  obtain ⟨D⟩ := transitiveBinaryPairCover_nonempty U hU x
  have hact : ∀ (u : U) (i : D.Points), u • i = D.frame.top u i := fun _ _ => rfl
  have hdegree := D.degree_product
  have hpoints : Nat.card D.Points = 2 := by omega
  letI : Nontrivial D.Points := Finite.one_lt_card_iff_nontrivial.mp (by omega)
  let f := D.frame.top.rangeRestrict
  letI : (N.map f).Normal := Subgroup.Normal.map inferInstance f
    D.frame.top.rangeRestrict_surjective
  by_cases hfull : N.map f = ⊤
  · have hsave := D.frame.normalGen_add_one_le_top_of_full_actual_image hU N hfull hproper
    have hNp : IsPGroup 2 (⊤ : Subgroup U) := hU.to_subgroup ⊤
    have hhalf := (MarkedC4.normalGen_normalSubgroup_le_primeCharacterRank
      2 (⊤ : Subgroup U) hNp).trans
      (permutationTwoGroup_primeCharacterRank_le (⊤ : Subgroup U) X hNp)
    omega
  · have htopcard : Nat.card D.Top ≤ 2 := by
      have hh := Subgroup.card_le_card_group D.Top
      rw [Nat.card_perm, hpoints] at hh
      exact hh
    have hz := normalGen_eq_zero_of_proper_card_le_two htopcard (N.map f) hfull
    have hu : UniformSubrepresentationGeneratorBound
        (permutationFunctionRepresentation (ZMod 2) U D.Points) 1 := by
      letI := Fintype.ofFinite D.Points
      apply pGroup_uniformSubrepresentationGeneratorBound_of_head_le hU
      intro M
      have hh := pGroup_permutationSubrepresentationHead_le_div hU M
      simpa only [hpoints] using hh
    have hb := D.frame.normalGen_le_uniform_add_actual_top hact 1 hu N
    change MarkedC4.normalGen N ≤ 1 + MarkedC4.normalGen (N.map f) at hb
    omega

end SymmetricSubgroupAsymptotics
