import SymmetricSubgroupAsymptotics.PermutationPolynomialOrbitGenerators
import SymmetricSubgroupAsymptotics.TransitiveInducedDerangementHead
import Mathlib.GroupTheory.OrderOfElement

/-! Every invariant subspace of a nontrivial transitive permutation
module is generated by at most half the point degree, over any field.
One actual derangement supplies cyclic orbits of size at least two;
the polynomial-ring PID argument works also in defining characteristic.
No invertible-order, semisimplicity or finite vector census is assumed. -/
set_option autoImplicit false
noncomputable section
open scoped Classical
namespace SymmetricSubgroupAsymptotics.TransitivePermutationModuleGenerators

variable {G X : Type} [Group G] [Finite G] [Finite X] [MulAction G X]

/-- Choose one point from each literal cyclic orbit. Finite group order
turns its original integer-power orbit into a nonnegative-power cover. -/
theorem cyclic_orbit_cover (g : G) :
    ∃ representative : Fin (Nat.card (MulAction.orbitRel.Quotient (Subgroup.zpowers g) X)) → X,
      ∀ x : X, ∃ (j : Fin (Nat.card (MulAction.orbitRel.Quotient (Subgroup.zpowers g) X)))
        (m : ℕ), g ^ m • representative j = x := by
  let O := MulAction.orbitRel.Quotient (Subgroup.zpowers g) X
  let e : O ≃ Fin (Nat.card O) := Finite.equivFin O
  let representative : Fin (Nat.card O) → X := fun j => (e.symm j).out
  refine ⟨representative, ?_⟩
  intro x
  let q : O := Quotient.mk (MulAction.orbitRel (Subgroup.zpowers g) X) x
  have he : Quotient.mk (MulAction.orbitRel (Subgroup.zpowers g) X)
      (representative (e q)) = q := by
    change Quotient.mk _ ((e.symm (e q)).out) = q
    rw [e.symm_apply_apply]
    exact Quotient.out_eq q
  have hrel : MulAction.orbitRel (Subgroup.zpowers g) X x (representative (e q)) :=
    Quotient.exact he.symm
  obtain ⟨u,hu⟩ := MulAction.mem_orbit_iff.mp (MulAction.orbitRel_apply.mp hrel)
  obtain ⟨m,_,hm⟩ := Finset.mem_image.mp
    (mem_zpowers_iff_mem_range_orderOf.mp u.property)
  refine ⟨e q,m,?_⟩
  change g ^ m • representative (e q) = x
  rw [hm]
  exact hu

/-- Any actual derangement uniformly generates every permutation
subrepresentation with at most floor(degree/2) vectors. -/
theorem uniform_of_derangement (k : Type) [Field k] [Nonempty X]
    (g : G) (hfree : MulAction.fixedBy X g = ∅) :
    UniformSubrepresentationGeneratorBound (permutationFunctionRepresentation k G X)
      (Nat.card X / 2) := by
  letI : Fintype X := Fintype.ofFinite X
  obtain ⟨representative,hcover⟩ := cyclic_orbit_cover (X:=X) g
  let O := MulAction.orbitRel.Quotient (Subgroup.zpowers g) X
  have hc : Nat.card O ≤ Nat.card X / 2 := by
    have hh := cyclicOrbitCount_mul_two_le_of_fixedBy_eq_empty g hfree
    change Nat.card O * 2 ≤ Nat.card X at hh
    omega
  let e : Fin (Nat.card O) ↪ Fin (Nat.card X / 2) := Fin.castLEEmb hc
  let padded : Fin (Nat.card X / 2) → X :=
    Function.extend e representative (fun _ => Classical.choice inferInstance)
  apply permutationFunctionRepresentation_uniform_of_polynomial_orbitCover g padded
  intro x
  obtain ⟨j,m,hm⟩ := hcover x
  refine ⟨e j,m,?_⟩
  change g ^ m • Function.extend e representative _ (e j) = x
  rw [e.injective.extend_apply]
  exact hm

/-- A finite transitive point action of degree at least two supplies
its own derangement. The conclusion holds in every characteristic. -/
theorem uniform_of_transitive (k : Type) [Field k] [Nontrivial X]
    [MulAction.IsPretransitive G X] :
    UniformSubrepresentationGeneratorBound (permutationFunctionRepresentation k G X)
      (Nat.card X / 2) := by
  obtain ⟨g,hg⟩ := exists_fixedBy_eq_empty_of_pretransitive G X
  exact uniform_of_derangement k g hg

end SymmetricSubgroupAsymptotics.TransitivePermutationModuleGenerators
