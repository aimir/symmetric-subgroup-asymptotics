import SymmetricSubgroupAsymptotics.CFSGReeFFourFixedWordPairedSigns
import SymmetricSubgroupAsymptotics.CFSGReeFFourPairedWordActions
import SymmetricSubgroupAsymptotics.CFSGReeFFourPairedInversionDescent

/-! The word action in a genuinely exceptional-fixed original cell is
generated by the two actual paired words. Strong induction uses their
strict three/six inversion drops and preserves only the proved reversed-
letter action invariant. No intermediate fixed-cell lift is required. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
open scoped Classical
namespace SymmetricSubgroupAsymptotics.CFSGReeFFourFixedWordClassification
open CFSGReeFFourFieldParameters CFSGReeFFourOriginalAutomorphism
open CFSGReeFFourOriginalWeylWords CFSGFFourOriginalBruhatCells
open CFSGReeFFourFixedCellWordAction CFSGReeFFourFixedWordPairedSigns
open CFSGReeFFourPairedDescentPrefixes CFSGReeFFourPairedWordActions
open CFSGReeFFourPairedInversionDescent CFSGTwistedE6WeylChamber
open CFSGTwistedE6RelativeWeylOrbits CFSGTwistedE6FixedWordClassification

def expandPaired : List Bool→List (Fin 4)
  | []=>[]
  | b::s=>pairedRelativeWord b++expandPaired s

theorem expandPaired_append (s t : List Bool) :
    expandPaired (s++t)=expandPaired s++expandPaired t := by
  induction s with
  | nil=>rfl
  | cons b s ih=>simp only [List.cons_append,expandPaired,ih,List.append_assoc]

theorem exists_paired_negative_support (m : ℕ) (r : List (Fin 4))
    (hr : ∀k,rootAction (expandRelative (r.map CFSG.Models.reverseNode)) k=
      rootAction (expandRelative r) k)
    (hv : linearAction (expandRelative r)≠1) :
    ∃middle,∀i∈pairedSupport middle,∀j,(rootAction (expandRelative r)
      (CFSGExceptionalNormTwoBases.E6Index i)).val j≤0 := by
  obtain ⟨a,ha⟩ := exists_negative_orbit (expandRelative r) hv (relative_root_action_commutes r)
  have hp := negative_partner_of_reversed_word_action m r a hr ha
  fin_cases a
  · refine ⟨false,?_⟩
    intro i hi
    change i∈[0,1,5] at hi
    simp only [List.mem_cons,List.mem_nil_iff,or_false] at hi
    rcases hi with rfl|rfl|rfl
    · exact ha 0 (by decide)
    · exact hp 1 (by decide)
    · exact ha 5 (by decide)
  · refine ⟨true,?_⟩
    intro i hi
    change i∈[2,3,4] at hi
    simp only [List.mem_cons,List.mem_nil_iff,or_false] at hi
    rcases hi with rfl|rfl|rfl
    · exact ha 2 (by decide)
    · exact hp 3 (by decide)
    · exact ha 4 (by decide)
  · refine ⟨true,?_⟩
    intro i hi
    change i∈[2,3,4] at hi
    simp only [List.mem_cons,List.mem_nil_iff,or_false] at hi
    rcases hi with rfl|rfl|rfl
    · exact hp 2 (by decide)
    · exact ha 3 (by decide)
    · exact hp 4 (by decide)
  · refine ⟨false,?_⟩
    intro i hi
    change i∈[0,1,5] at hi
    simp only [List.mem_cons,List.mem_nil_iff,or_false] at hi
    rcases hi with rfl|rfl|rfl
    · exact hp 0 (by decide)
    · exact ha 1 (by decide)
    · exact hp 5 (by decide)

theorem exists_paired_word_action (m : ℕ) (r : List (Fin 4))
    (hr : ∀k,rootAction (expandRelative (r.map CFSG.Models.reverseNode)) k=
      rootAction (expandRelative r) k) :
    ∃s : List Bool,linearAction (expandRelative r)=linearAction (expandRelative (expandPaired s)) := by
  suffices ∀n : ℕ,∀v : List (Fin 4),wordInversions (expandRelative v)=n→
      (∀k,rootAction (expandRelative (v.map CFSG.Models.reverseNode)) k=
        rootAction (expandRelative v) k)→
      ∃s : List Bool,linearAction (expandRelative v)=
        linearAction (expandRelative (expandPaired s)) by
    exact this (wordInversions (expandRelative r)) r rfl hr
  intro n
  induction n using Nat.strong_induction_on with
  | h n ih=>
    intro v hn hv
    by_cases hlin : linearAction (expandRelative v)=1
    · exact ⟨[],hlin⟩
    obtain ⟨middle,hnegative⟩ := exists_paired_negative_support m v hv hlin
    let v' := v++pairedRelativeWord middle
    have hexpand : expandRelative v'=expandRelative v++pairedWord middle := by
      change expandRelative (v++pairedRelativeWord middle)=_
      rw [expandRelative_append,expand_pairedRelativeWord]
    have hv' : ∀k,rootAction (expandRelative (v'.map CFSG.Models.reverseNode)) k=
        rootAction (expandRelative v') k := reversed_word_action_append v middle hv
    have hlt : wordInversions (expandRelative v')<n := by
      have hdrop := paired_inversion_drop (expandRelative v) middle hnegative
      have hlength : 0<(pairedWord middle).length := by cases middle <;> decide
      rw [hexpand]
      omega
    obtain ⟨s,hs⟩ := ih (wordInversions (expandRelative v')) hlt v' rfl hv'
    refine ⟨s++[middle],?_⟩
    have hfactor : linearAction (expandRelative v)=
        linearAction (expandRelative v')*linearAction (pairedWord middle) := by
      rw [hexpand,linearAction_append,mul_assoc,paired_linear_square,mul_one]
    rw [hfactor,hs,expandPaired_append,expandRelative_append,linearAction_append]
    simp only [expandPaired,List.append_nil,expand_pairedRelativeWord]

theorem exists_fixed_cell_paired_action (m : ℕ) (r : List (Fin 4))
    (b c : CFSG.Models.Chevalley.Model CartanMatrix.F₄ (Field m))
    (hb : b∈modelEnvelope (Field m)) (hc : c∈modelEnvelope (Field m))
    (hfix : reeAutomorphism m (b*modelWeylWord (Field m) r*c)=b*modelWeylWord (Field m) r*c) :
    ∃s : List Bool,linearAction (expandRelative r)=linearAction (expandRelative (expandPaired s)) :=
  exists_paired_word_action m r (fixed_cell_root_action m r b c hb hc hfix)

end SymmetricSubgroupAsymptotics.CFSGReeFFourFixedWordClassification
