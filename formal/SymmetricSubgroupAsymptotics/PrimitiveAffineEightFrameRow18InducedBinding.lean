      localRepresentation (sourceLocalMap (twist j a))
        (fun q ↦ (Pi.single k (1 : ZMod 2) : Fin 16 → ZMod 2)
          (CoinducedLeadingCoordinates.label (next j a) q)) i := by
  native_decide

private theorem generatorFormula : ∀ (j : Fin 9)
    (v : PrimitiveAffineEightFrameRow18ModuleRepresentation.ModelModule) (a : Fin 8) (i : Fin 2),
    PrimitiveAffineEightFrameRow18ModuleRepresentation.representation (PrimitiveAffineEightFrameTop10TopCertificate.ambient j) v
