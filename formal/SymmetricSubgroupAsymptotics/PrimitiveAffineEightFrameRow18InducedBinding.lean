      localRepresentation (sourceLocalMap (twist j a))
        (fun q ↦ v (CoinducedLeadingCoordinates.label (next j a) q)) i := by
  exact binaryFrameGeneratorFormula_of_basis
    PrimitiveAffineEightFrameRow18ModuleRepresentation.representation localRepresentation
    PrimitiveAffineEightFrameTop10TopCertificate.ambient (fun j a ↦ sourceLocalMap (twist j a)) next
    generatorFormula_basis

theorem representation_generator_formula (j : Fin 9)
    (v : PrimitiveAffineEightFrameRow18ModuleRepresentation.ModelModule)
    (a : Fin 8) (i : Fin 2) :
    PrimitiveAffineEightFrameRow18ModuleRepresentation.representation (PrimitiveAffineEightFrameTop10TopCertificate.ambient j) v
        (CoinducedLeadingCoordinates.label a i) =
      localRepresentation (sourceLocalMap (twist j a))
