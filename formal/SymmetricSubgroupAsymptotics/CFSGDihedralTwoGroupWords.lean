import Mathlib.GroupTheory.PGroup
import Mathlib.GroupTheory.Subgroup.Centralizer
import Mathlib.Algebra.Group.Conj
import Mathlib.Tactic.Group

/-! A genuine two-group generated by three actual involutions: two
generate a dihedral group with rotation exponent dividing four, and the
third commutes with both. This supplies a uniform Sylow seed for the
alternating reflection/cross-swap construction without finite tables. -/
set_option autoImplicit false
noncomputable section

namespace SymmetricSubgroupAsymptotics.CFSGDihedralTwoGroupWords

variable {G : Type*} [Group G]

theorem zpowers_isPGroup_of_pow (r : G) (n : ℕ) (hr : r ^ (2 ^ n) = 1) :
    IsPGroup 2 (Subgroup.zpowers r) := by
  rintro ⟨x, hx⟩
  refine ⟨n, Subtype.ext ?_⟩
  obtain ⟨z, rfl⟩ := Subgroup.mem_zpowers_iff.mp hx
  change (r ^ z) ^ (2 ^ n) = 1
  calc
    (r ^ z) ^ (2 ^ n) = r ^ (z * (2 ^ n : ℕ)) := by
      rw [zpow_mul, zpow_natCast]
    _ = r ^ ((2 ^ n : ℕ) * z) := congrArg (r ^ ·) (mul_comm _ _)
    _ = (r ^ (2 ^ n)) ^ z := by rw [zpow_mul, zpow_natCast]
    _ = 1 := by rw [hr, one_zpow]

theorem normalizes_zpowers_of_inverts (p r : G) (h : p * r * p⁻¹ = r⁻¹) :
    p ∈ Subgroup.normalizer (Subgroup.zpowers r : Set G) := by
  apply Subgroup.mem_normalizer_iff_conj_image_eq.mpr
  have hm : (Subgroup.zpowers r).map (MulAut.conj p).toMonoidHom = Subgroup.zpowers r := by
    rw [MonoidHom.map_zpowers]
    change Subgroup.zpowers (p * r * p⁻¹) = Subgroup.zpowers r
    rw [h, Subgroup.zpowers_inv]
  exact congrArg (fun H : Subgroup G => (H : Set G)) hm

theorem closure_three_involutions_isPGroup (p q a : G)
    (hp : p ^ 2 = 1) (hq : q ^ 2 = 1) (ha : a ^ 2 = 1)
    (hr : (p * q) ^ 4 = 1) (hap : Commute a p) (haq : Commute a q) :
    IsPGroup 2 (Subgroup.closure ({p, q, a} : Set G)) := by
  have hpp : p * p = 1 := by simpa only [pow_two] using hp
  have hqq : q * q = 1 := by simpa only [pow_two] using hq
  have hpi : p⁻¹ = p := inv_eq_of_mul_eq_one_right hpp
  have hqi : q⁻¹ = q := inv_eq_of_mul_eq_one_right hqq
  let R := Subgroup.zpowers (p * q)
  let D := Subgroup.zpowers p ⊔ R
  have hp2 : IsPGroup 2 (Subgroup.zpowers p) :=
    zpowers_isPGroup_of_pow p 1 (by simpa using hp)
  have hr2 : IsPGroup 2 R :=
    zpowers_isPGroup_of_pow (p * q) 2 (by simpa using hr)
  have hpN : Subgroup.zpowers p ≤ Subgroup.normalizer (R : Set G) := by
    apply Subgroup.zpowers_le.mpr
    apply normalizes_zpowers_of_inverts
    calc
      p * (p * q) * p⁻¹ = (p * p) * q * p⁻¹ := by group
      _ = q * p := by rw [hpp, one_mul, hpi]
      _ = (p * q)⁻¹ := by rw [mul_inv_rev, hpi, hqi]
  have hD : IsPGroup 2 D := hp2.to_sup_of_normal_right' hr2 hpN
  have hpD : p ∈ D := (show Subgroup.zpowers p ≤ D from le_sup_left)
    (Subgroup.mem_zpowers p)
  have hrD : p * q ∈ D := (show R ≤ D from le_sup_right) (Subgroup.mem_zpowers (p * q))
  have hqD : q ∈ D := by
    simpa only [inv_mul_cancel_left] using D.mul_mem (D.inv_mem hpD) hrD
  have har : Commute a (p * q) := by
    change a * (p * q) = (p * q) * a
    calc
      a * (p * q) = p * (a * q) := by rw [← mul_assoc, hap.eq, mul_assoc]
      _ = (p * q) * a := by rw [haq.eq, mul_assoc]
  have hDC : D ≤ Subgroup.centralizer ({a} : Set G) := by
    apply sup_le
    · exact Subgroup.zpowers_le.mpr (Subgroup.mem_centralizer_singleton_iff.mpr hap.eq.symm)
    · exact Subgroup.zpowers_le.mpr (Subgroup.mem_centralizer_singleton_iff.mpr har.eq.symm)
  have haC : a ∈ Subgroup.centralizer (D : Set G) := by
    apply Subgroup.mem_centralizer_iff.mpr
    intro d hd
    exact Subgroup.mem_centralizer_singleton_iff.mp (hDC hd)
  have haN : Subgroup.zpowers a ≤ Subgroup.normalizer (D : Set G) :=
    Subgroup.zpowers_le.mpr (Subgroup.centralizer_le_normalizer (D : Set G) haC)
  have ha2 : IsPGroup 2 (Subgroup.zpowers a) :=
    zpowers_isPGroup_of_pow a 1 (by simpa using ha)
  have hW : IsPGroup 2 (Subgroup.zpowers a ⊔ D : Subgroup G) :=
    ha2.to_sup_of_normal_right' hD haN
  apply hW.to_le
  apply (Subgroup.closure_le _).mpr
  intro x hx
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
  rcases hx with hx | hx | hx
  · subst x
    exact (show D ≤ Subgroup.zpowers a ⊔ D from le_sup_right) hpD
  · subst x
    exact (show D ≤ Subgroup.zpowers a ⊔ D from le_sup_right) hqD
  · subst x
    exact (show Subgroup.zpowers a ≤ Subgroup.zpowers a ⊔ D from le_sup_left)
      (Subgroup.mem_zpowers a)

end SymmetricSubgroupAsymptotics.CFSGDihedralTwoGroupWords
