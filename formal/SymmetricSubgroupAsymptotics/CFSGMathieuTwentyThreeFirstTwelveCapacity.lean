theorem whitelist_sum_eq_count :
    (∑ j : Second, (whitelist j.val.val).length) = literalWhitelistCount := by
  decide +kernel

theorem firstPointFibre_card_le_count
    [IsSimpleGroup CFSG.Models.Presentations.M23.Model] :
    Nat.card (firstPointFibre selectedFirst) ≤ literalWhitelistCount := by
  calc
    _ ≤ ∑ j : Second, (whitelist j.val.val).length :=
      firstPointFibre_card_le_whitelist_sum selectedFirst
        (fun j => failure j.val.val) (fun j => whitelist j.val.val) all_second_checks
    _ = _ := whitelist_sum_eq_count

theorem accepts_mem_acceptedAt (c : Code) (hfirst : c.1.1 = selectedFirst)
    (hc : CFSGMathieuTwentyThreeProductNecessaryRelations.Accepts (decodeAtZero c).val) :
