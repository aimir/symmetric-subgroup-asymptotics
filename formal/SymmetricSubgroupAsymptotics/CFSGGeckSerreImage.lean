import SymmetricSubgroupAsymptotics.CFSGGeckSerreRepresentation
import SymmetricSubgroupAsymptotics.CFSGSerreLocalNilpotence

/-! The original rational Serre representation lands in the Lie algebra
generated by its SAME literal Geck H/E/F matrices. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
namespace SymmetricSubgroupAsymptotics.CFSGGeckSerreImage
open CFSG.Models.Chevalley CFSGGeckSerreRepresentation
variable {ι M N : Type*} [Fintype ι] [DecidableEq ι]
    [AddCommGroup M] [Module ℚ M] [AddCommGroup N] [Module ℚ N]
    {P : RootPairing ι ℚ M N} [P.IsCrystallographic] [P.IsReduced] [P.IsIrreducible]
    (b : P.Base) {n : ℕ} (s : Fin n≃b.support)

theorem rationalRepresentation_mem_lieAlgebra (x : RationalLie (cartan b s)) :
    rationalRepresentation b s x∈RootPairing.GeckConstruction.lieAlgebra b := by
  let S := (RootPairing.GeckConstruction.lieAlgebra b).comap (rationalRepresentation b s)
  have hle : LieSubalgebra.lieSpan ℚ _ (Set.range (generator (cartan b s)))≤S := by
    apply LieSubalgebra.lieSpan_le.mpr
    rintro _ ⟨g,rfl⟩
    change rationalRepresentation b s (generator (cartan b s) g)∈
      RootPairing.GeckConstruction.lieAlgebra b
    cases g with
    | H i=>
      rw [rationalRepresentation_H]
      exact RootPairing.GeckConstruction.h_mem_lieAlgebra (s i)
    | E i=>
      rw [rationalRepresentation_E]
      exact RootPairing.GeckConstruction.e_mem_lieAlgebra (s i)
    | F i=>
      rw [rationalRepresentation_F]
      exact RootPairing.GeckConstruction.f_mem_lieAlgebra (s i)
  rw [CFSGSerreLocalNilpotence.generator_lieSpan_eq_top] at hle
  exact hle (LieSubalgebra.mem_top x)

end SymmetricSubgroupAsymptotics.CFSGGeckSerreImage
