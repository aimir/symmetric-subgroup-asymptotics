  (if j.val * 3 + k.val < 6 then (if j.val * 3 + k.val < 3 then (if j.val * 3 + k.val < 1 then .one else (if j.val * 3 + k.val < 2 then .mul (.mul (.mul (.one) (.generator 0)) (.inv (.generator 2))) (.generator 0) else .mul (.one) (.generator 1))) else (if j.val * 3 + k.val < 4 then .one else (if j.val * 3 + k.val < 5 then .mul (.mul (.one) (.inv (.generator 2))) (.inv (.generator 0)) else .mul (.mul (.one) (.inv (.generator 2))) (.inv (.generator 0))))) else (if j.val * 3 + k.val < 9 then (if j.val * 3 + k.val < 7 then .one else (if j.val * 3 + k.val < 8 then .mul (.mul (.mul (.one) (.generator 0)) (.inv (.generator 2))) (.generator 0) else .mul (.one) (.generator 1))) else (if j.val * 3 + k.val < 10 then .one else (if j.val * 3 + k.val < 11 then .mul (.mul (.one) (.inv (.generator 2))) (.inv (.generator 0)) else .one))))

private theorem power_checked : ∀ j : Fin 4,
    (PrimitiveAffineEightFrameRow23NormalCertificate.stateGenerators 4 j) ^ 2 =
      (powerWord j).eval (PrimitiveAffineEightFrameRow23NormalCertificate.stateGenerators 3) := by
  intro j
  fin_cases j <;> native_decide

private theorem mixed_checked : ∀ (j : Fin 4) (k : Fin 3),
    ⁅PrimitiveAffineEightFrameRow23NormalCertificate.stateGenerators 4 j,
        PrimitiveAffineEightFrameRow23NormalCertificate.topAmbient k⁆ =
      (mixedWord j k).eval (PrimitiveAffineEightFrameRow23NormalCertificate.stateGenerators 3) := by
  intro j k
  fin_cases j <;> fin_cases k <;> native_decide

theorem radical_eq : primeRelativeRadical 2 N4 = N3 := by
  apply primeRelativeRadical_eq_of_generator_words 2 N4 N3
    PrimitiveAffineEightFrameRow23NormalCertificate.topAmbient PrimitiveAffineEightFrameRow23NormalCertificate.topAmbient_full
    (PrimitiveAffineEightFrameRow23NormalCertificate.stateGenerators 4) rfl
    (PrimitiveAffineEightFrameRow23NormalCertificate.stateGenerators 3) rfl
    radicalWords radicalWords_checked
  · intro j
    rw [power_checked]
    exact (powerWord j).eval_mem_closure
      (PrimitiveAffineEightFrameRow23NormalCertificate.stateGenerators 3)
  · intro j k
    rw [mixed_checked]
    exact (mixedWord j k).eval_mem_closure
      (PrimitiveAffineEightFrameRow23NormalCertificate.stateGenerators 3)

theorem head_eq :
    Module.finrank (ZMod 2) (primeRelativeCharacters 2 N4) =
      1 := by
  apply primeRelativeHead_eq_of_radical_card 2 N4 N3
    1 radical_eq
  simp only [n4Card, n3Card]
