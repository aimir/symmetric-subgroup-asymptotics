import SymmetricSubgroupAsymptotics.CFSGFFourE6RootFieldEmbedding
import SymmetricSubgroupAsymptotics.CFSGFFourE6CentralizerCapacity
import SymmetricSubgroupAsymptotics.CFSGTwistedE6GeckRelativeRootGenerated

/-! Nine actual parameters from a sigma-fixed embedded coefficient
field, INSIDE the target field's literal semilinear fixed-U centralizer.
We embed the subgroup GENERATED by orthogonal root factors. Its image
lies in the corresponding K-generated subgroup, which centralizes the
FULL K root line; centralizing only the embedded F points is never used.
No fixed-group recognition or original-source faithfulness is required. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
open scoped Classical
namespace SymmetricSubgroupAsymptotics.CFSGFFourE6RestrictedCentralizerCapacity
open CFSGFFourE6RootFieldEmbedding CFSGFFourDiagramFieldEmbedding
open CFSGFFourE6CentralizerCapacity CFSGFFourE6CentralizerRootTransport
open CFSGFFourE6PositiveOrbitFactors CFSGFFourE6FixedHeightLifting
open CFSGTwistedE6GeckDiagramCovariance CFSGTwistedE6GeckMatrixTwist
open CFSGTwistedE6GeckPositiveTwist CFSGTwistedE6GeckRelativeRootGenerated

variable {F K : Type} [Field F] [Field K]

def positiveRawMap (iota : F→+*K) : Positive F→*(Matrix GeckIndex GeckIndex K)ˣ :=
  (rawFieldMap iota).comp (Positive F).subtype

def rawOrbitHom (iota : F→+*K) (r : List (Fin 4)) :
    orbitGenerated F r→*(Matrix GeckIndex GeckIndex K)ˣ :=
  (positiveRawMap iota).comp (orbitGenerated F r).subtype

theorem rawOrbitHom_injective (iota : F→+*K) (r : List (Fin 4)) :
    Function.Injective (rawOrbitHom iota r) := by
  intro u v he
  apply Subtype.ext
  apply Subtype.ext
  apply rawFieldMap_injective iota
  exact he

theorem rawOrbitHom_mem_generated_image (iota : F→+*K) (r : List (Fin 4))
    (u : orbitGenerated F r) :
    rawOrbitHom iota r u∈(orbitGenerated K r).map (Positive K).subtype := by
  have hle : orbitGenerated F r≤
      ((orbitGenerated K r).map (Positive K).subtype).comap (positiveRawMap iota) := by
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨⟨i,x⟩,rfl⟩
    let y := rootLineFieldMap iota (transportedRoot r i).val x
    refine ⟨rootOrbitFactor K (transportedRoot r i) y,
      orbitFactor_mem_generated K r i y,?_⟩
    exact (rootOrbitFactor_fieldMap iota (transportedRoot r i) x).symm
  exact hle u.property

theorem rawOrbitHom_support [Finite K] (iota : F→+*K) (r : List (Fin 4))
    (u : orbitGenerated F r) :
    rawOrbitHom iota r u∈Positive K ∧
      rawOrbitHom iota r u∈Subgroup.centralizer
        (rootLineAt K (transportedHighest r) : Set (Matrix GeckIndex GeckIndex K)ˣ) := by
  obtain ⟨v,hv,he⟩ := rawOrbitHom_mem_generated_image iota r u
  change v.val=rawOrbitHom iota r u at he
  have hc : v.val∈Subgroup.centralizer
      (rootLineAt K (transportedHighest r) : Set (Matrix GeckIndex GeckIndex K)ˣ) :=
    (orbitGenerated_le_foldedCentralizer K r hv).2
  constructor
  · rw [←he]
    exact v.property
  · rwa [he] at hc

theorem rawOrbitHom_fixed [Finite F] (iota : F→+*K) (sigma : K≃+*K)
    (hfix : ∀a,sigma (iota a)=iota a) (r : List (Fin 4)) (u : orbitGenerated F r) :
    unitTwist K sigma (rawOrbitHom iota r u)=rawOrbitHom iota r u := by
  have hu := (orbitGenerated_le_foldedCentralizer F r u.property).1
  have hf := congrArg (fun v : Positive F=>v.val) (foldedUpper_fixed F u.val hu)
  change unitTwist F (RingEquiv.refl F) u.val.val=u.val.val at hf
  exact fixed_unitsFieldMap diagramIndex iota sigma hfix u.val.val hf

def fixedRootCentralizer (K : Type) [Field K] (sigma : K≃+*K)
    (a : CFSGNormTwoRootPairing.Roots CartanMatrix.E₆) :
    Subgroup (signedFixed K sigma false) :=
  (Subgroup.centralizer (rootLineAt K a : Set (Matrix GeckIndex GeckIndex K)ˣ)).comap
    (signedFixed K sigma false).subtype

def restrictedCentralizerHom [Finite F] [Finite K] (iota : F→+*K) (sigma : K≃+*K)
    (hfix : ∀a,sigma (iota a)=iota a) (r : List (Fin 4)) :
    orbitGenerated F r→*fixedRootCentralizer K sigma (transportedHighest r) := by
  let f : orbitGenerated F r→*signedFixed K sigma false :=
    (rawOrbitHom iota r).codRestrict _ (fun u=>
      ⟨(rawOrbitHom_support iota r u).1,rawOrbitHom_fixed iota sigma hfix r u⟩)
  exact f.codRestrict _ (fun u=>(rawOrbitHom_support iota r u).2)

theorem restrictedCentralizerHom_raw [Finite F] [Finite K] (iota : F→+*K) (sigma : K≃+*K)
    (hfix : ∀a,sigma (iota a)=iota a) (r : List (Fin 4)) (u : orbitGenerated F r) :
    (restrictedCentralizerHom iota sigma hfix r u).val.val=rawOrbitHom iota r u := rfl

theorem restrictedCentralizerHom_injective [Finite F] [Finite K]
    (iota : F→+*K) (sigma : K≃+*K) (hfix : ∀a,sigma (iota a)=iota a) (r : List (Fin 4)) :
    Function.Injective (restrictedCentralizerHom iota sigma hfix r) := by
  intro u v he
  apply rawOrbitHom_injective iota r
  exact congrArg (fun z : fixedRootCentralizer K sigma (transportedHighest r)=>z.val.val) he

theorem fixed_root_centralizer_card_lower_nine [Finite F] [Finite K]
    (iota : F→+*K) (sigma : K≃+*K) (hfix : ∀a,sigma (iota a)=iota a) (r : List (Fin 4)) :
    Nat.card F^9≤Nat.card (fixedRootCentralizer K sigma (transportedHighest r)) :=
  (orbit_generated_card_lower_nine F r).trans (Nat.card_le_card_of_injective
    (restrictedCentralizerHom iota sigma hfix r)
    (restrictedCentralizerHom_injective iota sigma hfix r))

end SymmetricSubgroupAsymptotics.CFSGFFourE6RestrictedCentralizerCapacity
