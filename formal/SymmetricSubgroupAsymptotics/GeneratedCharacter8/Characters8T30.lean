import SymmetricSubgroupAsymptotics.BinaryNormalCharacterCriterion
import Mathlib.Algebra.Group.TransferInstance
import SymmetricSubgroupAsymptotics.GeneratedNormal8.Registry8T30

/-! Exact recorded centres and central involution subgroups of the
original quotients for 8T30. Analytic character counting is separate. -/
set_option autoImplicit false
set_option maxHeartbeats 0
set_option maxRecDepth 100000
noncomputable section
namespace SymmetricSubgroupAsymptotics.BinaryNormalCharacters8T30
local instance : Group BinaryNormal8T30.Source := BinaryMenuCayley8T30.group

namespace N0
abbrev state := BinaryNormal8T30.N0.state
structure Row where
  index : Fin 64
  deriving DecidableEq,Fintype
private def rowEquiv : Row ≃ state.Row where
  toFun x := ⟨x.index⟩
  invFun x := ⟨x.index⟩
  left_inv _ := rfl
  right_inv _ := rfl
def originalRowEquiv := state.quotientEquiv BinaryNormal8T30.generators_full
def centreLift : BinaryNormal8T30.Source := ⟨(26 : Fin 64)⟩
def omegaLift : BinaryNormal8T30.Source := ⟨(26 : Fin 64)⟩
def centreClass := QuotientGroup.mk' BinaryNormal8T30.N0.kernel centreLift
def omegaClass := QuotientGroup.mk' BinaryNormal8T30.N0.kernel omegaLift
private theorem centreLift_mem : state.cosets.representatives 60/centreLift∈state.kernel := by
  have he : state.cosets.representatives 60/centreLift=
      (⟨BinaryNormal8T30.N0.normalCertificate.rows 0⟩ : BinaryNormal8T30.Source) := by
    decide +kernel
  rw [he]
  exact binaryNormalRow_mem BinaryNormal8T30.N0.normalCertificate 0
private theorem omegaLift_mem : state.cosets.representatives 60/omegaLift∈state.kernel := by
  have he : state.cosets.representatives 60/omegaLift=
      (⟨BinaryNormal8T30.N0.normalCertificate.rows 0⟩ : BinaryNormal8T30.Source) := by
    decide +kernel
  rw [he]
  exact binaryNormalRow_mem BinaryNormal8T30.N0.normalCertificate 0
section Rows
local instance : Group Row := by
  letI : Group state.Row := state.group BinaryNormal8T30.generators_full
  exact rowEquiv.group

def centreGenerator : Row := ⟨(60 : Fin 64)⟩
def omegaGenerator : Row := ⟨(60 : Fin 64)⟩
private def centreRows (j : Fin 2) : Row := ⟨((if j.val < 1 then 0 else 60) : Fin 64)⟩
private def omegaRows (j : Fin 2) : Row := ⟨((if j.val < 1 then 0 else 60) : Fin 64)⟩

def centreCertificate : FiniteCayleyCertificate (fun _ : Fin 1 => centreGenerator) 2 where
  elements := centreRows
  identity := 0
  identity_eq := by decide +kernel
  next j _ := Fin.ofNat 2 (j.val+1)
  next_eq := by decide +kernel
  words j := List.replicate j.val 0
  words_eq := by decide +kernel

def omegaCertificate : FiniteCayleyCertificate (fun _ : Fin 1 => omegaGenerator) 2 where
  elements := omegaRows
  identity := 0
  identity_eq := by decide +kernel
  next j _ := Fin.ofNat 2 (j.val+1)
  next_eq := by decide +kernel
  words j := List.replicate j.val 0
  words_eq := by decide +kernel

/-- The whole original quotient centre, not a selected central subgroup. -/
theorem centre_complete : Subgroup.center Row=
    Subgroup.closure (Set.range (fun _ : Fin 1 => centreGenerator)) := by
  ext x
  rw [Subgroup.mem_center_iff,centreCertificate.mem_closure_iff]
  have hc : ∀ x : Row, (∀ y, y*x=x*y) ↔ ∃ j, centreCertificate.elements j=x := by
    decide +kernel
  exact hc x

/-- The complete central involution subgroup is generated by the retained
original omega lift; a proper subspace would fail this equality. -/
theorem omega_complete (x : Row) :
    (x∈Subgroup.center Row ∧ x^2=1) ↔ ∃ j, omegaCertificate.elements j=x := by
  rw [Subgroup.mem_center_iff]
  exact (by decide +kernel : ∀ x : Row, ((∀ y, y*x=x*y) ∧ x^2=1) ↔
    ∃ j, omegaCertificate.elements j=x) x

theorem omega_card : Nat.card (binaryCentralOmega Row)=2 := by
  rw [Nat.card_congr (binaryCentralOmegaEquiv Row)]
  letI : DecidablePred (fun x : Row => x∈Subgroup.center Row ∧ x^2=1) :=
    fun x => inferInstance
  rw [Nat.card_eq_fintype_card]
  decide +kernel

theorem centreGenerator_original : originalRowEquiv
    (rowEquiv centreGenerator)=centreClass := by
  rw [originalRowEquiv,BinaryNormalState.quotientEquiv,BinaryNormalCosetCertificate.rowQuotientEquiv_apply]
  exact QuotientGroup.eq_iff_div_mem.mpr centreLift_mem

theorem omegaGenerator_original : originalRowEquiv
    (rowEquiv omegaGenerator)=omegaClass := by
  rw [originalRowEquiv,BinaryNormalState.quotientEquiv,BinaryNormalCosetCertificate.rowQuotientEquiv_apply]
  exact QuotientGroup.eq_iff_div_mem.mpr omegaLift_mem

def criterion : BinaryNormalCharacterCriterion Row 8 where
  dimension := 1
  cardinal := by simpa using omega_card
  gap := by decide +kernel

def originalEquiv : Row ≃* (BinaryNormal8T30.Source ⧸ BinaryNormal8T30.N0.kernel) := by
  letI : Group state.Row := state.group BinaryNormal8T30.generators_full
  exact rowEquiv.mulEquiv.trans originalRowEquiv

/-- The criterion transfers to the actual original quotient U/N. -/
def originalQuotientCriterion : BinaryNormalCharacterCriterion
    (BinaryNormal8T30.Source ⧸ BinaryNormal8T30.N0.kernel) 8 :=
  criterion.transport originalEquiv

end Rows

abbrev Original := Subgroup.closure (Set.range BinaryMenuCayley8T30.generators)
def physicalNormal : Subgroup Original :=
  BinaryNormal8T30.N0.kernel.map BinaryMenuCayley8T30.originalEquiv.toMonoidHom
instance physicalNormal_normal : physicalNormal.Normal :=
  Subgroup.Normal.map inferInstance _ BinaryMenuCayley8T30.originalEquiv.surjective

def physicalCriterion : BinaryNormalCharacterCriterion (Original ⧸ physicalNormal) 8 :=
  originalQuotientCriterion.transport (QuotientGroup.congr BinaryNormal8T30.N0.kernel
    physicalNormal BinaryMenuCayley8T30.originalEquiv rfl)

theorem physical_dimension :
    Module.finrank (ZMod 2) (Additive (binaryCentralOmega (Original ⧸ physicalNormal)))=1 :=
  physicalCriterion.exact_dimension

end N0

