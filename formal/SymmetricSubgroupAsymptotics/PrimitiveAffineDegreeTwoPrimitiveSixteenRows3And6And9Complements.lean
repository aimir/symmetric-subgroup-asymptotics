import SymmetricSubgroupAsymptotics.PrimitiveAffineDegreeTwoPrimitiveSixteenRows3And6And9LinearRelations
import SymmetricSubgroupAsymptotics.MetacyclicGeneratorPair
import SymmetricSubgroupAsymptotics.CyclicQuotientSocles

/-! The original row3 complement is cyclic. The original row6/9
complements have the displayed cyclic normal subgroup and cyclic quotient.
Every ambient normal subgroup is generated by at most two elements, and
the same literal complements are irreducible on the four-bit module. -/

set_option autoImplicit false
noncomputable section
open scoped Classical

namespace SymmetricSubgroupAsymptotics
namespace PrimitiveAffineDegreeTwoPrimitiveSixteenRows3And6And9Complements

open BinaryFourProjectiveSpread
open PrimitiveAffineDegreeTwoPrimitiveSixteenRows3And6And9LinearRelations
open PrimitiveAffineDegreeTwoPrimitiveSixteenRows12And14LinearRelations

abbrev R3 : Subgroup LinearGroup := Subgroup.zpowers a3
abbrev R6 : Subgroup LinearGroup := Subgroup.closure ({a6, b6} : Set LinearGroup)
abbrev R9 : Subgroup LinearGroup := Subgroup.closure ({a9, b9} : Set LinearGroup)

theorem a3_mem : a3 ∈ R3 := Subgroup.mem_zpowers a3
theorem a6_mem : a6 ∈ R6 := Subgroup.subset_closure (by simp)
theorem b6_mem : b6 ∈ R6 := Subgroup.subset_closure (by simp)
theorem a9_mem : a9 ∈ R9 := Subgroup.subset_closure (by simp)
theorem b9_mem : b9 ∈ R9 := Subgroup.subset_closure (by simp)

theorem normal_generating_singletons3 :
    ∀ N : Subgroup R3, N.Normal →
      ∃ x : Fin 1 → R3, Subgroup.normalClosure (Set.range x) = N :=
  normal_generating_singletons_of_isCyclic

theorem normal_generating_pairs3 :
    ∀ N : Subgroup R3, N.Normal →
      ∃ x : Fin 2 → R3, Subgroup.normalClosure (Set.range x) = N := by
  intro N hN
  obtain ⟨x, hx⟩ := normal_generating_singletons3 N hN
  have heq : x = fun _ : Fin 1 ↦ x 0 := funext (fun i ↦ congrArg x (Subsingleton.elim i 0))
  rw [heq, Set.range_const] at hx
  exact ⟨fun _ ↦ x 0, by simpa only [Set.range_const] using hx⟩

theorem normal_generating_pairs6 :
    ∀ N : Subgroup R6, N.Normal →
      ∃ x : Fin 2 → R6, Subgroup.normalClosure (Set.range x) = N :=
  normal_generating_pairs_closure_of_conjugate_powers a6 b6 4 4
    b6_conj_a6 b6_inv_conj_a6

theorem normal_generating_pairs9 :
    ∀ N : Subgroup R9, N.Normal →
      ∃ x : Fin 2 → R9, Subgroup.normalClosure (Set.range x) = N :=
  normal_generating_pairs_closure_of_conjugate_powers a9 b9 2 8
    b9_conj_a9 b9_inv_conj_a9

theorem irreducible3 : AffineModel.Irreducible R3 :=
  irreducible_of_nonzero_orbit R3 a3 a3_mem a3_orbit
theorem irreducible6 : AffineModel.Irreducible R6 :=
  irreducible_of_nonzero_orbit R6 a6 a6_mem a6_orbit
theorem irreducible9 : AffineModel.Irreducible R9 :=
  irreducible_of_nonzero_orbit R9 a9 a9_mem a3_orbit

end PrimitiveAffineDegreeTwoPrimitiveSixteenRows3And6And9Complements
end SymmetricSubgroupAsymptotics

end
