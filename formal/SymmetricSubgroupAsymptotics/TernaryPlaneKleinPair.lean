import SymmetricSubgroupAsymptotics.TernaryPlaneD8Linear
import Mathlib.Data.Fintype.Units

/-!
# Two-generator model for ternary Klein subgroups

This small shared module isolates the subgroup generated by a displayed
pair of matrices.  The two independent finite certificates about such
pairs are compiled in separate downstream modules.
-/

set_option autoImplicit false
noncomputable section
open scoped Classical

namespace SymmetricSubgroupAsymptotics
namespace LinearThree

abbrev KleinC2 := Multiplicative (ZMod 2)
abbrev KleinV4 := KleinC2 × KleinC2

def kleinFirstBit : KleinV4 := (Multiplicative.ofAdd 1, 1)
def kleinSecondBit : KleinV4 := (1, Multiplicative.ofAdd 1)

/-- The subgroup generated by two displayed matrices. -/
def kleinPairSubgroup (a b : GL3) : Subgroup GL3 :=
  Subgroup.closure ({a, b} : Set GL3)

/-- The four literal elements generated by two commuting involutions. -/
def kleinFourElements (a b : GL3) : Finset GL3 :=
  {1, a, b, a * b}

/-- The explicit four-element subgroup carried by two commuting
involutions.  Keeping this carrier as a four-way disjunction makes its
membership computational, unlike membership in a generated closure. -/
def kleinFourSubgroup (a b : GL3)
    (ha2 : a ^ 2 = 1) (hb2 : b ^ 2 = 1) (hcomm : a * b = b * a) :
    Subgroup GL3 where
  carrier := {x | x = 1 ∨ x = a ∨ x = b ∨ x = a * b}
  one_mem' := Or.inl rfl
  mul_mem' := by
    intro x y hx hy
    have haa : a * a = 1 := by simpa only [pow_two] using ha2
    have hbb : b * b = 1 := by simpa only [pow_two] using hb2
    have haba : a * (b * a) = b := by
      calc
        a * (b * a) = a * (a * b) := by rw [← hcomm]
        _ = (a * a) * b := by rw [mul_assoc]
        _ = b := by rw [haa, one_mul]
    have hbba : b * (b * a) = a := by
      calc
        b * (b * a) = (b * b) * a := by rw [mul_assoc]
        _ = a := by rw [hbb, one_mul]
    have hbaba : b * (a * (b * a)) = 1 := by
      calc
        b * (a * (b * a)) = b * (a * (a * b)) := by rw [← hcomm]
        _ = b * ((a * a) * b) := by rw [mul_assoc]
        _ = b * b := by rw [haa, one_mul]
        _ = 1 := hbb
    rcases hx with rfl | rfl | rfl | rfl <;>
      rcases hy with rfl | rfl | rfl | rfl <;>
      simp [haa, hbb, hcomm, mul_assoc, haba, hbba]
  inv_mem' := by
    intro x hx
    have haa : a * a = 1 := by simpa only [pow_two] using ha2
    have hbb : b * b = 1 := by simpa only [pow_two] using hb2
    have habab : (a * b) * (a * b) = 1 := by
      calc
        (a * b) * (a * b) = a * (b * a) * b := by simp only [mul_assoc]
        _ = a * (a * b) * b := by rw [← hcomm]
        _ = (a * a) * (b * b) := by simp only [mul_assoc]
        _ = 1 := by rw [haa, hbb, one_mul]
    have hainv : a⁻¹ = a := inv_eq_of_mul_eq_one_right haa
    have hbinv : b⁻¹ = b := inv_eq_of_mul_eq_one_right hbb
    have habinv : (a * b)⁻¹ = a * b :=
      inv_eq_of_mul_eq_one_right habab
    rcases hx with rfl | rfl | rfl | rfl <;>
      simp [hainv, hbinv, habinv]

@[simp] theorem mem_kleinFourSubgroup_iff
    (a b x : GL3) (ha2 : a ^ 2 = 1) (hb2 : b ^ 2 = 1)
    (hcomm : a * b = b * a) :
    x ∈ kleinFourSubgroup a b ha2 hb2 hcomm ↔
      x ∈ kleinFourElements a b := by
  simp [kleinFourSubgroup, kleinFourElements]

/-- Under the displayed relations, the generated subgroup is the literal
four-element carrier. -/
theorem kleinPairSubgroup_eq_kleinFourSubgroup
    (a b : GL3) (ha2 : a ^ 2 = 1) (hb2 : b ^ 2 = 1)
    (hcomm : a * b = b * a) :
    kleinPairSubgroup a b = kleinFourSubgroup a b ha2 hb2 hcomm := by
  apply le_antisymm
  · apply (Subgroup.closure_le (kleinFourSubgroup a b ha2 hb2 hcomm)).2
    intro x hx
    rcases hx with rfl | rfl
    · exact Or.inr (Or.inl rfl)
    · exact Or.inr (Or.inr (Or.inl rfl))
  · intro x hx
    change x = 1 ∨ x = a ∨ x = b ∨ x = a * b at hx
    rcases hx with rfl | rfl | rfl | rfl
    · exact Subgroup.one_mem _
    · exact Subgroup.subset_closure (Set.mem_insert_iff.mpr (Or.inl rfl))
    · exact Subgroup.subset_closure
        (Set.mem_insert_iff.mpr (Or.inr (Set.mem_singleton _)))
    · exact Subgroup.mul_mem _
        (Subgroup.subset_closure (Set.mem_insert_iff.mpr (Or.inl rfl)))
        (Subgroup.subset_closure
          (Set.mem_insert_iff.mpr (Or.inr (Set.mem_singleton _))))

/-- A faithful image of the binary plane is generated by the images of its
two standard bits. -/
theorem binaryKleinRange_eq_pairSubgroup
    (f : KleinV4 →* GL3) (_hf : Function.Injective f) :
    f.range = kleinPairSubgroup (f kleinFirstBit) (f kleinSecondBit) := by
  apply le_antisymm
  · rintro y ⟨x, rfl⟩
    rcases x with ⟨a, b⟩
    rcases C2Wreath.cases a with rfl | rfl <;>
      rcases C2Wreath.cases b with rfl | rfl
    · change f (1 : KleinV4) ∈
        kleinPairSubgroup (f kleinFirstBit) (f kleinSecondBit)
      simpa only [map_one] using
        (Subgroup.one_mem
          (kleinPairSubgroup (f kleinFirstBit) (f kleinSecondBit)))
    · exact Subgroup.subset_closure
        (Set.mem_insert_iff.mpr (Or.inr (Set.mem_singleton _)))
    · exact Subgroup.subset_closure (Set.mem_insert_iff.mpr (Or.inl rfl))
    · rw [show (C2Wreath.gen, C2Wreath.gen) =
          kleinFirstBit * kleinSecondBit by rfl, map_mul]
      exact Subgroup.mul_mem _
        (Subgroup.subset_closure (Set.mem_insert_iff.mpr (Or.inl rfl)))
        (Subgroup.subset_closure (Set.mem_insert_iff.mpr
          (Or.inr (Set.mem_singleton _))))
  · apply (Subgroup.closure_le f.range).2
    intro y hy
    rcases hy with rfl | rfl
    · exact ⟨kleinFirstBit, rfl⟩
    · exact ⟨kleinSecondBit, rfl⟩

private theorem kleinFirstBit_square : kleinFirstBit ^ 2 = 1 := by decide
private theorem kleinSecondBit_square : kleinSecondBit ^ 2 = 1 := by decide

theorem map_kleinFirstBit_square (f : KleinV4 →* GL3) :
    (f kleinFirstBit) ^ 2 = 1 := by
  rw [← map_pow, kleinFirstBit_square, map_one]

theorem map_kleinSecondBit_square (f : KleinV4 →* GL3) :
    (f kleinSecondBit) ^ 2 = 1 := by
  rw [← map_pow, kleinSecondBit_square, map_one]

theorem map_kleinBits_commute (f : KleinV4 →* GL3) :
    f kleinFirstBit * f kleinSecondBit =
      f kleinSecondBit * f kleinFirstBit := by
  rw [← map_mul, mul_comm, map_mul]

/-- Literal conjugation of the four-element carrier. -/
def conjugatedKleinFourElements (a b g : GL3) : Finset GL3 :=
  (kleinFourElements a b).image (MulAut.conj g)

theorem conjugatedKleinFourElements_eq_iff
    (a b g : GL3) :
    conjugatedKleinFourElements a b g = kleinFourElements a b ↔
      ∀ x : GL3,
        x ∈ kleinFourElements a b ↔
          (MulAut.conj g) x ∈ kleinFourElements a b := by
  constructor
  · intro heq x
    constructor
    · intro hx
      rw [← heq]
      exact Finset.mem_image.mpr ⟨x, hx, rfl⟩
    · intro hx
      rw [← heq] at hx
      obtain ⟨y, hy, hyx⟩ := Finset.mem_image.mp hx
      have hxy : y = x := (MulAut.conj g).injective hyx
      simpa only [hxy] using hy
  · intro h
    apply Finset.ext
    intro y
    constructor
    · intro hy
      obtain ⟨x, hx, hxy⟩ := Finset.mem_image.mp hy
      exact hxy ▸ (h x).mp hx
    · intro hy
      let x : GL3 := (MulAut.conj g).symm y
      have hx : x ∈ kleinFourElements a b := by
        apply (h x).mpr
        simpa only [x, MulEquiv.apply_symm_apply]
      exact Finset.mem_image.mpr
        ⟨x, hx, by simpa only [x, MulEquiv.apply_symm_apply]⟩

theorem map_kleinFourSubgroup_eq_of_conjugated_elements_eq
    (a b c d g : GL3)
    (ha2 : a ^ 2 = 1) (hb2 : b ^ 2 = 1)
    (hcomm : a * b = b * a)
    (hc2 : c ^ 2 = 1) (hd2 : d ^ 2 = 1)
    (hcd : c * d = d * c)
    (heq : conjugatedKleinFourElements a b g =
      kleinFourElements c d) :
    (kleinFourSubgroup a b ha2 hb2 hcomm).map
        (MulAut.conj g).toMonoidHom =
      kleinFourSubgroup c d hc2 hd2 hcd := by
  ext x
  constructor
  · rintro ⟨y, hy, rfl⟩
    apply (mem_kleinFourSubgroup_iff c d _ hc2 hd2 hcd).mpr
    rw [← heq]
    exact Finset.mem_image.mpr
      ⟨y, (mem_kleinFourSubgroup_iff a b _ ha2 hb2 hcomm).mp hy, rfl⟩
  · intro hx
    have hx' : x ∈ kleinFourElements c d :=
      (mem_kleinFourSubgroup_iff c d _ hc2 hd2 hcd).mp hx
    rw [← heq] at hx'
    obtain ⟨y, hy, hyx⟩ := Finset.mem_image.mp hx'
    exact ⟨y,
      (mem_kleinFourSubgroup_iff a b _ ha2 hb2 hcomm).mpr hy, hyx⟩

/-- A fully computable filter for matrices normalizing the literal Klein
carrier. -/
def explicitGLFinset : Finset GL3 :=
  LinearThree.glSet.attach.image fun A => LinearThree.ofGL A.1 A.2

theorem mem_explicitGLFinset (g : GL3) : g ∈ explicitGLFinset := by
  apply Finset.mem_image.mpr
  refine ⟨⟨(g : M2), LinearThree.coe_mem_glSet g⟩, by simp, ?_⟩
  apply Units.ext
  rfl

/-- A fully computable filter for matrices normalizing the literal Klein
carrier.  Its ambient enumerator is the explicit list of invertible matrices,
instead of the noncomputable default `Fintype` on units. -/
def kleinNormalizerFinset (a b : GL3) : Finset GL3 :=
  explicitGLFinset.filter fun g =>
    conjugatedKleinFourElements a b g = kleinFourElements a b

theorem mem_kleinNormalizerFinset_iff
    (a b g : GL3) (ha2 : a ^ 2 = 1) (hb2 : b ^ 2 = 1)
    (hcomm : a * b = b * a) :
    g ∈ kleinNormalizerFinset a b ↔
      g ∈ Subgroup.normalizer (kleinPairSubgroup a b : Set GL3) := by
  rw [kleinNormalizerFinset, Finset.mem_filter]
  simp only [mem_explicitGLFinset, true_and]
  rw [kleinPairSubgroup_eq_kleinFourSubgroup a b ha2 hb2 hcomm,
    Subgroup.mem_normalizer_iff,
    conjugatedKleinFourElements_eq_iff]
  simp only [mem_kleinFourSubgroup_iff, MulAut.conj_apply]

end LinearThree
end SymmetricSubgroupAsymptotics

end
