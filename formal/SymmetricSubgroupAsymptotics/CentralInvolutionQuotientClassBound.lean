import SymmetricSubgroupAsymptotics.CentralInvolutionConjugacyClasses
import Mathlib.GroupTheory.QuotientGroup.Basic

/-! The literal subgroup generated by a central element of square one
is {1,z}. Its quotient has the central-translation class-count formula.
The full central quotient is reached only by a surjective homomorphism;
no identification of the full centre with {1,z} is required. -/
set_option autoImplicit false
noncomputable section
namespace SymmetricSubgroupAsymptotics.CentralInvolutionQuotientClassBound
variable {G : Type*} [Group G]

def pairSubgroup (z : G) (hz : z ∈ Subgroup.center G) (hzz : z*z=1) : Subgroup G where
  carrier := {x | x=1 ∨ x=z}
  one_mem' := by
    have _ := hz
    exact Or.inl rfl
  mul_mem' := by
    intro a b ha hb
    rcases ha with ha | ha <;> rcases hb with hb | hb
    · left; rw [ha,hb,one_mul]
    · right; rw [ha,hb,one_mul]
    · right; rw [ha,hb,mul_one]
    · left; rw [ha,hb,hzz]
  inv_mem' := by
    rintro a (rfl | rfl)
    · exact Or.inl inv_one
    · exact Or.inr (inv_eq_of_mul_eq_one_left hzz)

theorem pairSubgroup_eq_closure (z : G) (hz : z ∈ Subgroup.center G) (hzz : z*z=1) :
    pairSubgroup z hz hzz=Subgroup.closure ({z} : Set G) := by
  apply le_antisymm
  · intro x hx
    rcases hx with h | h
    · rw [h]; exact (Subgroup.closure ({z} : Set G)).one_mem
    · rw [h]; exact Subgroup.subset_closure (Set.mem_singleton z)
  · apply (Subgroup.closure_le (pairSubgroup z hz hzz)).2
    intro x hx
    exact Or.inr (Set.mem_singleton_iff.mp hx)

theorem pairSubgroup_le_center (z : G) (hz : z ∈ Subgroup.center G) (hzz : z*z=1) :
    pairSubgroup z hz hzz≤Subgroup.center G := by
  intro x hx
  rcases hx with h | h
  · rw [h]; exact (Subgroup.center G).one_mem
  · rw [h]; exact hz

instance pairSubgroupNormal (z : G) (hz : z ∈ Subgroup.center G) (hzz : z*z=1) :
    (pairSubgroup z hz hzz).Normal where
  conj_mem := by
    intro x hx g
    have hc := Subgroup.mem_center_iff.mp (pairSubgroup_le_center z hz hzz hx) g
    simpa only [hc,mul_assoc,mul_inv_cancel,mul_one] using hx

theorem quotient_class_formula [Finite G]
    (z : G) (hz : z ∈ Subgroup.center G) (hzz : z*z=1) :
    2*Nat.card (ConjClasses (G ⧸ pairSubgroup z hz hzz))=
      Nat.card (ConjClasses G)+Nat.card {c : ConjClasses G //
        CentralInvolutionConjugacyClasses.translate z hz c=c} := by
  exact CentralInvolutionConjugacyClasses.twice_class_card_eq
    (QuotientGroup.mk' (pairSubgroup z hz hzz)) (QuotientGroup.mk'_surjective _)
    z hz hzz (fun g => (QuotientGroup.eq_one_iff g).trans Iff.rfl)

theorem twice_central_quotient_class_card_le [Finite G]
    (z : G) (hz : z ∈ Subgroup.center G) (hzz : z*z=1) :
    2*Nat.card (ConjClasses (G ⧸ Subgroup.center G))≤
      Nat.card (ConjClasses G)+Nat.card {c : ConjClasses G //
        CentralInvolutionConjugacyClasses.translate z hz c=c} := by
  let N := pairSubgroup z hz hzz
  let f := QuotientGroup.mk' (Subgroup.center G)
  have hn : N≤f.ker := by
    intro x hx
    exact (QuotientGroup.eq_one_iff x).mpr (pairSubgroup_le_center z hz hzz hx)
  let q : G ⧸ N →* G ⧸ Subgroup.center G := QuotientGroup.lift N f hn
  letI : Finite (G ⧸ N) :=
    Finite.of_surjective (QuotientGroup.mk' N) (QuotientGroup.mk'_surjective N)
  letI : Finite (ConjClasses (G ⧸ N)) :=
    Finite.of_surjective (@ConjClasses.mk (G ⧸ N) _) ConjClasses.mk_surjective
  have hq : Function.Surjective q :=
    QuotientGroup.lift_surjective_of_surjective N f (QuotientGroup.mk'_surjective _) hn
  have hb := Nat.card_le_card_of_surjective (ConjClasses.map q) (ConjClasses.map_surjective hq)
  calc
    2*Nat.card (ConjClasses (G ⧸ Subgroup.center G))≤
        2*Nat.card (ConjClasses (G ⧸ N)) := Nat.mul_le_mul_left 2 hb
    _ =_ := quotient_class_formula z hz hzz

end SymmetricSubgroupAsymptotics.CentralInvolutionQuotientClassBound
