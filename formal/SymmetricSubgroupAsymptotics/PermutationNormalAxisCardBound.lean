import SymmetricSubgroupAsymptotics.FiniteGroupPaddedGenerators
import SymmetricSubgroupAsymptotics.McIverNeumannPermutationSection

/-! A normal-axis coefficient from the actual permutation degree rather
than the logarithm of the group order. This uses the already retained
McIver--Neumann input on the literal image of each actual subgroup. -/
set_option autoImplicit false
noncomputable section
open scoped Classical
namespace SymmetricSubgroupAsymptotics

/-- Each actual subgroup of R≤S_n is generated by at most floor(n/2)
elements, with the sole degree3 exception explicitly excluded. -/
theorem permutation_paddedTupleClosure_surjective
    (hMN : McIverNeumannPermutationGeneratorBound)
    {n : ℕ} (hn : n≠3) (R : Subgroup (Equiv.Perm (Fin n))) :
    Function.Surjective (paddedTupleClosure (R := R) (n/2)) := by
  intro H
  let f : H →* Equiv.Perm (Fin n) := R.subtype.comp H.subtype
  have hf : Function.Injective f := Subtype.val_injective.comp Subtype.val_injective
  let e : H ≃* f.range := MonoidHom.ofInjective (f := f) hf
  obtain ⟨S,hS,hcard⟩ := hMN n f.range (fun h => (hn h).elim)
  have hgen : MarkedC4.genRank H ≤ n/2 :=
    ((MarkedC4.genRank_le_of_surjective e.symm.toMonoidHom e.symm.surjective).trans
      (MarkedC4.genRank_le hS)).trans (by omega)
  obtain ⟨T,hTcard,hTgen⟩ := MarkedC4.genRank_spec (G := H)
  exact exists_paddedTupleClosure_eq (n/2) H T hTgen (hTcard.trans_le hgen)

/-- The full literal normal-subgroup axes cost at most |R|^(n/2), retaining
R's actual degree-n action. No axis is identified with a different quotient. -/
theorem permutation_normalSubgroup_card_le
    (hMN : McIverNeumannPermutationGeneratorBound)
    {n : ℕ} (hn : n≠3) (R : Subgroup (Equiv.Perm (Fin n)))
    (m : ℕ) (hR : Nat.card R ≤ 2^m) :
    Nat.card {N : Subgroup R // N.Normal} ≤ 2^(m*(n/2)) := by
  calc
    _ ≤ Nat.card (Subgroup R) :=
      Nat.card_le_card_of_injective Subtype.val Subtype.val_injective
    _ ≤ Nat.card (Fin (n/2) → R) := Nat.card_le_card_of_surjective _
      (permutation_paddedTupleClosure_surjective hMN hn R)
    _ = Nat.card R^(n/2) := by rw [Nat.card_fun,Nat.card_fin]
    _ ≤ (2^m)^(n/2) := Nat.pow_le_pow_left hR _
    _ = _ := by rw [←pow_mul]

end SymmetricSubgroupAsymptotics
