import SymmetricSubgroupAsymptotics.DerivedTwoCosetGeneratorContainment
import SymmetricSubgroupAsymptotics.CFSGReeFFourBinaryMiddleSquareSaving
import SymmetricSubgroupAsymptotics.CFSGReeFFourSignedBlockGeneration

/-! Generation of the actual binary derived fixed group by its literal
positive intersection and the two original Weyl involutions. The ONLY
conditional input is membership of the original outer involution in the
actual commutator subgroup. No derived index, simple-group recognition,
whole-positive containment, or two-Sylow generation is assumed. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
namespace SymmetricSubgroupAsymptotics.CFSGReeFFourBinaryDerivedGeneration
open CFSGReeFFourFixedModelEquivalence CFSGReeFFourFixedPositiveFamilies
open CFSGReeFFourOuterThreeWord CFSGReeFFourMiddleDerivedFiveWord
open CFSGReeFFourRelativePositiveSubgroups CFSGReeFFourOuterFixedRoot
open CFSGReeFFourBinaryAbelianGenerators CFSGReeFFourMinimalParabolics
open CFSGReeFFourSimpleBlockPeelingGeneration CFSGReeFFourAbelianImageCardinality
open CFSGReeFFourSignedBlockGeneration CFSGReeFFourFixedOppositeGeneration
open CFSGReeFFourOppositionFixedPositiveNegative CFSGReeFFourBinaryMiddleGenerators
open CFSGReeFFourMiddleSquareCommutator CFSGReeFFourMiddleFixedSubgroup
open CFSGReeFFourMiddleFixedWords CFSGReeFFourMiddleFixedParameters

/-- The original four literal generators suffice for the full fixed group. -/
theorem subgroup_eq_top_of_four_generators (H : Subgroup (originalModelFixed 0))
    (hx : outerInvolution 0 ∈ H) (hy : fourCycle 0 ∈ H)
    (ho : outerFixedWeyl 0 ∈ H) (hm : middleFixedWeyl 0 ∈ H) : H = ⊤ := by
  have hW : ∀ b : Bool, simpleWeyl 0 b ∈ H := by
    intro b
    cases b
    · simpa only [simpleWeyl_false] using ho
    · simpa only [simpleWeyl_true] using hm
  have hB : ∀ b : Bool, positiveBlock 0 b ≤ H := by
    intro b
    cases b
    · rw [positiveBlock_false_eq_zpowers]
      exact Subgroup.zpowers_le.mpr hx
    · rw [positiveBlock_true_eq_zpowers]
      exact Subgroup.zpowers_le.mpr hy
  have hU : fixedPositive 0 ≤ H :=
    positive_le_of_simple_inversions_and_weyls 0 H hW hB
  have hO : oppositionFixed 0 ∈ H := by
    rw [opposition_eq_simpleWeyl_power]
    exact H.pow_mem (H.mul_mem (hW false) (hW true)) 4
  have hV : fixedNegative 0 ≤ H := by
    rw [← fixed_positive_image_eq_fixed_negative]
    rintro _ ⟨u, hu, rfl⟩
    exact H.mul_mem (H.mul_mem hO (hU hu)) (H.inv_mem hO)
  apply top_unique
  rw [← fixed_positive_sup_negative 0]
  exact sup_le hU hV

/-- Normality and the original three-word identity retain the same source. -/
theorem outer_weyl_mem_derived (m : ℕ)
    (hx : outerInvolution m ∈ commutator (originalModelFixed m)) :
    outerFixedWeyl m ∈ commutator (originalModelFixed m) := by
  let D := commutator (originalModelFixed m)
  have hc : outerFixedWeyl m * outerInvolution m * (outerFixedWeyl m)⁻¹ ∈ D :=
    (inferInstance : D.Normal).conj_mem _ hx _
  rw [outerWeyl_three_word]
  exact D.mul_mem (D.mul_mem hx hc) hx

/-- The actual middle square and actual five-word already lie in the
commutator, so the original middle Weyl involution does too. -/
theorem middle_weyl_mem_derived (m : ℕ) :
    middleFixedWeyl m ∈ commutator (originalModelFixed m) := by
  let D := commutator (originalModelFixed m)
  have hm := D.mul_mem (fiveWord_mem_commutator m) (D.inv_mem (square_mem_derived m))
  have he : fiveWord m * ((fourCycle m) ^ 2)⁻¹ = middleFixedWeyl m := by
    simp only [fiveWord, mul_assoc, mul_inv_cancel, mul_one]
  rwa [he] at hm

/-- The full actual derived subgroup is generated by its positive
intersection and the two actual Weyl elements. -/
theorem derived_eq_positive_intersection_sup_weyls
    (hxD : outerInvolution 0 ∈ commutator (originalModelFixed 0)) :
    commutator (originalModelFixed 0) =
      (fixedPositive 0 ⊓ commutator (originalModelFixed 0)) ⊔
        Subgroup.closure ({outerFixedWeyl 0, middleFixedWeyl 0} : Set (originalModelFixed 0)) := by
  let D := commutator (originalModelFixed 0)
  let U := fixedPositive 0
  let x := outerInvolution 0
  let y := fourCycle 0
  let wo := outerFixedWeyl 0
  let wm := middleFixedWeyl 0
  let H : Subgroup (originalModelFixed 0) :=
    (U ⊓ D) ⊔ Subgroup.closure ({wo, wm} : Set (originalModelFixed 0))
  have hwoD : wo ∈ D := outer_weyl_mem_derived 0 hxD
  have hwmD : wm ∈ D := middle_weyl_mem_derived 0
  have hxU : x ∈ U := fixedOuterHom_range_le_fixedPositive 0 ⟨_, rfl⟩
  have hyM : y ∈ middleFixedSubgroup 0 := by
    change fourCycle 0 ∈ (middleFixedSubgroup 0 : Set (originalModelFixed 0))
    rw [middleFixedSubgroup_set]
    exact ⟨(1, 0), rfl⟩
  have hyU : y ∈ U := middleFixedSubgroup_le_fixedPositive 0 hyM
  have hsD : y ^ 2 ∈ D := square_mem_derived 0
  have hxH : x ∈ H := Subgroup.mem_sup_left ⟨hxU, hxD⟩
  have hsH : y ^ 2 ∈ H := Subgroup.mem_sup_left ⟨U.pow_mem hyU 2, hsD⟩
  have hwoH : wo ∈ H := Subgroup.mem_sup_right (Subgroup.subset_closure (Or.inl rfl))
  have hwmH : wm ∈ H := Subgroup.mem_sup_right (Subgroup.subset_closure (Or.inr rfl))
  have hcyx : y * x * y⁻¹ ∈ H := Subgroup.mem_sup_left
    ⟨U.mul_mem (U.mul_mem hyU hxU) (U.inv_mem hyU),
      (inferInstance : D.Normal).conj_mem _ hxD _⟩
  have hcywo : y * wo * y⁻¹ ∈ H := by
    have hwoY : wo * y * wo⁻¹ ∈ U :=
      outer_conjugate_middleFixedSubgroup_le 0 ⟨y, hyM, rfl⟩
    have hcU := U.mul_mem hyU (U.inv_mem hwoY)
    have he : y * (wo * y * wo⁻¹)⁻¹ = (y * wo * y⁻¹) * wo⁻¹ := by group
    rw [he] at hcU
    have hcD : (y * wo * y⁻¹) * wo⁻¹ ∈ D := D.mul_mem
      ((inferInstance : D.Normal).conj_mem _ hwoD _) (D.inv_mem hwoD)
    have hcH : (y * wo * y⁻¹) * wo⁻¹ ∈ H := Subgroup.mem_sup_left ⟨hcU, hcD⟩
    have hh := H.mul_mem hcH hwoH
    simpa only [mul_assoc, inv_mul_cancel, mul_one] using hh
  have hcywm : y * wm * y⁻¹ ∈ H := by
    have hfive : fiveWord 0 ∈ H := H.mul_mem hwmH hsH
    have he : y * wm * y⁻¹ = (fiveWord 0) ^ 2 * (y ^ 2)⁻¹ := by
      calc
        _ = (y * fiveWord 0 * y⁻¹) * (y ^ 2)⁻¹ := by
          dsimp only [fiveWord, y, wm]
          group
        _ = _ := by rw [fiveWord_conjugate]
    rw [he]
    exact H.mul_mem (H.pow_mem hfive 2) (H.inv_mem hsH)
  let S : Set (originalModelFixed 0) := {x, wo, wm}
  have hgen : Subgroup.closure (S ∪ {y}) = ⊤ := by
    apply subgroup_eq_top_of_four_generators
    · exact Subgroup.subset_closure (Or.inl (Or.inl rfl))
    · exact Subgroup.subset_closure (Or.inr rfl)
    · exact Subgroup.subset_closure (Or.inl (Or.inr (Or.inl rfl)))
    · exact Subgroup.subset_closure (Or.inl (Or.inr (Or.inr rfl)))
  have hSchreier : DerivedTwoCosetGeneratorContainment.generatedSubgroup S y ≤ H := by
    apply (Subgroup.closure_le _).mpr
    intro z hz
    rcases hz with (hs | ⟨s, hs, rfl⟩) | hs
    · rcases hs with rfl | rfl | rfl
      · exact hxH
      · exact hwoH
      · exact hwmH
    · rcases hs with rfl | rfl | rfl
      · exact hcyx
      · exact hcywo
      · exact hcywm
    · have hz : z = y ^ 2 := hs
      subst z
      exact hsH
  have hDH : D ≤ H :=
    (DerivedTwoCosetGeneratorContainment.commutator_le_generatedSubgroup S y hgen).trans hSchreier
  have hHD : H ≤ D := by
    apply sup_le inf_le_right
    apply (Subgroup.closure_le _).mpr
    intro z hz
    rcases hz with rfl | rfl
    · exact hwoD
    · exact hwmD
  exact le_antisymm hDH hHD

end SymmetricSubgroupAsymptotics.CFSGReeFFourBinaryDerivedGeneration
