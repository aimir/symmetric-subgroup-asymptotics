import Mathlib.GroupTheory.GroupAction.Quotient
import Mathlib.Algebra.Group.Subgroup.Basic
import Mathlib.SetTheory.Cardinal.Finite

/-! Simultaneously fixed functions on the FULL original point set are
exactly functions on the orbits of the subgroup generated by the SAME
two elements. This does not assert anything about a proper submodule. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
namespace SymmetricSubgroupAsymptotics.PermutationJointFixedFunctions
variable {G I D : Type*} [Group G] [MulAction G I]

def pairGenerated (h k : G) : Subgroup G := Subgroup.closure ({h,k} : Set G)

def pairFixedFunctions (h k : G) :=
  {f : I → D // (∀ i, f (h • i) = f i) ∧ (∀ i, f (k • i) = f i)}

theorem pairFixed_apply_smul (h k : G) (f : pairFixedFunctions (I := I) (D := D) h k)
    (a : pairGenerated h k) (i : I) : f.val (a • i) = f.val i := by
  let S : Subgroup G := {
    carrier := {a | ∀ i : I, f.val (a • i) = f.val i}
    one_mem' := by intro i; rw [one_smul]
    mul_mem' := by intro a b ha hb i; rw [mul_smul, ha, hb]
    inv_mem' := by
      intro a ha i
      have he := (ha (a⁻¹ • i)).symm
      simpa only [smul_inv_smul] using he }
  have hle : pairGenerated h k ≤ S := by
    apply (Subgroup.closure_le S).mpr
    intro a ha
    rcases Set.mem_insert_iff.mp ha with rfl | ha
    · exact f.property.1
    · have he : a = k := Set.mem_singleton_iff.mp ha
      subst a
      exact f.property.2
  exact hle a.property i

def pairFixedOrbitEquiv (h k : G) :
    pairFixedFunctions (I := I) (D := D) h k ≃
      (MulAction.orbitRel.Quotient (pairGenerated h k) I → D) where
  toFun f := Quotient.lift f.val (by
    intro i j hij
    obtain ⟨a, ha⟩ := hij
    rw [← ha]
    exact pairFixed_apply_smul h k f a j)
  invFun u := ⟨fun i => u (Quotient.mk'' i), by
    have hh : h ∈ pairGenerated h k := Subgroup.subset_closure (by simp)
    have hk : k ∈ pairGenerated h k := Subgroup.subset_closure (by simp)
    constructor
    · intro i
      apply congrArg u
      exact Quotient.sound ⟨⟨h,hh⟩,rfl⟩
    · intro i
      apply congrArg u
      exact Quotient.sound ⟨⟨k,hk⟩,rfl⟩⟩
  left_inv f := rfl
  right_inv u := by
    funext q
    refine Quotient.inductionOn q ?_
    intro i
    rfl

theorem pairFixed_card [Finite I] [Finite D] (h k : G) :
    Nat.card (pairFixedFunctions (I := I) (D := D) h k) =
      Nat.card D ^ Nat.card (MulAction.orbitRel.Quotient (pairGenerated h k) I) := by
  rw [Nat.card_congr (pairFixedOrbitEquiv (I := I) (D := D) h k),Nat.card_fun]

end SymmetricSubgroupAsymptotics.PermutationJointFixedFunctions
