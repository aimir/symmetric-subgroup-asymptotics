private theorem row_mem (k : Fin 32) :
    BinaryMenuCayley8T22.certificate.toCayley.elements k ∈ H :=
  (BinaryMenuCayley8T22.certificate.toCayley.mem_closure_iff _).mpr ⟨k, rfl⟩

theorem step_mem (i : Fin 1260) (j : Fin 3) :
    representatives i * signedGenerators j * (representatives (nextSigned i j))⁻¹ ∈ H := by
  have hrow : permutationCode (BinaryMenuCayley8T22.certificate.toCayley.elements (witness i j)) =
      BinaryMenuCayley8T22.certificate.rows (witness i j) :=
    BinaryMenuCayley8T22.certificate.encode_elements _
  have he := permutationCode_injective 8 ((step_checked i j).trans hrow.symm)
  rw [he]
  exact row_mem _

def certificate : FiniteLeftCosetCover generators H 1260 where
  representatives := representatives
  identity := 0
  identity_mem := by
    have h : representatives 0 = 1 := by decide +kernel
    rw [h]
    exact H.one_mem
  next i j := nextSigned i j.castSucc
  step_mem i j := by
    have h := step_mem i j.castSucc
    change representatives i * generators j * (representatives (nextSigned i j.castSucc))⁻¹ ∈ H
    simpa only [signed_cast] using h
  prev i j := nextSigned i (previousLetter j)
  inverse_step_mem i j := by
    rw [inverse_generators j]
    exact step_mem i (previousLetter j)

theorem covers (g : Ambient) : ∃ i : Fin 1260, g * (representatives i)⁻¹ ∈ H :=
  certificate.covers SymmetricEightTwoGenerators.generators_full g

