import SymmetricSubgroupAsymptotics.CFSGTwistedAUnitaryRadicalUpperEmbedding
import SymmetricSubgroupAsymptotics.CFSGTwistedAUnitaryUpperProductCard
import SymmetricSubgroupAsymptotics.CFSGTwistedAUnitaryUpperCardBases
import Mathlib.GroupTheory.SpecificGroups.Cyclic.Basic

/-! The actual rank-three upper group's middle root acts by the literal
two-coordinate shear on its radical quotient. The existing actual upper
factorization supplies generation; at binary q the genuine middle group
is generated by the same single root element. -/
set_option autoImplicit false
noncomputable section
open scoped Matrix
namespace SymmetricSubgroupAsymptotics.CFSGUnitaryRankThreeUpperShear
open CFSGTwistedANaturalMatrices CFSGTwistedAUpperUnipotent
open CFSGTwistedAUnitaryCoordinates CFSGTypeAElementaryMatrices

def middleGenerator (q : CFSG.PrimePower) : naturalUnipotent 3 q :=
  middleUnipotentHom q 1 (rankOneUpperElement q 1)

def radicalConjugate (q : CFSG.PrimePower) (z : fixedRadical q 1) : fixedRadical q 1 :=
  radicalMiddleConjugate q 1 (upperFixedHom q 1 (rankOneUpperElement q 1)) z

theorem conjugate_apply (q : CFSG.PrimePower) (z : fixedRadical q 1) :
    radicalUpperHom q 1 (radicalConjugate q z) =
      middleGenerator q*radicalUpperHom q 1 z*(middleGenerator q)⁻¹ := by
  apply upperFixedHom_injective q 3
  rfl

theorem parameter_conjugate (q : CFSG.PrimePower) (z : fixedRadical q 1) :
    (fixedRadicalParameterHom q 1 (radicalConjugate q z)).toAdd =
      (fixedRadicalParameterHom q 1 z).toAdd+
        Pi.single 0 ((fixedRadicalParameterHom q 1 z).toAdd 1) := by
  rw [radicalConjugate,fixedRadicalParameter_middle_conjugate]
  let v := (fixedRadicalParameterHom q 1 z).toAdd
  change (1+(1 : q.Extension 2) • positive (q.Extension 2) 1 0) *ᵥ v = v+Pi.single 0 (v 1)
  simp only [one_smul]
  change (1+Matrix.single (0 : Fin 2) 1 (1 : q.Extension 2)) *ᵥ v = v+Pi.single 0 (v 1)
  rw [Matrix.add_mulVec,Matrix.one_mulVec,Matrix.single_mulVec]
  simp only [one_mul]
  congr 1

theorem ranges_generate (q : CFSG.PrimePower) :
    (radicalUpperHom q 1).range ⊔ (middleUnipotentHom q 1).range = ⊤ := by
  apply top_unique
  intro g _
  obtain ⟨⟨u,m⟩,rfl⟩ := upperProduct_surjective q 1 g
  change radicalUpperHom q 1 u*middleUnipotentHom q 1 m ∈
    (radicalUpperHom q 1).range ⊔ (middleUnipotentHom q 1).range
  exact Subgroup.mul_mem _
    ((show (radicalUpperHom q 1).range ≤
      (radicalUpperHom q 1).range ⊔ (middleUnipotentHom q 1).range from le_sup_left) ⟨u,rfl⟩)
    ((show (middleUnipotentHom q 1).range ≤
      (radicalUpperHom q 1).range ⊔ (middleUnipotentHom q 1).range from le_sup_right) ⟨m,rfl⟩)

theorem generator_generate_of_binary (q : CFSG.PrimePower) (hq : q.order = 2) :
    (radicalUpperHom q 1).range ⊔ Subgroup.zpowers (middleGenerator q) = ⊤ := by
  letI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hcard : Nat.card (naturalUnipotent 1 q) = 2 := (naturalUnipotent_card_one q).trans hq
  have hzero : rankOneUpperParameter q (1 : naturalUnipotent 1 q) = 0 := by
    apply Subtype.ext
    change (1 : Mat (q.Extension 2) 1) 0 1 = 0
    simp only [Matrix.one_apply,if_neg (by decide : (0 : Fin 2) ≠ 1)]
  have hne : rankOneUpperElement q (1 : CFSGTwistedA2FixedField.fixedField q) ≠ 1 := by
    intro he
    have hh := congrArg (rankOneUpperParameter q) he
    rw [rankOneUpperParameter_element,hzero] at hh
    exact one_ne_zero hh
  have hcycle := zpowers_eq_top_of_prime_card (p := 2) hcard hne
  have hm : (middleUnipotentHom q 1).range ≤ Subgroup.zpowers (middleGenerator q) := by
    rintro _ ⟨u,rfl⟩
    have hu : u ∈ Subgroup.zpowers (rankOneUpperElement q 1) := by rw [hcycle]; trivial
    have hh : middleUnipotentHom q 1 u ∈
        (Subgroup.zpowers (rankOneUpperElement q 1)).map (middleUnipotentHom q 1) := ⟨u,hu,rfl⟩
    rwa [MonoidHom.map_zpowers] at hh
  apply top_unique
  rw [←ranges_generate q]
  exact sup_le_sup le_rfl hm

end SymmetricSubgroupAsymptotics.CFSGUnitaryRankThreeUpperShear
