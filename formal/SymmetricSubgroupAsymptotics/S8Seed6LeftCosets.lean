theorem step_mem (i : Fin 2520) (j : Fin 3) :
    representatives i * signedGenerators j * (representatives (nextSigned i j))⁻¹ ∈ H := by
  have hrow : permutationCode (BinaryMenuCayley8T6.certificate.toCayley.elements (witness i j)) =
