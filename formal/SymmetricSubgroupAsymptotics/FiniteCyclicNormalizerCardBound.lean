import Mathlib.GroupTheory.Subgroup.Centralizer
import Mathlib.GroupTheory.SpecificGroups.Cyclic
import Mathlib.GroupTheory.Index

/-! Normalizer order accounting uses the actual conjugation homomorphism.
This contains no classification or finite permutation enumeration. -/
set_option autoImplicit false
noncomputable section
open scoped Classical
namespace SymmetricSubgroupAsymptotics

/-- Conjugation embeds the quotient of a normalizer by its centralizer
into the actual automorphism group of the subgroup. -/
theorem normalizer_card_le_centralizer_mul_aut
    {G : Type*} [Group G] [Finite G] (H : Subgroup G) :
    Nat.card (Subgroup.normalizer (H : Set G)) ≤
      Nat.card (Subgroup.centralizer (H : Set G))*Nat.card (MulAut H) := by
  let f := H.normalizerMonoidHom
  have hk : Nat.card f.ker ≤ Nat.card (Subgroup.centralizer (H : Set G)) := by
    change Nat.card H.normalizerMonoidHom.ker ≤ _
    rw [H.normalizerMonoidHom_ker]
    exact Nat.card_le_card_of_injective
      (fun x => (⟨x.val.val,x.property⟩ : Subgroup.centralizer (H : Set G)))
      (by
        intro a b h
        have hab : a.val.val=b.val.val := congrArg
          (fun z : Subgroup.centralizer (H : Set G) => z.val) h
        exact Subtype.ext (Subtype.ext hab))
  have hr : Nat.card f.range ≤ Nat.card (MulAut H) := f.range.card_le_card_group
  calc
    Nat.card (Subgroup.normalizer (H : Set G))=Nat.card f.ker*Nat.card f.range := by
      rw [←Subgroup.index_ker,f.ker.card_mul_index]
    _ ≤ _ := Nat.mul_le_mul hk hr

/-- The cyclic subgroup generated by a prime-order element has at most
`p-1` conjugation automorphisms. The centralizer price remains explicit. -/
theorem prime_order_normalizer_card_le
    {G : Type*} [Group G] [Finite G] (g : G) {p : ℕ}
    (hp : p.Prime) (hg : orderOf g=p) :
    Nat.card (Subgroup.normalizer (Subgroup.zpowers g : Set G)) ≤
      Nat.card (Subgroup.centralizer (Subgroup.zpowers g : Set G))*(p-1) := by
  have h := normalizer_card_le_centralizer_mul_aut (Subgroup.zpowers g)
  rwa [IsCyclic.card_mulAut,Nat.card_zpowers,hg,Nat.totient_prime hp] at h

end SymmetricSubgroupAsymptotics
