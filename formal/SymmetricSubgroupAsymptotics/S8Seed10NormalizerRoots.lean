/-! Selected original8T10 normalizer forest. The actual normalizer
generator, both seed-word inclusions and every forest edge are checked. -/
set_option autoImplicit false
set_option maxRecDepth 100000
noncomputable section
open scoped Pointwise
namespace SymmetricSubgroupAsymptotics.S8Seed10NormalizerRoots
open S8Seed10LeftCosets

def normalizer : Ambient where
  toFun := ![6, 7, 0, 1, 2, 3, 4, 5]
  invFun := ![2, 3, 4, 5, 6, 7, 0, 1]
  left_inv := by decide +kernel
  right_inv := by decide +kernel

def normalizerCertificate : FiniteGeneratorEquivWordCertificate (MulAut.conj normalizer)
    BinaryMenuCayley8T10.generators BinaryMenuCayley8T10.generators where
  forward := {
    words := ![(.generator 0), (.mul (.generator 1) (.generator 0))]
    equations := by
      intro j
      fin_cases j <;> apply Equiv.ext <;> intro x <;> revert x <;> decide +kernel }
  backward := {
    words := ![(.generator 0), (.mul (.generator 1) (.generator 0))]
    equations := by
      intro j
      fin_cases j <;> apply Equiv.ext <;> intro x <;> revert x <;> decide +kernel }

theorem normalizes_seed : MulAut.conj normalizer • H = H := by
  change H.map (MulAut.conj normalizer).toMonoidHom = H
  exact normalizerCertificate.map_closure_eq

def edgeConjugator : Fin 3 → Ambient := ![1, 1, normalizer]
def edgeFactor : Fin 3 → Ambient :=
  ![BinaryMenuCayley8T10.generators 0, BinaryMenuCayley8T10.generators 1, 1]

theorem edge_normalizes (j : Fin 3) : MulAut.conj (edgeConjugator j) • H = H := by
  fin_cases j
  · change MulAut.conj (1 : Ambient) • H = H
    simp only [map_one, one_smul]
  · change MulAut.conj (1 : Ambient) • H = H
    simp only [map_one, one_smul]
  · exact normalizes_seed

theorem edge_factor_mem (j : Fin 3) : edgeFactor j ∈ H := by
  fin_cases j
  · exact Subgroup.subset_closure (Set.mem_range_self 0)
  · exact Subgroup.subset_closure (Set.mem_range_self 1)
  · exact H.one_mem

