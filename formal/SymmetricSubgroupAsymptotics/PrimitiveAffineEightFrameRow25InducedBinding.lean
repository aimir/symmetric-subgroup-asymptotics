      localRepresentation (sourceLocalMap (twist j a))
        (fun q ↦ v (CoinducedLeadingCoordinates.label (next j a) q)) i := by
  exact binaryFrameGeneratorFormula_of_basis
    PrimitiveAffineEightFrameRow25ModuleRepresentation.representation localRepresentation
    PrimitiveAffineEightFrameTop16TopCertificate.ambient (fun j a ↦ sourceLocalMap (twist j a)) next
    generatorFormula_basis

theorem representation_generator_formula (j : Fin 5)
    (v : PrimitiveAffineEightFrameRow25ModuleRepresentation.ModelModule)
    (a : Fin 8) (i : Fin 2) :
    PrimitiveAffineEightFrameRow25ModuleRepresentation.representation (PrimitiveAffineEightFrameTop16TopCertificate.ambient j) v
