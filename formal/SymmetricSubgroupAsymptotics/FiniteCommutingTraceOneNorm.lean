import SymmetricSubgroupAsymptotics.FiniteTraceOneUnitNorm
import Mathlib.Algebra.Ring.Subring.Basic
import Mathlib.Algebra.Ring.NonZeroDivisors
import Mathlib.Algebra.CharP.Algebra
import Mathlib.Tactic.Abel

/-! Norms in the actual commutative star-stable subring generated by
the trace-one element and the selfadjoint unit. The ambient ring may be
noncommutative. The constructed norm root retains every common
centralizer, so it can be used for actual intertwining operators. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
open scoped IsMulCommutative

namespace SymmetricSubgroupAsymptotics.FiniteCommutingTraceOneNorm

variable {E : Type*} [Ring E] [Finite E] [CharP E 2] [StarRing E]

theorem exists_unit_norm_commuting (u : E) (hu : u+star u=1)
    (s : Eˣ) (hs : star (s:E)=(s:E)) (hcomm : Commute u (s:E)) :
    ∃ T : Eˣ, (T:E)*star (T:E)=(s:E) ∧
      ∀ a : E, Commute a u → Commute a (s:E) → Commute a (T:E) := by
  let C : Subring E := Subring.closure {u,(s:E)}
  have hum : u∈C := Subring.subset_closure (by simp)
  have hsm : (s:E)∈C := Subring.subset_closure (by simp)
  letI : IsMulCommutative C := Subring.isMulCommutative_closure (by
    intro x hx y hy
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx hy
    rcases hx with rfl|rfl <;> rcases hy with rfl|rfl
    · rfl
    · exact hcomm.eq
    · exact hcomm.eq.symm
    · rfl)
  letI : CommRing C := inferInstance
  have hstable (x:E) (hx:x∈C) : star x∈C := by
    induction hx using Subring.closure_induction with
    | mem x hx =>
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rcases hx with rfl|rfl
      · have he : star x=1-x := by rw [←hu]; abel
        rw [he]
        exact C.sub_mem C.one_mem hum
      · rw [hs]
        exact hsm
    | zero => rw [star_zero]; exact C.zero_mem
    | one => rw [star_one]; exact C.one_mem
    | add x y _ _ hx hy => rw [star_add]; exact C.add_mem hx hy
    | neg x _ hx => rw [star_neg]; exact C.neg_mem hx
    | mul x y _ _ hx hy => rw [star_mul]; exact C.mul_mem hy hx
  letI : StarRing C := {
    star := fun x => ⟨star (x:E),hstable x x.property⟩
    star_involutive := fun x => Subtype.ext (star_star (x:E))
    star_mul := fun x y => Subtype.ext (star_mul (x:E) (y:E))
    star_add := fun x y => Subtype.ext (star_add (x:E) (y:E)) }
  letI : Finite C := Finite.of_injective C.subtype C.subtype_injective
  letI : CharP C 2 := C.subtype.charP C.subtype_injective 2
  let uC : C := ⟨u,hum⟩
  let sC : C := ⟨(s:E),hsm⟩
  have hinj : Function.Injective (fun x:C => sC*x) := by
    intro x y he
    have hh := congrArg (fun z:C => (↑(s⁻¹):E)*(z:E)) he
    apply Subtype.ext
    change (↑(s⁻¹):E)*((s:E)*(x:E))=(↑(s⁻¹):E)*((s:E)*(y:E)) at hh
    simpa only [←mul_assoc, Units.inv_mul, one_mul] using hh
  have hunit : IsUnit sC :=
    IsUnit.isUnit_iff_mulLeft_bijective.mpr (Finite.injective_iff_bijective.mp hinj)
  obtain ⟨sUnit,hsUnit⟩ := hunit
  have huC : uC+star uC=1 := Subtype.ext hu
  have hsC : star (sUnit:C)=(sUnit:C) := by
    rw [hsUnit]
    exact Subtype.ext hs
  obtain ⟨t,ht⟩ := FiniteTraceOneUnitNorm.exists_unit_norm uC huC sUnit hsC
  let T : Eˣ := Units.map C.subtype.toMonoidHom t
  refine ⟨T,?_,?_⟩
  · have he := congrArg (fun x:C => (x:E)) ht
    rw [hsUnit] at he
    exact he
  · intro a hau has
    have hC : C≤Subring.centralizer {a} := Subring.closure_le.mpr (by
      intro x hx
      apply Subring.mem_centralizer_iff.mpr
      intro b hb
      have hb' : b=a := Set.mem_singleton_iff.mp hb
      subst b
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rcases hx with rfl|rfl
      · exact hau.eq
      · exact has.eq)
    exact Subring.mem_centralizer_iff.mp (hC (t:C).property) a (by simp)

end SymmetricSubgroupAsymptotics.FiniteCommutingTraceOneNorm
