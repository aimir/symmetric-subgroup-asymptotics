import SymmetricSubgroupAsymptotics.CFSGTwistedE6GeckRelativeWordTwist
import SymmetricSubgroupAsymptotics.CFSGTwistedE6GeckPositiveTwist
import SymmetricSubgroupAsymptotics.CFSGCentralTwistedCommutatorLift

/-! The actual subgroup generated by fixed U and fixed V contains every
relative Weyl word. Paired rank-one words are regrouped using literal
mixed-sign orthogonal commutation, over every coefficient field. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
open scoped Classical
namespace SymmetricSubgroupAsymptotics.CFSGTwistedE6GeckRelativeRootGenerated
open CFSGTwistedE6GeckDiagramCovariance CFSGTwistedE6GeckMatrixTwist
open CFSGTwistedE6GeckPositiveTwist CFSGTwistedE6GeckRelativeWordTwist
open CFSGTwistedE6RelativeWeylOrbits CFSGTwistedE6FixedWordClassification
open CFSGExceptionalNormTwoBases CFSGExceptionalCartanPositiveDefinite
open CFSGNormTwoGeckOrthogonalWeyl CFSGSerreQuadraticMatrix CFSGSerreQuadraticWeylWord
open CFSGNormTwoGeckIntegralWord CFSGNormTwoGeckWeylWordDegree
open CFSGNormTwoGeckWeylWordAlgebra
open CFSGCentralTwistedCommutatorLift
local notation "A" => CartanMatrix.E₆
local notation "hs" => CartanMatrix.E₆_transpose
local notation "hp" => E6_positive_definite

def signedFixed (K : Type) [Field K] (sigma : K≃+*K) (neg : Bool) :
    Subgroup (Matrix GeckIndex GeckIndex K)ˣ :=
  SignedUpper K neg ⊓ fixedSubgroup (unitTwist K sigma)

def fixedRootGenerated (K : Type) [Field K] (sigma : K≃+*K) :
    Subgroup (Matrix GeckIndex GeckIndex K)ˣ :=
  signedFixed K sigma false ⊔ signedFixed K sigma true

theorem signedFixed_le_generated (K : Type) [Field K] (sigma : K≃+*K) (neg : Bool) :
    signedFixed K sigma neg ≤ fixedRootGenerated K sigma := by
  cases neg
  · exact le_sup_left
  · exact le_sup_right

theorem fixedRootGenerated_le_fixed (K : Type) [Field K] (sigma : K≃+*K) :
    fixedRootGenerated K sigma ≤ fixedSubgroup (unitTwist K sigma) :=
  sup_le inf_le_right inf_le_right

def orbitParameter (K : Type) [Field K] (neg : Bool) (a : Fin 4) (t : K) :
    (Matrix GeckIndex GeckIndex K)ˣ :=
  ![canonicalRoot rawData K neg 0 t*canonicalRoot rawData K neg 5 t,
    canonicalRoot rawData K neg 2 t*canonicalRoot rawData K neg 4 t,
    canonicalRoot rawData K neg 3 t,canonicalRoot rawData K neg 1 t] a

theorem orbitParameter_mem_upper (K : Type) [Field K] (neg : Bool) (a : Fin 4) (t : K) :
    orbitParameter K neg a t∈SignedUpper K neg := by
  have h (i : Fin 6) : canonicalRoot rawData K neg i t∈SignedUpper K neg :=
    Subgroup.subset_closure ⟨(i,t),rfl⟩
  fin_cases a
  · exact (SignedUpper K neg).mul_mem (h 0) (h 5)
  · exact (SignedUpper K neg).mul_mem (h 2) (h 4)
  · exact h 3
  · exact h 1

theorem orbitParameter_fixed (K : Type) [Field K] (sigma : K≃+*K)
    (neg : Bool) (a : Fin 4) (t : K) (ht : sigma t=t) :
    unitTwist K sigma (orbitParameter K neg a t)=orbitParameter K neg a t := by
  fin_cases a
  · change unitTwist K sigma (canonicalRoot rawData K neg 0 t*canonicalRoot rawData K neg 5 t)=_
    rw [map_mul,unitTwist_root,unitTwist_root,ht]
    change canonicalRoot rawData K neg 5 t*canonicalRoot rawData K neg 0 t=_
    exact (orthogonal_signed_roots A hs hp E6Base E6Index K 0 5
      (by rw [E6_cartan];decide) neg neg t t).eq.symm
  · change unitTwist K sigma (canonicalRoot rawData K neg 2 t*canonicalRoot rawData K neg 4 t)=_
    rw [map_mul,unitTwist_root,unitTwist_root,ht]
    change canonicalRoot rawData K neg 4 t*canonicalRoot rawData K neg 2 t=_
    exact (orthogonal_signed_roots A hs hp E6Base E6Index K 2 4
      (by rw [E6_cartan];decide) neg neg t t).eq.symm
  · change unitTwist K sigma (canonicalRoot rawData K neg 3 t)=_
    rw [unitTwist_root,ht]
    rfl
  · change unitTwist K sigma (canonicalRoot rawData K neg 1 t)=_
    rw [unitTwist_root,ht]
    rfl

theorem orbitParameter_mem_generated (K : Type) [Field K] (sigma : K≃+*K)
    (neg : Bool) (a : Fin 4) (t : K) (ht : sigma t=t) :
    orbitParameter K neg a t∈fixedRootGenerated K sigma :=
  signedFixed_le_generated K sigma neg
    ⟨orbitParameter_mem_upper K neg a t,orbitParameter_fixed K sigma neg a t ht⟩

private theorem paired_rank_one {G : Type*} [Group G] (a b c d : G)
    (hbc : Commute b c) (hba : Commute b a) (hda : Commute d a) :
    (a*b)*(c*d)*(a*b)=(a*c*a)*(b*d*b) := by
  rw [hbc.mul_mul_mul_comm a d]
  exact (hba.mul_left hda).mul_mul_mul_comm (a*c) b

theorem orbit_word_parameter (K : Type) [Field K] (a : Fin 4) :
    canonicalWord rawData K (orbitWord a)=
      orbitParameter K false a 1*orbitParameter K true a (-1)*orbitParameter K false a 1 := by
  have hpair (i j : Fin 6) (hij : CFSGGeckSerreRepresentation.cartan E6Base E6Index i j=0) :
      canonicalWeyl rawData K i*canonicalWeyl rawData K j=
        (canonicalRoot rawData K false i 1*canonicalRoot rawData K false j 1)*
        (canonicalRoot rawData K true i (-1)*canonicalRoot rawData K true j (-1))*
        (canonicalRoot rawData K false i 1*canonicalRoot rawData K false j 1) := by
    have hji : CFSGGeckSerreRepresentation.cartan E6Base E6Index j i=0 := by
      rw [E6_cartan] at hij ⊢
      calc
        A j i=CartanMatrix.E₆.transpose i j := rfl
        _=A i j := congrArg (fun M : Matrix (Fin 6) (Fin 6) ℤ=>M i j) CartanMatrix.E₆_transpose
        _=0 := hij
    symm
    exact paired_rank_one _ _ _ _
      (orthogonal_signed_roots A hs hp E6Base E6Index K j i hji false true 1 (-1))
      (orthogonal_signed_roots A hs hp E6Base E6Index K j i hji false false 1 1)
      (orthogonal_signed_roots A hs hp E6Base E6Index K j i hji true false (-1) 1)
  fin_cases a
  · change canonicalWeyl rawData K 0*(canonicalWeyl rawData K 5*1)=_
    rw [mul_one]
    exact hpair 0 5 (by rw [E6_cartan];decide)
  · change canonicalWeyl rawData K 2*(canonicalWeyl rawData K 4*1)=_
    rw [mul_one]
    exact hpair 2 4 (by rw [E6_cartan];decide)
  · change canonicalWeyl rawData K 3*1=_
    rw [mul_one]
    rfl
  · change canonicalWeyl rawData K 1*1=_
    rw [mul_one]
    rfl

theorem relativeWord_mem_generated (K : Type) [Field K] (sigma : K≃+*K)
    (r : List (Fin 4)) : wordUnit A hs hp E6Base E6Index K (expandRelative r)∈
      fixedRootGenerated K sigma := by
  induction r with
  | nil=>exact (fixedRootGenerated K sigma).one_mem
  | cons a r ih=>
    rw [expandRelative,wordUnit_append]
    apply (fixedRootGenerated K sigma).mul_mem _ ih
    rw [word_eq_canonicalWord,orbit_word_parameter]
    exact (fixedRootGenerated K sigma).mul_mem
      ((fixedRootGenerated K sigma).mul_mem
        (orbitParameter_mem_generated K sigma false a 1 (by simp))
        (orbitParameter_mem_generated K sigma true a (-1) (by simp)))
      (orbitParameter_mem_generated K sigma false a 1 (by simp))

end SymmetricSubgroupAsymptotics.CFSGTwistedE6GeckRelativeRootGenerated
